          <entry>
            <string>dataSource</string>
            <string>--Author rich.rose@aptare.com
--Last Updated: 06/13/2012
SELECT
vm_id, vm_name, 
host_id, host_name, 
vm_host_id, vm_host_name, vm_status,
vmw_datastore_id, datastore_name, 
file_name, file_path, 
file_type, 
file_size/1024/1024 file_size, 
storage_array_id, array_name, 
logical_unit_id, logical_unit_name, 
last_updated
FROM apt_v_vmw_vmfile
WHERE host_id IN (${hosts})
AND logical_unit_id IS NOT NULL
AND file_type = &apos;VmDisk&apos;</string>
          </entry>
