          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 01/28/2012
WITH 
t1 AS (
SELECT 
to_char(trunc(nss.mirror_timestamp,DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;)),&apos;YYYY-MM-DD&apos;) the_date,
max(nss.summary_status) status,
sum(DECODE(nss.summary_status,2,1,0)) failed,
sum(DECODE(nss.summary_status,1,1,0)) partial,
sum(DECODE(nss.summary_status,0,1,0)) success
FROM 
aps_v_nap_snapvault_config nsc,
aps_v_nap_snapvault_status nss
WHERE
nsc.nap_snapvault_config_id = nss.nap_snapvault_config_id (+)
AND nss.mirror_timestamp BETWEEN ${startDate} AND ${endDate}
AND nsc.source_system_name LIKE DECODE(&apos;${queryCombo1}&apos;,&apos; All&apos;,&apos;%&apos;,&apos;${queryCombo1}&apos;)
AND nsc.source_storage_system_id IS NULL
GROUP BY
to_char(trunc(nss.mirror_timestamp,DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;)),&apos;YYYY-MM-DD&apos;)
)
SELECT
the_date,
success,
partial,
failed
FROM t1
ORDER BY the_date DESC</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
