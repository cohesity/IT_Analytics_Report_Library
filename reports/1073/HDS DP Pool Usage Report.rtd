          <entry>
            <string>dataSource</string>
            <string>--Author:rich.rose@aptare.com
--Last Modified: 09/10/2015
WITH
VAR AS (
SELECT
ROUND((${endDate} - ${startDate}),2) nbrOfDays, 
${startDate} startDate, 
&apos;${freeCombo1}&apos; unit,
DECODE(&apos;${freeCombo1}&apos;, &apos;KB&apos;,1,&apos;MB&apos;,1024,&apos;GB&apos;,(1024*1024),&apos;TB&apos;,(1024*1024*1024),&apos;PB&apos;,(1024*1024*1024*1024)) div_by 
FROM apt_v_dual 
)
SELECT
storage_array_id,
array_name,
pool_id,
NVL(pool_name,&apos;DP &apos;||pool_id) pool_name, 
capacity_kb/div_by capacity,
free_capacity_kb/div_by free_capacity,
(capacity_kb - free_capacity_kb)/div_by touched,
ROUND((capacity_kb - free_capacity_kb)/capacity_kb*100) pct_touched,
(capacity_kb - free_capacity_kb)/capacity_kb touched_pct,
threshold,
CASE WHEN ((capacity_kb - free_capacity_kb)/capacity_kb*100) &gt;= threshold THEN &apos;red&apos; ELSE &apos;green&apos; END t1_dot,
CASE WHEN ((capacity_kb - free_capacity_kb)/capacity_kb*100) &gt;= threshold THEN &apos;Exceeds&apos; ELSE &apos;Less Than&apos; END t1_message,
threshold2,
CASE WHEN ((capacity_kb - free_capacity_kb)/capacity_kb*100) &gt;= threshold2 THEN &apos;red&apos; ELSE &apos;green&apos; END t2_dot,
CASE WHEN ((capacity_kb - free_capacity_kb)/capacity_kb*100) &gt;= threshold2 THEN &apos;Exceeds&apos; ELSE &apos;Less Than&apos; END t2_message,
capacity_of_vvols_kb/div_by capacity_of_vvols,
((capacity_kb-capacity_of_vvols_kb)/div_by)*-1 provisioned,
CASE WHEN (capacity_of_vvols_kb/capacity_kb*100) &gt; 100 
THEN &apos;&lt;font color=red&gt;&apos;||ROUND((capacity_of_vvols_kb/capacity_kb*100))||&apos;%&apos;
ELSE &apos;&lt;font color=green&gt;&apos;||ROUND((capacity_of_vvols_kb/capacity_kb*100))||&apos;%&apos;
END prov_pct,
--usage_rate,
DECODE(threshold_vol_forewarn,-1,null,threshold_vol_forewarn) threshold_vol_forewarn,
CASE 
WHEN threshold_vol_forewarn = -1 THEN &apos;white&apos;
WHEN ROUND((capacity_of_vvols_kb/capacity_kb*100)) &gt;= threshold_vol_forewarn THEN &apos;red&apos; 
WHEN ROUND((capacity_of_vvols_kb/capacity_kb*100)) BETWEEN 0 AND threshold_vol_forewarn THEN &apos;green&apos; 
ELSE &apos;blue&apos; END fore_dot,
DECODE(threshold_vol_overwarn,-1,null,threshold_vol_overwarn) threshold_vol_overwarn,
CASE 
WHEN threshold_vol_overwarn = -1 THEN &apos;white&apos;
WHEN ROUND((capacity_of_vvols_kb/capacity_kb*100)) &gt;= threshold_vol_overwarn THEN &apos;red&apos; 
WHEN ROUND((capacity_of_vvols_kb/capacity_kb*100)) BETWEEN 0 AND threshold_vol_overwarn THEN &apos;green&apos; 
ELSE &apos;blue&apos; END over_dot
FROM aps_v_hds_journal_pool, var
WHERE array_name LIKE DECODE(&apos;${queryCombo1}&apos;,&apos; All&apos;,&apos;%&apos;,&apos;${queryCombo1}&apos;)
AND array_name IS NOT NULL
AND capacity_of_vvols_kb &gt; 0</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
