          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 04/25/2016
--Computes the future capacity of an array based on 
--Linear Regression (Linear) Sum of squares linear algorithm y=mX+b
WITH 
d0 AS (
SELECT
DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,1,&apos;Week&apos;,10,&apos;Month&apos;,31,&apos;Quarter&apos;,93,&apos;Year&apos;,365.24) nbr_of_days,
TO_NUMBER(&apos;${freeCombo2}&apos;) forecast_periods,
&apos;${freeCombo3}&apos; unit,
DECODE(&apos;${freeCombo3}&apos;, &apos;GB&apos;,1,&apos;TB&apos;,1024,&apos;PB&apos;,(1024*1024)) div_by 
FROM apt_v_dual
),
t0 AS (--Get all indiviapt_v_dual pools for each period
SELECT 
array_name,
emc_cla_storage_pool_id pool_id,
TRUNC(log_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YY&apos;)) log_date,
MAX(total_subscribed_capacity_gb) subscribed,
MAX(available_capacity_gb) + MAX(consumed_capacity_gb) capacity,
MAX(consumed_capacity_gb) used,
MAX(available_capacity_gb) available
FROM aps_v_emc_cla_storage_pool_log
WHERE log_date BETWEEN ${startDate} AND ${endDate}
AND array_name = &apos;${queryCombo1}&apos;
GROUP BY array_name, emc_cla_storage_pool_id,
TRUNC(log_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YY&apos;))
),
t1 AS (--Aggregate them at the array level
SELECT 
array_name entity,
log_date,
COUNT(DISTINCT pool_id) nbr_of_pools,
SUM(subscribed) subscribed,
SUM(capacity) capacity,
SUM(used) used,
SUM(available) available
FROM t0
GROUP BY array_name, log_date
ORDER BY array_name, log_date
),
a0 AS (--Aggregate them at the array level
SELECT 
entity,
log_date,
ROW_NUMBER() OVER (PARTITION BY entity  ORDER BY entity) row_number,
subscribed,
capacity,
used,
available
FROM t1
ORDER BY entity, log_date
),
a1 AS (
SELECT 
ROWNUM period,
log_date,
subscribed,
capacity,
used,
available,
REGR_SLOPE(available,ROWNUM) OVER (PARTITION BY entity) a_slope,
REGR_INTERCEPT(available, ROWNUM) OVER (PARTITION BY entity) a_y_intercept,
REGR_SLOPE(used,ROWNUM) OVER (PARTITION BY entity) u_slope,
REGR_INTERCEPT(used, ROWNUM) OVER (PARTITION BY entity) u_y_intercept
FROM a0
ORDER BY 1,2
),
p0 AS (--Find the last period so you can forecast past it
SELECT 
MAX(period) last_period,
MAX(log_date) last_date
FROM a1
)
SELECT
TO_CHAR(log_date,&apos;MM/DD/YYYY&apos;) log_date,
ROUND(subscribed/div_by,2) subscribed,
ROUND(capacity/div_by,2) capacity,
ROUND(available/div_by,2) available,
0 future_available,
ROUND((period*a_slope+a_y_intercept)/div_by,2) a_trend_line,
ROUND(used/div_by,2) used,
0 future_used,
ROUND((period*u_slope+u_y_intercept)/div_by,2) u_trend_line,
unit
FROM a1, p0, d0
UNION ALL --Future
SELECT 
TO_CHAR(TRUNC(the_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YY&apos;)),&apos;MM/DD/YYYY&apos;) log_date,
ROUND(subscribed/div_by,2) subscribed,
ROUND(capacity/div_by,2) capacity,
0 available,
ROUND(((period+ROWNUM)*a_slope+a_y_intercept)/div_by,2) future_available,
ROUND(((period+ROWNUM)*a_slope+a_y_intercept)/div_by,2) a_trend_line,
0 used,
ROUND(((period+ROWNUM)*u_slope+u_y_intercept)/div_by,2) future_used,
ROUND(((period+ROWNUM)*u_slope+u_y_intercept)/div_by,2) u_trend_line,
unit
FROM a1, p0, d0, 
TABLE(rtd.APTlistOfDates(p0.last_date+d0.nbr_of_days,p0.last_date+(d0.forecast_periods*d0.nbr_of_days),DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,11,&apos;Week&apos;,12,&apos;Month&apos;,13,&apos;Quarter&apos;,14,&apos;Year&apos;,15))) the_dates
WHERE period = p0.last_period
AND ROUND((period+ROWNUM)*a_slope+a_y_intercept,2) &gt; 0
AND ROUND((period+ROWNUM)*u_slope+u_y_intercept,2) &gt; 0</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
