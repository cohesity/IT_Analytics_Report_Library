                  </entry>
                  <entry>
                    <string>queryComboValues2</string>
                    <string>SELECT &apos; All&apos;, &apos; All&apos; FROM apt_v_dual UNION SELECT DISTINCT destination_system_name,destination_system_name FROM aps_v_nap_snapvault_config WHERE source_storage_system_id is null</string>
                  </entry>
