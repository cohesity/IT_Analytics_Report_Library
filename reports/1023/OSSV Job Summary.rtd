          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 06/14/2012
SELECT 
nss.mirror_timestamp the_date,
nsc.source_system_name,
nsc.source_volume_name,
DECODE(nss.summary_status,0,&apos;Successful&apos;,1,&apos;Partial&apos;,2,&apos;Failed&apos;) status_name,
DECODE(summary_status,null,&apos;white&apos;,0,&apos;green&apos;,1,&apos;yellow&apos;,2,&apos;red&apos;) status_color,
nss.mirror_state,
nss.mirror_status,
nss.transfer_progress,
nsc.destination_system_name,
nsc.destination_qtree_name,
rtd.secsToHoursMinSecs(nss.lag_time) lag_time,
nss.last_transfer_size_kb/1024/1024 last_transfer_size_gb
FROM 
aps_v_nap_snapvault_config nsc,
aps_v_nap_snapvault_status nss
WHERE
nsc.nap_snapvault_config_id = nss.nap_snapvault_config_id (+)
AND nss.mirror_timestamp BETWEEN ${startDate} AND ${endDate}
AND nsc.source_system_name LIKE DECODE(&apos;${queryCombo1}&apos;,&apos; All&apos;,&apos;%&apos;,&apos;${queryCombo1}&apos;)
AND nsc.destination_system_name LIKE DECODE(&apos;${queryCombo2}&apos;,&apos; All&apos;,&apos;%&apos;,&apos;${queryCombo2}&apos;)
AND nsc.source_storage_system_id IS NULL
AND to_char(nss.summary_status) LIKE DECODE(&apos;${freeCombo1}&apos;,&apos;Successful&apos;,&apos;0&apos;,&apos;Partial&apos;,&apos;1&apos;,&apos;Failed&apos;,&apos;2&apos;,&apos;All&apos;,&apos;%&apos;)</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
