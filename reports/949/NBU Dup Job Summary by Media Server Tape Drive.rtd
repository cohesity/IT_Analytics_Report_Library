          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 05/10/2012
SELECT
ndj.media_host_name, ndj.drive_id, ntd.drive_name tape_drive,count(ndj.job_id) job_count,
avg(ndj.mbytes_sec) avg_mbytes_sec,
sum(ndj.kilobytes/1024/1024) size_gb 
FROM apt_v_nbu_duplication_job ndj, apt_v_nbu_tape_drive ntd
WHERE ndj.start_date BETWEEN ${startDate} AND ${endDate}
AND ndj.server_id IN (${hosts})
AND ndj.drive_id = ntd.drive_id(+)
AND ndj.is_active = &apos;N&apos;
GROUP BY 
ndj.drive_id,
ntd.drive_name,
ndj.media_host_name
ORDER BY 1,2</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
