          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 12/27/2012
WITH 
var AS (
SELECT
DECODE(&apos;${freeCombo2}&apos;,
&apos;KB&apos;,1,&apos;MB&apos;,1024,&apos;GB&apos;,(1024*1024),&apos;TB&apos;,(1024*1024*1024),&apos;PB&apos;,(1024*1024*1024*1024)) div_by 
FROM apt_v_dual
)
SELECT
to_char(trunc(start_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;)),&apos;YYYY/MM/DD&apos;) the_date,
ROUND(SUM(DECODE(job_type,101,kilobytes/var.div_by,0)),2) Full,
ROUND(SUM(DECODE(job_type,102,kilobytes/var.div_by,0)),2) Incremental,
ROUND(SUM(DECODE(job_type,112,kilobytes/var.div_by,0)),2) Application,
ROUND(SUM(DECODE(job_type,107,kilobytes/var.div_by,0)),2) Duplication,
ROUND(SUM(CASE WHEN job_type NOT IN (101,102,112,107) THEN kilobytes/var.div_by ELSE 0 END),2) all_others
FROM apt_v_nbu_job, var
WHERE client_id IN (${hosts})
AND start_date BETWEEN ${startDate} AND ${endDate}
GROUP BY to_char(trunc(start_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;)),&apos;YYYY/MM/DD&apos;)
ORDER BY 1</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
