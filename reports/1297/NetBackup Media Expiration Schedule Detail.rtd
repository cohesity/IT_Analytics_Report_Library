          <entry>
            <string>dataSource</string>
            <string>-- drilldown report&#xd;
&#xd;
SELECT ntmd.tape_media_id,&#xd;
       s.hostname server,&#xd;
       ntmd.media_name Media,&#xd;
       ntmd.vendor_media_type_name Media_Type,&#xd;
       ntmd.bar_code,&#xd;
       ntd.serial_number,&#xd;
       ntmd.volume_pool_name,&#xd;
       ntmd.written_kilobytes Used_Kb,&#xd;
       ntd.robot_drive_index robot_number,&#xd;
       ntd.drive_name robot_name,&#xd;
       ntmd.expiration_date     &#xd;
FROM apt_v_nbu_tape_media_detail ntmd,&#xd;
     apt_v_nbu_tape_drive ntd,&#xd;
     apt_v_server s&#xd;
WHERE ntmd.vendor_media_type_name= &apos;${the_media_type}&apos;&#xd;
  AND ntmd.server_id=ntd.controlling_server_id (+)&#xd;
  AND ntmd.last_mounted_drive_id=ntd.drive_id (+)&#xd;
  AND ntmd.server_id=s.server_id  (+)&#xd;
  AND TO_CHAR(TRUNC(ntmd.expiration_date),&apos;${the_date_format}&apos;) = &apos;${the_date_char}&apos;&#xd;
  AND ntmd.expiration_date BETWEEN ${startDate} AND ${endDate}&#xd;
ORDER BY ntmd.expiration_date</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
