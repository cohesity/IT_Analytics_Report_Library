          <entry>
            <string>dataSource</string>
            <string>
--Author: rich.rose@aptare.com
--Last Updated: 05/30/2012
WITH 
t1 as (-- add up the size of all the disks
SELECT host_id,
count(distinct disk_id) nbr_of_disks,
sum(size_kb/1024/1024) disk_size_gb
FROM aps_v_host_disk
WHERE host_id IN (${hosts})
GROUP BY host_id
)
SELECT 
hs.host_id, hs.host_name, t1.nbr_of_disks, t1.disk_size_gb, hs.seen_by_host_gb,hs.allocated_capacity_gb
FROM aps_v_host_storage hs, t1
WHERE t1.host_id = hs.host_id</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
