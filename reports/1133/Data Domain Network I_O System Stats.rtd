                  <entry>
                    <string>queryComboValues1</string>
                    <string>SELECT DISTINCT host_name key, host_name value FROM apt_v_ddm_system_log s, aps_v_host h WHERE s.host_id = h.host_id AND collection_time &gt; sysdate - 7 ORDER BY 1</string>
                  </entry>
                  <entry>
                    <string>queryComboHeading1</string>
                    <string>Data Domain:</string>
                  </entry>
                  <entry>
                    <string>sql</string>
                    <string>SELECT DISTINCT host_name key, host_name value FROM apt_v_ddm_system_log s, aps_v_host h WHERE s.host_id = h.host_id AND collection_time &gt; sysdate - 7 ORDER BY 1</string>
