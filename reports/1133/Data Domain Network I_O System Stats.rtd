          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 12/10/2014
WITH 
var AS (
SELECT
DECODE(&apos;${freeCombo2}&apos;,&apos;KB&apos;,1,&apos;MB&apos;,1024,&apos;GB&apos;,(1024*1024),&apos;TB&apos;,(1024*1024*1024),&apos;PB&apos;,(1024*1024*1024*1024)) div_by 
FROM apt_v_dual
)
SELECT
to_char(trunc(collection_time,DECODE(&apos;${freeCombo1}&apos;,&apos;Hour&apos;,&apos;HH24&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YY&apos;)),&apos;MM/DD/YYYY HH24&apos;) the_date,
to_char(trunc(collection_time,DECODE(&apos;${freeCombo1}&apos;,&apos;Hour&apos;,&apos;HH24&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YY&apos;)),&apos;YYYYMMDDHH24&apos;) sort_order,
ROUND(MAX(cpu_avg_pct_busy),2) cpu_avg_pct_busy,
ROUND(MAX(cpu_max_pct_busy),2) cpu_max_pct_busy,
ROUND(SUM(disk_read_kb/div_by),2) disk_read,
ROUND(SUM(disk_written_kb/div_by),2) disk_written,
ROUND(MAX(disk_pct_busy),2) disk_pct_busy,
ROUND(MAX(nfs_proc_pct_busy),2) nfs_proc_pct_busy,
ROUND(SUM(net_kb_in/div_by),2) net_in,
ROUND(SUM(net_kb_out/div_by),2) net_out,
ROUND(SUM(replication_kb/div_by),2) replication
FROM apt_v_ddm_system_log sl, aps_v_host h, var
WHERE collection_time BETWEEN ${startDate} AND ${endDate}
AND sl.host_id = h.host_id
AND h.host_name = &apos;${queryCombo1}&apos;
GROUP BY
to_char(trunc(collection_time,DECODE(&apos;${freeCombo1}&apos;,&apos;Hour&apos;,&apos;HH24&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YY&apos;)),&apos;MM/DD/YYYY HH24&apos;),
to_char(trunc(collection_time,DECODE(&apos;${freeCombo1}&apos;,&apos;Hour&apos;,&apos;HH24&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YY&apos;)),&apos;YYYYMMDDHH24&apos;)</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
