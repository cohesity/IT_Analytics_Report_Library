          <entry>
            <string>dataSource</string>
            <string>

--Author: rich.rose@aptare.com
--Last Modified: 05/10/2012
SELECT 
to_char(start_date, &apos;MM/DD/YY&apos;) job_date,
NVL(SUM(CASE WHEN UPPER(os_version) LIKE &apos;%WIN%&apos; THEN 1 END),0) Windows,
NVL(SUM(CASE WHEN UPPER(os_version) LIKE &apos;%SOL%&apos; THEN 1 END),0) Solaris,
NVL(SUM(CASE WHEN UPPER(os_version) LIKE &apos;%LIN%&apos; THEN 1 END),0) Linux,
NVL(SUM(CASE WHEN UPPER(os_version) LIKE &apos;%AIX%&apos; THEN 1 END),0) AIX,
NVL(SUM(CASE WHEN UPPER(os_version) LIKE &apos;%HP%&apos; THEN 1 END),0) HPUX
FROM
apt_v_job j, apt_v_server s
WHERE j.client_id=s.server_id
AND j.client_id IN (${hosts})
AND start_date BETWEEN ${startDate} AND ${endDate}
GROUP BY to_char(start_date, &apos;MM/DD/YY&apos;)</string>
          </entry>
