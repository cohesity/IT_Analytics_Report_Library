          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 01/20/2019
WITH 
VAR AS (
SELECT 
&apos;${freeCombo1}&apos; unit,
DECODE(&apos;${freeCombo1}&apos;, &apos;KB&apos;,1,&apos;MB&apos;,1024,&apos;GB&apos;,(1024*1024),&apos;TB&apos;,(1024*1024*1024),&apos;PB&apos;,(1024*1024*1024*1024)) div_by
FROM apt_v_dual
)
SELECT
sa.storage_array_id,
sa.array_name,
sa.array_family,
SUM(DECODE(pd.disk_type,&apos;FC&apos;,1,0)) fc_count,
SUM(DECODE(pd.disk_type,&apos;FC&apos;,pd.capacity_kb/div_by,0)) fc_capacity,
SUM(DECODE(pd.disk_type,&apos;EFD&apos;,1,0)) efd_count,
SUM(DECODE(pd.disk_type,&apos;EFD&apos;,pd.capacity_kb/div_by,0)) efd_capacity,
SUM(DECODE(pd.disk_type,&apos;LUN&apos;,1,0)) lun_count,
SUM(DECODE(pd.disk_type,&apos;LUN&apos;,pd.capacity_kb/div_by,0)) lun_capacity,
SUM(DECODE(pd.disk_type,&apos;SAS&apos;,1,0)) sas_count,
SUM(DECODE(pd.disk_type,&apos;SAS&apos;,pd.capacity_kb/div_by,0)) sas_capacity,
SUM(DECODE(pd.disk_type,&apos;SSD&apos;,1,0)) ssd_count,
SUM(DECODE(pd.disk_type,&apos;SSD&apos;,pd.capacity_kb/div_by,0)) ssd_capacity,
SUM(DECODE(pd.disk_type,&apos;BSAS&apos;,1,0)) bsas_count,
SUM(DECODE(pd.disk_type,&apos;BSAS&apos;,pd.capacity_kb/div_by,0)) bsas_capacity,
SUM(DECODE(pd.disk_type,&apos;SATA&apos;,1,0)) sata_count,
SUM(DECODE(pd.disk_type,&apos;SATA&apos;,pd.capacity_kb/div_by,0)) sata_capacity,
SUM(DECODE(pd.disk_type,&apos;NL SAS&apos;,1,0)) nlsas_count,
SUM(DECODE(pd.disk_type,&apos;NL SAS&apos;,pd.capacity_kb/div_by,0)) nlsas_capacity,
SUM(DECODE(pd.disk_type,&apos;Unknown&apos;,1,0)) unknown_count,
SUM(DECODE(pd.disk_type,&apos;Unknown&apos;,pd.capacity_kb/div_by,0)) unknown_capacity,
SUM(DECODE(pd.disk_type,&apos;SATA SSD&apos;,1,0)) satassd_count,
SUM(DECODE(pd.disk_type,&apos;SATA SSD&apos;,pd.capacity_kb/div_by,0)) satassd_capacity
FROM aps_v_pdev pd, aps_v_storage_array sa, var
WHERE 
sa.storage_array_id IN (${arrays})
AND sa.storage_array_id = pd.storage_array_id
GROUP BY 
sa.storage_array_id,
sa.array_name,
sa.array_family</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
