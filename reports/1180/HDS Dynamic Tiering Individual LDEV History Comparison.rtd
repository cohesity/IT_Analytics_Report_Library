          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 09/28/2017
WITH
VAR AS (
SELECT
ROUND((${endDate} - ${startDate}),2) nbrOfDays, 
${startDate} startDate, 
DECODE(&apos;${freeCombo1}&apos;, &apos;KB&apos;,1,&apos;MB&apos;,1024,&apos;GB&apos;,(1024*1024),&apos;TB&apos;,(1024*1024*1024),&apos;PB&apos;,(1024*1024*1024*1024)) div_by 
FROM apt_v_dual 
),
t1 AS (
SELECT
ll.storage_array_id,
ll.array_name,
ll.ldev_id,
l.label,
TRUNC(ll.log_date,&apos;HH24&apos;) the_date,
MAX(ll.dp_tier0_consumed_kb/div_by) max_tier0,
MAX(ll.dp_tier1_consumed_kb/div_by) max_tier1,
MAX(ll.dp_tier2_consumed_kb/div_by) max_tier2
FROM aps_v_hds_ldev_log ll, aps_v_hds_ldev l, var
WHERE 
ll.storage_array_id IN (${arrays})
AND ll.ldev_id = l.ldev_id
AND ll.log_date BETWEEN ${startDate} AND ${endDate}
AND ll.dp_tier0_consumed_kb+ll.dp_tier2_consumed_kb+ll.dp_tier2_consumed_kb &gt; 0
GROUP BY
ll.storage_array_id,
ll.array_name,
ll.ldev_id,
l.label,
TRUNC(ll.log_date,&apos;HH24&apos;)
ORDER BY 1
),
t2 AS (--Get the values of the first and last periods to caclulate deltas
SELECT DISTINCT
storage_array_id,
ldev_id,
FIRST_VALUE(max_tier0) OVER (PARTITION BY storage_array_id, ldev_id ORDER BY the_date ASC) first_tier0, 
FIRST_VALUE(max_tier0) OVER (PARTITION BY storage_array_id, ldev_id ORDER BY the_date DESC) last_tier0,
FIRST_VALUE(max_tier1) OVER (PARTITION BY storage_array_id, ldev_id ORDER BY the_date ASC) first_tier1, 
FIRST_VALUE(max_tier1) OVER (PARTITION BY storage_array_id, ldev_id ORDER BY the_date DESC) last_tier1,
FIRST_VALUE(max_tier2) OVER (PARTITION BY storage_array_id, ldev_id ORDER BY the_date ASC) first_tier2, 
FIRST_VALUE(max_tier2) OVER (PARTITION BY storage_array_id, ldev_id ORDER BY the_date DESC) last_tier2
FROM T1
),
t3 AS (--Build the sparlines 
SELECT 
storage_array_id,
array_name,
ldev_id,
label,
MIN(the_date) first_sample,
MAX(the_date) last_sample,
COUNT(the_date) sample_count,
MAX(max_tier0) max_tier0,
rtd.collectString(CAST(COLLECT(TO_CHAR(ROUND(max_tier0,2)) ORDER BY the_date) AS StringListType),&apos;, &apos;) spk_tier0,
MAX(max_tier1) max_tier1,
rtd.collectString(CAST(COLLECT(TO_CHAR(ROUND(max_tier1,2)) ORDER BY the_date) AS StringListType),&apos;, &apos;) spk_tier1,
MAX(max_tier2) max_tier2,
rtd.collectString(CAST(COLLECT(TO_CHAR(ROUND(max_tier2,2)) ORDER BY the_date) AS StringListType),&apos;, &apos;) spk_tier2
FROM t1
GROUP BY
storage_array_id,
array_name,
ldev_id,
label
)
SELECT
t3.storage_array_id,
t3.array_name,
t3.ldev_id,
t3.label,
t3.first_sample,
t3.last_sample,
t3.sample_count,
--Tier 0
t3.max_tier0,
t2.first_tier0,
t2.last_tier0,
t2.first_tier0 - t2.last_tier0 delta_t0,
t3.spk_tier0,
--Tier 1
t3.max_tier1,
t2.first_tier1,
t2.last_tier1,
t2.first_tier1 - t2.last_tier1 delta_t1,
t3.spk_tier1,
--Tier 2
t3.max_tier2,
t2.first_tier2,
t2.last_tier2,
t2.first_tier2 - t2.last_tier2 delta_t2,
t3.spk_tier2
FROM 
t2, t3
WHERE 
t2.storage_array_id = t3.storage_array_id
AND t2.ldev_id = t3.ldev_id
AND (ABS(ROUND(t2.first_tier0)-ROUND(t2.last_tier0)) &gt; DECODE(&apos;${freeCombo2}&apos;,&apos;Only LDEVs that changed&apos;,0, -1))
ORDER BY 
ABS(t2.first_tier0 - t2.last_tier0) DESC</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
