          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 04/10/2012
--NBU Load Balance by Media Server  
WITH
t1 AS (
SELECT 
j.master_host_name,
j.media_host_name,
count(DISTINCT td.drive_id) drive_count,
count(j.job_id) job_count,
NVL(SUM((j.finished_readwrite-j.started_readwrite)*24*60*60),0) duration_secs,
ROUND(NVL(SUM(j.kilobytes/1024/1024),0 ),2) job_size,
ROUND(NVL(SUM(j.kilobytes/1024)/(SUM(j.finished_readwrite-j.started_readwrite)*24*60*60),0 ),2) throughput
FROM apt_v_nbu_job_try j, apt_v_nbu_job_tape_media jtm, apt_v_nbu_tape_drive td
WHERE j.job_id = jtm.job_id
AND jtm.drive_id = td.drive_id
AND j.start_date BETWEEN ${startDate} AND ${endDate}
AND j.finish_date IS NOT NULL
AND j.media_server_id IN (${hosts})
AND j.media_host_name IS NOT NULL
AND j.kilobytes &gt; 1024
AND j.summary_status &lt;= 1
GROUP BY j.master_host_name, j.media_host_name
HAVING ROUND(NVL(AVG(jtm.kilobytes/1024/1024),0 ),2) &gt; 1 --Exclude Small Stuff
),
avg_val AS (
SELECT 
ROUND(AVG(drive_count),2) avg_drive_count,
ROUND(AVG(job_count),2) avg_job_count,
ROUND(AVG(duration_secs),2) avg_duration_secs,
ROUND(AVG(job_size),2) avg_job_size,
ROUND(AVG(throughput),2) avg_throughput
FROM t1
)
SELECT 
master_host_name,
media_host_name, 
drive_count,
job_size,
avg_job_size,
ROUND(((job_size-avg_job_size)/avg_job_size)*100,2) pct_avg_job_size,
CASE 
WHEN job_size BETWEEN avg_job_size-(avg_job_size*.3333) AND avg_job_size+(avg_job_size*.3333) THEN &apos;yellow&apos;
WHEN job_size &lt; avg_job_size-(avg_job_size*.3333) THEN &apos;red&apos;
WHEN job_size &gt; avg_job_size+(avg_job_size*.3333) THEN &apos;green&apos;
ELSE &apos;white&apos;
END job_size_dot,
job_count,
avg_job_count,
ROUND(((job_count-avg_job_count)/avg_job_count)*100,2) pct_avg_job_count,
CASE 
WHEN job_count BETWEEN avg_job_count-(avg_job_count*.3333) AND avg_job_count+(avg_job_count*.3333) THEN &apos;yellow&apos;
WHEN job_count &lt; avg_job_count-(avg_job_count*.3333) THEN &apos;red&apos;
WHEN job_count &gt; avg_job_count+(avg_job_count*.3333) THEN &apos;green&apos;
ELSE &apos;white&apos;
END job_count_dot,
rtd.secsToHoursMinSecs(duration_secs) duration,
rtd.secsToHoursMinSecs(avg_duration_secs) avg_duration_secs,
ROUND(((duration_secs-avg_duration_secs)/avg_duration_secs)*100,2) pct_avg_duration_secs,
CASE 
WHEN duration_secs BETWEEN avg_duration_secs-(avg_duration_secs*.3333) AND avg_duration_secs+(avg_duration_secs*.3333) THEN &apos;yellow&apos;
WHEN duration_secs &lt; avg_duration_secs-(avg_duration_secs*.3333) THEN &apos;red&apos;
WHEN duration_secs &gt; avg_duration_secs+(avg_duration_secs*.3333) THEN &apos;green&apos;
ELSE &apos;white&apos;
END duration_secs_dot,
throughput,
avg_throughput,
ROUND(((throughput-avg_throughput)/avg_throughput)*100,2) pct_avg_throughput,
CASE 
WHEN throughput BETWEEN avg_throughput-(avg_throughput*.3333) AND avg_throughput+(avg_throughput*.3333) THEN &apos;yellow&apos;
WHEN throughput &lt; avg_throughput-(avg_throughput*.3333) THEN &apos;red&apos;
WHEN throughput &gt; avg_throughput+(avg_throughput*.3333) THEN &apos;green&apos;
ELSE &apos;white&apos;
END throughput_dot
FROM t1, avg_val
ORDER BY job_size DESC</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
