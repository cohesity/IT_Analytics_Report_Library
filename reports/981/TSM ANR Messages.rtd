          <entry>
            <string>dataSource</string>
            <string>WITH t1 as (
SELECT count(jm.job_id) occurances, 
jm.msg_code, jm.message, jm.explanation, jm.msg_type 
FROM apt_v_tsm_job j, apt_v_tsm_job_message jm
WHERE j.job_id=jm.job_id
AND msg_date BETWEEN ${startDate} AND ${endDate}
AND j.client_id IN (${hosts})
AND upper(msg_code) LIKE upper(&apos;${freeText1}&apos;)
AND upper(message) LIKE upper(&apos;${freeText2}&apos;)
GROUP BY jm.msg_code, jm.message, jm.explanation, jm.msg_type
)
SELECT occurances, 
CASE msg_type
  WHEN &apos;E&apos; THEN &apos;&lt;font color=&quot;red&quot;&gt;Error&lt;/font&gt;&apos;
  WHEN &apos;W&apos; THEN &apos;&lt;font color=&quot;orange&quot;&gt;Warning&lt;/font&gt;&apos;
  ELSE &apos;&lt;font color=&quot;red&quot;&gt;Other&lt;/font&gt;&apos;
END type,
msg_code,
message,explanation
FROM T1 
ORDER by occurances DESC</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
