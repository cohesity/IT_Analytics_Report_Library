          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 07/30/2015
WITH 
t1 AS (--get the largest backup
SELECT /*+ NO_MERGE  */
j.server_id,
j.server_name,
j.client_id,
j.client_name,
MAX(j.kilobytes) max_kb
FROM 
apt_v_job j
WHERE j.client_id IN (${hosts})
AND j.start_date BETWEEN ${startDate} AND ${endDate}
--AND j.server_id &lt;&gt; j.client_id
AND j.summary_status IN (0,1)
GROUP BY 
j.server_id,
j.server_name,
j.client_id,
j.client_name
HAVING 
MAX(j.kilobytes) &gt;= ${freeText1} * 1024 * 1024
)--Now get the job Id for that backup
SELECT /*+ NO_MERGE(t1) */
j.product_type_name,
j.job_id,
t1.server_id,
t1.server_name,
t1.client_id,
t1.client_name,
j.finish_date,
j.job_type_name,
j.nbr_of_files,
t1.max_kb
FROM 
apt_v_job j, t1
WHERE j.client_id IN (${hosts})
AND j.start_date BETWEEN ${startDate} AND ${endDate}
--AND j.server_id &lt;&gt; j.client_id
AND j.client_id = t1.client_id
AND j.server_id = t1.server_id
AND j.summary_status IN (0,1)
AND j.kilobytes = t1.max_kb
ORDER BY max_kb DESC</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
