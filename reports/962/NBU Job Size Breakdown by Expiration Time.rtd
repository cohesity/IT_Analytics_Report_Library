          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 12/27/2012
WITH 
var AS (
SELECT
DECODE(&apos;${freeCombo2}&apos;,
&apos;KB&apos;,1,&apos;MB&apos;,1024,&apos;GB&apos;,(1024*1024),&apos;TB&apos;,(1024*1024*1024),&apos;PB&apos;,(1024*1024*1024*1024)) div_by 
FROM dual
)
SELECT to_char(trunc(start_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;)),&apos;YYYY/MM/DD&apos;) the_date,
SUM(kilobytes)/var.div_by total_unexpired_data,
ROUND(SUM(CASE WHEN expiration_date BETWEEN start_date AND start_date+30 THEN kilobytes END)/var.div_by,2) less_than_30,
ROUND(SUM(CASE WHEN expiration_date BETWEEN start_date+30 AND start_date+90 THEN kilobytes END)/var.div_by,2) bt_30_and_90,
ROUND(SUM(CASE WHEN expiration_date BETWEEN start_date+90 AND start_date+365.25 THEN kilobytes END)/var.div_by,2) bt_90_and_1yr,
ROUND(SUM(CASE WHEN expiration_date BETWEEN start_date+365.25 AND start_date+1825 THEN kilobytes END)/var.div_by,2) bt_1_and_5yrs,
ROUND(SUM(CASE WHEN expiration_date &gt; start_date+1825 THEN kilobytes END)/var.div_by,2) over_5yrs
FROM apt_v_nbu_job_detail, var
WHERE client_id IN (${hosts})
AND start_date BETWEEN ${startDate} AND ${endDate}
AND expiration_date &gt; start_date
AND job_type &lt;&gt; 105
GROUP BY to_char(trunc(start_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;)),&apos;YYYY/MM/DD&apos;)
ORDER BY 1</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
