          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 06/21/2018
SELECT 
tm.tape_media_id,
tm.media_name,
nj.nbu_job_id,
nj.job_id,
nj.backup_id,
nj.master_host_name,
nj.client_host_name,
nj.policy_id,
nj.policy_name,
nj.job_type_name,
nj.start_date,
nj.finish_date,
nj.nbr_of_files,
ROUND(jtm.kilobytes/1024/1024) size_gb,
nj.expiration_date
FROM 
apt_v_nbu_job_detail nj,apt_v_nbu_job_tape_media jtm, apt_v_tape_media tm
WHERE
nj.start_date BETWEEN ${startDate} AND  ${endDate}
AND nj.job_id=jtm.job_id
AND jtm.tape_media_id = tm.tape_media_id
AND nj.client_id IN (${hosts})</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
