          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 08/27/2015
WITH 
var AS (
SELECT
&apos;${freeCombo2}&apos; unit,
DECODE(&apos;${freeCombo2}&apos;,&apos;KB&apos;,1,&apos;MB&apos;,1024,&apos;GB&apos;,(1024*1024),&apos;TB&apos;,(1024*1024*1024),&apos;PB&apos;,(1024*1024*1024*1024)) div_by 
FROM apt_v_dual
)
SELECT
j.master_host_name,
to_char(trunc(l.trans_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Minute&apos;,&apos;MI&apos;,&apos;Hour&apos;,&apos;HH24&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YY&apos;)),&apos;MM/DD/YYYY&apos;) the_date,
to_char(trunc(l.trans_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Minute&apos;,&apos;MI&apos;,&apos;Hour&apos;,&apos;HH24&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YY&apos;)),&apos;YYYYMMDDHH24MI&apos;) sort_order,
var.unit unit,
ROUND(SUM(j.kilobytes/div_by),2) total_size,
COUNT(l.backup_id) total_count,
SUM(DECODE(l.trans_type,&apos;D&apos;,1,0)) dup_count,
ROUND(SUM(DECODE(l.trans_type,&apos;D&apos;,j.kilobytes,0)/div_by),2) dup_size,
SUM(DECODE(l.trans_type,&apos;E&apos;,1,0)) exp_count,
ROUND(SUM(DECODE(l.trans_type,&apos;E&apos;,j.kilobytes,0)/div_by),2) exp_size,
SUM(DECODE(l.trans_type,&apos;P&apos;,1,0)) pch_count,
ROUND(SUM(DECODE(l.trans_type,&apos;P&apos;,j.kilobytes,0)/div_by),2) pch_size
FROM apt_v_nbu_image_log l,  apt_v_nbu_job j, var 
WHERE l.client_id IN (${hosts})
AND j.client_id IN (${hosts})
AND l.job_id = j.job_id
AND l.trans_date BETWEEN ${startDate} AND ${endDate}
GROUP BY
j.master_host_name,
to_char(trunc(l.trans_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Minute&apos;,&apos;MI&apos;,&apos;Hour&apos;,&apos;HH24&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YY&apos;)),&apos;MM/DD/YYYY&apos;),
to_char(trunc(l.trans_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Minute&apos;,&apos;MI&apos;,&apos;Hour&apos;,&apos;HH24&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YY&apos;)),&apos;YYYYMMDDHH24MI&apos;),
var.unit
ORDER BY 1,3 DESC
</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
