          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 10/22/2018
SELECT
TO_CHAR(TRUNC(log_date),&apos;MM/DD/YY&apos;) log_date,
array_name||&apos; - &apos;||volume_name array_volume,
MAX(${freeCombo1}) the_metric
FROM 
aps_v_ntc_volume_perform_log
WHERE
ntc_storage_system_id IN (${arrays})
AND log_date BETWEEN ${startDate} AND ${endDate}
GROUP BY
TO_CHAR(TRUNC(log_date),&apos;MM/DD/YY&apos;),
array_name||&apos; - &apos;||volume_name
ORDER BY
1 DESC</string>
          </entry>
        </data>
