          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified:09/19/2018
WITH 
var AS (
SELECT
DECODE(&apos;${freeCombo1}&apos;,&apos;KB&apos;,1,&apos;MB&apos;,1024,&apos;GB&apos;,(1024*1024),&apos;TB&apos;,(1024*1024*1024),&apos;PB&apos;,(1024*1024*1024*1024)) div_by 
FROM apt_v_dual
)
SELECT
si.host_name,
si.display_name server,
ct.bar_code,
ct.cmv_tape_media_id_ext,
ct.tape_media_id,
ct.media_name,
ct.server_instance_id,
ct.slot_name,
ct.slot_type,
ct.media_type,
ct.media_vendor_type,
ct.cmv_current_drive_id,
tm.media_status_name,
ct.cmv_media_status,
ct.media_location,
ct.export_location,
ct.block_size_kb,
ct.total_space_kb/div_by total_space,
ct.used_space_kb/div_by used_space,
ct.free_space_kb/div_by free_space,
ct.nbr_sides,
ct.nbr_backups,
ct.nbr_restores,
ct.nbr_reuse,
ct.nbr_soft_errors,
ct.nbr_hard_errors,
ct.media_creation_time,
ct.last_backup_time,
ct.last_restore_time,
ct.last_export_time,
ct.last_updated
FROM 
apt_v_cmv_tape_media ct, apt_v_tape_media tm, apt_v_server_instance si, var
WHERE 
ct.tape_media_id = tm.tape_media_id
AND si.server_id IN (${hosts})
AND ct.server_instance_id = si.server_instance_id (+)
AND REGEXP_LIKE(ct.bar_code,&apos;${freeText1}&apos;)</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
