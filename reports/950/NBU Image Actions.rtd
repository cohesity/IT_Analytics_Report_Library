          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 01/22/2015
SELECT
l.job_id, 
m.hostname master_server,
c.hostname client,
l.trans_date,
l.backup_id image_id,
j.kilobytes/1024/1024 size_gb,
DECODE(l.trans_type,&apos;D&apos;,&apos;Duplication&apos;,&apos;E&apos;,&apos;Expiration&apos;,&apos;P&apos;,&apos;Primary Change&apos;) trans_type,
DECODE(l.was_successful,&apos;Y&apos;,&apos;blue&apos;,&apos;N&apos;, &apos;red&apos;,&apos;white&apos;) status_dot,
l.msg_log
FROM apt_v_nbu_image_log l,  apt_v_nbu_job j, apt_v_server c, apt_v_server m
WHERE l.client_id IN (${hosts})
AND j.client_id IN (${hosts})
AND l.job_id = j.job_id
AND l.server_id = m.server_id (+)
AND l.client_id = c.server_id (+)
AND l.trans_date BETWEEN ${startDate} AND ${endDate}
AND trans_type LIKE DECODE(&apos;${freeCombo1}&apos;,&apos;All&apos;,&apos;%&apos;,&apos;Duplication&apos;,&apos;D&apos;,&apos;Expiration&apos;,&apos;E&apos;,&apos;Primary Change&apos;,&apos;P&apos;)
AND l.was_successful LIKE DECODE(&apos;${freeCombo2}&apos;,&apos;All&apos;,&apos;%&apos;,&apos;Successful&apos;,&apos;Y&apos;,&apos;Failed&apos;,&apos;N&apos;)</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
