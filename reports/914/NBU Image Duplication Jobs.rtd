          <entry>
            <string>dataSource</string>
            <string>--Drilldowns
--Dup Jobs Image List
WITH t1 as (
SELECT j.job_id,
aptStringConcat(&apos;&lt;a onclick=&quot;drilldown(&apos;&apos;templateName=NBUImageLocations.D&amp;amp;BackupID=&apos;||jf.pathname||&apos;&apos;&apos;, this, &apos;&apos;&apos;&apos; ); return false;&quot; href=&quot;#&quot;&gt;&apos;||jf.pathname||&apos;&lt;/a&gt;&apos;) images_duplicated
FROM  apt_v_nbu_job_file jf, apt_v_nbu_job j
WHERE j.start_date BETWEEN ${startDate} AND ${endDate}
AND j.client_id IN (${hosts})
AND j.job_id = jf.job_id
AND j.job_type = 107
GROUP BY j.job_id
)
SELECT t1.job_id, jd.nbu_job_id, jd.master_host_name, jd.storage_unit_label, 
jd.start_date, jd.finish_date, jd.kilobytes/1024/1024 size_gb, jd.nbr_of_files, jd.vendor_status,
DECODE(jd.is_active,&apos;Y&apos;,&apos;Active&apos;,&apos;N&apos;,&apos;Completed&apos;) State,
t1.images_duplicated
FROM t1, apt_v_nbu_job_detail jd
WHERE t1.job_id = jd.job_id
AND &apos;${freeCombo1}&apos; IN 
  CASE 
    WHEN &apos;${freeCombo1}&apos; NOT IN (&apos;All&apos;) THEN
      CASE
        WHEN jd.is_active = &apos;Y&apos;  THEN &apos;Active&apos;
        WHEN jd.is_active = &apos;N&apos;  THEN &apos;Completed&apos;
      END
   ELSE &apos;All&apos;
 END</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
