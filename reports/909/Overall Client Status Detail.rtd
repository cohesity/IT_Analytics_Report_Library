          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 09/24/20111
--All Failed, All Success, All Partial, All Mixed Success &amp; Failure
WITH t1 as (
SELECT &apos;&lt;font color=red&gt;All Jobs Failed&lt;/font&gt;&apos; status,
j.server_name as &quot;Backup Server&quot;,
j.client_name as &quot;Client&quot;,
j.JOB_TYPE_NAME as &quot;Job Type&quot;,
min(start_date) as &quot;First Job&quot;,
max(start_date) as &quot;Last Job&quot;,
count(j.job_id) as &quot;Nbr. of Jobs&quot;,
trunc(sum(kilobytes)/1024/1024) as &quot;size(GB)&quot;,
client_id, job_type
FROM apt_v_job j
WHERE finish_date BETWEEN ${startDate} AND ${endDate}
AND client_id IN (${hosts} )
AND j.summary_status IS NOT NULL
GROUP BY j.server_name,j.client_name, j.job_type_name, client_id, job_type
HAVING min(summary_status) &gt;1
UNION
SELECT &apos;&lt;font color=green&gt;Mixed Success &amp; Failures&lt;/font&gt;&apos; status,
j.server_name as &quot;Backup Server&quot;,
j.client_name as &quot;Client&quot;,
j.JOB_TYPE_NAME as &quot;Job Type&quot;,
min(start_date) as &quot;First Job&quot;,
max(start_date) as &quot;Last Job&quot;,
count(j.job_id) as &quot;Nbr. of Jobs&quot;,
trunc(sum(kilobytes)/1024/1024) as &quot;size(GB)&quot;,
client_id, job_type
FROM apt_v_job j
WHERE finish_date BETWEEN ${startDate} AND ${endDate}
AND client_id IN (${hosts} )
AND j.summary_status IS NOT NULL
GROUP BY j.server_name,j.client_name, j.job_type_name, client_id, job_type
HAVING max(summary_status) &gt; 1
AND min(summary_status) = 0
UNION
SELECT &apos;&lt;font color=orange&gt;All Jobs Partial&lt;/font&gt;&apos; status,
j.server_name as &quot;Backup Server&quot;,
j.client_name as &quot;Client&quot;,
j.JOB_TYPE_NAME as &quot;Job Type&quot;,
min(start_date) as &quot;First Job&quot;,
max(start_date) as &quot;Last Job&quot;,
count(j.job_id) as &quot;Nbr. of Jobs&quot;,
trunc(sum(kilobytes)/1024/1024) as &quot;size(GB)&quot;,
client_id, job_type
FROM apt_v_job j
WHERE finish_date BETWEEN ${startDate} AND ${endDate}
AND client_id IN (${hosts} )
AND j.summary_status IS NOT NULL
GROUP BY j.server_name,j.client_name, j.job_type_name, client_id, job_type
HAVING min(summary_status) =1
AND max(summary_status) =1
UNION
SELECT &apos;&lt;font color=blue&gt;All Jobs Successful&lt;/font&gt;&apos; status,
j.server_name as &quot;Backup Server&quot;,
j.client_name as &quot;Client&quot;,
j.JOB_TYPE_NAME as &quot;Job Type&quot;,
min(start_date) as &quot;First Job&quot;,
max(start_date) as &quot;Last Job&quot;,
count(j.job_id) as &quot;Nbr. of Jobs&quot;,
trunc(sum(kilobytes)/1024/1024) as &quot;size(GB)&quot;,
client_id, job_type
FROM apt_v_job j
WHERE finish_date BETWEEN ${startDate} AND ${endDate}
AND client_id IN (${hosts} )
AND j.summary_status IS NOT NULL
GROUP BY j.server_name,j.client_name, j.job_type_name, client_id, job_type
HAVING max(summary_status) =0
)
SELECT * FROM t1 
WHERE status LIKE DECODE(&apos;${freeCombo1}&apos;,&apos;All&apos;,&apos;%&apos;,&apos;%${freeCombo1}%&apos;)</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
