          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 02/22/2018
WITH 
var AS (
SELECT
DECODE(&apos;${freeCombo1}&apos;,&apos;KB&apos;,1,&apos;MB&apos;,1024,&apos;GB&apos;,(1024*1024),&apos;TB&apos;,(1024*1024*1024),&apos;PB&apos;,(1024*1024*1024*1024)) div_by 
FROM apt_v_dual
),
a0 AS (--Get the indiviapt_v_dual pools then add them up in the end 
SELECT
TRUNC(log_date,DECODE(&apos;${freeCombo2}&apos;,&apos;Hour&apos;,&apos;HH24&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;)) log_date,
array_name,
pool_id,
ROUND(MAX(allocated_kb/div_by),2) allocated,
ROUND(MAX(unallocated_kb/div_by),2) unallocated,
ROUND(MAX(available_kb/div_by),2) available,
ROUND(MAX(capacity_kb/div_by),2) capacity,
ROUND(MAX(capacity_of_vvols_kb/div_by),2) capacity_of_vvols,
ROUND(MAX(touched_kb/div_by),2) touched,
ROUND(MAX(associated_warn_kb/div_by),2) associated_warn,
ROUND(MAX(allocated_warn_kb/div_by),2) allocated_warn
FROM 
aps_v_hds_journal_pool_log, var
WHERE 
log_date BETWEEN ${startDate} AND ${endDate}
AND array_name = &apos;${queryCombo1}&apos;
AND array_name is not null
GROUP BY 
TRUNC(log_date,DECODE(&apos;${freeCombo2}&apos;,&apos;Hour&apos;,&apos;HH24&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;)),
array_name,
pool_id
HAVING MAX(allocated_kb) &gt; 0
)
SELECT 
log_date,
SUM(a0.allocated) allocated,
SUM(a0.unallocated) unallocated,
SUM(a0.capacity) capacity,
SUM(a0.capacity_of_vvols) capacity_of_vvols, 
SUM(a0.touched) touched,
SUM(a0.available) available,
SUM(a0.touched + a0.available) associated,
SUM(a0.associated_warn) associated_warn,
SUM(a0.allocated_warn) allocated_warn
FROM 
a0
GROUP BY
log_date
ORDER BY 
log_date ASC
</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
