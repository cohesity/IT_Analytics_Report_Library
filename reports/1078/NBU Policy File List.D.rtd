          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 07/09/2012
--Drilldown: systemName = NBUPolicyList.D This will not run standalone!
--This will display all NBU policy Information for the_master_server and the_policy_type
SELECT
s.hostname master_server,
policy_id,policy_name, 
is_active, 
policy_type_name, 
(SELECT REPLACE(aptStringConcat(DISTINCT pf.pathname),&apos;,&apos;,&apos;&lt;br /&gt;&apos;) paths
FROM apt_v_nbu_policy_file pf WHERE pf.policy_id = np.policy_id GROUP BY pf.policy_id) directives,
storage_unit, 
max_jobs_per_policy, 
max_fragment_size, 
job_priority, 
keyword, 
exists_in_catalog, 
effective_date, 
block_incremental, 
backup_copy, 
file_restore_raw, 
perform_snapshot_backup, 
snapshot_method, 
snapshot_method_argument, 
perform_offhost_backup, 
use_data_mover, 
data_mover_type, 
use_alternate_client, 
alternate_client_name, 
use_virtual_machine, 
enable_instant_recovery, 
collect_bmr_info, 
data_classification, 
is_storage_life_policy, 
checkpoint, 
checkpoint_interval, 
granular_restore_info, 
generation, 
nbu_server_group, 
lifecycle_policy_name, 
follow_nfs_mount_points, 
cross_mount_points, 
client_compress, 
client_encrypt, 
multiple_streams
FROM apt_v_nbu_policy np, apt_v_server s
WHERE policy_type = &apos;${the_policy_type}&apos;
AND np.server_id = ${the_server_id}
AND np.is_active = DECODE(&apos;${the_state}&apos;,&apos;All&apos;,np.is_active,&apos;Active&apos;,&apos;Y&apos;,&apos;Inactive&apos;,&apos;N&apos;)
AND np.server_id = s.server_id
ORDER BY 2</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
