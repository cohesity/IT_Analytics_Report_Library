          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 10/27/2017
WITH
VAR AS (
SELECT
DECODE(&apos;${freeCombo1}&apos;,&apos;GB&apos;,1,&apos;TB&apos;,1024,&apos;PB&apos;,(1024*1024)) div_by 
FROM apt_v_dual 
), 
rep AS (
SELECT
&apos;EMC Symmetrix&apos; array_type,
logical_unit_id, 
CASE WHEN SUBSTR(raid_type,1,4) = &apos;RDF1&apos; THEN &apos;Y&apos;WHEN SUBSTR(raid_type,1,5) = &apos;2-Way&apos; THEN &apos;Y&apos; ELSE &apos;N&apos; END is_replicated_lun
FROM aps_v_emc_sym_logical_unit
UNION ALL
SELECT 
&apos;HDS&apos; array_type,
logical_unit_id,
CASE WHEN true_copy_vol_type = &apos;P-VOL&apos; 
OR univ_replicator_vol_type = &apos;P-VOL&apos; 
OR shadow_image_vol_type = &apos;P-VOL&apos; 
OR quick_shadow_vol_type = &apos;P-VOL&apos; THEN &apos;Y&apos; ELSE &apos;N&apos; END is_replicated_lun
FROM aps_v_hds_logical_unit 
UNION ALL
SELECT
&apos;IBM XIV&apos; array_type,
xiv_volume_id logical_unit_id, 
is_mirrored is_replicated_lun
FROM aps_v_xiv_volume
UNION ALL
SELECT
&apos;IBM SVC&apos; array_type,
svc_storage_volume_id logical_unit_id, 
CASE WHEN COUNT(svc_mirror_extent_id) &gt; 1 THEN &apos;Y&apos; ELSE &apos;N&apos; END is_replicated_lun
FROM aps_v_svc_mirror_extent sme
GROUP BY sme.svc_storage_volume_id
UNION ALL
SELECT
&apos;HP EVA&apos; array_type,
logical_unit_id, 
does_mirror_exists is_replicated_lun
FROM aps_v_eva_logical_unit sme
),
t1 AS (
SELECT 
lu.storage_array_id,
lu.array_name,
COUNT(lu.logical_unit_id) tot_lun_count,
COUNT(DECODE(NVL(rep.is_replicated_lun,&apos;N&apos;),&apos;N&apos;,lu.logical_unit_id)) non_rep_lun_count,
COUNT(DECODE(NVL(rep.is_replicated_lun,&apos;N&apos;),&apos;Y&apos;,lu.logical_unit_id)) rep_lun_count,
SUM(lu.total_capacity_gb/div_by) tot_lun_capacity,
SUM(DECODE(NVL(rep.is_replicated_lun,&apos;N&apos;),&apos;N&apos;,lu.total_capacity_gb)/div_by) non_rep_lun_capacity,
SUM(DECODE(NVL(rep.is_replicated_lun,&apos;N&apos;),&apos;Y&apos;,lu.total_capacity_gb)/div_by) rep_lun_capacity
FROM aps_v_logical_unit lu, rep, var
WHERE lu.logical_unit_id = rep.logical_unit_id (+)
GROUP BY 
lu.storage_array_id,
lu.array_name
)
SELECT 
s.vendor_name,
s.array_family,
t1.storage_array_id,
t1.array_name,
t1.tot_lun_count,
non_rep_lun_count,
rep_lun_count,
rep_lun_count/tot_lun_count rep_lun_pct_count,
rep_lun_count/tot_lun_count*100 pct_rep_lun_count,
tot_lun_capacity,
non_rep_lun_capacity,
rep_lun_capacity,
rep_lun_capacity/tot_lun_capacity rep_lun_pct_cap,
rep_lun_capacity/tot_lun_capacity*100 pct_rep_lun_cap
FROM t1, aps_v_storage_array s, var
WHERE
t1.storage_array_id IN (${arrays}) 
AND t1.storage_array_id = s.storage_array_id
AND rep_lun_count &gt; 0
ORDER BY 2</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
