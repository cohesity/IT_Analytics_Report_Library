          <entry>
            <string>dataSource</string>
            <string>SELECT to_char(start_date,&apos;MM/DD/YY&apos;) run_date, nvl(to_char(${freeCombo1}),&apos;Null&apos;) unit,  trunc(sum(kilobytes/1024/1024)) size_gb
FROM apt_v_tsm_job
WHERE start_date BETWEEN ${startDate} AND ${endDate}
AND client_id in (${hosts})
GROUP BY to_char(start_date,&apos;MM/DD/YY&apos;), nvl(to_char(${freeCombo1}),&apos;Null&apos;)</string>
