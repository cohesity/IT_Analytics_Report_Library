          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com&#xd;
--Last Updated: 04/05/2012&#xd;
--Total Capacity,Amount Used,Available Capacity,Used %&#xd;
WITH t1 AS (&#xd;
SELECT &#xd;
file_system_type,host_name,&#xd;
count(filesystem_id) nbr_of_file_systems,&#xd;
sum(capacity_kb/1024/1024) capacity_gb,&#xd;
sum(used_kb/1024/1024) used_gb,&#xd;
sum(capacity_kb/1024/1024) - sum(used_kb/1024/1024) available_gb,&#xd;
sum(used_kb/1024/1024)/sum(capacity_kb/1024/1024)*100 used_pct,&#xd;
sum(used_kb/1024/1024)/sum(capacity_kb/1024/1024) pct_used&#xd;
FROM aps_v_file_system&#xd;
WHERE host_id IN (${hosts})&#xd;
AND capacity_kb &gt; 0&#xd;
GROUP BY&#xd;
file_system_type,host_name&#xd;
ORDER BY 1&#xd;
)SELECT&#xd;
nvl(file_system_type,&apos;Other&apos;) file_system_type,&#xd;
host_name,&#xd;
DECODE(&apos;${freeCombo1}&apos;,&#xd;
&apos;Total Capacity&apos;,capacity_gb,&#xd;
&apos;Available Capacity&apos;,available_gb,&#xd;
&apos;Amount Used&apos;,used_gb,&#xd;
&apos;Used %&apos;,used_pct) metric&#xd;
FROM t1</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
