          <entry>
            <string>dataSource</string>
            <string>WITH 
avg_tpt AS (
SELECT to_char(j.start_date,&apos;MM/DD/YY&apos;) avg_run_date,  
ROUND(NVL(avg(jtm.kilobytes/1024/1024),0 ) , 2) avgSize
FROM apt_v_nbu_job_detail j, apt_v_nbu_job_tape_media jtm, apt_v_nbu_tape_drive td
WHERE j.job_id = jtm.job_id
  AND jtm.drive_id = td.drive_id
  AND j.start_date BETWEEN ${startDate} AND ${endDate}
  AND j.finish_date        IS NOT NULL
  AND j.client_id in (${hosts})
  AND j.kilobytes          &gt; 1024
  AND j.summary_status     &lt;= 1
GROUP BY to_char(j.start_date,&apos;MM/DD/YY&apos;)
),
t1 AS (
SELECT to_char(j.start_date,&apos;MM/DD/YY&apos;) run_date, td.drive_name,  
ROUND(NVL(avg(jtm.kilobytes/1024/1024),0 ) , 2) size_gb
FROM apt_v_nbu_job_detail j, apt_v_nbu_job_tape_media jtm, apt_v_nbu_tape_drive td
WHERE j.job_id = jtm.job_id
  AND jtm.drive_id = td.drive_id
  AND j.start_date BETWEEN ${startDate} AND ${endDate}
  AND j.finish_date        IS NOT NULL
  AND j.client_id in (${hosts})
  AND j.kilobytes          &gt; 1024
  AND j.summary_status     &lt;= 1
GROUP BY to_char(start_date,&apos;MM/DD/YY&apos;), td.drive_name
)
SELECT run_date, drive_name, 
CASE WHEN size_gb &gt;= avgSize+(avgSize*(${freeCombo1}*.01))
  THEN &apos;&lt;font color=&quot;red&quot;&gt;&apos;||size_gb||&apos;&lt;/font&gt;&apos;
  ELSE &apos;&lt;font color=&quot;blue&quot;&gt;&apos;||size_gb||&apos;&lt;/font&gt;&apos;
END size_gb
FROM t1, avg_tpt</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
