          <entry>
            <string>dataSource</string>
            <string>SELECT ttm.library_name, ttm.server_host_name,
       ttm.media_status_name, 
       COUNT(DISTINCT ttm.tape_media_id) nbr_of_tapes
    FROM apt_v_tsm_tape_media ttm
    WHERE ttm.server_id IN (${hosts})
    GROUP BY ttm.library_name, ttm.server_host_name, ttm.media_status_name
    ORDER BY Upper(ttm.server_host_name), UPPER(ttm.library_name)</string>
          </entry>
