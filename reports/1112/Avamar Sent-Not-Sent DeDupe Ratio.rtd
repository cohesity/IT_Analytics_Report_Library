          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 07/16/2013
WITH t1 AS (
SELECT
TRUNC(j.start_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YY&apos;)) the_date,
ROUND(SUM(aa.modified_not_sent_kb/1024/1024),2) modified_not_sent_gb,
ROUND(SUM(aa.modified_sent_kb/1024/1024),2) modified_sent_gb
FROM 
apt_v_avm_activities aa, apt_v_job j
WHERE 
aa.job_id = j.job_id
AND j.start_date BETWEEN ${startDate} AND ${endDate}
AND j.server_id = DECODE(${queryCombo1},999,j.server_id,${queryCombo1})
GROUP BY 
TRUNC(j.start_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YY&apos;))
)
SELECT
TO_CHAR(the_date,&apos;YYYY/MM/DD&apos;) the_date,
modified_not_sent_gb,
modified_sent_gb,
ROUND((modified_sent_gb/modified_not_sent_gb)*100,2) dd_ratio
FROM t1
ORDER BY 1</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
