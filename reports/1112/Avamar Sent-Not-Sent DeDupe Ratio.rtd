                  <entry>
                    <string>queryComboValues1</string>
                    <string>SELECT 999 server_id, &apos;All&apos; hostname FROM apt_v_dual UNION ALL SELECT server_id,lower(hostname) hostname FROM apt_v_server WHERE server_type_name=&apos;EMC Avamar Server&apos; ORDER BY 2</string>
                  </entry>
