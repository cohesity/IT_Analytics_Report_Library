          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 06/28/2017
SELECT 
TRUNC(vm_start_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YY&apos;)) the_date,
SUM(CASE WHEN INSTR(NVL(r.description,&apos;xxx&apos;),&apos;Warning&apos;) = 0 AND vm_status = 0 THEN 1 ELSE 0 END) success,
SUM(CASE WHEN INSTR(r.description,&apos;Warning&apos;) &gt; 0 AND vm_status = 0 THEN 1 ELSE 0 END) warning,
SUM(CASE WHEN vm_status &gt; 0 THEN 1 ELSE 0 END) failure
FROM apt_v_cmv_job_vm jv, apt_v_cmv_reason r
WHERE
jv.client_id IN (${hosts})
AND vm_start_date BETWEEN ${startDate} AND ${endDate}
AND jv.vm_failed_reason_id = r.cmv_reason_code (+) 
GROUP BY 
TRUNC(vm_start_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YY&apos;))</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
