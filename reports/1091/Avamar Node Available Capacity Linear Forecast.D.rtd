          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 12/07/2012
--Computes the future capacity of an Avamar Node based on 
--Linear Regression (Linear) Sum of squares linear algorithm y=mX+b
--This is a drill down report that can&apos;t run stand alone
--TemplateName: AvamarNodeAvailableCapacityLinearForecastD
WITH 
d0 AS (
SELECT
DECODE(&apos;${TheGroupBy}&apos;,&apos;Day&apos;,1,&apos;Week&apos;,7,&apos;Month&apos;,31,&apos;Quarter&apos;,93,&apos;Year&apos;,365.24) nbr_of_days,
--Limit the forecasting periods to 48
CASE 
WHEN to_number(&apos;${TheForecastPeriods}&apos;) &gt; 48 THEN 48 
ELSE to_number(&apos;${TheForecastPeriods}&apos;) END forecast_periods
FROM dual
),
a0 AS (--Get all the capacity merics for each period
SELECT 
master_server_id,
node_id,
TRUNC(log_date,DECODE(&apos;${TheGroupBy}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YY&apos;)) log_date,
ROW_NUMBER() over (PARTITION BY master_server_id, node_id ORDER BY master_server_id, node_id) row_number,
ROUND(MAX((capacity_mb - used_mb)/1024),2) available
FROM apt_v_avm_node_space_log ansl, apt_v_server s 
WHERE log_date BETWEEN ${startDate} AND ${endDate}
AND master_server_id = s.server_id
AND s.hostname = &apos;${TheMasterServerName}&apos;
AND node_id = &apos;${TheNodeID}&apos;
GROUP BY master_server_id, node_id, trunc(log_date,DECODE(&apos;${TheGroupBy}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YY&apos;))
),
a1 AS (
SELECT 
ROWNUM period,
log_date,
available,
REGR_SLOPE(available,ROWNUM) OVER (PARTITION BY master_server_id) slope,
REGR_INTERCEPT(available, ROWNUM) OVER (PARTITION BY master_server_id) y_intercept
FROM a0
ORDER BY 1
),
p0 AS (--Find the last period so you can forecast past it
SELECT 
MAX(period) last_period,
MAX(log_date) last_date
FROM a1
)
SELECT
log_date,
round(available,2) available,
0 future_available,
period*slope+y_intercept trend_line--Future values can be determined for any period using this formula
FROM a1, p0
UNION ALL --Future
SELECT 
TRUNC(the_date,DECODE(&apos;${TheGroupBy}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YY&apos;)) log_date,
0 available,
ROUND((period+ROWNUM)*slope+y_intercept,2) future_available,
(period+ROWNUM)*slope+y_intercept trend_line
FROM a1,p0,d0, TABLE(rtd.APTlistOfDates(p0.last_date+d0.nbr_of_days,p0.last_date+(d0.forecast_periods*d0.nbr_of_days),DECODE(&apos;${TheGroupBy}&apos;,&apos;Day&apos;,11,&apos;Week&apos;,12,&apos;Month&apos;,13,&apos;Quarter&apos;,14,&apos;Year&apos;,15))) the_dates
WHERE period = p0.last_period</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
