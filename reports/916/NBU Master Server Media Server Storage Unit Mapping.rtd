          <entry>
            <string>dataSource</string>
            <string>SELECT 
s.hostname master_server,
REPLACE(aptStringConcat(DISTINCT tl.library_name),&apos;,&apos;,&apos;&lt;br&gt;&apos;) tape_libraries,
REPLACE(aptStringConcat(DISTINCT m.media_server_name),&apos;,&apos;,&apos;&lt;br&gt;&apos;) media_servers,
REPLACE(aptStringConcat(DISTINCT su.storage_unit_label),&apos;,&apos;,&apos;&lt;br&gt;&apos;) storage_units
FROM apt_v_server s,apt_v_nbu_storage_unit su, apt_v_nbu_media_server m,apt_v_nbu_tape_library tl
WHERE s.server_id in (${hosts})
AND s.server_id = su.server_id
AND su.storage_unit_id = m.storage_unit_id
AND s.server_id = tl.server_id
AND s.hostname = DECODE(&apos;${queryCombo1}&apos;,&apos; ALL&apos;,s.hostname,&apos;${queryCombo1}&apos;)
GROUP BY s.hostname</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
