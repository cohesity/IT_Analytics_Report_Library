          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 10/23/2018
WITH 
t1 AS (
SELECT DISTINCT
TRUNC(log_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YY&apos;)) sort_order,
TO_CHAR(TRUNC(log_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YY&apos;)),&apos;MM/DD/YYYY&apos;) log_date,
vs.virtual_system_id,
TRUNC(AVG(nbr_of_active_vms)) nbr_of_active_vms
FROM apt_v_vmw_cluster vc, apt_v_virtual_system vs, apt_v_virtual_system_log vsl
WHERE 
vc.vmw_cluster_id = vs.vmw_cluster_id
AND vs.virtual_system_id = vsl.virtual_system_id
AND vsl.log_date BETWEEN ${startDate} AND ${endDate}
AND vs.data_center_name||&apos; - &apos;||vc.cluster_name LIKE &apos;${queryCombo1}&apos;
GROUP BY
TRUNC(log_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YY&apos;)),
TO_CHAR(TRUNC(log_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YY&apos;)),&apos;MM/DD/YYYY&apos;),
vs.virtual_system_id
)
SELECT
sort_order,
log_date,
COUNT(virtual_system_id) nbr_virtual_systems,
SUM(nbr_of_active_vms) nbr_of_active_vms
FROM 
t1
GROUP BY
sort_order,
log_date
ORDER BY 
sort_order ASC</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
