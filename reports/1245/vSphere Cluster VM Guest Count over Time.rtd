                    <string>SELECT DISTINCT vs.data_center_name||&apos; - &apos;||vc.cluster_name the_key, vs.data_center_name||&apos; - &apos;||vc.cluster_name the_value FROM apt_v_vmw_cluster vc, apt_v_virtual_system vs WHERE vc.vmw_cluster_id = vs.vmw_cluster_id ORDER BY 1</string>
