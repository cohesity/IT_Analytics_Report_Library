          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@veritas.com
--Last Modified: 07/02/2020
SELECT
  i.via_account_id,
  i.resource_id,
  i.host_id,
  i.account_id,
  a.alias,
  i.name,
  i.scope_selector_name,
  i.region_id,
  r.name AS region,
  i.availability_zone_id,
  z.name AS availability_zone,
  i.tenancy,
  i.owner,
  i.type,
  i.virtualization,
  i.hypervisor,
  i.platform,
  i.architecture,
  i.monitoring,
  i.launched,
  i.state_code,
  i.state,
  i.instance_status,
  i.system_status,
  i.image_resource_id,
  i.is_ebs_optimized,
  i.key_pair_resource_id,
  i.root_device,
  i.root_device_type,
  i.vpc_resource_id,
  i.creation_date,
  i.last_updated,
  i.id,
  i.marked_for_delete
FROM
  sdk_v_aws_account a, 
  sdk_v_aws_ec2_instance i, 
  sdk_v_aws_region r, 
  sdk_v_aws_availability_zone z
WHERE
  i.account_id = a.id
  AND i.region_id = r.id
  AND i.availability_zone_id = z.id</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
