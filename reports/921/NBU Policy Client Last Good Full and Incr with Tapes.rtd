          <entry>
            <string>dataSource</string>
            <string>-- Author: rich.rose@aptare.com
-- Last Updated: 02/06/2012
WITH
full AS (--Find the last successful full backup that for each client
SELECT
nj.client_id,
nj.policy_id,
max(nj.job_id) job_id
FROM apt_v_nbu_job nj
WHERE nj.client_id IN (${hosts})
AND nj.start_date BETWEEN ${startDate} AND ${endDate}
AND nj.job_type = 101
AND nj.summary_status IN (0,1)
AND nj.expiration_date &gt;= sysdate
GROUP BY 
nj.client_id,nj.policy_id
),
incr AS (--Find the last successful incr backup that for each client
SELECT
nj.client_id,nj.policy_id,
max(nj.job_id) job_id
FROM apt_v_nbu_job nj
WHERE nj.client_id IN (${hosts})
AND nj.start_date BETWEEN ${startDate} AND ${endDate}
AND nj.job_type = 102
AND nj.summary_status IN (0,1)
AND nj.expiration_date &gt;= sysdate
GROUP BY nj.client_id,nj.policy_id
),
ftapes AS (--String together all the tapes used for full jobs
SELECT
full.client_id,
full.policy_id,
full.job_id,
aptStringConcat(ntm.bar_code) ftapes
FROM full, apt_v_nbu_job_tape_media jtm, apt_v_nbu_tape_media ntm
WHERE full.job_id = jtm.job_id
AND jtm.tape_media_id = ntm.tape_media_id
GROUP BY full.client_id, full.policy_id, full.job_id
),
itapes AS (--String together all the tapes used for incr jobs
SELECT
incr.client_id,
incr.job_id,
incr.policy_id,
aptStringConcat(ntm.bar_code) itapes
FROM incr, apt_v_nbu_job_tape_media jtm, apt_v_nbu_tape_media ntm
WHERE incr.job_id = jtm.job_id
AND jtm.tape_media_id = ntm.tape_media_id
GROUP BY incr.client_id,incr.policy_id,incr.job_id
),
ijobs AS (--Find all the incremental backups that occurred after the full
SELECT
nj.client_id,
nj.policy_id,
count(nj.job_id) job_count,
sum(DECODE(nj.summary_status,0,1,1,1,0)) success,
sum(DECODE(nj.summary_status,2,1,0)) failed,
sum(DECODE(nj.summary_status,0,nj.duration_secs,1,nj.duration_secs,0)) duration_secs
FROM full, apt_v_nbu_job nj
WHERE nj.client_id = full.client_id
AND nj.job_id &gt; full.job_id
AND nj.job_type = 102
GROUP BY nj.client_id,nj.policy_id
)
SELECT
fj.master_host_name,
fj.client_id,
fj.client_host_name,
fj.policy_id,
fj.policy_name fj_policy_name,
fj.schedule_name fj_schedule_name,
fj.job_id fj_job_id,
fj.nbu_job_id fj_nbu_job_id,
ftapes,
fj.finish_date fj_finish_date,
fj.duration fj_duration,
sysdate+(fj.duration_secs/60/60/24) est_full_revovery_date,
ij.schedule_name ij_schedule_name,
ij.job_id ij_job_id,
ij.nbu_job_id ij_nbu_job_id,
itapes,
ij.finish_date ij_finish_date,
DECODE(ijobs.job_count,null,&apos;white&apos;,&apos;blue&apos;) ijobs_count_status,
nvl(ijobs.job_count,0) ijobs_job_count,
CASE WHEN ijobs.success &gt;=1
  THEN
   CASE WHEN ijobs.failed &gt;= 1
     THEN &apos;yellow&apos;
   WHEN ijobs.failed = 0 
     THEN &apos;green&apos;
  END
  ELSE &apos;red&apos;
END ijobs_status,
nvl(ijobs.success,0) success,
nvl(ijobs.failed,0) failed,
sysdate+(ijobs.duration_secs/60/60/24) est_incr_revovery_date
FROM full, incr, apt_v_nbu_job_detail fj, apt_v_nbu_job_detail ij, ftapes, itapes, ijobs
WHERE full.client_id = incr.client_id (+) 
AND full.policy_id = incr.policy_id (+)
AND full.client_id = ijobs.client_id (+) 
AND full.job_id = fj.job_id 
AND incr.job_id = ij.job_id
AND full.job_id = ftapes.job_id 
AND incr.job_id = itapes.job_id</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
