          <entry>
            <string>dataSource</string>
            <string>SELECT 
s.hostname as &quot;master server&quot;,
nvl(tl.library_name,&apos;Outside Library&apos;) library_name,
ntm.media_name as &quot;Barcode&quot;,
DECODE(ntm.vendor_media_status, 
1,&apos;Available&apos;,
2,&apos;Assigned&apos;,
3,&apos;Frozen&apos;,
4,&apos;Suspended&apos;,
5,&apos;Imported&apos;,
6,&apos;Full&apos;,
7,&apos;Expired&apos;,
8,&apos;Catalog&apos;,
9,&apos;Cleaning&apos;,
0,&apos;Unknown&apos;) media_status_name,
nvp.volume_pool_name as &quot;volume pool&quot;,
nvg.volume_group_name as &quot;volume group&quot;,
&apos;${the_expiration}&apos; as &quot;expiration&quot;,
ntm.date_created as &quot;Date Created&quot;,
ntm.date_assigned as &quot;Date Assigned&quot;,
ntm.last_mounted as &quot;Last Mounted&quot;,
ntm.last_written as &quot;Last Written&quot;,
ntm.last_read as &quot;Last Read&quot;,
ntm.expiration_date as &quot;Expiration Date&quot;,
ntm.tape_media_id as &quot;tape_id&quot;
FROM apt_v_nbu_tape_media ntm, apt_v_server s, apt_v_nbu_volume_pool nvp, 
apt_v_tape_library tl, apt_v_nbu_volume_group nvg
WHERE ntm.server_id = s.server_id
AND ntm.library_id = tl.library_id(+)
AND ntm.server_id = ${the_server_id}
AND nvl(ntm.library_id,999) = ${the_library_id}
AND ntm.vendor_media_status = ${the_status}
AND ntm.volume_pool_id = nvp.volume_pool_id (+)
AND ntm.volume_group_id = nvg.volume_group_id (+)</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
