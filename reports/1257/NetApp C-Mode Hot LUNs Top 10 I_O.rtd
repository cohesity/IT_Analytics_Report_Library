          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 11/02/2018
WITH 
var AS (
SELECT 
DECODE(&apos;${freeCombo2}&apos;,&apos;Total IO&apos;,1,&apos;Read IO&apos;,2,&apos;Write IO&apos;,3,&apos;Read Latency&apos;,5,&apos;Write Latency&apos;,6) top_by,
DECODE(&apos;${freeCombo3}&apos;,&apos;1x&apos;,1,&apos;5x&apos;,5,&apos;10x&apos;,10,&apos;15x&apos;,15,&apos;20x&apos;,20,&apos;25x&apos;,25,&apos;30x&apos;,30,&apos;35x&apos;,35,&apos;40x&apos;,40,&apos;45x&apos;,45,&apos;50x&apos;,50,&apos;55x&apos;,55,&apos;60x&apos;,60,&apos;65x&apos;,65,&apos;70x&apos;,70,&apos;75x&apos;,75,&apos;80x&apos;,80,&apos;85x&apos;,85,&apos;90x&apos;,90,&apos;95x&apos;,95,&apos;100x&apos;,100) threshold
FROM
apt_v_dual
),
t1 AS (
SELECT 
storage_array_id,
array_name,
logical_unit_id,
logical_unit_name,
MAX(read_io) max_read_io,
AVG(read_io) avg_read_io,
MAX(write_io) max_write_io,
AVG(write_io) avg_write_io,
MAX(total_io) max_total_io,
AVG(total_io) avg_total_io,
MAX(read_io_response_time) max_read_io_response,
AVG(read_io_response_time) avg_read_io_response,
MAX(write_io_response_time) max_write_io_response,
AVG(write_io_response_time) avg_write_io_response,
MAX(total_io_response_time) max_total_io_response,
AVG(total_io_response_time) avg_total_io_response
FROM aps_v_lun_perform_log pl, var
WHERE pl.storage_array_id IN (${arrays})
AND log_date BETWEEN ${startDate} AND ${endDate}
GROUP BY
storage_array_id,
array_name, 
logical_unit_id,
logical_unit_name
ORDER BY 
DECODE(&apos;${freeCombo2}&apos;,&apos;Total IO&apos;,MAX(total_io),&apos;Read IO&apos;,MAX(read_io),&apos;Write IO&apos;,MAX(write_io),&apos;Read Latency&apos;,MAX(read_io_response_time),&apos;Write Latency&apos;,MAX(write_io_response_time))  DESC
)
SELECT 
t1.storage_array_id,
t1.array_name,
t1.logical_unit_id,
t1.logical_unit_name,
t1.avg_read_io,
t1.max_read_io,
(max_read_io / DECODE(avg_read_io,0,NULL,avg_read_io)) moa_read_io,
CASE 
WHEN(max_read_io / DECODE(avg_read_io,0,NULL,avg_read_io)) &gt; threshold  THEN &apos;red&apos; 
WHEN(max_read_io / DECODE(avg_read_io,0,NULL,avg_read_io)) &lt; threshold  THEN &apos;green&apos;
ELSE &apos;white&apos;
END read_io_dot,
t1.avg_write_io,
t1.max_write_io,
(max_write_io / DECODE(avg_write_io,0,NULL,avg_write_io)) moa_write_io,
CASE 
WHEN(max_write_io / DECODE(avg_write_io,0,NULL,avg_write_io)) &gt; threshold  THEN &apos;red&apos; 
WHEN(max_write_io / DECODE(avg_write_io,0,NULL,avg_write_io)) &lt; threshold  THEN &apos;green&apos;
ELSE &apos;white&apos; 
END write_io_dot,
t1.avg_read_io_response,
t1.max_read_io_response,
(max_read_io_response / DECODE(avg_read_io_response,0,NULL,avg_read_io_response)) moa_read_io_response,
CASE 
WHEN(max_read_io_response / DECODE(avg_read_io_response,0,NULL,avg_read_io_response)) &gt; threshold  THEN &apos;red&apos; 
WHEN(max_read_io_response / DECODE(avg_read_io_response,0,NULL,avg_read_io_response)) &lt; threshold  THEN &apos;green&apos; 
ELSE &apos;white&apos; 
END read_io_response_dot,
t1.avg_write_io_response,
t1.max_write_io_response,
(max_write_io_response / DECODE(avg_write_io_response,0,NULL,avg_write_io_response)) moa_write_io_response,
CASE 
WHEN(max_write_io_response / DECODE(avg_write_io_response,0,NULL,avg_write_io_response)) &gt; threshold  THEN &apos;red&apos; 
WHEN(max_write_io_response / DECODE(avg_write_io_response,0,NULL,avg_write_io_response)) &lt; threshold  THEN &apos;green&apos; 
ELSE &apos;white&apos; 
END write_io_response_dot,
t1.avg_total_io_response,
t1.max_total_io_response,
(max_total_io_response / DECODE(avg_total_io_response,0,NULL,avg_total_io_response)) moa_total_io_response,
CASE 
WHEN(max_total_io_response / DECODE(avg_total_io_response,0,NULL,avg_total_io_response)) &gt; threshold  THEN &apos;red&apos; 
WHEN(max_total_io_response / DECODE(avg_total_io_response,0,NULL,avg_total_io_response)) &lt; threshold  THEN &apos;green&apos; 
ELSE &apos;white&apos; 
END total_io_response_dot
FROM t1, var
WHERE 
ROWNUM &lt;= ${freeCombo1}
ORDER BY 
DECODE(&apos;${freeCombo2}&apos;,&apos;Read IO&apos;,max_read_io,&apos;Write IO&apos;,max_write_io,&apos;Read Latency&apos;,max_read_io_response,&apos;Write Latency&apos;,max_write_io_response)  DESC</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
