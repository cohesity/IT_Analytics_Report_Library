          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 01/20/2019
WITH 
t1 AS (--Host and LUN counts
SELECT
ap.storage_array_id,
ap.port_id,
ap.nickname,
ap.wwn,
COUNT(DISTINCT sp.host_id) hosts,
COUNT(DISTINCT sp.logical_unit_id) luns
FROM
aps_v_array_port ap,  aps_v_storage_path sp
WHERE 
ap.storage_array_id IN (${arrays})
AND ap.port_id = sp.array_port_id
AND UPPER(ap.port_role) = &apos;TARGET&apos;
GROUP BY
ap.storage_array_id,
ap.port_id,
ap.nickname,
ap.wwn
),
t2 AS (--Get all the Distinct LUNs
SELECT
DISTINCT
ap.storage_array_id,
ap.port_id,
sp.logical_unit_id,
sp.total_capacity_gb
FROM
aps_v_array_port ap,  aps_v_storage_path sp, t1
WHERE 
ap.storage_array_id IN (${arrays})
AND ap.port_id = t1.port_id
AND UPPER(ap.port_role) = &apos;TARGET&apos;
AND ap.port_id = sp.array_port_id
),
t3 AS (--Add Up the Capacity
SELECT
t2.storage_array_id,
t2.port_id,
SUM(t2.total_capacity_gb/1024) total_capacity_tb
FROM t2
GROUP BY
t2.storage_array_id,
t2.port_id
),
t4 AS (--Get the storage I/O
SELECT
l.port_id,
MAX(l.kbytes_transferred/1024/1024) gb_transferred
FROM aps_v_array_port_stats_log l, t1
WHERE
l.log_date &gt;= sysdate -7
AND l.port_id = t1.port_id
GROUP BY
l.port_id
),
t5 AS (
SELECT
t1.storage_array_id,
sa.array_name,
sa.vendor_name,
t1.port_id,
t1.nickname,
t1.wwn,
t1.hosts,
DENSE_RANK() OVER (ORDER BY NVL(hosts,0) DESC) dr_hosts,
t1.luns,
DENSE_RANK() OVER (ORDER BY NVL(luns,0) DESC) dr_luns,
t3.total_capacity_tb,
DENSE_RANK() OVER (ORDER BY NVL(total_capacity_tb,0) DESC) dr_total_capacity_tb,
NVL(t4.gb_transferred,0) gb_transferred,
DENSE_RANK() OVER (ORDER BY NVL(gb_transferred,0) DESC) dr_gb_transferred
FROM
aps_v_storage_array sa, t1, t3, t4
WHERE
t1.port_id = t3.port_id
AND t1.port_id = t4.port_id (+)
AND t1.storage_array_id = sa.storage_array_id
)
SELECT
storage_array_id,
array_name,
vendor_name,
port_id,
nickname,
wwn,
gb_transferred,
dr_gb_transferred,
CASE WHEN dr_gb_transferred = 1 THEN &apos;red&apos; WHEN dr_gb_transferred = 2 THEN &apos;yellow&apos; WHEN dr_gb_transferred = 3 THEN &apos;green&apos; WHEN dr_gb_transferred = 4 THEN &apos;blue&apos; ELSE &apos;white&apos; END transferred_dot,
hosts,
dr_hosts,
CASE WHEN dr_hosts = 1 THEN &apos;red&apos; WHEN dr_hosts = 2 THEN &apos;yellow&apos; WHEN dr_hosts = 3 THEN &apos;green&apos;  WHEN dr_hosts = 4 THEN &apos;blue&apos; ELSE &apos;white&apos; END hosts_dot,
luns,
dr_luns,
CASE WHEN dr_luns = 1 THEN &apos;red&apos; WHEN dr_luns = 2 THEN &apos;yellow&apos; WHEN dr_luns = 3 THEN &apos;green&apos; WHEN dr_luns = 4 THEN &apos;blue&apos; ELSE &apos;white&apos; END luns_dot,
total_capacity_tb,
dr_total_capacity_tb,
CASE WHEN dr_total_capacity_tb = 1 THEN &apos;red&apos; WHEN dr_total_capacity_tb = 2 THEN &apos;yellow&apos; WHEN dr_total_capacity_tb = 3 THEN &apos;green&apos; WHEN dr_total_capacity_tb = 4 THEN &apos;blue&apos; ELSE &apos;white&apos; END capacity_dot,
&apos;Ranks &apos;||
CASE WHEN gb_transferred &gt; 0 THEN dr_gb_transferred||DECODE(dr_gb_transferred,1,&apos;st&apos;,2,&apos;nd&apos;,3,&apos;rd&apos;,&apos;th&apos;)||&apos; in I/O, &apos; ELSE &apos;&apos; END ||
CASE WHEN hosts &gt; 0 THEN dr_hosts||DECODE(dr_hosts,1,&apos;st&apos;,2,&apos;nd&apos;,3,&apos;rd&apos;,&apos;th&apos;)||&apos; in #Hosts, &apos; ELSE &apos;&apos; END
||dr_luns||DECODE(dr_luns,1,&apos;st&apos;,2,&apos;nd&apos;,3,&apos;rd&apos;,&apos;th&apos;)||&apos; in #LUNs, &apos;
||dr_total_capacity_tb||DECODE(dr_total_capacity_tb,1,&apos;st&apos;,2,&apos;nd&apos;,3,&apos;rd&apos;,&apos;th&apos;)||&apos; in Capacity&apos;
message
FROM t5
ORDER BY gb_transferred DESC</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
