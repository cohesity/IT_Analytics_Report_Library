          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 11/06/2018
WITH 
VAR AS (
SELECT
&apos;${freeCombo1}&apos; unit,
DECODE(&apos;${freeCombo1}&apos;, &apos;GB&apos;,1024*1024,&apos;TB&apos;,1024*1024*1024,&apos;PB&apos;,(1024*1024*1024*1024)) div_by
FROM apt_v_dual
),
t1 AS (
SELECT
storage_array_id,
vendor_name,
array_name,
array_family,
array_type,
domain_id,
domain_name,
root_group_id,
object_id,
product_name,
serial_nbr,
device_manager_id,
ip_address,
agent_version,
controller_version,
cache_kb/div_by cache,
is_active,
is_rm_enabled,
creation_date,
last_updated,
nbr_allocated_luns,
nbr_of_luns,
nbr_array_ports,
nbr_hosts,
nbr_of_fc_ports,
nbr_of_iscsi_ports,
nbr_of_ethernet_ports,
nbr_of_physical_disks,
nbr_of_array_groups,
nbr_of_storage_pools,
nbr_of_thin_pools,
thin_pool_subscribed_pct,
raw_capacity_kb/div_by raw_capacity,
raw_allocated_kb/div_by raw_allocated,
raw_available_kb/div_by raw_available,
capacity_kb/div_by capacity,
allocated_kb/div_by allocated,
other_allocated_kb/div_by other_allocated,
available_kb/div_by available,
largest_free_space_kb/div_by largest_free_space,
array_group_capacity_kb/div_by array_group_capacity,
array_group_allocated_kb/div_by array_group_allocated,
array_group_available_kb/div_by array_group_available,
pool_capacity_kb/div_by pool_capacity,
pool_allocated_kb/div_by pool_allocated,
pool_available_kb/div_by pool_available,
thin_pool_capacity_kb/div_by thin_pool_capacity,
thin_pool_allocated_kb/div_by thin_pool_allocated,
thin_pool_available_kb/div_by thin_pool_available,
thin_pool_subscribed_kb/div_by thin_pool_subscribed,
(NVL(usable_internal_capacity_kb,0) + NVL(usable_external_capacity_kb,0))/div_by usable_total_capacity,
usable_internal_capacity_kb/div_by usable_internal_capacity,
usable_external_capacity_kb/div_by usable_external_capacity,
usable_used_capacity_kb/div_by usable_used_capacity,
usable_free_capacity_kb/div_by usable_free_capacity,
virtualized_capacity_kb/div_by virtualized_capacity,
virtualized_capacity_thin_kb/div_by virtualized_capacity_thin,
replication_capacity_kb/div_by replication_capacity,
estimated_used_kb/div_by estimated_used,
lun_allocated_kb/div_by lun_allocated,
lun_capacity_kb/div_by lun_capacity 
FROM aps_v_storage_array sa, var
WHERE storage_array_id IN (${arrays})
)
SELECT 100 sort_order, array_name, &apos;APTARE Unique ID&apos; metric,TO_CHAR(storage_array_id) value FROM t1 UNION
SELECT 101 sort_order, array_name, &apos;Vendor&apos; metric, vendor_name value FROM t1 UNION
SELECT 102 sort_order, array_name, &apos;Name&apos; metric, array_name value FROM t1 UNION
SELECT 103 sort_order, array_name, &apos;Family&apos; metric, array_family value FROM t1 UNION
SELECT 104 sort_order, array_name, &apos;Type&apos; metric, array_type value FROM t1 UNION
SELECT 105 sort_order, array_name, &apos;Domain&apos; metric, domain_name value FROM t1 UNION
SELECT 106 sort_order, array_name, &apos;Root Group ID&apos; metric, TO_CHAR(root_group_id,&apos;9999999999&apos;) value FROM t1 UNION
SELECT 107 sort_order, array_name, &apos;Object ID&apos; metric, SUBSTR(object_id,1,30) value FROM t1 UNION
SELECT 108 sort_order, array_name, &apos;Product&apos; metric, product_name value FROM t1 UNION
SELECT 109 sort_order, array_name, &apos;Serial#&apos; metric, serial_nbr value FROM t1 UNION
SELECT 110 sort_order, array_name, &apos;Device Manager ID&apos; metric, TO_CHAR(device_manager_id,&apos;9999999999&apos;) value FROM t1 UNION
SELECT 111 sort_order, array_name, &apos;IP Address&apos; metric, SUBSTR(ip_address,1,30) value FROM t1 UNION
SELECT 112 sort_order, array_name, &apos;Agent Version&apos; metric, agent_version value FROM t1 UNION
SELECT 113 sort_order, array_name, &apos;Controller Version&apos; metric, controller_version value FROM t1 UNION
SELECT 114 sort_order, array_name, &apos;Cache&apos; metric, TO_CHAR(cache,&apos;999,999,999.99&apos;) value FROM t1 UNION
SELECT 115 sort_order, array_name, &apos;Is Active&apos; metric, is_active value FROM t1 UNION
SELECT 116 sort_order, array_name, &apos;Is RM Enabled&apos; metric, is_rm_enabled value FROM t1 UNION
SELECT 117 sort_order, array_name, &apos;Creation Date&apos; metric, TO_CHAR(creation_date,&apos;MM/DD/YYYY HH:MI:SS AM&apos;) value FROM t1 UNION
SELECT 118 sort_order, array_name, &apos;Last Updated&apos; metric, TO_CHAR(last_updated,&apos;MM/DD/YYYY HH:MI:SS AM&apos;) value FROM t1 UNION
SELECT 119 sort_order, array_name, &apos;#LUNs&apos; metric, TO_CHAR(nbr_of_luns,&apos;9999999999&apos;) value FROM t1 UNION
SELECT 120 sort_order, array_name, &apos;#Allocated LUNs&apos; metric, TO_CHAR(nbr_allocated_luns,&apos;9999999999&apos;) value FROM t1 UNION
SELECT 121 sort_order, array_name, &apos;#Array Ports&apos; metric, TO_CHAR(nbr_array_ports,&apos;9999999999&apos;) value FROM t1 UNION
SELECT 122 sort_order, array_name, &apos;#FC Ports&apos; metric, TO_CHAR(nbr_of_fc_ports,&apos;9999999999&apos;) value FROM t1 UNION
SELECT 123 sort_order, array_name, &apos;#iSCSI Ports&apos; metric, TO_CHAR(nbr_of_iscsi_ports,&apos;9999999999&apos;) value FROM t1 UNION
SELECT 124 sort_order, array_name, &apos;#Ethernet Ports&apos; metric, TO_CHAR(nbr_of_ethernet_ports,&apos;9999999999&apos;) value FROM t1 UNION
SELECT 125 sort_order, array_name, &apos;#Physical Disks&apos; metric, TO_CHAR(nbr_of_physical_disks,&apos;9999999999&apos;) value FROM t1 UNION
SELECT 126 sort_order, array_name, &apos;#Array Groups&apos; metric, TO_CHAR(nbr_of_array_groups,&apos;&apos;) value FROM t1 UNION
SELECT 127 sort_order, array_name, &apos;#Storage Pools&apos; metric, TO_CHAR(nbr_of_storage_pools,&apos;9999999999&apos;) value FROM t1 UNION
SELECT 128 sort_order, array_name, &apos;#Thin Pools&apos; metric, TO_CHAR(nbr_of_thin_pools,&apos;9999999999&apos;) value FROM t1 UNION
SELECT 129 sort_order, array_name, &apos;#Hosts&apos; metric, TO_CHAR(nbr_hosts,&apos;9999999999&apos;) value FROM t1 UNION
SELECT 129 sort_order, array_name, &apos;Thin Pool Subscribed%&apos; metric, TO_CHAR(thin_pool_subscribed_pct,&apos;9999.99&apos;)||&apos;%&apos; value FROM t1 UNION
SELECT 130 sort_order, array_name, &apos;Raw Capacity&apos; metric, TO_CHAR(raw_capacity,&apos;999,999,999.99&apos;) value FROM t1 UNION
SELECT 131 sort_order, array_name, &apos;Raw Allocated&apos; metric, TO_CHAR(raw_allocated,&apos;999,999,999.99&apos;) value FROM t1 UNION
SELECT 132 sort_order, array_name, &apos;Raw Available&apos; metric, TO_CHAR(raw_available,&apos;999,999,999.99&apos;) value FROM t1 UNION
SELECT 133 sort_order, array_name, &apos;Capacity&apos; metric, TO_CHAR(capacity,&apos;999,999,999.99&apos;) value FROM t1 UNION
SELECT 134 sort_order, array_name, &apos;Allocated&apos; metric, TO_CHAR(allocated,&apos;999,999,999.99&apos;) value FROM t1 UNION
SELECT 135 sort_order, array_name, &apos;Other Allocated&apos; metric, TO_CHAR(other_allocated,&apos;999,999,999.99&apos;) value FROM t1 UNION
SELECT 136 sort_order, array_name, &apos;Available&apos; metric, TO_CHAR(available,&apos;999,999,999.99&apos;) value FROM t1 UNION
SELECT 137 sort_order, array_name, &apos;Largest Free Space&apos; metric, TO_CHAR(largest_free_space,&apos;999,999,999.99&apos;) value FROM t1 UNION
SELECT 138 sort_order, array_name, &apos;Array Group Capacity&apos; metric, TO_CHAR(array_group_capacity,&apos;999,999,999.99&apos;) value FROM t1 UNION
SELECT 139 sort_order, array_name, &apos;Array Group Allocated&apos; metric, TO_CHAR(array_group_allocated,&apos;999,999,999.99&apos;) value FROM t1 UNION
SELECT 140 sort_order, array_name, &apos;Array Group Available&apos; metric, TO_CHAR(array_group_available,&apos;999,999,999.99&apos;) value FROM t1 UNION
SELECT 141 sort_order, array_name, &apos;Pool Capacity&apos; metric, TO_CHAR(pool_capacity ,&apos;999,999,999.99&apos;) value FROM t1 UNION
SELECT 142 sort_order, array_name, &apos;Pool Allocated&apos; metric, TO_CHAR(pool_allocated ,&apos;999,999,999.99&apos;) value FROM t1 UNION
SELECT 143 sort_order, array_name, &apos;Pool Available&apos; metric, TO_CHAR(pool_available ,&apos;999,999,999.99&apos;) value FROM t1 UNION
SELECT 144 sort_order, array_name, &apos;Thin Pool Capacity&apos; metric, TO_CHAR(thin_pool_capacity ,&apos;999,999,999.99&apos;) value FROM t1 UNION
SELECT 145 sort_order, array_name, &apos;Thin Pool Allocated&apos; metric, TO_CHAR(thin_pool_allocated ,&apos;999,999,999.99&apos;) value FROM t1 UNION
SELECT 146 sort_order, array_name, &apos;Thin Pool Available&apos; metric, TO_CHAR(thin_pool_available ,&apos;999,999,999.99&apos;) value FROM t1 UNION
SELECT 147 sort_order, array_name, &apos;Thin Pool Subscribed&apos; metric, TO_CHAR(thin_pool_subscribed ,&apos;999,999,999.99&apos;) value FROM t1 UNION
SELECT 148 sort_order, array_name, &apos;Usable Total Capacity*&apos; metric, TO_CHAR(usable_total_capacity,&apos;999,999,999.99&apos;) value FROM t1 UNION
SELECT 149 sort_order, array_name, &apos;Usable Internal Capacity&apos; metric, TO_CHAR(usable_internal_capacity,&apos;999,999,999.99&apos;) value FROM t1 UNION
SELECT 150 sort_order, array_name, &apos;Usable External Capacity&apos; metric, TO_CHAR(usable_external_capacity,&apos;999,999,999.99&apos;) value FROM t1 UNION
SELECT 151 sort_order, array_name, &apos;Usable Used Capacity&apos; metric, TO_CHAR(usable_used_capacity,&apos;999,999,999.99&apos;) value FROM t1 UNION
SELECT 152 sort_order, array_name, &apos;Usable Free Capacity&apos; metric, TO_CHAR(usable_free_capacity,&apos;999,999,999.99&apos;) value FROM t1 UNION
SELECT 153 sort_order, array_name, &apos;Virtualized Capacity &apos; metric, TO_CHAR(virtualized_capacity,&apos;999,999,999.99&apos;) value FROM t1 UNION
SELECT 154 sort_order, array_name, &apos;Virtualized Capacity Thin&apos; metric, TO_CHAR(virtualized_capacity_thin,&apos;999,999,999.99&apos;) value FROM t1 UNION
SELECT 155 sort_order, array_name, &apos;Replication Capacity&apos; metric, TO_CHAR(replication_capacity,&apos;999,999,999.99&apos;) value FROM t1 UNION
SELECT 156 sort_order, array_name, &apos;LUN Capacity&apos; metric, TO_CHAR(lun_capacity,&apos;999,999,999.99&apos;) value FROM t1 UNION
SELECT 157 sort_order, array_name, &apos;LUN Allocated&apos; metric, TO_CHAR(lun_allocated,&apos;999,999,999.99&apos;) value FROM t1 UNION
SELECT 158 sort_order, array_name, &apos;Estimated Used&apos; metric, TO_CHAR(estimated_used,&apos;999,999,999.99&apos;) value FROM t1
</string>
