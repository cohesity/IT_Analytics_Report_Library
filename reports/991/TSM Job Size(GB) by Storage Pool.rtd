          <entry>
            <string>dataSource</string>
            <string>--TSM Job Size by Storage Pool
SELECT to_char(tj.start_date,&apos;MM/DD/YY&apos;) run_date, sp.storage_pool_name,  
sum(tj.kilobytes/1024/1024) size_gb
FROM apt_v_tsm_job tj, apt_v_tsm_storage_pool sp
WHERE tj.start_date BETWEEN ${startDate} AND ${endDate}
AND tj.client_id in (${hosts})
AND tj.storage_pool_id = sp.storage_pool_id
GROUP BY to_char(tj.start_date,&apos;MM/DD/YY&apos;), sp.storage_pool_name
ORDER BY to_char(tj.start_date,&apos;MM/DD/YY&apos;), sp.storage_pool_name</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
