          <entry>
            <string>dataSource</string>
            <string>
--Author: rich.rose@aptare.com
--Last Modified: 05/10/2012
SELECT nvl(${freeCombo1},&apos;Unknown&apos;) metric, count(DISTINCT host_id) host_count
FROM aps_v_host_luns hl, aps_v_storage_array
WHERE 
hl.storage_array_id = aps_v_storage_array.storage_array_id
AND host_id IN (${hosts})
GROUP BY nvl(${freeCombo1},&apos;Unknown&apos;)</string>
