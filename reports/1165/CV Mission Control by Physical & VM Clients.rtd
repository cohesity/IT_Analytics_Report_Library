          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 10/01/2015
WITH 
VAR AS (
SELECT
ROUND((${endDate} - ${startDate}),2) nbrOfDays, 
${startDate} startDate, 
&apos;${freeCombo1}&apos; unit,
DECODE(&apos;${freeCombo1}&apos;, &apos;KB&apos;,1,&apos;MB&apos;,1024,&apos;GB&apos;,(1024*1024),&apos;TB&apos;,(1024*1024*1024),&apos;PB&apos;,(1024*1024*1024*1024)) div_by 
FROM apt_v_dual 
),
t1 AS (
SELECT 
j.job_id, 
cj.cmv_job_id_ext, --Simpana Job ID
cj.cmv_primary_backup_copy_id,
0 vm_cmv_client_id_ext,
j.client_id, 
j.client_name, 
h2.display_name cv_server,
j.server_name,
&apos;Physical&apos; client_type,
h.display_name client,
id.idataagent_name,
cbp.cmv_backup_policy_id,
cbp.backup_policy_name,
cbc.copy_name,
j.job_type_name,
j.summary_status,
DECODE(j.summary_status,0,&apos;green&apos;,1,&apos;yellow&apos;,&apos;red&apos;) status_dot,
cj.job_status cj_status_code,
DECODE(cj.job_status,1,&apos;Success&apos;,2,&apos;Failed&apos;,3,&apos;Partial Success&apos;,4,&apos;Killed&apos;,5,&apos;Stopped&apos;,6,&apos;Interrupted&apos;,7,&apos;Unknown&apos;,8,&apos;Failed to Start&apos;,cj.job_status) cv_status,
nvl(cr.description,&apos;N/A&apos;) reason,
j.start_date, --For physical hosts this is our normal job start/end  
j.finish_date,
j.duration,
cj.nbr_of_streams,
j.kilobytes/div_by job_size,
DECODE(cj.nbr_of_other_skipped_files,0,NULL,cj.nbr_of_other_skipped_files) skipped_files,
DECODE(j.kilobytes,0,NULL,j.mbytes_sec) throughput
FROM var, apt_v_job j, 
apt_v_cmv_job cj, 
apt_v_cmv_reason cr,
apt_v_cmv_idataagent id,
apt_v_cmv_backup_policy cbp,
apt_v_server h,
apt_v_server h2,
apt_v_cmv_backup_copy cbc
WHERE 
j.job_id = cj.job_id
AND h2.server_id = j.server_id
AND cj.job_failed_reason_id=cr.cmv_reason_id (+)
AND cj.cmv_idataagent_id = id.cmv_idataagent_id
AND cj.cmv_backup_policy_id = cbp.cmv_backup_policy_id
AND cj.client_id = h.server_id
AND cj.cmv_primary_backup_copy_id = cbc.cmv_backup_copy_id
AND h.server_id IN (${hosts})
AND j.start_date BETWEEN ${startDate} AND ${endDate} 
AND j.vendor_state = 2
UNION
SELECT 
j.job_id,
cj.cmv_job_id_ext, -- Simpana Job ID
cj.cmv_primary_backup_copy_id,
cjv.vm_cmv_client_id_ext,
j.client_id, 
j.client_name, 
j.server_name,
h2.display_name cv_server,
&apos;Virtual&apos; client_type,
nvl(cjv.vm_name,h.display_name) client,
id.idataagent_name,
cbp.cmv_backup_policy_id,
cbp.backup_policy_name,
cbc.copy_name,
j.job_type_name,
j.summary_status,
DECODE(cj.job_status,1,&apos;green&apos;,2,&apos;red&apos;,3,&apos;yellow&apos;,4,&apos;red&apos;,5,&apos;red&apos;,6,&apos;red&apos;,7,&apos;white&apos;,8,&apos;red&apos;,cj.job_status) status_dot,
cj.job_status cj_status_code,
DECODE(cj.job_status,1,&apos;Success&apos;,2,&apos;Failed&apos;,3,&apos;Partial Success&apos;,4,&apos;Killed&apos;,5,&apos;Stopped&apos;,6,&apos;Interrupted&apos;,7,&apos;Unknown&apos;,8,&apos;Failed to Start&apos;,cj.job_status) cv_status,
nvl(cr.description,&apos;N/A&apos;) reason,
cjv.vm_start_date start_date, --For VM&apos;s the parent job start/end not needed each guest has its own start/end
cjv.vm_finish_date finish_date,
rtd.secsToHoursMinSecs((cjv.vm_finish_date-cjv.vm_start_date)*24*60*60) duration,
1 nbr_of_streams,
cjv.vm_used_space_kb/div_by job_size,
DECODE(cj.nbr_of_other_skipped_files,0,NULL,cj.nbr_of_other_skipped_files) skipped_files,
DECODE((cjv.vm_used_space_kb/1024)/((cjv.vm_finish_date-cjv.vm_start_date)*24*60*60),0,NULL) throughput
FROM var, apt_v_job j, 
apt_v_cmv_job cj, 
apt_v_cmv_job_vm cjv,
apt_v_cmv_reason cr,
apt_v_cmv_idataagent id,
apt_v_cmv_backup_policy cbp,
apt_v_server h,
apt_v_server h2,
apt_v_cmv_backup_copy cbc
WHERE cj.job_id = cjv.job_id
AND j.job_id = cj.job_id
AND cjv.vm_failed_reason_id=cr.cmv_reason_id (+)
AND cj.cmv_idataagent_id = id.cmv_idataagent_id
AND cj.cmv_backup_policy_id = cbp.cmv_backup_policy_id
AND cjv.vm_client_id = h.server_id
AND j.server_id = h2.server_id
AND cj.cmv_primary_backup_copy_id = cbc.cmv_backup_copy_id
AND h.server_id IN (${hosts})
AND j.start_date BETWEEN ${startDate} AND ${endDate} 
AND j.vendor_state = 2
ORDER BY 1,2
),
t2 AS (
SELECT
TRUNC(start_date) the_date,
client_type||&apos; - &apos;||client client,
COUNT(job_id) nbr_of_jobs,
SUM(job_size) job_size,
SUM(skipped_files) skipped_files,
MIN(summary_status) min_status,
SUM(DECODE(cj_status_code,1,1,0)) Success,
SUM(DECODE(cj_status_code,2,1,0)) Failed,
SUM(DECODE(cj_status_code,3,1,0)) Partial_Success,
SUM(DECODE(cj_status_code,4,1,0)) Killed,
SUM(DECODE(cj_status_code,5,1,0)) Stopped,
SUM(DECODE(cj_status_code,6,1,0)) Interrupted,
SUM(DECODE(cj_status_code,7,1,0)) Unknown,
SUM(DECODE(cj_status_code,8,1,0)) Failed_to_Start
FROM t1
WHERE start_date IS NOT NULL
AND client_type LIKE DECODE(&apos;${freeCombo2}&apos;,&apos;All&apos;,&apos;%&apos;,&apos;${freeCombo2}&apos;)
GROUP BY
TRUNC(start_date),
client_type||&apos; - &apos;||client
)
SELECT
TO_CHAR(the_date,&apos;MM/DD/YY&apos;) the_date,
TO_CHAR(the_date,&apos;YYYYMMDD&apos;) sort_order,
client,
CASE 
WHEN min_status = 0 THEN &apos;green&apos;
WHEN min_status = 1 THEN &apos;yellow&apos;
WHEN min_status = 2 THEN &apos;red&apos;
END status_dot,
nbr_of_jobs,
ROUND(job_size,2) job_size,
NVL(skipped_files,0) skipped_files,
NVL(success,0) success,
NVL(failed,0) failed,
NVL(failed_to_Start,0) failed_to_Start,
NVL(partial_Success,0) partial_Success,
NVL(killed,0) killed,
NVL(stopped,0) stopped,
NVL(interrupted,0) interrupted,
NVL(unknown,0) unknown,
var.unit
FROM t2, var
ORDER BY 2 DESC,3
</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
    <entry>
      <string>authorUserId</string>
      <long>100000</long>
    </entry>
    <entry>
      <string>templateName</string>
      <null/>
    </entry>
    <entry>
