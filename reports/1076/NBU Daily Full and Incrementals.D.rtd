          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated, 10/22/2012
SELECT 
server_id,
master_host_name,
client_id,
client_host_name,
policy_id,
policy_name, 
policy_type_name,
job_id,
start_date,
finish_date,
expiration_date,
job_type_name,
kilobytes/1024/1024 job_size
FROM apt_v_nbu_job_detail
WHERE start_date BETWEEN ${startDate} AND ${endDate}
AND job_type IN (101,102)
AND summary_status IN (0,1)
AND client_host_name||&apos; - &apos;||policy_name = &apos;${the_client_policy}&apos;
AND to_char(start_date,&apos;MM/DD/YY&apos;) = &apos;${the_date}&apos;</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
