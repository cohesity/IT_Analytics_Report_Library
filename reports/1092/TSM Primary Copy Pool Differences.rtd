          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 02/29/2012
WITH 
q1 AS (
SELECT 
instance_name,
sum(DECODE(storage_pool_type,&apos;Primary&apos;,1,0)) primary_pools,
sum(DECODE(storage_pool_type,&apos;Primary&apos;,est_mbyte_capacity,0)/1024/1024) primary_capacity,
sum(DECODE(storage_pool_type,&apos;Copy&apos;,1,0)) copy_pools,
sum(DECODE(storage_pool_type,&apos;Copy&apos;,est_mbyte_capacity,0)/1024/1024) copy_capacity
FROM apt_v_tsm_storage_pool
GROUP BY instance_name
HAVING sum(DECODE(storage_pool_type,&apos;Primary&apos;,est_mbyte_capacity,0)/1024) &gt; 0
)
SELECT
instance_name,
primary_pools,primary_capacity,
copy_pools,copy_capacity,
round(copy_capacity/DECODE(primary_capacity,0,null,primary_capacity)*100,2) copy_pct
FROM q1</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
