          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 09/07/2016
WITH 
var AS (
SELECT
ROUND((${endDate} - ${startDate}),2) nbrOfDays,
DECODE(&apos;${freeCombo1}&apos;,
&apos;KB&apos;,1,&apos;MB&apos;,(1024),&apos;GB&apos;,(1024*1024),&apos;TB&apos;,(1024*1024*1024),&apos;PB&apos;,(1024*1024*1024*1024)) div_by 
FROM apt_v_dual
),
n1 AS (
SELECT
master_server_id,
COUNT(DISTINCT node_id) nodes,
SUM(total_capacity_kb/div_by) nodes_total_capacity,
SUM((total_capacity_kb-used_capacity_kb)/div_by) nodes_free_capacity,
SUM(used_capacity_kb/div_by) nodes_used_capacity
FROM apt_v_avm_node n, var, apt_v_server s
WHERE master_server_id IN (${hosts})
AND s.server_id = n.master_server_id
AND s.display_name LIKE &apos;${queryCombo1}&apos;
GROUP BY master_server_id
),
dp AS (
SELECT
ds.master_server_id,
MAX(data_protected_kb) data_protected_kb
FROM apt_v_avm_dpn_statistics ds, apt_v_server s
WHERE ds.master_server_id IN (${hosts})
AND s.server_id = ds.master_server_id
AND s.display_name LIKE &apos;${queryCombo1}&apos;
--FIXME
--AND ds.last_updated &gt; sysdate - 7
GROUP BY ds.master_server_id
),
t2 AS (--Get the highest value for each client/plugin combination
SELECT 
aa.server_id, 
aa.client_id,
aa.plugin_id,
MAX(aa.scanned_kb/div_by) scanned
FROM apt_v_avm_activities aa, var, apt_v_server s
WHERE
aa.client_id IN (${hosts}) 
AND aa.scanned_kb &gt; 0
--FIXME
--AND aa.expiration_date &gt; sysdate
AND s.server_id = aa.server_id
AND s.display_name LIKE &apos;${queryCombo1}&apos;
GROUP BY 
aa.server_id,
aa.client_id,
aa.plugin_id
),
t3 AS (--Add them up and this should be the size of each client on the grid
SELECT 
server_id master_server_id,
COUNT(DISTINCT client_id) clients,
SUM(scanned) scanned
FROM t2
GROUP BY 
server_id
),
t4 AS (
SELECT 
axion_system_id,
gsan_system_id, 
ms.master_server_id, 
hfs_address,
local_hfs_address, 
hfs_port, 
mcs_port, 
gsan_run_level, 
DECODE(gsan_run_level,&apos;up&apos;,&apos;green&apos;,&apos;degraded&apos;,&apos;yellow&apos;,&apos;red&apos;) run_level_dot,
t3.clients,
t3.scanned,
dp.data_protected_kb/div_by data_protected,
ROUND((dp.data_protected_kb/used_capacity_kb),1)||&apos;:1&apos; dedup_ratio,
((total_capacity_kb-used_capacity_kb)*(dp.data_protected_kb/used_capacity_kb)) /div_by est_available_capacity,
total_capacity_kb/var.div_by total_capacity,
used_capacity_kb/var.div_by used_capacity,  
(total_capacity_kb-used_capacity_kb)/div_by available_capacity,
(used_capacity_kb/DECODE(total_capacity_kb,0,null,total_capacity_kb)) used_pct,
(used_capacity_kb/DECODE(total_capacity_kb,0,null,total_capacity_kb))*100 pct_used,
protected_bytes_quota, 
license_expiration_date, 
time_since_server_init, 
rtd.secsToHoursMinSecs(time_since_server_init) time_since_server_init_hrs, 
last_updated_in_avm, 
last_checkpoint, 
last_validated_checkpoint,
nodes,
nodes_total_capacity,
nodes_used_capacity, 
nodes_free_capacity
FROM apt_v_avm_axion_system ms, var, n1, dp, t3, apt_v_server s
WHERE ms.master_server_id IN (${hosts})
AND s.server_id = ms.master_server_id
AND s.display_name LIKE &apos;${queryCombo1}&apos;
AND ms.master_server_id = n1.master_server_id (+)
AND ms.master_server_id = dp.master_server_id (+)
AND ms.master_server_id = t3.master_server_id (+)
)
--SELECT &apos;01&apos; sort_order,&apos;&lt;b&gt;Server ID Primary Key&lt;/b&gt;&apos; metric, TO_CHAR(master_server_id) value FROM t4 UNION
--SELECT &apos;05&apos; sort_order,&apos;&lt;b&gt;MCS Port&lt;/b&gt;&apos; metric, TO_CHAR(mcs_port) value FROM t4 UNION 
SELECT &apos;02&apos; sort_order,&apos;&lt;b&gt;HFS IP Address&lt;/b&gt;&apos; metric, hfs_address value FROM t4 UNION
SELECT &apos;03&apos; sort_order,&apos;&lt;b&gt;HFS Name&lt;/b&gt;&apos; metric, local_hfs_address value FROM t4 UNION
SELECT &apos;04&apos; sort_order,&apos;&lt;b&gt;HFS / MCS Port&lt;/b&gt;&apos; metric, TO_CHAR(hfs_port)||&apos; / &apos;||TO_CHAR(mcs_port) value FROM t4 UNION
SELECT &apos;05&apos; sort_order,&apos;&lt;b&gt;Run Level&lt;/b&gt;&apos; metric, gsan_run_level value FROM t4 UNION 
SELECT &apos;06&apos; sort_order,&apos;&lt;b&gt;License Expiration&lt;/b&gt;&apos; metric, NVL(TO_CHAR(license_expiration_date,&apos;MM/DD/YYYY&apos;),&apos;Never&apos;) FROM t4 UNION 
SELECT &apos;07&apos; sort_order,&apos;&lt;b&gt;Time Since Server Intitialization&lt;/b&gt;&apos; metric, time_since_server_init_hrs FROM t4 UNION 
SELECT &apos;08&apos; sort_order,&apos;&lt;b&gt;Last Checkpoint&lt;/b&gt;&apos; metric, TO_CHAR(last_checkpoint,&apos;MM/DD/YYYY&apos;) FROM t4 UNION 
SELECT &apos;09&apos; sort_order,&apos;&lt;b&gt;Last Validated Checkpoint&lt;/b&gt;&apos; metric, TO_CHAR(last_validated_checkpoint,&apos;MM/DD/YYYY&apos;) FROM t4 UNION 
SELECT &apos;10&apos; sort_order,&apos;&lt;b&gt;Protected Quota&lt;/b&gt;&apos; metric, protected_bytes_quota FROM t4 UNION 
SELECT &apos;12&apos; sort_order,&apos;&lt;b&gt;Number of Clients&lt;/b&gt;&apos; metric, TO_CHAR(clients) value FROM t4 UNION 
SELECT &apos;13&apos; sort_order,&apos;&lt;b&gt;Client Data&lt;/b&gt;&apos; metric, TO_CHAR(scanned,&apos;999G999G999D99&apos;)||&apos; ${freeCombo1}&apos; value FROM t4 UNION 
SELECT &apos;14&apos; sort_order,&apos;&lt;b&gt;Data Protected&lt;/b&gt;&apos; metric, TO_CHAR(data_protected,&apos;999G999G999D99&apos;)||&apos;${freeCombo1}&apos; value FROM t4 UNION 
SELECT &apos;15&apos; sort_order,&apos;&lt;b&gt;Dedup Ratio&lt;/b&gt;&apos; metric, dedup_ratio value FROM t4 UNION 
SELECT &apos;17&apos; sort_order,&apos;&lt;b&gt;Estimated Available Capacity*&lt;/b&gt;&apos; metric, TO_CHAR(est_available_capacity,&apos;999G999G999D99&apos;)||&apos; ${freeCombo1}&apos; FROM t4 UNION 
SELECT &apos;19&apos; sort_order,&apos;&lt;b&gt;Total Disk Capacity&lt;/b&gt;&apos; metric, TO_CHAR(total_capacity,&apos;999G999G999D99&apos;)||&apos; ${freeCombo1}&apos; FROM t4 UNION 
SELECT &apos;20&apos; sort_order,&apos;&lt;b&gt;Used Disk Capacity&lt;/b&gt;&apos; metric, TO_CHAR(used_capacity,&apos;999G999G999D99&apos;)||&apos; ${freeCombo1}&apos; FROM t4 UNION 
SELECT &apos;22&apos; sort_order,&apos;&lt;b&gt;Available Disk Capacity&lt;/b&gt;&apos; metric, TO_CHAR(available_capacity,&apos;999G999G999D99&apos;)||&apos; ${freeCombo1}&apos; FROM t4 UNION 
SELECT &apos;24&apos; sort_order,&apos;&lt;b&gt;Percent Used&lt;/b&gt;&apos; metric, TO_CHAR(pct_used,&apos;999D99&apos;)||&apos;%&apos; FROM t4 UNION 
SELECT &apos;26&apos; sort_order,&apos;&lt;b&gt;Number of Nodes&lt;/b&gt;&apos; metric, TO_CHAR(nodes) FROM t4 UNION 
SELECT &apos;28&apos; sort_order,&apos;&lt;b&gt;Nodes Disk Capacity&lt;/b&gt;&apos; metric, TO_CHAR(nodes_total_capacity,&apos;999G999G999D99&apos;)||&apos; ${freeCombo1}&apos; FROM t4 UNION 
SELECT &apos;30&apos; sort_order,&apos;&lt;b&gt;Nodes Used Capacity&lt;/b&gt;&apos; metric, TO_CHAR(nodes_used_capacity,&apos;999G999G999D99&apos;)||&apos; ${freeCombo1}&apos; FROM t4 UNION 
SELECT &apos;32&apos; sort_order,&apos;&lt;b&gt;Nodes Available Capacity&lt;/b&gt;&apos; metric, TO_CHAR(nodes_free_capacity,&apos;999G999G999D99&apos;)||&apos; ${freeCombo1}&apos; FROM t4 ORDER BY 1,2</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
