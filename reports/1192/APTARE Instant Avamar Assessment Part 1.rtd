                </componentScript>
                <configuration>
                  <entry>
                    <string>queryComboValues1</string>
                    <string>SELECT display_name the_key, display_name the_value FROM apt_v_server s, apt_v_avm_axion_system av WHERE s.server_id = av.master_server_id</string>
                  </entry>
                  <entry>
                    <string>queryComboHeading1</string>
                    <string>Avamar Server:</string>
                  </entry>
                  <entry>
                    <string>sql</string>
                    <string>SELECT display_name the_key, display_name the_value FROM apt_v_server s, apt_v_avm_axion_system av WHERE s.server_id = av.master_server_id</string>
