          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 10/09/2011
--Similar to TSM Process Count Breakdown except as a bar chart
SELECT
instance_name,
count(job_id) job_count,
sum(DECODE(job_type_name,&apos;Expiration&apos;,1,0)) Expiration,
sum(DECODE(job_type_name,&apos;Full DB Backup&apos;,1,0)) Full_DB_Backup,
sum(DECODE(job_type_name,&apos;Incremental DB Backup&apos;,1,0)) Incr_DB_Backup,
sum(DECODE(job_type_name,&apos;Migration&apos;,1,0)) migration,
sum(DECODE(job_type_name,&apos;Move Media&apos;,1,0)) move_media,
sum(DECODE(job_type_name,&apos;Reclamation&apos;,1,0)) reclamation,
sum(DECODE(job_type_name,&apos;Storage Pool Backup&apos;,1,0)) stg_pool_backup
FROM apt_v_tsm_process
WHERE start_date BETWEEN ${startDate} AND ${endDate}
AND server_id IN (${hosts})
AND job_type_name IN (&apos;Expiration&apos;,&apos;Full DB Backup&apos;,&apos;Incremental DB Backup&apos;,&apos;Migration&apos;,&apos;Move Media&apos;,&apos;Reclamation&apos;,&apos;Storage Pool Backup&apos;)
GROUP BY instance_name
ORDER BY 2 DESC</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
