gregation&quot;:&quot;&quot;,&quot;drilldown&quot;:&quot;&quot;,&quot;additionalDetail&quot;:&quot;${row[&apos;job_success_rate&apos;].data}% Job Success Rate&quot;},{&quot;selected&quot;:true,&quot;name&quot;:&quot;successful_job_count&quot;,&quot;label&quot;:&quot;Successful&quot;,&quot;description&quot;:&quot;&quot;,&quot;type&quot;:0,&quot;typeOverride&quot;:&quot;&quot;,&quot;typeName&quot;:&quot;number&quot;,&quot;formatter&quot;:&quot;CustomNumberFormatter&quot;,&quot;formatPattern&quot;:&quot;###,###,##0&quot;,&quot;alignment&quot;:&quot;right&quot;,&quot;colour&quot;:&quot;&quot;,&quot;barType&quot;:&quot;bar&quot;,&quot;pieType&quot;:&quot;pie&quot;,&quot;aggregation&quot;:&quot;sum&quot;,&quot;drilldown&quot;:&quot;templateInstanceId=150&amp;jobStatusIds=0&amp;dateRange.startDate=${row[&apos;start_date_char&apos;]}&amp;dateRange.startHour=${row[&apos;start_hour_char&apos;]}&amp;dateRange.startMinute=0&amp;dateRange.startSecond=0&amp;dateRange.finishDate=${row[&apos;finish_date_char&apos;]}&amp;dateRange.finishHour=${row[&apos;finish_hour_char&apos;]}&amp;dateRange.finishMinute=59&amp;dateRange.finishSecond=59&amp;dateRange.useFinishTime=false&amp;backupServerIds=${row[&apos;server_id&apos;]}&amp;parentJobOnly=false&amp;ignoreRetries=true&quot;,&quot;additionalDetail&quot;:&quot;&quot;},{&quot;selected&quot;:true,&quot;name&quot;:&quot;partial_job_count&quot;,&quot;label&quot;:&quot;Partial&quot;,&quot;description&quot;:&quot;&quot;,&quot;type&quot;:0,&quot;typeOverride&quot;:&quot;&quot;,&quot;typeName&quot;:&quot;number&quot;,&quot;formatter&quot;:&quot;CustomNumberFormatter&quot;,&quot;formatPattern&quot;:&quot;###,###,##0&quot;,&quot;alignment&quot;:&quot;right&quot;,&quot;colour&quot;:&quot;&quot;,&quot;barType&quot;:&quot;bar&quot;,&quot;pieType&quot;:&quot;pie&quot;,&quot;aggregation&quot;:&quot;sum&quot;,&quot;drilldown&quot;:&quot;templateInstanceId=150&amp;jobStatusIds=1&amp;dateRange.startDate=${row[&apos;start_date_char&apos;]}&amp;dateRange.startHour=${row[&apos;start_hour_char&apos;]}&amp;dateRange.startMinute=0&amp;dateRange.startSecond=0&amp;dateRange.finishDate=${row[&apos;finish_date_char&apos;]}&amp;dateRange.finishHour=${row[&apos;finish_hour_char&apos;]}&amp;dateRange.finishMinute=59&amp;dateRange.finishSecond=59&amp;dateRange.useFinishTime=false&amp;backupServerIds=${row[&apos;server_id&apos;]}&amp;parentJobOnly=false&amp;ignoreRetries=true&quot;,&quot;additionalDetail&quot;:&quot;&quot;},{&quot;selected&quot;:true,&quot;name&quot;:&quot;failed_job_count&quot;,&quot;label&quot;:&quot;Failed&quot;,&quot;description&quot;:&quot;&quot;,&quot;type&quot;:0,&quot;typeOverride&quot;:&quot;&quot;,&quot;typeName&quot;:&quot;number&quot;,&quot;formatter&quot;:&quot;CustomNumberFormatter&quot;,&quot;formatPattern&quot;:&quot;###,###,##0&quot;,&quot;alignment&quot;:&quot;right&quot;,&quot;colour&quot;:&quot;&quot;,&quot;barType&quot;:&quot;bar&quot;,&quot;pieType&quot;:&quot;pie&quot;,&quot;aggregation&quot;:&quot;sum&quot;,&quot;drilldown&quot;:&quot;templateInstanceId=150&amp;jobStatusIds=2&amp;dateRange.startDate=${row[&apos;start_date_char&apos;]}&amp;dateRange.startHour=${row[&apos;start_hour_char&apos;]}&amp;dateRange.startMinute=0&amp;dateRange.startSecond=0&amp;dateRange.finishDate=${row[&apos;finish_date_char&apos;]}&amp;dateRange.finishHour=${row[&apos;finish_hour_char&apos;]}&amp;dateRange.finishMinute=59&amp;dateRange.finishSecond=59&amp;dateRange.useFinishTime=false&amp;backupServerIds=${row[&apos;server_id&apos;]}&amp;parentJobOnly=false&amp;ignoreRetries=true&quot;,&quot;additionalDetail&quot;:&quot;&quot;},{&quot;selected&quot;:true,&quot;name&quot;:&quot;job_success_rate&quot;,&quot;label&quot;:&quot;Job Success&quot;,&quot;description&quot;:&quot;&quot;,&quot;type&quot;:0,&quot;typeOverride&quot;:&quot;&quot;,&quot;typeName&quot;:&quot;number&quot;,&quot;formatter&quot;:&quot;CustomNumberFormatter&quot;,&quot;formatPattern&quot;:&quot;###,###.00&apos;%&apos;&quot;,&quot;alignment&quot;:&qu