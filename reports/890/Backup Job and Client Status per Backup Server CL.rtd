          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 01/11/2019
WITH 
d1 AS (
SELECT
--Dates Required for Drilldown 
TO_CHAR(${startDate},&apos;MM/DD/YYYY&apos;) start_date_char,
TO_CHAR(${startDate},&apos;HH24&apos;) start_hour_char,
TO_CHAR(${endDate},&apos;MM/DD/YYYY&apos;) finish_date_char,
TO_CHAR(${endDate},&apos;HH24&apos;) finish_hour_char
FROM apt_v_dual
),
j1 AS (--Job Stats
SELECT 
j.server_id,
j.server_name,
j.product_type_name,
SUM(j.kilobytes/1024/1024/1024) job_volume,
COUNT(j.job_id) job_count,
SUM(DECODE(j.vendor_status_name,&apos;Successful&apos;,1,0)) successful_job_count,
SUM(DECODE(j.vendor_status_name,&apos;Failed&apos;,1,0)) failed_job_count,
SUM(DECODE(j.vendor_status_name,&apos;Partial&apos;,1,0)) partial_job_count,
ROUND((sum(DECODE(j.vendor_status_name,&apos;Successful&apos;,1,0))+sum(DECODE(j.vendor_status_name,&apos;Partial&apos;,1,0)))
/count(j.job_id)*100,2) job_success_rate
FROM apt_v_job j
WHERE j.start_date BETWEEN ${startDate} AND ${endDate}
AND j.server_id IN (${hosts})
GROUP BY 
j.server_id,
j.server_name,
j.product_type_name
),
fc1 AS (--Failed Clients 
SELECT
j.server_id,
j.client_id,
min(summary_status) min_summary_status,
max(summary_status) max_summary_status
FROM apt_v_job j
WHERE j.client_id IN (${hosts})
AND j.start_date BETWEEN ${startDate} AND ${endDate}
AND summary_status IS NOT NULL
GROUP BY
j.server_id,
j.client_id
),
fc2 AS (
SELECT
server_id,
COUNT(DISTINCT client_id) client_count,
SUM(CASE WHEN min_summary_status = 2 AND max_summary_status = 2 THEN 1 ELSE 0 END) failed_clients,
SUM(CASE WHEN min_summary_status = 1 AND max_summary_status = 1 THEN 1 ELSE 0 END) partial_clients,
SUM(CASE WHEN min_summary_status = 0 AND max_summary_status = 0 THEN 1 ELSE 0 END) successful_clients,
SUM(CASE WHEN min_summary_status &lt;&gt; max_summary_status THEN 1 ELSE 0 END) mixed_clients
FROM fc1
GROUP BY server_id
), 
fc3 AS (
SELECT
server_id,
failed_clients,
partial_clients,
successful_clients,
mixed_clients,
client_count,
ROUND(failed_clients/client_count*100,2) client_failure_rate,
ROUND(partial_clients/client_count*100,2) client_partial_rate,
ROUND(successful_clients/client_count*100,2) client_success_rate,
ROUND(mixed_clients/client_count*100,2) client_mixed_rate
FROM fc2
)
SELECT 
--If you have attributes for your backup servers un-comment the line 
--below and modify the attribute name if necessary.  The example below assumes a
--&apos;Location&apos; attribute has been assigned to each backup server.
--rtd.getObjectAttributeValue(j1.server_id,&apos;Location&apos;,&apos;S&apos;) location,
j1.server_id,
server_name,
product_type_name,
job_volume,
job_count,
CASE 
WHEN job_success_rate BETWEEN ${freeCombo2} AND 99.999 THEN &apos;green&apos;
WHEN job_success_rate BETWEEN ${freeCombo1} AND ${freeCombo2} THEN &apos;yellow&apos;
WHEN job_success_rate &lt; ${freeCombo1} THEN &apos;red&apos;
WHEN job_success_rate = 100 THEN &apos;blue&apos;
ELSE &apos;white&apos;
END job_status_dot,
successful_job_count,
partial_job_count,
failed_job_count,
job_success_rate,
client_count,
CASE 
WHEN client_success_rate BETWEEN ${freeCombo2} AND 99.999 THEN &apos;green&apos;
WHEN client_success_rate BETWEEN ${freeCombo1} AND ${freeCombo2} THEN &apos;yellow&apos;
WHEN client_success_rate &lt; ${freeCombo1} THEN &apos;red&apos;
WHEN client_success_rate = 100 THEN &apos;blue&apos;
ELSE &apos;white&apos;
END client_status_dot,
successful_clients,
partial_clients,
failed_clients,
mixed_clients,
client_success_rate,
start_date_char,
start_hour_char,
finish_date_char,
finish_hour_char
FROM d1, j1, fc3
WHERE j1.server_id = fc3.server_id 
ORDER BY 10 asc</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
