          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 01/28/2012
WITH 
t1 AS (
SELECT 
to_char(nss.mirror_timestamp,&apos;MM/DD/YY&apos;) the_date,
nsc.source_system_name  ||&apos; &apos;||nsc.source_volume_name source,
max(nss.summary_status) status,
sum(DECODE(nss.summary_status,2,1,0)) failed,
sum(DECODE(nss.summary_status,1,1,0)) partial,
sum(DECODE(nss.summary_status,0,1,0)) success
FROM 
aps_v_nap_snapvault_config nsc,
aps_v_nap_snapvault_status nss
WHERE
nsc.nap_snapvault_config_id = nss.nap_snapvault_config_id (+)
AND nss.mirror_timestamp BETWEEN ${startDate} AND ${endDate}
AND nsc.source_system_name LIKE DECODE(&apos;${queryCombo1}&apos;,&apos; All&apos;,&apos;%&apos;,&apos;${queryCombo1}&apos;)
AND nsc.source_storage_system_id IS NULL
GROUP BY
to_char(nss.mirror_timestamp,&apos;MM/DD/YY&apos;),
nsc.source_system_name ||&apos; &apos;|| nsc.source_volume_name
)
SELECT
the_date, lower(source) source,
DECODE(status,null,&apos;white&apos;,0,&apos;green&apos;,1,&apos;yellow&apos;,2,&apos;red&apos;) status,
failed, 
partial, 
success
FROM t1
ORDER BY the_date DESC</string>
          </entry>
        </data>
