          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 10/10/2018
WITH
VAR AS (
SELECT 
DECODE(&apos;${freeCombo1}&apos;,&apos;KB&apos;,1,&apos;MB&apos;,1024,&apos;GB&apos;,(1024*1024),&apos;TB&apos;,(1024*1024*1024),&apos;PB&apos;,(1024*1024*1024*1024)) div_by 
FROM apt_v_dual
)
SELECT 
dl.array_name,
COUNT(DISTINCT dl.vmw_datastore_id) nbr_of_datastores,
ROUND(SUM(ds.tot_capacity_kb/div_by),2) tot_capacity,
ROUND(SUM((ds.tot_capacity_kb-ds.free_capacity_kb)/div_by),2) used_capacity,
ROUND(SUM(ds.free_capacity_kb/div_by),2) free_capacity
FROM 
var, apt_v_vmw_map_datastore_lun dl, apt_v_vmw_datastore ds
WHERE 
dl.storage_array_id IN (${arrays})
AND dl.vmw_datastore_id = ds.vmw_datastore_id
GROUP BY 
dl.storage_array_id,
dl.array_name
ORDER BY 3 DESC</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
