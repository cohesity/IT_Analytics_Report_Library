          <entry>
            <string>dataSource</string>
            <string>
--Author: rich.rose@aptare.com
--Last Modified: 05/10/2012
SELECT 
ntm.server_id,
s.hostname as &quot;master server&quot;,
nvl(tl.library_id,999) library_id,
nvl(tl.library_name,&apos;Outside Library&apos;) library_name,
count(ntm.tape_media_id) total_tapes,
sum(DECODE(ntm.vendor_media_status, &apos;1&apos;,1,0)) Available,
sum(DECODE(ntm.vendor_media_status, &apos;2&apos;,1,0)) Assigned,
sum(DECODE(ntm.vendor_media_status, &apos;3&apos;,1,0)) Frozen,
sum(DECODE(ntm.vendor_media_status, &apos;4&apos;,1,0)) Suspended,
sum(DECODE(ntm.vendor_media_status, &apos;5&apos;,1,0)) Imported,
sum(DECODE(ntm.vendor_media_status, &apos;6&apos;,1,0)) Full,
sum(DECODE(ntm.vendor_media_status, &apos;7&apos;,1,0)) Expired,
sum(DECODE(ntm.vendor_media_status, &apos;8&apos;,1,0)) Catalog,
sum(DECODE(ntm.vendor_media_status, &apos;9&apos;,1,0)) Cleaning,
sum(DECODE(ntm.vendor_media_status, &apos;0&apos;,1,0)) Unknown
FROM apt_v_nbu_tape_media ntm,apt_v_server s,apt_v_tape_library tl
WHERE ntm.server_id = s.server_id
AND ntm.server_id = DECODE(${queryCombo1},999,ntm.server_id,${queryCombo1})
AND ntm.library_id = tl.library_id (+)
AND &apos;${freeCombo1}&apos; IN 
  CASE 
    WHEN &apos;${freeCombo1}&apos; NOT IN (&apos;All&apos;) THEN
      CASE
        WHEN tl.library_name IS NULL THEN &apos;Outside Library&apos;
        WHEN tl.library_name LIKE &apos;%#0%&apos; THEN &apos;#0&apos;
        WHEN tl.library_name LIKE &apos;%#1%&apos; THEN &apos;#1&apos;
        WHEN tl.library_name LIKE &apos;%#2%&apos; THEN &apos;#2&apos;
        WHEN tl.library_name LIKE &apos;%#3%&apos; THEN &apos;#3&apos;
        WHEN tl.library_name LIKE &apos;%#4%&apos; THEN &apos;#4&apos;
      END
   ELSE &apos;All&apos;
 END
GROUP BY
ntm.server_id,
s.hostname,
nvl(tl.library_id,999),
nvl(tl.library_name,&apos;Outside Library&apos;)</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
