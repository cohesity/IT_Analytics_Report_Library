            <string>designerScript</string>
            <null/>
          </entry>
          <entry>
            <string>dataSource</string>
            <string>WITH t1 as (
SELECT
trunc(aa.recorded_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;)) the_date,
sum(scanned_kb/1024/1024) scanned_gb,
sum(new_kb/1024/1024) new_gb
FROM 
apt_v_avm_activities aa, apt_v_job j
WHERE 
aa.job_id = j.job_id
AND aa.recorded_date BETWEEN ${startDate} AND ${endDate}
AND aa.server_id = DECODE(${queryCombo1},999,aa.server_id,${queryCombo1})
GROUP BY trunc(aa.recorded_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;))
)
SELECT
the_date,
scanned_gb,
new_gb,
100-((new_gb/scanned_gb)*100) dedup_pct
FROM t1</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
