                    <string>Group by:</string>
                  </entry>
                </configuration>
                <referenceData/>
              </com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
              <com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
                <name>freeQueryCombo</name>
                <componentScript>
                  <before/>
                  <after/>
                </componentScript>
                <configuration>
                  <entry>
                    <string>queryComboValues1</string>
                    <string>SELECT 999 server_id, &apos;All&apos; hostname FROM apt_v_dual UNION ALL SELECT server_id,lower(hostname) hostname FROM apt_v_server WHERE server_type_name=&apos;EMC Avamar Server&apos; ORDER BY 2</string>
                  </entry>
                  <entry>
                    <string>queryComboHeading1</string>
                    <string>Avamar Server:</string>
                  </entry>
                </configuration>
