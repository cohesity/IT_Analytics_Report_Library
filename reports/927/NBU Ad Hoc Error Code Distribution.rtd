          <entry>
            <string>dataSource</string>
            <string>WITH t1 as (
SELECT
summary_status,
vendor_status status,
server_id,
nvl(DECODE(&apos;${freeCombo1}&apos;,
&apos;Client&apos;,client_host_name,
&apos;Master Server&apos;,master_host_name,
&apos;Media Server&apos;,media_host_name,
&apos;Storage Unit&apos;,storage_unit_label,
&apos;Policy&apos;,policy_name,
&apos;Policy Type&apos;,policy_type_name,
&apos;Job Type&apos;,job_type_name,
&apos;Schedule&apos;,schedule_name,
&apos;Schedule Type&apos;,schedule_type_name),&apos;None&apos;) unit,  
count(job_id) job_count
FROM apt_v_nbu_job_detail
WHERE client_id IN (${hosts})
AND finish_date BETWEEN ${startDate}  AND ${endDate}
AND vendor_status is not null
GROUP BY
summary_status, 
vendor_status,
server_id,
nvl(DECODE(&apos;${freeCombo1}&apos;,
&apos;Client&apos;,client_host_name,
&apos;Master Server&apos;,master_host_name,
&apos;Media Server&apos;,media_host_name,
&apos;Storage Unit&apos;,storage_unit_label,
&apos;Policy&apos;,policy_name,
&apos;Policy Type&apos;,policy_type_name,
&apos;Job Type&apos;,job_type_name,
&apos;Schedule&apos;,schedule_name,
&apos;Schedule Type&apos;,schedule_type_name),&apos;None&apos;)
)
SELECT
to_char(${startDate},&apos;MM/DD/YYYY&apos;) start_date_char,
to_char(${startDate},&apos;HH24&apos;) start_hour_char,
to_char(${endDate},&apos;MM/DD/YYYY&apos;) finish_date_char,
to_char(${endDate},&apos;HH24&apos;) finish_hour_char,
t1.server_id,
t1.summary_status,
t1.status,
t1.unit,
t1.job_count  
FROM t1</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
