          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 11/14/2012
--Computes the future capacity of Avamar Nodes based on 2 different methods
--Linear Regression (Linear) Sum of squares linear algorithm y=mX+b
--Period Over Period (POP) ((last period - first period) / nbr of periods) + last period...
--First period goes back as far back as data collection began and last period is
--the current capacity of the last time data collection occurred.
WITH
d0 AS (
SELECT
DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,1,&apos;Week&apos;,7,&apos;Month&apos;,31,&apos;Quarter&apos;,93,&apos;Year&apos;,365.24) nbr_of_days,
&apos;${freeCombo1}&apos; the_group_by
FROM dual
),
a0 as (
SELECT
master_server_id,
node_id,
trunc(log_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YY&apos;)) log_date,
row_number() over (partition by master_server_id,  node_id ORDER BY master_server_id, node_id) row_number,
MAX((capacity_mb-used_mb)/1024) available
FROM apt_v_avm_node_space_log
WHERE log_date BETWEEN ${startDate} AND ${endDate}
AND master_server_id IN (${hosts})
GROUP BY master_server_id,node_id,trunc(log_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YY&apos;))
),
p0 AS (--Get the first and last period number for each array &amp; pool
SELECT
master_server_id,
node_id,
MIN(row_number) first_period_number, --First period will always be 1
MAX(row_number) last_period_number, --Last period is the current period or last time data was collected
min(log_date) first_period_date,
max(log_date) last_period_date,
COUNT(log_date) period_count
FROM a0
GROUP BY
master_server_id,
node_id
),
pop1 AS (--Get the first and last period metrics based on the row number of the periods
SELECT
a0.master_server_id, a0.node_id,
MAX(last_period_number) nbr_of_periods,
SUM(DECODE(a0.row_number,first_period_number,a0.available,0)) first_available,
SUM(DECODE(a0.row_number,last_period_number,a0.available,0)) last_available
FROM a0,p0
WHERE a0.master_server_id = p0.master_server_id
AND a0.node_id = p0.node_id
GROUP BY a0.master_server_id, a0.node_id
),
pop2 AS (--Calculate the Period Over Period Changes
SELECT
master_server_id,
node_id,
first_available,
last_available,
ROUND(last_available - first_available,2) pop_available_delta,
ROUND((last_available - first_available ) / DECODE(nbr_of_periods,0,null,nbr_of_periods),2) pop_available_trend
FROM pop1
),
lin1 AS (--Get the Linear Growth statistics
SELECT
a0.master_server_id,
a0.node_id,
ROUND(REGR_SLOPE(available,row_number),2) linear_trend,
REGR_R2(available,row_number) r2_value,
REGR_AVGX(available,row_number) avex,
REGR_AVGY(available,row_number)  avey,
REGR_INTERCEPT(available,row_number) y_intercept,
REGR_COUNT(available,row_number) period_count,
STDDEV(available)  stddev
FROM a0
GROUP BY master_server_id,  node_id
)
SELECT
pop1.master_server_id,
s.hostname,
pop1.node_id,
pop2.first_available,
pop2.last_available,
lin1.avey average_available,
period_count,
--
TO_CHAR(pop_available_trend) pop_available_trend,
TO_CHAR(linear_trend) linear_trend,
--
CASE
WHEN period_count &lt; 3 THEN null
WHEN pop_available_trend &gt; 0  THEN null
WHEN pop_available_trend &lt; 0  THEN round(pop1.last_available/DECODE(abs(pop_available_trend),0,null,abs(pop_available_trend)),0)
ELSE NULL
END pop_periods_left,
CASE
WHEN period_count &lt; 3 THEN null
WHEN linear_trend &gt; 0  THEN null
WHEN linear_trend &lt; 0  THEN round(pop1.last_available/DECODE(abs(linear_trend),0,null,abs(linear_trend)),0)
ELSE NULL
END linear_periods_left,
r2_value*100 r2_value,
lin1.y_intercept,
CASE
WHEN pop_available_trend &lt; 0 THEN &apos;red&apos;
WHEN pop_available_trend = 0 THEN &apos;white&apos;
WHEN pop_available_trend &gt; 0 THEN &apos;green&apos;
END pop_status,
CASE
WHEN pop_available_trend &lt; 0 THEN &apos;Available Capacity Decreasing by &apos;||abs(pop_available_trend)||&apos;(GB) &apos;||the_group_by||&apos; Over &apos;||the_group_by
WHEN pop_available_trend = 0 THEN &apos;Available Capacity Staying Flat &apos;||the_group_by||&apos; Over &apos;||the_group_by
WHEN pop_available_trend &gt; 0 THEN &apos;Available Capacity Increasing by &apos;||pop_available_trend||&apos;(GB) &apos;||the_group_by||&apos; Over &apos;||the_group_by
END pop_status_name,
CASE
WHEN pop1.last_available &lt;= 0 THEN &apos;Already out of capacity&apos;
WHEN pop_available_trend = 0 THEN &apos;Not changing&apos;
WHEN period_count &lt; 3 THEN &apos;Not enough data to calculate&apos;
WHEN pop_available_trend &gt; 0 THEN &apos;Available capacity increased&apos;
WHEN pop_available_trend &lt; 0 THEN &apos;Will run out on:&apos;|| to_char(sysdate+(d0.nbr_of_days*pop1.last_available/DECODE(abs(pop_available_trend),0,null,abs(pop_available_trend))),&apos;MM/DD/YYYY&apos;)
END pop_date_of_concern,
CASE
WHEN linear_trend &lt; 0 THEN &apos;red&apos;
WHEN linear_trend = 0 THEN &apos;white&apos;
WHEN linear_trend &gt; 0 THEN &apos;green&apos;
END linear_status,
CASE
WHEN linear_trend &lt; 0 THEN &apos;Available Capacity Decreasing by &apos;||abs(linear_trend)||&apos;(GB) &apos;||the_group_by||&apos; Over &apos;||the_group_by
WHEN linear_trend = 0 THEN &apos;Available Capacity Staying Flat &apos;||the_group_by||&apos; Over &apos;||the_group_by
WHEN linear_trend &gt; 0 THEN &apos;Available Capacity Increasing by &apos;||linear_trend||&apos;(GB) &apos;||the_group_by||&apos; Over &apos;||the_group_by
END linear_status_name,
CASE
WHEN pop1.last_available &lt;= 0 THEN &apos;Already out of capacity&apos;
WHEN linear_trend = 0 THEN &apos;Not changing&apos;
WHEN period_count &lt; 3 THEN &apos;Not enough data to calculate&apos;
WHEN linear_trend &gt; 0 THEN &apos;Available capacity increased&apos;
WHEN linear_trend &lt; 0 THEN &apos;Will run out on:&apos;|| to_char(sysdate+(d0.nbr_of_days*pop1.last_available/DECODE(abs(linear_trend),0,null,abs(linear_trend))),&apos;MM/DD/YYYY&apos;)
END linear_date_of_concern,
d0.nbr_of_days,
d0.the_group_by
FROM  d0, lin1, pop1, pop2, apt_v_server s
WHERE
pop1.master_server_id = s.server_id
AND pop1.master_server_id = pop2.master_server_id
AND pop1.node_id = pop2.node_id
AND pop1.master_server_id = lin1.master_server_id
AND pop1.node_id = lin1.node_id</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
    <entry>
      <string>authorUserId</string>
      <long>100000</long>
    </entry>
    <entry>
      <string>templateName</string>
      <null/>
    </entry>
    <entry>
