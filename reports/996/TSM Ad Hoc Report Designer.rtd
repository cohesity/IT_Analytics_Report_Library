          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 09/22/2011
--Report On: Job Size(GB),Client Count,File Count,Job Count,Successful Jobs,Partial Jobs,Failed Jobs,MB/sec,Duration(Min),Data Transfer(Min),Media Wait(Min),Idle(Min),Failed Objects,Examined Objects
--by: TSM Instance,TSM Server,Client,Node,Backup Type,Media type,Domain, Schedule,Storage Pool,Storage Pool Type,Device Class
--per: Day,Week,Month,Quarter,Year
--
--
WITH t1 AS (
SELECT trunc(tj.start_date,DECODE(&apos;${freeCombo3}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;)) the_date, 
DECODE(&apos;${freeCombo2}&apos;,
&apos;TSM Instance&apos;, tj.instance_name,
&apos;TSM Server&apos;, tj.server_name,
&apos;Client&apos;, tj.client_name,
&apos;Node&apos;, tj.node_name,
&apos;Backup Type&apos;, tj.job_type_name,
&apos;Media type&apos;, tj.media_type,
&apos;Domain&apos;, tj.domain_name,
&apos;Schedule&apos;, tj.schedule_name,
&apos;Storage Pool&apos;, sp.storage_pool_name,
&apos;Storage Pool Type&apos;, sp.storage_pool_type,
&apos;Device Class&apos;, sp.storage_pool_name) unit,  
trunc(sum(tj.kilobytes/1024/1024)) job_size_gb,
count(DISTINCT tj.client_id) client_count,
sum(tj.nbr_of_files) file_count,
count(DISTINCT tj.job_id) job_count,
sum(DECODE(tj.summary_status,0,1)) successful_jobs,
sum(DECODE(tj.summary_status,1,1)) partial_jobs,
sum(DECODE(tj.summary_status,2,1)) failed_jobs,
avg(tj.mbytes_sec) mbytes_sec,
sum(tj.duration_secs/60) duration_min,
sum(tj.data_transfer_secs/60) data_transfer_min,
sum(tj.media_wait_secs/60) media_wait_min, 
sum(tj.idle_secs/60) idle_min, 
sum(tj.nbr_failed_objects) nbr_failed_objects, 
sum(tj.nbr_examined_objects) nbr_examined_objects
FROM apt_v_tsm_job tj, apt_v_tsm_storage_pool sp
WHERE tj.start_date BETWEEN ${startDate} AND ${endDate}
AND tj.client_id IN (${hosts})
AND tj.storage_pool_id = sp.storage_pool_id (+)
GROUP BY trunc(tj.start_date,DECODE(&apos;${freeCombo3}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;)),
DECODE(&apos;${freeCombo2}&apos;,
&apos;TSM Instance&apos;, tj.instance_name,
&apos;TSM Server&apos;, tj.server_name,
&apos;Client&apos;, tj.client_name,
&apos;Node&apos;, tj.node_name,
&apos;Backup Type&apos;,tj.job_type_name,
&apos;Media type&apos;, tj.media_type,
&apos;Domain&apos;,tj.domain_name,
&apos;Schedule&apos;,tj.schedule_name,
&apos;Storage Pool&apos;,sp.storage_pool_name,
&apos;Storage Pool Type&apos;,sp.storage_pool_type,
&apos;Device Class&apos;,sp.storage_pool_name)
) 
SELECT to_char(the_date,&apos;MM/DD/YY&apos;) the_date,
nvl(unit,&apos;Unknown&apos;) unit,
DECODE(&apos;${freeCombo1}&apos;,
&apos;Job Size(GB)&apos;, job_size_gb,
&apos;Client Count&apos;, client_count,
&apos;File Count&apos;, file_count,
&apos;Job Count&apos;, job_count,
&apos;Successful Jobs&apos;, successful_jobs,
&apos;Partial Jobs&apos;, partial_jobs,
&apos;Failed Jobs&apos;, failed_jobs,
&apos;MB/sec&apos;, mbytes_sec,
&apos;Duration(Min)&apos;, duration_min,
&apos;Data Transfer(Min)&apos;, data_transfer_min,
&apos;Media Wait(Min)&apos;, media_wait_min, 
&apos;Idle(Min)&apos;, idle_min, 
&apos;Failed Objects&apos;, nbr_failed_objects, 
&apos;Examined Objects&apos;, nbr_examined_objects) the_metric
FROM t1 
ORDER BY 1</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
