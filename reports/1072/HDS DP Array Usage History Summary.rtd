          <entry>
            <string>dataSource</string>
            <string>WITH 
a0 as (
SELECT
trunc(log_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;)) log_date,
array_name,
count(DISTINCT journal_pool_id) nbr_of_pools,
max(allocated_kb/1024/1024) allocated_gb,
max(unallocated_kb/1024/1024) unallocated_gb,
max(available_kb/1024/1024) available_gb,
max(capacity_kb/1024/1024) capacity_gb,
max(capacity_of_vvols_kb/1024/1024) capacity_of_vvols_gb,
max(touched_kb/1024/1024) touched_gb,
max(associated_warn_kb/1024/1024) associated_warn_gb,
max(allocated_warn_kb/1024/1024) allocated_warn_gb
FROM aps_v_hds_journal_pool_log
WHERE log_date BETWEEN ${startDate} AND ${endDate}
AND array_name = &apos;${queryCombo1}&apos;
AND array_name is not null
GROUP BY trunc(log_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;)),array_name
HAVING max(allocated_kb) &gt; 0
)
SELECT to_char(log_date,&apos;MM/DD/YY&apos;) the_date,
a0.array_name,
a0.nbr_of_pools,
a0.allocated_gb,
a0.unallocated_gb,
a0.capacity_gb,
a0.capacity_of_vvols_gb, 
a0.touched_gb,
a0.available_gb,
a0.touched_gb + a0.available_gb associated_gb,
a0.associated_warn_gb,
a0.allocated_warn_gb
FROM a0</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
