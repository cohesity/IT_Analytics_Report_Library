          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 11/14/2012
--NOTE: This is a drilldown report only and will not run standalone
--The templateName is NBUQueuedStatusSummary.D
WITH 
t1 AS (
SELECT
server_id,
master_host_name,
client_id,
client_host_name,
policy_name,
schedule_name,
start_date,
started_readwrite,
(started_readwrite - start_date)*24*60 queue_min,
finish_date,
vendor_status,
CASE 
WHEN (started_readwrite - start_date)*24*60 &lt; 5 THEN &apos;l5&apos;
WHEN (started_readwrite - start_date)*24*60 BETWEEN 5 AND 15 THEN &apos;515&apos;
WHEN (started_readwrite - start_date)*24*60 &gt;= 15 THEN &apos;g15&apos; 
END q_code
FROM apt_v_nbu_job_detail
WHERE start_date BETWEEN ${startDate} AND ${endDate}
AND server_id = ${theServerID}
AND summary_status IS NOT NULL
)
SELECT * 
FROM t1 
WHERE 
q_code = &apos;${theQueueCode}&apos;</string>
          </entry>
