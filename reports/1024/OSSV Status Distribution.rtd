          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 01/28/2012
WITH 
t1 AS (
SELECT 
nss.summary_status status_name,
count(*) status_count
FROM 
aps_v_nap_snapvault_config nsc,
aps_v_nap_snapvault_status nss
WHERE
nsc.nap_snapvault_config_id = nss.nap_snapvault_config_id (+)
AND nss.mirror_timestamp BETWEEN ${startDate} AND ${endDate}
AND nsc.source_system_name LIKE DECODE(&apos;${queryCombo1}&apos;,&apos; All&apos;,&apos;%&apos;,&apos;${queryCombo1}&apos;)
AND nsc.source_storage_system_id IS NULL
GROUP BY nss.summary_status
)
SELECT
DECODE(status_name,0,&apos;Successful&apos;,1,&apos;Partial&apos;,2,&apos;Failed&apos;) status_name,
status_count
FROM t1</string>
          </entry>
        </data>
