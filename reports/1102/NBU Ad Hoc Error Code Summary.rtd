SUM(DECODE(nj.summary_status,1,1,null)) parital,
SUM(DECODE(nj.summary_status,2,1,null)) failed,
SUM(DECODE(nj.vendor_status,2,1,6,1,11,1,12,1,13,1,14,1,21,1,22,1,23,1,24,1,25,1,41,1,42,1,47,1,54,1,57,1,58,1,59,1,63,1,71,1,155,1,156,1,160,1,197,1,230,1,237,1,239,1,247,1,null)) clt_error,    
