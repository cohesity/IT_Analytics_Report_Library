FROM
apt_v_nbu_job_detail nj
WHERE nj.start_date BETWEEN ${startDate} AND ${endDate}
AND nj.server_id IN (${hosts})
AND nj.vendor_status IS NOT NULL
AND nj.client_host_name &lt;&gt; &apos;NONE&apos;
GROUP BY 
DECODE(&apos;${freeCombo1}&apos;,
&apos;Client&apos;,client_host_name,
&apos;Master Server&apos;,master_host_name,
&apos;Media Server&apos;,media_host_name,
&apos;Storage Unit&apos;,storage_unit_label,
&apos;Policy&apos;,policy_name,
&apos;Policy Type&apos;,policy_type_name,
&apos;Job Type&apos;,job_type_name,
&apos;Schedule&apos;,schedule_name,
&apos;Schedule Type&apos;,schedule_type_name)
)
SELECT
metric,
clients,
total_jobs,
success,
parital,
failed,
clt_error,    
nbu_error,
CASE 
  WHEN failed = 0 THEN 0
  ELSE (clt_error/failed) * 100 
END clt_error_pct,
CASE 
  WHEN failed = 0 THEN 0
  ELSE (nbu_error/failed) * 100 
END nbu_error_pct,   
partial_pct,
success_pct,   
