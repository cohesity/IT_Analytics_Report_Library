          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 08/16/2018
WITH
p1 AS (--Get the master list of policies
SELECT  --Policies with SLP
p.server_id,
s.display_name master_server_name,
pc.client_id,
pc.client_name,
p.policy_id,
p.policy_name,
p.policy_type_name,
p.is_active,
p.lifecycle_policy_id,
p.lifecycle_policy_name
FROM
apt_v_nbu_policy p, apt_v_nbu_policy_client pc, apt_v_server s
WHERE
p.server_id IN (${hosts}) 
AND p.server_id = s.server_id
AND p.is_active = DECODE(&apos;${freeCombo1}&apos;,&apos;Active&apos;,&apos;Y&apos;,&apos;Inactive&apos;,&apos;N&apos;,&apos;All&apos;,p.is_active)
AND p.lifecycle_policy_id IS NOT NULL  
AND p.policy_id = pc.policy_id
AND pc.is_active = DECODE(&apos;${freeCombo1}&apos;,&apos;Active&apos;,&apos;Y&apos;,&apos;Inactive&apos;,&apos;N&apos;,&apos;All&apos;,pc.is_active)
UNION
SELECT --Policies without SLP
p.server_id,
s.display_name master_server_name,
pc.client_id,
pc.client_name,
p.policy_id,
p.policy_name,
p.policy_type_name,
p.is_active,
NULL lifecycle_policy_id,
&apos;No Lifecycle Policy&apos; lifecycle_policy_name
FROM
apt_v_nbu_policy p, apt_v_nbu_policy_client pc, apt_v_server s
WHERE
p.server_id IN (${hosts}) 
AND p.server_id = s.server_id  
AND p.is_active = DECODE(&apos;${freeCombo1}&apos;,&apos;Active&apos;,&apos;Y&apos;,&apos;Inactive&apos;,&apos;N&apos;,&apos;All&apos;,p.is_active)
AND p.exists_in_catalog = DECODE(&apos;${freeCombo1}&apos;,&apos;Active&apos;,&apos;Y&apos;,&apos;Inactive&apos;,&apos;N&apos;,&apos;All&apos;,p.exists_in_catalog)
AND p.lifecycle_policy_id IS NULL  
AND p.policy_id = pc.policy_id
AND pc.is_active = DECODE(&apos;${freeCombo1}&apos;,&apos;Active&apos;,&apos;Y&apos;,&apos;Inactive&apos;,&apos;N&apos;,&apos;All&apos;,pc.is_active)
AND pc.exists_in_catalog = DECODE(&apos;${freeCombo1}&apos;,&apos;Active&apos;,&apos;Y&apos;,&apos;Inactive&apos;,&apos;N&apos;,&apos;All&apos;,pc.exists_in_catalog)
),
pf1 AS (
SELECT
p.policy_id,
rtd.collectString(CAST(COLLECT(TO_CHAR(
SUBSTR(pf.pathname,1,60)
) ORDER BY pf.pathname) AS StringListType),&apos;&lt;br&gt;&apos;) directives
FROM
apt_v_nbu_policy p, apt_v_nbu_policy_file pf
WHERE
p.server_id IN (${hosts}) 
AND p.policy_id = pf.policy_id
AND p.is_active = &apos;Y&apos;
AND p.exists_in_catalog = &apos;Y&apos;
AND pf.include_exclude_flag = &apos;I&apos;
GROUP BY 
p.policy_id
),
s1 AS (--get the Schedule configs grouped by policy
SELECT
p.policy_id,
MAX(s.retention_days) max_retention_days,
rtd.collectString(CAST(COLLECT(TO_CHAR(
  s.schedule_name  
  ||&apos; - &apos;||
  DECODE(s.selection_type,1,&apos;&apos;,2,&apos;Calendar - &apos;)
  ||
  CASE 
  WHEN s.frequency &lt; 3600 THEN s.frequency||&apos; Secs&apos;
  WHEN s.frequency = 3600 THEN &apos;Every Hour&apos;
  WHEN s.frequency BETWEEN 3601 AND 86400 THEN &apos;Every &apos;||ROUND(s.frequency/60/60,2)||&apos; Hours&apos;
  WHEN s.frequency = 86400 THEN &apos;Every day&apos;
  WHEN s.frequency BETWEEN 86401 AND 31536000 THEN &apos;Every &apos;||ROUND(s.frequency/60/60/24,2)||&apos; Days&apos;
  WHEN s.frequency &gt; 31536000 THEN &apos;Every &apos;||ROUND(s.frequency/60/60/24/365,2)||&apos; Years&apos;
  ELSE TO_CHAR(s.frequency)
  END 
  ||&apos; - Retain: &apos;||
  DECODE(s.retention_days,
    9999,&apos;Forever&apos;,
    -1,&apos;No&apos;,
    null,&apos; &apos;,
   DECODE(lp.lifecycle_policy_name,NULL,s.retention_days||&apos; Days&apos;,&apos;SLP*&apos;))
  ||NVL2(s.volume_pool_name,&apos; - Vol pool: &apos;||SUBSTR(s.volume_pool_name,1,25),&apos;&apos;)
  ||NVL2(su.storage_unit_label,&apos; - Stg Unit:&apos;||SUBSTR(su.storage_unit_label,1,25),&apos;&apos;)
  ||NVL2(lp.lifecycle_policy_name,&apos; - Res:&apos;||SUBSTR(lp.lifecycle_policy_name,1,25),&apos;&apos;)
) ORDER BY s.schedule_name) AS StringListType),&apos;&lt;br&gt;&apos;) sched_config
FROM 
apt_v_nbu_policy p, apt_v_nbu_schedule s, apt_v_nbu_storage_unit su, apt_v_nbu_lifecycle_policy lp
WHERE 
p.server_id IN (${hosts}) 
AND p.is_active = &apos;Y&apos;
AND p.exists_in_catalog = &apos;Y&apos;
AND p.policy_id = s.policy_id
AND s.exists_in_catalog = &apos;Y&apos;
AND s.storage_unit_id = su.storage_unit_id (+)
AND s.lifecycle_policy_id = lp.lifecycle_policy_id (+)
GROUP BY p.policy_id
),
c1 AS (--get the Lifecycle Policy Destinations
SELECT DISTINCT
&apos;Policy&apos; lp_source,
p.policy_id,
p.lifecycle_policy_id,
lp.lifecycle_policy_name,
MAX(lpd.destination_index_nbr) nbr_of_destinations,
rtd.collectString(CAST(COLLECT(TO_CHAR(
  &apos;Copy: &apos;
  ||
  lpd.destination_index_nbr
  ||&apos; - &apos;||
  DECODE(lpd.used_for,
    0,&apos;Backup&apos;,
    1,&apos;Duplication&apos;,
    2,&apos;Snapshot&apos;,
    3,&apos;Remote Server Duplication&apos;,
    4,&apos;Import&apos;,
    5,&apos;Backup Snapshot&apos;,
    6,&apos;Index Snapshot&apos;,
    7,&apos;Replication&apos;) 
  ||&apos; - Retain: &apos;||
  DECODE(lpd.retention_days,
    9999,&apos;Never Expires&apos;,
    -1,&apos;Expires Immediately&apos;,
    null,&apos; &apos;,
   lpd.retention_days||&apos; Days&apos;)
  ||&apos; - Store to: &apos;||
  su.storage_unit_label
  ||&apos; &apos;||
  vp.volume_pool_name
) ORDER BY lpd.destination_index_nbr) AS StringListType),&apos;&lt;br&gt;&apos;) slp_config
FROM
apt_v_nbu_policy p, apt_v_nbu_lifecycpolicy_dest lpd, apt_v_nbu_lifecycle_policy lp, 
apt_v_nbu_storage_unit su, apt_v_nbu_volume_pool vp
WHERE
p.server_id IN (${hosts}) 
AND p.exists_in_catalog =&apos;Y&apos;
AND p.is_active = &apos;Y&apos;
AND p.lifecycle_policy_id = lp.lifecycle_policy_id
AND lp.lifecycle_policy_id = lpd.lifecycle_policy_id
AND lpd.storage_unit_id = su.storage_unit_id (+)
AND lpd.volume_pool_id = vp.volume_pool_id (+)
GROUP BY
p.policy_id,
p.lifecycle_policy_id,
lp.lifecycle_policy_name
UNION
SELECT DISTINCT
&apos;Schedule&apos; lp_source,
p.policy_id,
s.lifecycle_policy_id,
lp.lifecycle_policy_name,
MAX(lpd.destination_index_nbr) nbr_of_destinations,
rtd.collectString(CAST(COLLECT(TO_CHAR(
  &apos;Copy: &apos;
  ||
  lpd.destination_index_nbr
  ||&apos; - &apos;||
  DECODE(lpd.used_for,
    0,&apos;Backup&apos;,
    1,&apos;Duplication&apos;,
    2,&apos;Snapshot&apos;,
    3,&apos;Remote Server Duplication&apos;,
    4,&apos;Import&apos;,
    5,&apos;Backup Snapshot&apos;,
    6,&apos;Index Snapshot&apos;,
    7,&apos;Replication&apos;) 
  ||&apos; - Retain: &apos;||
  DECODE(lpd.retention_days,
    9999,&apos;Never Expires&apos;,
    -1,&apos;Expires Immediately&apos;,
    null,&apos; &apos;,
   lpd.retention_days||&apos; Days&apos;)
  ||&apos; - Store to: &apos;||
  su.storage_unit_label
  ||&apos; &apos;||
  vp.volume_pool_name
) ORDER BY lpd.destination_index_nbr) AS StringListType),&apos;&lt;br&gt;&apos;) slp_config
FROM
apt_v_nbu_policy p, apt_v_nbu_lifecycpolicy_dest lpd, apt_v_nbu_lifecycle_policy lp, 
apt_v_nbu_storage_unit su, apt_v_nbu_volume_pool vp, apt_v_nbu_schedule s
WHERE
p.server_id IN (${hosts}) 
AND p.is_active = &apos;Y&apos;
AND p.policy_id = s.policy_id
AND s.lifecycle_policy_id = lp.lifecycle_policy_id
AND p.lifecycle_policy_id IS NULL
AND lp.lifecycle_policy_id = lpd.lifecycle_policy_id
AND lpd.storage_unit_id = su.storage_unit_id (+)
AND lpd.volume_pool_id = vp.volume_pool_id (+)
GROUP BY
p.policy_id,
s.lifecycle_policy_id,
lp.lifecycle_policy_name
)
SELECT
p1.server_id,
p1.master_server_name,
p1.client_id,
p1.client_name,
p1.policy_id,
p1.policy_name,
p1.policy_type_name,
p1.is_active,
pf1.directives,
s1.sched_config,
c1.lp_source,
c1.lifecycle_policy_id,
NVL(c1.lifecycle_policy_name,&apos;No Lifecycle Policy&apos;) lifecycle_policy_name,
c1.nbr_of_destinations,
c1.slp_config
FROM
p1, pf1, s1, c1
WHERE
p1.policy_id = pf1.policy_id (+)
AND p1.policy_id = s1.policy_id (+)
AND p1.policy_id = c1.policy_id (+)</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
