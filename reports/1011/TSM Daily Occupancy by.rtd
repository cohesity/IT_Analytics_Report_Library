          <entry>
            <string>dataSource</string>
            <string>
--Author: rich.rose@aptare.com    Date: 07/07/2011
--
--
WITH t1 as (
SELECT to_char(poll_date,&apos;MM/DD/YY&apos;) poll_date,
host_name tcp_client_name, 
node_name node,
node_name||&apos; - &apos;||storage_pool_name node_storage_pool,
node_name||&apos; - &apos;||filespace_name node_filespace,
storage_pool_name storage_pool,
filespace_name filespace,
storage_pool_name,  
(stg_pool_phy_mbytes/1024) size_gb
FROM apt_v_tsm_occupancy_log
WHERE poll_date BETWEEN ${startDate} AND ${endDate}
AND client_id in (${hosts})
)
SELECT poll_date, to_char(${freeCombo1}) unit,sum(size_gb) size_gb
FROM t1
GROUP BY poll_date, to_char(${freeCombo1})</string>
          </entry>
        </data>
