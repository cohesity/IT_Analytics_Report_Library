            <string>designerScript</string>
            <null/>
          </entry>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 04/02/2018
WITH 
var AS (
SELECT 
DECODE(&#039;${freeCombo2}&#039;,&#039;Total IO&#039;,1,&#039;Read IO&#039;,2,&#039;Write IO&#039;,3,&#039;Read Latency&#039;,5,&#039;Write Latency&#039;,6) top_by,
DECODE(&#039;${freeCombo3}&#039;,&#039;1x&#039;,1,&#039;5x&#039;,5,&#039;10x&#039;,10,&#039;15x&#039;,15,&#039;20x&#039;,20,&#039;25x&#039;,25,&#039;30x&#039;,30,&#039;35x&#039;,35,&#039;40x&#039;,40,&#039;45x&#039;,45,&#039;50x&#039;,50,&#039;55x&#039;,55,&#039;60x&#039;,60,&#039;65x&#039;,65,&#039;70x&#039;,70,&#039;75x&#039;,75,&#039;80x&#039;,80,&#039;85x&#039;,85,&#039;90x&#039;,90,&#039;95x&#039;,95,&#039;100x&#039;,100) threshold
FROM
dual
),
t1 AS (
SELECT 
storage_array_id,
array_name,
logical_unit_id,
logical_unit_name,
MAX(read_io) max_read_io,
AVG(read_io) avg_read_io,
MAX(write_io) max_write_io,
AVG(write_io) avg_write_io,
MAX(total_io) max_total_io,
AVG(total_io) avg_total_io,
MAX(read_io_response_time) max_read_io_response,
AVG(read_io_response_time) avg_read_io_response,
MAX(write_io_response_time) max_write_io_response,
AVG(write_io_response_time) avg_write_io_response
FROM aps_v_lun_perform_log pl, var
WHERE pl.storage_array_id IN (${arrays})
AND log_date BETWEEN ${startDate} AND ${endDate}
GROUP BY
storage_array_id,
array_name, 
logical_unit_id,
logical_unit_name
ORDER BY 
DECODE(&#039;${freeCombo2}&#039;,&#039;Total IO&#039;,MAX(total_io),&#039;Read IO&#039;,MAX(read_io),&#039;Write IO&#039;,MAX(write_io),&#039;Read Latency&#039;,MAX(read_io_response_time),&#039;Write Latency&#039;,MAX(write_io_response_time))  DESC
),
h1 AS (
SELECT
sp.logical_unit_id,
aptStringConcat(DISTINCT h.host_name) host_names
FROM
t1, aps_v_storage_path sp, aps_v_host h
WHERE sp.host_id = h.host_id
AND t1.logical_unit_id = sp.logical_unit_id
GROUP BY sp.logical_unit_id
)
SELECT 
t1.storage_array_id,
t1.array_name,
t1.logical_unit_id,
t1.logical_unit_name,
t1.avg_read_io,
t1.max_read_io,
(max_read_io / DECODE(avg_read_io,0,NULL,avg_read_io)) moa_read_io,
CASE 
WHEN(max_read_io / DECODE(avg_read_io,0,NULL,avg_read_io)) &gt; threshold  THEN &#039;red&#039; 
WHEN(max_read_io / DECODE(avg_read_io,0,NULL,avg_read_io)) &lt; threshold  THEN &#039;green&#039;
ELSE &#039;white&#039;
END read_io_dot,
t1.avg_write_io,
t1.max_write_io,
(max_write_io / DECODE(avg_write_io,0,NULL,avg_write_io)) moa_write_io,
CASE 
WHEN(max_write_io / DECODE(avg_write_io,0,NULL,avg_write_io)) &gt; threshold  THEN &#039;red&#039; 
WHEN(max_write_io / DECODE(avg_write_io,0,NULL,avg_write_io)) &lt; threshold  THEN &#039;green&#039;
ELSE &#039;white&#039; 
END write_io_dot,
t1.avg_read_io_response,
t1.max_read_io_response,
(max_read_io_response / DECODE(avg_read_io_response,0,NULL,avg_read_io_response)) moa_read_io_response,
CASE 
WHEN(max_read_io_response / DECODE(avg_read_io_response,0,NULL,avg_read_io_response)) &gt; threshold  THEN &#039;red&#039; 
WHEN(max_read_io_response / DECODE(avg_read_io_response,0,NULL,avg_read_io_response)) &lt; threshold  THEN &#039;green&#039; 
ELSE &#039;white&#039; 
END read_io_response_dot,
t1.avg_write_io_response,
t1.max_write_io_response,
(max_write_io_response / DECODE(avg_write_io_response,0,NULL,avg_write_io_response)) moa_write_io_response,
CASE 
WHEN(max_write_io_response / DECODE(avg_write_io_response,0,NULL,avg_write_io_response)) &gt; threshold  THEN &#039;red&#039; 
WHEN(max_write_io_response / DECODE(avg_write_io_response,0,NULL,avg_write_io_response)) &lt; threshold  THEN &#039;green&#039; 
ELSE &#039;white&#039; 
END write_io_response_dot,
h1.host_names 
FROM t1, h1, var
WHERE 
ROWNUM &lt;= ${freeCombo1}
--AND NVL(t1.max_total_io,0) &gt; 0
AND t1.logical_unit_id = h1.logical_unit_id (+)
ORDER BY 
DECODE(&#039;${freeCombo2}&#039;,&#039;Read IO&#039;,max_read_io,&#039;Write IO&#039;,max_write_io,&#039;Read Latency&#039;,max_read_io_response,&#039;Write Latency&#039;,max_write_io_response)  DESC</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
