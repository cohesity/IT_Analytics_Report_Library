<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 01/28/2012
WITH 
t1 AS (
SELECT 
to_char(trunc(nss.mirror_timestamp,DECODE(&#039;${freeCombo1}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;)),&#039;YYYY-MM-DD&#039;) the_date,
max(nss.summary_status) status,
sum(DECODE(nss.summary_status,2,1,0)) failed,
sum(DECODE(nss.summary_status,1,1,0)) partial,
sum(DECODE(nss.summary_status,0,1,0)) success
FROM 
aps_v_nap_snapvault_config nsc,
aps_v_nap_snapvault_status nss
WHERE
nsc.nap_snapvault_config_id = nss.nap_snapvault_config_id (+)
AND nss.mirror_timestamp BETWEEN ${startDate} AND ${endDate}
AND nsc.source_system_name LIKE DECODE(&#039;${queryCombo1}&#039;,&#039; All&#039;,&#039;%&#039;,&#039;${queryCombo1}&#039;)
AND nsc.source_storage_system_id IS NULL
GROUP BY
to_char(trunc(nss.mirror_timestamp,DECODE(&#039;${freeCombo1}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;)),&#039;YYYY-MM-DD&#039;)
)
SELECT
the_date,
success,
partial,
failed
FROM t1
ORDER BY the_date DESC</string>
          </entry>
