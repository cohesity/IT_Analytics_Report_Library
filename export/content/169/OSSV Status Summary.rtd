                    <string>SELECT &#039; All&#039;, &#039; All&#039; FROM dual UNION SELECT DISTINCT source_system_name,source_system_name FROM aps_v_nap_snapvault_config WHERE source_storage_system_id is null</string>
                  </entry>
                  <entry>
                    <string>queryComboValues1</string>
                    <string>SELECT &#039; All&#039;, &#039; All&#039; FROM dual UNION SELECT DISTINCT source_system_name,source_system_name FROM aps_v_nap_snapvault_config WHERE source_storage_system_id is null</string>
                  </entry>
