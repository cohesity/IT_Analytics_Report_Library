<com.aptare.sc.dal.versioning.ObjectMap>
  <version>1</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>SELECT vmw_datastore_id, datastore_name, file_path,file_name, file_size/1024/1024 file_size_gb, last_updated
FROM apt_v_vmw_vmfile_not_inventory
WHERE datastore_name LIKE DECODE(&#039;${queryCombo1}&#039;,&#039;All&#039;,&#039;%&#039;,&#039;${queryCombo1}&#039;)
ORDER BY file_size DESC</string>
          </entry>
          <entry>
            <string>designerScript</string>
            <null/>
          </entry>
          <entry>
            <string>advancedComponents</string>
            <list/>
          </entry>
          <entry>
            <string>systemName</string>
            <null/>
          </entry>
          <entry>
            <string>supportsPagenation</string>
            <null/>
          </entry>
          <entry>
            <string>descriptiveName</string>
            <string>VM Files Not in Inventory</string>
          </entry>
          <entry>
            <string>drilldown</string>
            <boolean>false</boolean>
          </entry>
          <entry>
            <string>postReportInterceptor</string>
            <null/>
          </entry>
          <entry>
            <string>specalisedReportBuilder</string>
            <null/>
          </entry>
          <entry>
            <string>encodedDataSource</string>
            <null/>
          </entry>
          <entry>
            <string>productsSupported</string>
            <null/>
          </entry>
          <entry>
            <string>designerComponents</string>
            <list>
              <com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
                <name>freeQueryCombo</name>
                <componentScript>
                  <before/>
                  <after/>
                </componentScript>
                <configuration>
                  <entry>
                    <string>sql</string>
                    <string>SELECT &#039;All&#039; datastore_name, &#039;All&#039; datastore_name FROM apt_v_vmw_vmfile_not_inventory UNION SELECT DISTINCT  datastore_name, datastore_name FROM apt_v_vmw_vmfile_not_inventory</string>
                  </entry>
                  <entry>
                    <string>queryComboValues1</string>
                    <string>SELECT &#039;All&#039; datastore_name, &#039;All&#039; datastore_name FROM apt_v_vmw_vmfile_not_inventory UNION SELECT DISTINCT  datastore_name, datastore_name FROM apt_v_vmw_vmfile_not_inventory</string>
                  </entry>
                  <entry>
                    <string>queryComboHeading1</string>
                    <string>Datastore...</string>
                  </entry>
                </configuration>
                <referenceData/>
              </com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
            </list>
          </entry>
          <entry>
            <string>composedReports</string>
            <null/>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
    <entry>
      <string>authorUserId</string>
      <long>100020</long>
    </entry>
    <entry>
      <string>reportDecorator</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDecorator</className>
        <data>
          <entry>
            <string>headers</string>
            <list/>
          </entry>
          <entry>
            <string>renderType</string>
            <com.aptare.sc.domain.report.enumerations.RenderType>table</com.aptare.sc.domain.report.enumerations.RenderType>
          </entry>
          <entry>
            <string>groupBySuppressHeaders</string>
            <null/>
          </entry>
          <entry>
            <string>spanningCaptions</string>
            <list/>
          </entry>
          <entry>
            <string>eventNotFoundComment</string>
            <null/>
          </entry>
          <entry>
            <string>chartWidth</string>
            <int>0</int>
          </entry>
          <entry>
            <string>cacheDataFields</string>
            <null/>
          </entry>
          <entry>
            <string>displayScope</string>
            <boolean>true</boolean>
          </entry>
          <entry>
            <string>leftTitle</string>
            <string></string>
          </entry>
          <entry>
            <string>columns</string>
            <list>
              <com.aptare.sc.domain.report.ColumnDecorator>
                <type>hidden</type>
                <caption>vmw_datastore_id</caption>
                <fieldName>vmw_datastore_id</fieldName>
                <fieldIndex>0</fieldIndex>
                <align>right</align>
                <formatPattern>#,##0</formatPattern>
                <drillDown></drillDown>
                <rowCount>0</rowCount>
              </com.aptare.sc.domain.report.ColumnDecorator>
              <com.aptare.sc.domain.report.ColumnDecorator>
                <caption>Datastore</caption>
                <fieldName>datastore_name</fieldName>
                <fieldIndex>0</fieldIndex>
                <drillDown>systemName=vmDatastoreDetail&amp;datastoreId=${row[&#039;vmw_datastore_id&#039;]}&amp;datastoreIds=${row[&#039;vmw_datastore_id&#039;]} </drillDown>
                <rowCount>0</rowCount>
              </com.aptare.sc.domain.report.ColumnDecorator>
              <com.aptare.sc.domain.report.ColumnDecorator>
                <caption>Path</caption>
                <fieldName>file_path</fieldName>
                <fieldIndex>0</fieldIndex>
                <drillDown></drillDown>
                <rowCount>0</rowCount>
              </com.aptare.sc.domain.report.ColumnDecorator>
              <com.aptare.sc.domain.report.ColumnDecorator>
                <caption>File Name</caption>
                <fieldName>file_name</fieldName>
                <fieldIndex>0</fieldIndex>
                <drillDown></drillDown>
                <rowCount>0</rowCount>
              </com.aptare.sc.domain.report.ColumnDecorator>
              <com.aptare.sc.domain.report.ColumnDecorator>
                <caption>Size (GB)</caption>
                <fieldName>file_size_gb</fieldName>
                <fieldIndex>0</fieldIndex>
                <align>right</align>
                <formatter>NumberFormatter</formatter>
                <formatPattern>#,##.##</formatPattern>
                <aggregation>sum</aggregation>
                <drillDown></drillDown>
                <rowCount>0</rowCount>
              </com.aptare.sc.domain.report.ColumnDecorator>
              <com.aptare.sc.domain.report.ColumnDecorator>
                <caption>Last Updated</caption>
                <fieldName>last_updated</fieldName>
                <fieldIndex>0</fieldIndex>
                <formatter>DateFormatter</formatter>
                <formatPattern>MMM dd, yyyy hh:mm:ssa</formatPattern>
                <drillDown></drillDown>
                <rowCount>0</rowCount>
              </com.aptare.sc.domain.report.ColumnDecorator>
            </list>
          </entry>
          <entry>
            <string>chartHeight</string>
