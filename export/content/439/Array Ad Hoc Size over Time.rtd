            <string>designerScript</string>
            <null/>
          </entry>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 10/24/2018
WITH 
VAR AS (
SELECT
&#039;${freeCombo1}&#039; unit,
DECODE(&#039;${freeCombo1}&#039;,&#039;GB&#039;,1,&#039;TB&#039;,1024,&#039;PB&#039;,1024*1024) div_by
FROM dual
),
t1 AS (--get one entry per day per array
SELECT 
TRUNC(log_date,DECODE(&#039;${freeCombo2}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;,&#039;YY&#039;)) log_date,
storage_array_id,
MAX(
DECODE(&#039;${freeCombo3}&#039;,
&#039;Cache&#039;,Cache_GB,
&#039;Capacity&#039;,Capacity_GB,
&#039;Allocated&#039;,Allocated_GB,
&#039;Available&#039;,Available_GB,
&#039;Largest Free Space&#039;,Largest_Free_Space_GB,
&#039;Raw Capacity&#039;,Raw_Capacity_GB,
&#039;Raw Allocated&#039;,Raw_Allocated_GB,
&#039;Raw Available&#039;,Raw_Available_GB,
&#039;Virtual Capacity&#039;, Virtual_Capacity_GB,
&#039;Known Virtual Capacity&#039;,Known_Virtual_Capacity_GB,
&#039;License Capacity&#039;, License_Capacity_GB,
&#039;Usable Internal Capacity&#039;,Usable_Internal_Capacity_GB,
&#039;Usable External Capacity&#039;,Usable_External_Capacity_GB,
&#039;Virtualized Capacity&#039;,Virtualized_Capacity_GB,
&#039;Virtualized Capacity Thin&#039;,Virtualized_Capacity_Thin_GB,
&#039;Usable Used Capacity&#039;,Usable_Used_Capacity_GB,
&#039;Usable Free Capacity&#039;,Usable_Free_Capacity_GB,
&#039;LUN Capacity&#039;,LUN_Capacity_GB,
&#039;LUN Allocated&#039;,LUN_Allocated_GB,
&#039;LUN Unallocated&#039;,LUN_Unallocated_GB,
&#039;Thin Pool Capacity&#039;,Thin_Pool_Capacity_GB,
&#039;Thin Pool Allocated&#039;,Thin_Pool_Allocated_GB,
&#039;Thin Pool Available&#039;,Thin_Pool_Available_GB,
&#039;Thin Pool Subscribed&#039;,Thin_Pool_Subscribed_GB)
) the_max_value,
AVG(
DECODE(&#039;${freeCombo3}&#039;,
&#039;Cache&#039;,Cache_GB,
&#039;Capacity&#039;,Capacity_GB,
&#039;Allocated&#039;,Allocated_GB,
&#039;Available&#039;,Available_GB,
&#039;Largest Free Space&#039;,Largest_Free_Space_GB,
&#039;Raw Capacity&#039;,Raw_Capacity_GB,
&#039;Raw Allocated&#039;,Raw_Allocated_GB,
&#039;Raw Available&#039;,Raw_Available_GB,
&#039;Virtual Capacity&#039;, Virtual_Capacity_GB,
&#039;Known Virtual Capacity&#039;,Known_Virtual_Capacity_GB,
&#039;License Capacity&#039;, License_Capacity_GB,
&#039;Usable Internal Capacity&#039;,Usable_Internal_Capacity_GB,
&#039;Usable External Capacity&#039;,Usable_External_Capacity_GB,
&#039;Virtualized Capacity&#039;,Virtualized_Capacity_GB,
&#039;Virtualized Capacity Thin&#039;,Virtualized_Capacity_Thin_GB,
&#039;Usable Used Capacity&#039;,Usable_Used_Capacity_GB,
&#039;Usable Free Capacity&#039;,Usable_Free_Capacity_GB,
&#039;LUN Capacity&#039;,LUN_Capacity_GB,
&#039;LUN Allocated&#039;,LUN_Allocated_GB,
&#039;LUN Unallocated&#039;,LUN_Unallocated_GB,
&#039;Thin Pool Capacity&#039;,Thin_Pool_Capacity_GB,
&#039;Thin Pool Allocated&#039;,Thin_Pool_Allocated_GB,
&#039;Thin Pool Available&#039;,Thin_Pool_Available_GB,
&#039;Thin Pool Subscribed&#039;,Thin_Pool_Subscribed_GB)
) the_avg_value
FROM aps_v_storage_array_log
WHERE
log_date BETWEEN ${startDate} AND ${endDate}
AND storage_array_id IN (${arrays})
GROUP BY
TRUNC(log_date,DECODE(&#039;${freeCombo2}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;,&#039;YY&#039;)),
storage_array_id
)
SELECT
log_date,
ROUND(SUM(the_max_value/div_by),2) the_max_value,
ROUND(SUM(the_avg_value/div_by),2) the_avg_value
FROM t1, var
GROUP BY 
log_date
ORDER BY 1</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
