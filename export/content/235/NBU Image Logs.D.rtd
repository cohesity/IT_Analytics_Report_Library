  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 09/20/2012
--Drilldown templateName is: NBUImageLogs.D
SELECT 
m.hostname master_server,
c.hostname client,
l.trans_date,
l.backup_id image_id,
DECODE(l.trans_type,&#039;D&#039;,&#039;Duplication&#039;,&#039;E&#039;,&#039;Expiration&#039;,&#039;P&#039;,&#039;Primary Change&#039;) trans_type,
DECODE(l.was_successful,&#039;Y&#039;,&#039;Successful&#039;,&#039;N&#039;,&#039;Failed&#039;,&#039;Unknown&#039;) status_name,
DECODE(l.was_successful,&#039;Y&#039;,&#039;blue&#039;,&#039;N&#039;,&#039;red&#039;,&#039;white&#039;) status_dot,
l.msg_log
FROM 
apt_v_nbu_image_log l,  apt_v_server c, apt_v_server m
WHERE 
backup_id = &#039;${BackupID}&#039;
AND l.client_id = c.server_id
AND l.server_id = m.server_id</string>
          </entry>
