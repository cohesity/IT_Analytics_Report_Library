          <entry>
            <string>designerScript</string>
            <null/>
          </entry>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified 09/20/2018
SELECT 
h3p_storage_system_id,
system_name,
tier1_dsp_name,
tier2_dsp_name,
tier3_dsp_name,
snap_dsp_name,
user_dsp_name,
logical_unit_id,
logical_unit_name,
(NVL(tier1_user_kb,0)+NVL(tier2_user_kb,0)+NVL(tier3_user_kb,0))/1024/1024 t1t2t3_user_gb,
is_compression_enabled,
is_dedup_enabled,
--
ROUND(NVL(dedup_ratio,1),1) dedup_ratio_num,
ROUND(NVL(dedup_ratio,1),1)||&apos;:1&apos; dedup_ratio,
CEIL(DECODE(dedup_ratio,NULL,1,0,1,dedup_ratio))||&apos;:1&apos; dedup_ratio_norm,
--
ROUND(NVL(compression_ratio,1),1) compression_ratio_num,
ROUND(NVL(compression_ratio,1),1)||&apos;:1&apos; compression_ratio,
CEIL(DECODE(compression_ratio,NULL,1,0,1,compression_ratio))||&apos;:1&apos; compression_ratio_norm,
--
ROUND(NVL(compaction_ratio,1),1) compaction_ratio_num,
ROUND(NVL(compaction_ratio,1),1)||&apos;:1&apos; compaction_ratio,
CEIL(DECODE(compaction_ratio,NULL,1,0,1,compaction_ratio))||&apos;:1&apos; compaction_ratio_norm,
--
total_capacity_gb,
--
raw_admin_gb,
raw_copy_gb,
raw_user_gb,
raw_blocks_gb,
--
consumable_admin_gb,
consumable_copy_gb,
consumable_user_gb,
--
used_snapshot_admin_space_gb,
used_snapshot_data_space_gb,
used_user_space_gb,
--
tier1_admin_kb/1024/1024 tier1_admin,
tier2_admin_kb/1024/1024 tier2_admin,
tier3_admin_kb/1024/1024 tier3_admin,
--
tier1_snapshot_kb/1024/1024 tier1_snapshot,
tier2_snapshot_kb/1024/1024 tier2_snapshot,
tier3_snapshot_kb/1024/1024 tier3_snapshot,
--
tier1_user_kb/1024/1024 tier1_user,
tier2_user_kb/1024/1024 tier2_user,
tier3_user_kb/1024/1024 tier3_user,
--
date_created,
master_node,
backup_node1,
backup_node2,
lun_policy,
preferred_availability,
current_availability,
export_state,
disk_device_type,
--
snap_space_allocation_warning,
snap_space_allocation_limit,
user_space_allocation_warning,
user_space_allocation_limit,
--
lun_domain,
set_size,
set_data,
expiration_time,
retention_time,
lun_operational_status||&apos; - &apos;||lun_other_operational_status lun_operational_status,
volume_type,
lun_access,
is_underlying_redundancy,
data_redundancy,
package_redundancy,
name_format,
name_space,
is_thinly_provisioned,
device_nbr,
object_id,
usr_array_group_id,
snp_array_group_id,
vcopy_base_logical_unit_id,
--
tier1_array_group_id,
tier2_array_group_id,
tier3_array_group_id,
--
tier1_new_admin_kb/1024/1024 tier1_new_admin,
tier2_new_admin_kb/1024/1024 tier2_new_admin,
tier3_new_admin_kb/1024/1024 tier3_new_admin,
--
tier1_new_snapshot_kb/1024/1024 tier1_new_snapshot,
tier2_new_snapshot_kb/1024/1024 tier2_new_snapshot,
tier3_new_snapshot_kb/1024/1024 tier3_new_snapshot,
--
tier1_new_user_kb/1024/1024 tier1_new_user,
tier2_new_user_kb/1024/1024 tier2_new_user,
tier3_new_user_kb/1024/1024 tier3_new_user,
--compaction_ratio_str,
--compression_ratio_str,
--dedup_ratio_str,
last_updated
FROM
aps_v_h3p_logical_unit
WHERE 
h3p_storage_system_id IN (${arrays})
AND CEIL(DECODE(dedup_ratio,NULL,1,0,1,dedup_ratio))||&apos;:1&apos; LIKE DECODE(&apos;${queryCombo1}&apos;,&apos; All&apos;,&apos;%&apos;,&apos;${queryCombo1}&apos;)
AND CEIL(DECODE(compression_ratio,NULL,1,0,1,compression_ratio))||&apos;:1&apos; LIKE DECODE(&apos;${queryCombo2}&apos;,&apos; All&apos;,&apos;%&apos;,&apos;${queryCombo2}&apos;)
AND is_dedup_enabled LIKE DECODE(&apos;${freeCombo1}&apos;,&apos;All&apos;,&apos;%&apos;,&apos;${freeCombo1}&apos;)
AND is_compression_enabled LIKE DECODE(&apos;${freeCombo2}&apos;,&apos;All&apos;,&apos;%&apos;,&apos;${freeCombo2}&apos;)</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
