      <string>reportGuid</string>
      <string>49411ba9-1e12-4613-952a-1957788dd7fd</string>
    </entry>
    <entry>
      <string>inventoryCategory</string>
      <long>5</long>
    </entry>
    <entry>
      <string>description</string>
      <string>*09/20/2018 List of LUNs with a way to filter on DeDup ratio and if Compression and DeDup are enabled</string>
    </entry>
    <entry>
      <string>exportName</string>
      <string>HPE 3PAR LUN List with Filter for DeDup &amp; Compression</string>
    </entry>
    <entry>
      <string>version</string>
      <double>0.0</double>
    </entry>
    <entry>
      <string>products</string>
      <list>
        <long>241</long>
      </list>
    </entry>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>drilldown</string>
            <boolean>false</boolean>
          </entry>
          <entry>
            <string>designerComponents</string>
            <list>
              <com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
                <name>scope</name>
                <componentScript>
                  <before/>
                  <after/>
                </componentScript>
                <configuration>
                  <entry>
                    <string>nodes</string>
                    <string>ARRAYS</string>
                  </entry>
                </configuration>
                <referenceData/>
              </com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
              <com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
                <name>freeCombo</name>
                <componentScript>
                  <before/>
                  <after/>
                </componentScript>
                <configuration>
                  <entry>
                    <string>freeComboHeading2</string>
                    <string>Is Compression Enabled:</string>
                  </entry>
                  <entry>
                    <string>freeComboValues2</string>
                    <string>Yes,No,All</string>
                  </entry>
                  <entry>
                    <string>freeComboHeading1</string>
                    <string>Is DeDup Enabled:</string>
                  </entry>
                  <entry>
                    <string>freeComboValues1</string>
                    <string>Yes,No,All</string>
                  </entry>
                  <entry>
                    <string>freeComboDefaultValue1</string>
                    <string>All</string>
                  </entry>
                  <entry>
                    <string>freeComboDefaultValue2</string>
                    <string>All</string>
                  </entry>
                </configuration>
                <referenceData/>
              </com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
              <com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
                <name>freeQueryCombo</name>
                <componentScript>
                  <before/>
                  <after/>
                </componentScript>
                <configuration>
                  <entry>
                    <string>queryComboDefaultValue1</string>
                    <string> All</string>
                  </entry>
                  <entry>
                    <string>queryComboDefaultValue2</string>
                    <string>All</string>
                  </entry>
                  <entry>
                    <string>queryComboValues1</string>
                    <string>SELECT &apos; All&apos; the_key, &apos; All&apos; the_value FROM apt_v_dual UNION SELECT DISTINCT CEIL(DECODE(dedup_ratio,NULL,1,0,1,dedup_ratio))||&apos;:1&apos; the_key , CEIL(DECODE(dedup_ratio,NULL,1,0,1,dedup_ratio))||&apos;:1&apos;  the_value FROM aps_v_h3p_logical_unit ORDER BY 1</string>
                  </entry>
                  <entry>
                    <string>queryComboValues2</string>
                    <string>SELECT &apos; All&apos; the_key, &apos; All&apos; the_value FROM apt_v_dual UNION SELECT DISTINCT CEIL(DECODE(compression_ratio,NULL,1,0,1,compression_ratio))||&apos;:1&apos; the_key , CEIL(DECODE(compression_ratio,NULL,1,0,1,compression_ratio))||&apos;:1&apos;  the_value FROM aps_v_h3p_logical_unit ORDER BY 1</string>
                  </entry>
                  <entry>
                    <string>queryComboHeading2</string>
                    <string>Compression Ratio:</string>
                  </entry>
                  <entry>
                    <string>queryComboHeading1</string>
                    <string>DeDup Ratio:</string>
                  </entry>
                  <entry>
                    <string>sql</string>
                    <string>SELECT &apos; All&apos; the_key, &apos; All&apos; the_value FROM apt_v_dual UNION SELECT DISTINCT CEIL(DECODE(compression_ratio,NULL,1,0,1,compression_ratio))||&apos;:1&apos; the_key , CEIL(DECODE(compression_ratio,NULL,1,0,1,compression_ratio))||&apos;:1&apos;  the_value FROM aps_v_h3p_logical_unit ORDER BY 1</string>
                  </entry>
                </configuration>
                <referenceData/>
              </com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
            </list>
          </entry>
          <entry>
            <string>descriptiveName</string>
            <string>HPE 3PAR LUN List with Filter for DeDup &amp; Compression</string>
          </entry>
