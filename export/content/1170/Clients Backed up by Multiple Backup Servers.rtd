          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 09/16/2015
SELECT
client_id,
client_name,
COUNT(DISTINCT server_id) server_count,
aptStringConcat(DISTINCT product_type_name) backup_products,
aptStringConcat(DISTINCT server_name) backup_servers
FROM apt_v_job
WHERE client_id IN (${hosts})
AND start_date BETWEEN ${startDate} AND ${endDate}
GROUP BY 
client_id,
client_name
HAVING COUNT(DISTINCT server_id) &gt; 1</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
