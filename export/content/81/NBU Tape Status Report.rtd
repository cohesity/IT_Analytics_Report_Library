          <entry>
            <string>designerComponents</string>
            <list>
              <com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
                <name>freeCombo</name>
                <componentScript>
                  <before/>
                  <after/>
                </componentScript>
                <configuration>
                  <entry>
                    <string>freeComboValues1</string>
                    <string>All,#0,#1,#2,Outside Library</string>
                  </entry>
                  <entry>
                    <string>freeComboHeading1</string>
                    <string>Library:</string>
                  </entry>
                </configuration>
                <referenceData/>
              </com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
              <com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
                <name>freeQueryCombo</name>
                <componentScript>
                  <before/>
                  <after/>
                </componentScript>
                <configuration>
                  <entry>
                    <string>queryComboValues1</string>
                    <string>SELECT 999 server_id, &#039;All&#039; hostname FROM DUAL UNION ALL SELECT server_id,lower(hostname) hostname FROM apt_v_server WHERE server_type_name=&#039;NetBackup Master&#039; ORDER BY 2</string>
                  </entry>
                  <entry>
                    <string>queryComboHeading1</string>
                    <string>Master Server:</string>
                  </entry>
                </configuration>
                <referenceData/>
              </com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
            </list>
          </entry>
          <entry>
            <string>composedReports</string>
            <null/>
          </entry>
        </data>
