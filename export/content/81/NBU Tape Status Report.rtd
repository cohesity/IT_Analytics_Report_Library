<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>
--Author: rich.rose@aptare.com
--Last Modified: 05/10/2012
SELECT 
ntm.server_id,
s.hostname as &quot;master server&quot;,
nvl(tl.library_id,999) library_id,
nvl(tl.library_name,&#039;Outside Library&#039;) library_name,
count(ntm.tape_media_id) total_tapes,
sum(DECODE(ntm.vendor_media_status, &#039;1&#039;,1,0)) Available,
sum(DECODE(ntm.vendor_media_status, &#039;2&#039;,1,0)) Assigned,
sum(DECODE(ntm.vendor_media_status, &#039;3&#039;,1,0)) Frozen,
sum(DECODE(ntm.vendor_media_status, &#039;4&#039;,1,0)) Suspended,
sum(DECODE(ntm.vendor_media_status, &#039;5&#039;,1,0)) Imported,
sum(DECODE(ntm.vendor_media_status, &#039;6&#039;,1,0)) Full,
sum(DECODE(ntm.vendor_media_status, &#039;7&#039;,1,0)) Expired,
sum(DECODE(ntm.vendor_media_status, &#039;8&#039;,1,0)) Catalog,
sum(DECODE(ntm.vendor_media_status, &#039;9&#039;,1,0)) Cleaning,
sum(DECODE(ntm.vendor_media_status, &#039;0&#039;,1,0)) Unknown
FROM apt_v_nbu_tape_media ntm,apt_v_server s,apt_v_tape_library tl
WHERE ntm.server_id = s.server_id
AND ntm.server_id = DECODE(${queryCombo1},999,ntm.server_id,${queryCombo1})
AND ntm.library_id = tl.library_id (+)
AND &#039;${freeCombo1}&#039; IN 
  CASE 
    WHEN &#039;${freeCombo1}&#039; NOT IN (&#039;All&#039;) THEN
      CASE
        WHEN tl.library_name IS NULL THEN &#039;Outside Library&#039;
        WHEN tl.library_name LIKE &#039;%#0%&#039; THEN &#039;#0&#039;
        WHEN tl.library_name LIKE &#039;%#1%&#039; THEN &#039;#1&#039;
        WHEN tl.library_name LIKE &#039;%#2%&#039; THEN &#039;#2&#039;
        WHEN tl.library_name LIKE &#039;%#3%&#039; THEN &#039;#3&#039;
        WHEN tl.library_name LIKE &#039;%#4%&#039; THEN &#039;#4&#039;
      END
   ELSE &#039;All&#039;
 END
GROUP BY
ntm.server_id,
s.hostname,
nvl(tl.library_id,999),
nvl(tl.library_name,&#039;Outside Library&#039;)</string>
          </entry>
