          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 03/20/2018
WITH 
var AS (
SELECT
DECODE(&apos;${freeCombo2}&apos;,&apos;KB&apos;,1,&apos;MB&apos;,1024,&apos;GB&apos;,(1024*1024),&apos;TB&apos;,(1024*1024*1024),&apos;PB&apos;,(1024*1024*1024*1024)) div_by 
FROM apt_v_dual
),
t1 AS (
SELECT
server_name,
client_name,
group_name,
COUNT(*) nbr_of_jobs,
MAX(Scanned_kb/div_by) max_scanned,
SUM(new_kb/div_by) AS new_data
FROM apt_v_avm_activities,var
WHERE 
client_id IN (${hosts})
AND start_date BETWEEN ${startDate} AND ${endDate}
AND group_name &lt;&gt; &apos;none&apos;
GROUP BY 
server_name, 
client_name, 
group_name
ORDER BY  
SUM(new_kb) DESC
),
t2 AS (
SELECT
server_name,
client_name,
REPLACE(aptStringConcat(DISTINCT group_name),&apos;,&apos;,&apos;&lt;br&gt;&apos;) the_groups,
COUNT(nbr_of_jobs) nbr_of_jobs,
MAX(max_scanned) max_scanned,
SUM(new_data) AS new_data
FROM t1
GROUP BY
server_name,
client_name
ORDER BY
new_data DESC
)
SELECT * 
FROM t2
WHERE ROWNUM &lt;= ${freeCombo1} </string>
          </entry>
        </data>
