          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 10/22/2018
WITH 
VAR AS (
SELECT
&#039;${freeCombo1}&#039; unit,
DECODE(&#039;${freeCombo1}&#039;, &#039;GB&#039;,(1024*1024),&#039;TB&#039;,(1024*1024*1024),&#039;PB&#039;,(1024*1024*1024*1024)) div_by
FROM dual
),
v1 AS (
SELECT /*+ NO_MERGE */ DISTINCT
vf.vm_id,
vf.storage_array_id
FROM apt_v_vmw_vmfile vf
WHERE
vf.storage_array_id IN (${arrays})
),
t1 AS (
SELECT /*+ NO_MERGE */
TRUNC(log_date,DECODE(&#039;${freeCombo2}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;,&#039;YY&#039;)) log_date,
gal.vm_id,
ROUND(MAX(gal.vm_size_kb/div_by),2) max_vm_size,
ROUND(MAX(gal.total_volume_size_kb/div_by),2) max_total_volume_size,
ROUND(MAX(gal.used_volume_size_kb/div_by),2) max_used_volume_size
FROM
apt_v_vmw_guest_allocusage_log gal, v1, var
WHERE
gal.vm_id = v1.vm_id 
AND gal.log_date BETWEEN ${startDate} AND ${endDate}
GROUP BY 
TRUNC(log_date,DECODE(&#039;${freeCombo2}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;,&#039;YY&#039;)),
gal.vm_id
ORDER BY 1,2
)
SELECT /*+ NO_MERGE */
log_date,
COUNT(DISTINCT vm_id) vm_count,
SUM(max_vm_size) max_vm_size,
SUM(max_used_volume_size) max_used_volume_size,
SUM(max_total_volume_size) max_total_volume_size,
SUM(max_total_volume_size)-SUM(max_used_volume_size) max_free_volume_size
FROM t1
GROUP BY
log_date
ORDER BY log_date</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
