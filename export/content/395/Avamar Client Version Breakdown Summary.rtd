          </entry>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 06/11/2018
WITH 
var AS (
SELECT &#039;${freeText1}&#039; the_version FROM DUAL
),
t1 AS (
SELECT
ac.client_id,
ac.agent_version,
SUBSTR(ac.agent_version,1,3) short_version
FROM apt_v_avm_clients ac, var
WHERE 
ac.client_id IN (${hosts})
AND ac.backup_date BETWEEN ${startDate} AND ${endDate}
AND agent_version NOT LIKE &#039;%unKnown%&#039;
AND agent_version NOT LIKE &#039;%Unknown%&#039;
AND agent_version IS NOT NULL
)
SELECT
DECODE(&#039;${freeCombo1}&#039;,&#039;Normalized&#039;,short_version,&#039;Detailed&#039;,agent_version) version_name,
COUNT(*) version_count
FROM t1
GROUP BY 
DECODE(&#039;${freeCombo1}&#039;,&#039;Normalized&#039;,short_version,&#039;Detailed&#039;,agent_version)
ORDER BY 2 DESC</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
