          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 09/13/2018
WITH
VAR AS (
SELECT
DECODE(&#039;${freeCombo1}&#039;, &#039;KB&#039;,1,&#039;MB&#039;,1024,&#039;GB&#039;,(1024*1024),&#039;TB&#039;,(1024*1024*1024),&#039;PB&#039;,(1024*1024*1024*1024)) div_by 
FROM dual 
),
sw AS (
SELECT
t.target_storage_array_id storage_array_id,
aptStringConcat(DISTINCT sw.switch_id) switch_ids,
aptStringConcat(DISTINCT sw.element_name) switches
FROM aps_v_swi_topology t, aps_v_swi_switch sw
WHERE
t.source_switch_id = sw.switch_id 
AND t.target_storage_array_id IS NOT NULL
GROUP BY t.target_storage_array_id
)
SELECT
vf.host_id,vf.host_name,
vd.partition_id, vd.partition_name,
vd.virtual_system_id, vd.virtual_system_name,
vd.vmw_datastore_id, vd.datastore_name,
vd.disk_label,
vd.rdisk_lun_name,
vd.is_thin_provisioned,
vd.file_path,
vd.file_name,
vf.file_size/div_by file_size,
vf.storage_array_id, vf.array_name,
vf.logical_unit_id, vf.logical_unit_name,
sw.switch_ids,
REPLACE(sw.switches,&#039;,&#039;,&#039;&lt;br&gt;&#039;) switches
FROM apt_v_vmw_virtual_disk vd, apt_v_vmw_vmfile vf, sw, var
WHERE
vd.disk_type = &#039;RDISK&#039;
AND vd.vmw_datastore_id = vf.vmw_datastore_id
AND vd.partition_id = vf.partition_id
AND vd.file_name = vf.file_name
AND vf.file_type = &#039;VmDisk&#039;
AND vf.storage_array_id = sw.storage_array_id (+)
AND vf.partition_id IN (${vmGuests})</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
