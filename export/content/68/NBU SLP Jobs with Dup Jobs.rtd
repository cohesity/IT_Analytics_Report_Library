<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 05/07/1012
WITH t1 as ( --If the path is an image then it&#039;s a dup Job
SELECT jf.pathname image_id
FROM  apt_v_nbu_job_file jf, apt_v_nbu_job j
WHERE jf.pathname = j.backup_id
AND j.start_date BETWEEN ${startDate} AND ${endDate}
AND j.client_id IN (${hosts})
),
t2 as ( --The base job
SELECT j.job_id, j.backup_id,j.nbu_job_id backup_nbu_job_id, j.master_host_name,
j.client_id,j.client_host_name backup_client,
j.policy_id,j.policy_name,
j.schedule_name,j.job_type_name,j.kilobytes/1024 data_mb,
j.nbr_of_files, j.mbytes_sec,
j.start_date backup_start_date,
j.finish_date backup_end_date,
j.expiration_date backup_expiration, j.storage_unit_label backup_storage_unit
FROM apt_v_nbu_job_detail j,t1
WHERE j.backup_id = t1.image_id
),
t3 as ( --The Dup Job
SELECT jf.job_id,j.nbu_job_id dup_nbu_job_id, jf.pathname, 
j.client_id dup_client, 
np.policy_id dup_job_policy_id, 
np.policy_name dup_job_policy_name, 
np.lifecycle_policy_name,
su.storage_unit_label dup_storage_unit,
j.start_date dup_start_date, 
j.finish_date dup_end_date, 
j.vendor_state_name state
FROM  apt_v_nbu_job_file jf, t1, apt_v_nbu_job j, apt_v_nbu_policy np, apt_v_nbu_storage_unit su
WHERE jf.pathname = t1.image_id
AND jf.job_id = j.job_id
AND j.policy_id = np.policy_id
AND j.storage_unit_id = su.storage_unit_id (+)
) 
SELECT 
t2.job_id backup_job_id, backup_nbu_job_id, 
t2.master_host_name, 
t2.client_id,t2.backup_client,
t2.policy_id, t2.policy_name, 
t2.schedule_name, t2.job_type_name, 
t2.backup_expiration, t2.backup_id,  backup_storage_unit, 
backup_start_date, backup_end_date,
t2.data_mb,
t2.nbr_of_files, t2.mbytes_sec,
t3.job_id dup_job_id, dup_nbu_job_id, t3.dup_client, 
t3.dup_job_policy_id, t3.dup_job_policy_name,t3.lifecycle_policy_name,
t3.dup_storage_unit,
t3.dup_start_date, t3.dup_end_date, 
rtd.secsToHoursMinSecs((t3.dup_start_date - t2.backup_end_date)*24*60*60) elapsed_since_bkup, 
t3.state,
jtm.copy_index, jtm.expiration_date dup_expiration_date
FROM t2,t3,apt_v_nbu_job_tape_media jtm
WHERE t2.backup_id = t3.pathname
AND t2.job_id = jtm.job_id</string>
          </entry>
