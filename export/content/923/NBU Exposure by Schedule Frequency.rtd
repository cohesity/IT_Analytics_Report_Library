          <entry>
            <string>dataSource</string>
            <string>
--Author: rich.rose@aptare.com
--Last Modified: 05/25/2012
--Determines the recovery point of a backup and shows true exposure based on the 
--expirarion of the image.
WITH 
t1 AS (
SELECT DISTINCT 
pc.client_id, 
pc.client_name, 
pc.server_id,
s.hostname master_server,
pc.policy_id, 
pc.policy_name,
DECODE(pc.is_active,&apos;Y&apos;,&apos;Yes&apos;,&apos;N&apos;,&apos;No&apos;) is_active, 
DECODE(sc.selection_type,1,&apos;Frequency Based Schedule&apos;,2,&apos;Calendar Based Schedule&apos;)  selection_type, 
sc.schedule_id,
sc.schedule_name schedule_name, 
sc.frequency seconds, 
DECODE(
sc.frequency,3600,&apos;Every Hour&apos;,
7200,&apos;Every 2 Hours&apos;,
64800,&apos;Every 18 Hours&apos;,
72000,&apos;Every 20 Hours&apos;,
82800,&apos;Every 23 Hours&apos;,
86400,&apos;Every Day&apos;,
345600,&apos;Every 4 Days&apos;,
604800,&apos;Every 7 Days&apos;,
21168000,&apos;Every 245 Days&apos;,
NULL,&apos;Calendar&apos;) frequency, 
DECODE(sc.schedule_type,
0,&apos;Full Backup&apos;,
1,&apos;Cumulative Incremantal&apos;,
2,&apos;Application Backup&apos;,
4,&apos;Differential Incremental&apos;,
5,&apos;Archive&apos;) as &quot;Backup Type&quot; , 
sc.retention_days,
sc.retention_days||&apos; Days&apos; Retain_Data_For 
FROM apt_v_server s, apt_v_server c, 
apt_v_nbu_schedule sc, apt_v_nbu_policy_client pc 
WHERE pc.client_id IN (${hosts})
AND pc.client_id = c.server_id
AND pc.server_id = s.server_id 
AND pc.policy_id = sc.policy_id (+)
ORDER BY pc.client_name
),
t2 AS (
SELECT 
lnb.server_id,
lnb.client_id,
lnb.schedule_id,
max(lnb.job_id) last_job_id
FROM apt_v_last_nbu_backup lnb,apt_v_last_client_job lcj, t1
WHERE lcj.job_id = lnb.job_id
AND lnb.server_id = t1.server_id 
AND lnb.client_id = t1.client_id  
AND lnb.schedule_id = t1.schedule_id
AND lcj.summary_status &lt; 2
GROUP BY
lnb.server_id,
lnb.client_id,
lnb.schedule_id
),
t3 AS (
SELECT
nj.job_id,
nj.finish_date last_good_backup_date,
nj.duration_secs
FROM apt_v_nbu_job nj,t2
WHERE nj.job_id = t2.last_job_id
) 
SELECT 
t1.server_id,
t1.master_server,
t1.client_id, 
client_name, 
policy_id, 
policy_name,
is_active, 
schedule_name, 
selection_type, 
t1.schedule_id,
seconds, 
frequency, 
retain_data_for,
last_good_backup_date,
rtd.secsToHoursMinSecs(t3.duration_secs) duration,
(sysdate + (t3.duration_secs/60/60/24)) earliest_recovery_date,
CASE 
WHEN retention_days - (sysdate-last_good_backup_date) &gt; 0 THEN to_char(trunc(retention_days - (sysdate-last_good_backup_date)))
ELSE &apos;Too Late&apos;
END days_left,
CASE  
WHEN (retention_days - (sysdate-last_good_backup_date)) &gt; 0 THEN &apos;green&apos; 
WHEN (retention_days - (sysdate-last_good_backup_date)) = 0 THEN &apos;white&apos; 
WHEN (retention_days - (sysdate-last_good_backup_date)) &lt; 0 THEN &apos;red&apos;
END 
status
FROM t1, t2, t3
WHERE t1.server_id = t2.server_id 
AND t1.client_id = t2.client_id  
AND t1.schedule_id = t2.schedule_id
AND t3.job_id = t2.last_job_id</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
