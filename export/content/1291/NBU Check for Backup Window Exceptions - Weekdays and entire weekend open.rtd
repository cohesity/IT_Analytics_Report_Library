          <entry>
            <string>dataSource</string>
            <string>-- Author: ernie.bergan@veritas.com
-- Last Modified January 12, 2024
-- Added selection of specific job types.
/*  NBU job types as of 2022/08/12 - list in APT_JOB_TYPE  ---
101	Full Backup
102	Differential Incr Backup
137	Cumulative Incr Backup
103	Catalog Backup
112	Application Backup
104	Archive
105	Restore
106	Verify
107	Duplication
108	Import
109	Vault
110	Label
111	Media Erase
113	Tape Mount Request
114	Tape Drive Cleaning
115	Format Optical Media
116	Inventory Library
117	DB Recovery
118	Media Listing
119	Qualification
120	Live Update
121	Replication Duplicate
122	Replication Import
123	Replication (Snapshot)
130	Snapshot
124	Snap Index
125	Backup From Snapshot
126	Import (Snapshot)
127	Application State Capture
128	Indexing
129	Index Cleanup
131	Activate Instant Recovery
132	Deactivate Instant Recovery
133	Reactivate Instant Recovery
134	Stop Instant Recovery
135	Instant Recovery
136	Image Cleanup
138	Automatic Schedule
139	RMAN Catalog
140	Lock VM
141	Deployment
142	Instant Access
143	Cloud Snapshot Replication
*/
-- Last Modified July 17, 2022
-- Removed incorrect call against apt_v_job_detail
-- Added check to exclude jobs without finish_date
-- Added faster logic for NBU policy name resolution

-- Previously Modified June 27, 2022
-- Added regular date and scoping
-- Removed any restrictions on rows returns, added primary server, client, policy, job types to each row.

-- Original report logic was hardcoded to:
-- Computations for Backup windows that are defined:
-- Monday 5 PM to 7 AM next day  (day of week = 1)
-- Tuesday 5 PM to 7 AM next day (day of week = 2)
-- Wednesday 5 PM to 7 AM next day
-- Thursday 5 PM to 7 AM next day  (day of week= 4)
-- Friday 5 PM to 7 AM Monday  (day of week=5:Friday 6:Saturday 7: Sunday
--
-- IMPORTANT:  Jobs that start in the blackout window for a given day will be flagged that their backup window --opened at 5 PM of the next backup window
-- Any job exceeding 24 hours duration will be flagged in job_finish_check.
With t1 as (
select job_id from apt_v_job where start_date between ${startDate} and ${endDate} --sysdate-30 and sysdate
and finish_date is not null
and client_id in (${hosts})
AND job_type in (101,102,103,137,112,121,122)
),
sliced AS (
SELECT 
1 + TRUNC(j.start_date) - TRUNC(j.start_date,&apos;IW&apos;) Day_of_week_int,
DECODE((1 + TRUNC(j.start_date) - TRUNC(j.start_date,&apos;IW&apos;)),1,&apos;MON&apos;,2,&apos;TUE&apos;,3,&apos;WED&apos;,4,&apos;THU&apos;,5,&apos;FRI&apos;,6,&apos;SAT&apos;,7,&apos;SUN&apos;) day_of_week_start,
DECODE((1 + TRUNC(j.finish_date) - TRUNC(j.finish_date,&apos;IW&apos;)),1,&apos;MON&apos;,2,&apos;TUE&apos;,3,&apos;WED&apos;,4,&apos;THU&apos;,5,&apos;FRI&apos;,6,&apos;SAT&apos;,7,&apos;SUN&apos;) day_of_week_finish,
DECODE((1 + TRUNC(j.start_date) - TRUNC(j.start_date,&apos;IW&apos;)),5,&apos;Weekend&apos;,6,&apos;Weekend&apos;,7,&apos;Weekend&apos;,&apos;Weekday&apos;) week_day_or_end,
j.start_date,
j.finish_date,
to_char(j.start_date,&apos;DD-MON-YY HH24:MI:SS&apos;) start_date_char,
to_char(j.finish_date,&apos;DD-MON-YY HH24:MI:SS&apos;) finish_date_char,
CASE -- Compute backup window opening
WHEN 1 + TRUNC(j.start_date) - TRUNC(j.start_date,&apos;IW&apos;) = 1 THEN --Monday 
  CASE WHEN (j.start_date - TRUNC(j.start_date)) &lt; ${freeText2}/24 THEN  --Window opened previous Friday at 5 PM
  trunc(j.start_date) - ${freeText2}/24 - 2
  ELSE -- after the blackout window.  Start window at end of blackout
  trunc(j.start_date) + ${freeText3}/24
  END 
WHEN 1 + TRUNC(j.start_date) - TRUNC(j.start_date,&apos;IW&apos;) between 2 AND 4 THEN --Tuesday thru Thursday
  CASE WHEN (j.start_date - TRUNC(j.start_date)) &lt; ${freeText2}/24 THEN  --same day as window closes
  trunc(j.start_date) - ${freeText2}/24 
  ELSE -- after the blackout window.  Start window at end of blackout window
  trunc(j.start_date) + ${freeText3}/24
  END 
ELSE  -- A Friday, Saturday, or Sunday, so backup window begins Friday at end of blackout 
  CASE WHEN (j.start_date - TRUNC(j.start_date)) &lt; ${freeText2}/24 THEN  
  trunc(j.start_date) - ${freeText2}/24 - (TRUNC(j.start_date) - TRUNC(j.start_date,&apos;IW&apos;) - 5)
  ELSE -- after the blackout window.  Start window at end of blackout
  trunc(j.start_date) + ${freeText3}/24 - ((1 + TRUNC(j.start_date) - TRUNC(j.start_date,&apos;IW&apos;) - 5))
  END 
END window_opens,

CASE 
WHEN (1 + TRUNC(j.start_date) - TRUNC(j.start_date,&apos;IW&apos;)) = 1 THEN -- Monday
  CASE WHEN (j.start_date - TRUNC(j.start_date)) &lt; ${freeText2}/24 THEN  --same day as window closes, before window close
    trunc(j.start_date) + ${freeText2}/24
  ELSE -- after the blackout window.  Start window at blackout the next day
    trunc(j.start_date) + 1 + ${freeText2}/24
  END
WHEN (1 + TRUNC(j.start_date) - TRUNC(j.start_date,&apos;IW&apos;)) between 2 AND 4 THEN --Tuesday thru Thursday
  CASE WHEN (j.start_date - TRUNC(j.start_date)) &lt; ${freeText2}/24 THEN  --same day as window closes, before window close
    trunc(j.start_date) + ${freeText2}/24
  ELSE -- after the blackout window.  Start window at end of blackout next day
    trunc(j.start_date) + 1 + ${freeText2}/24
  END
ELSE -- A Friday, Saturday, or Sunday, so backup window ends Monday at beginning of blackout
    trunc(j.start_date) + ${freeText2}/24 + (8 - (1 + TRUNC(j.start_date) - TRUNC(j.start_date,&apos;IW&apos;)))
END window_closes,

CASE WHEN (j.start_date - TRUNC(j.start_date)) between ${freeText2}/24 and ${freeText3}/24 AND DECODE((1 + TRUNC(j.start_date) - TRUNC(j.start_date,&apos;IW&apos;)),1,&apos;MON&apos;,2,&apos;TUE&apos;,3,&apos;WED&apos;,4,&apos;THU&apos;,5,&apos;FRI&apos;,6,&apos;SAT&apos;,7,&apos;SUN&apos;) NOT IN (&apos;SAT&apos;,&apos;SUN&apos;) THEN
   &apos;Job Start in Blackout Window&apos;
ELSE
   &apos;No violation&apos;
END Job_start_check,

CASE WHEN j.finish_date-j.start_date &gt; 1 THEN
   &apos;Job ran more than 24 hours&apos;
WHEN (j.finish_date - TRUNC(j.finish_date)) between ${freeText2}/24 and ${freeText3}/24 AND DECODE((1 + TRUNC(j.finish_date) - TRUNC(j.finish_date,&apos;IW&apos;)),1,&apos;MON&apos;,2,&apos;TUE&apos;,3,&apos;WED&apos;,4,&apos;THU&apos;,5,&apos;FRI&apos;,6,&apos;SAT&apos;,7,&apos;SUN&apos;) NOT IN (&apos;SAT&apos;,&apos;SUN&apos;) THEN
   &apos;Job Finish in Blackout Window&apos;
ELSE
   &apos;No violation&apos;
END Job_finish_check,
t1.job_id,
j.server_name,
j.client_name,
j.job_type_name
from apt_v_job j, t1
where j.job_id = t1.job_id 
)
--select * from sliced
,pname as (
select t1.job_id, policy_name
FROM t1, apt_v_nbu_job_detail jd
WHERE t1.job_id = jd.job_id
)
--select * from pname;
select day_of_week_int,day_of_week_start,week_day_or_end, start_date,window_opens,
finish_date, day_of_week_finish,window_closes, job_start_check, job_finish_check,
CASE WHEN finish_date &gt; window_closes then
&apos;Job finishes after window closed&apos;
ELSE
&apos;OK&apos;
END Post_Process_window_chk,
s.job_id,
server_name,
client_name,
policy_name,
job_type_name
from sliced s, pname
WHERE s.job_id = pname.job_id (+)
--where job_start_check != &apos;No violation&apos;  OR job_finish_check != &apos;No violation&apos; OR j.finish_date &gt; window_closes
order by start_date, client_name</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
    <entry>
