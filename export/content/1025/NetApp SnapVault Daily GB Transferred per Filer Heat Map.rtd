          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 06/14/2012
WITH t1 AS (
SELECT
to_char(nss.mirror_timestamp,&apos;MM/DD/YYYY&apos;)  the_date,
nsc.source_system_name||&apos; &gt;&gt; &apos;||nsc.destination_system_name source_dest,
sum(nss.last_transfer_size_kb/1024/1024) last_transfer_size_gb
FROM
aps_v_nap_snapvault_config nsc,
aps_v_nap_snapvault_status nss
WHERE
nsc.nap_snapvault_config_id = nss.nap_snapvault_config_id (+)
AND nss.mirror_timestamp BETWEEN ${startDate} AND ${endDate}
AND to_char(nss.mirror_state) = &apos;snapvaulted&apos;
GROUP BY to_char(nss.mirror_timestamp,&apos;MM/DD/YYYY&apos;),
nsc.source_system_name||&apos; &gt;&gt; &apos;||nsc.destination_system_name
),

t2 AS (
SELECT source_dest,
avg(last_transfer_size_gb) avg_transfer_size_gb
FROM t1
GROUP BY source_dest
)
SELECT
t1.the_date,
t1.source_dest,
CASE WHEN t1.last_transfer_size_gb &gt; t2.avg_transfer_size_gb+(t2.avg_transfer_size_gb*(${freeCombo1}/100)) THEN &apos;&lt;font color=red&gt;&apos;||to_char(t1.last_transfer_size_gb,&apos;999,999,999.99&apos;)||&apos;&lt;/font&gt;&apos;
ELSE to_char(t1.last_transfer_size_gb,&apos;999,999,999.99&apos;) END last_transfer_size_gb
FROM t1,t2
WHERE
t1.source_dest = t2.source_dest
ORDER by 1 DESC</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
