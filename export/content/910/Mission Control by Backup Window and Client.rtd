          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 06/14/2012
WITH
t1 as (--Seed the backup window dates based on the window_id from the dropdown
SELECT start_date, finish_date  
FROM TABLE(rtd.ListOfBackupWindowDates(${startDate},${endDate},${queryCombo1})) bw
),
t2 as ( 
SELECT 
t1.start_date, t1.finish_date,
j.client_name,
DECODE(min(summary_status),0,&apos;green&apos; ,1,&apos;green&apos;,2,&apos;red&apos;,&apos;white&apos;) status
FROM apt_v_job j,t1
WHERE j.start_date BETWEEN t1.start_date AND t1.finish_date
AND t1.start_date &gt;= ${startDate}
AND j.client_id IN (${hosts})
AND j.job_type_name like &apos;%Backup&apos;
GROUP BY  
t1.start_date, t1.finish_date,
j.client_name
)
SELECT 
to_char(start_date,&apos;MM/DD/YY&apos;)||&apos;&lt;br/&gt;&apos;||to_char(start_date,&apos;hh:mm&apos;)||&apos;-&apos;||to_char(finish_date,&apos;hh:mm&apos;) window,
client_name,
status
FROM t2</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
