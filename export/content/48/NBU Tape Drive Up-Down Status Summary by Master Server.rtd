<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 07/04/2012
WITH t1 AS (
SELECT
tl.master_host_name,
COUNT(DISTINCT tl.library_id) libraries,
SUM(CASE WHEN td.drive_status_name IN (&#039;Down&#039;,&#039;Unknown&#039;) THEN 1 ELSE 0 END) down_count,
SUM(CASE WHEN td.drive_status_name IN (&#039;Up&#039;,&#039;Up OPR Mode&#039;) THEN 1 ELSE 0 END) up_count
FROM apt_v_nbu_tape_drive td, apt_v_nbu_tape_library tl
WHERE td.library_id = tl.library_id
AND tl.server_id IN (${hosts})
GROUP BY tl.master_host_name
HAVING count(td.drive_id) &gt; 0
)
SELECT 
master_host_name,
libraries,
(up_count+down_count) total_drives,
up_count,
down_count,
round(down_count/(up_count+down_count+.0001)*100,2) down_pct,
CASE WHEN round(down_count/(up_count+down_count+.0001)*100,2) &gt; ${freeCombo1} THEN &#039;red&#039; ELSE &#039;green&#039; END down_dot
FROM t1
ORDER BY 6 DESC</string>
          </entry>
