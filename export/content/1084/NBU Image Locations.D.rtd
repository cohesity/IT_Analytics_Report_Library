          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 09/20/2012
--Drilldown templateName is: NBUImageLocations.D
WITH t1 as (
SELECT t.copy_index, &apos;Tape&apos; media_type, t.tape_media_id media_id, m.media_name, 
jtm.kilobytes written_kilobytes, t.expired_copy, 
t.expiration_date, g.volume_group_name,j.backup_id
FROM
apt_v_nbu_job j,
apt_v_job_tape_media jtm,
apt_v_nbu_job_tape_media t,
apt_v_tape_media m,
apt_v_nbu_tape_media mn,
apt_v_nbu_volume_group g
WHERE jtm.job_id = j.job_id
AND j.backup_id = &apos;${BackupID}&apos;
AND jtm.job_id  = t.job_id
AND j.client_id IN (${hosts})
AND jtm.tape_media_id  = t.tape_media_id
AND t.tape_media_id    = m.tape_media_id
AND m.tape_media_id    = mn.tape_media_id
AND mn.volume_group_id = g.volume_group_id(+)
UNION
SELECT d.copy_index, &apos;Disk&apos; media_type, NULL media_id, &apos;Disk Path&apos; media_name, 
d.written_kilobytes, d.expired_copy, d.expiration_date, NULL volume_group_name,j.backup_id
FROM apt_v_nbu_job j, apt_v_nbu_job_disk_media d
WHERE d.job_id = j.job_id
AND j.backup_id = &apos;${BackupID}&apos;
AND j.client_id IN (${hosts})
)
SELECT t1.*,
(SELECT count(backup_id) FROM apt_v_nbu_image_log WHERE backup_id = &apos;${BackupID}&apos; ) image_logs
FROM t1</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
