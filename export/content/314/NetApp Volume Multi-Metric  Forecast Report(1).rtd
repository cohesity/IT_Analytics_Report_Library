                </componentScript>
                <configuration>
                  <entry>
                    <string>freeComboValues1</string>
                    <string>Day,Week,Month,Quarter,Year</string>
                  </entry>
                  <entry>
                    <string>freeComboValues2</string>
                    <string>PB,TB,GB,MB,KB</string>
                  </entry>
                  <entry>
                    <string>freeComboHeading1</string>
                    <string>Group by:</string>
                  </entry>
                  <entry>
                    <string>freeComboHeading2</string>
                    <string>Values in:</string>
                  </entry>
                </configuration>
                <referenceData/>
              </com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
              <com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
                <name>freeQueryCombo</name>
                <componentScript>
                  <before/>
                  <after/>
                </componentScript>
                <configuration>
                  <entry>
                    <string>sql</string>
                    <string>SELECT &#039; All&#039; system_name, &#039; All&#039; system_name FROM dual UNION ALL SELECT DISTINCT system_name, system_name FROM aps_v_nap_volume</string>
                  </entry>
                  <entry>
                    <string>queryComboValues1</string>
                    <string>SELECT &#039; All&#039; system_name, &#039; All&#039; system_name FROM dual UNION ALL SELECT DISTINCT system_name, system_name FROM aps_v_nap_volume</string>
                  </entry>
                  <entry>
                    <string>queryComboHeading1</string>
                    <string>Array:</string>
                  </entry>
                </configuration>
                <referenceData/>
              </com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
            </list>
          </entry>
