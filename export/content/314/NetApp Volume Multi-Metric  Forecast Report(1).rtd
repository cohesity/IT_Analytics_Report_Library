<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>descriptiveName</string>
            <string>NetApp Volume Multi-Metric  Forecast Report</string>
          </entry>
          <entry>
            <string>drilldown</string>
            <boolean>false</boolean>
          </entry>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 06/05/2014
--Computes the future capacity of an NetApp array based on 2 different methods
--Linear Regression (Linear) Sum of squares linear algorithm y=mX+b
--Period Over Period (POP) (Last period - first period) / nbr of periods
WITH 
d0 AS (
SELECT
DECODE(&#039;${freeCombo1}&#039;,&#039;Day&#039;,1,&#039;Week&#039;,7,&#039;Month&#039;,31,&#039;Quarter&#039;,93,&#039;Year&#039;,365.24) nbr_of_days,
&#039;${freeCombo1}&#039; the_group_by,
DECODE(&#039;${freeCombo2}&#039;,
&#039;KB&#039;,1,&#039;MB&#039;,(1024),&#039;GB&#039;,(1024*1024),&#039;TB&#039;,(1024*1024*1024),&#039;PB&#039;,(1024*1024*1024*1024)) div_by 
FROM dual
),
a0 as (
SELECT 
v.nap_storage_system_id, l.nap_volume_id,
TRUNC(l.log_date,DECODE(&#039;${freeCombo1}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;,&#039;YY&#039;)) log_date,
row_number() OVER (PARTITION BY v.nap_storage_system_id, l.nap_volume_id ORDER BY v.nap_storage_system_id, l.nap_volume_id) row_number,
MAX(l.available_size_kb/div_by)  available
FROM aps_v_nap_volume_log l,aps_v_nap_volume v, d0
WHERE l.log_date BETWEEN ${startDate} AND ${endDate}
AND l.nap_volume_id = v.nap_volume_id
AND v.system_name = DECODE(&#039;${queryCombo1}&#039;, &#039; All&#039;,v.system_name, &#039;${queryCombo1}&#039;)
--AND v.volume_name = &#039;AquaLogic_test&#039;
GROUP BY v.nap_storage_system_id, l.nap_volume_id,TRUNC(l.log_date,DECODE(&#039;${freeCombo1}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;,&#039;YY&#039;))
),
lin1 AS (--Get the Linear Growth statistics
SELECT 
nap_storage_system_id,
nap_volume_id,
ROUND(REGR_SLOPE(available,row_number),2) linear_trend,
REGR_R2(available,row_number) r2_value,
REGR_AVGX(available,row_number) avex,
REGR_AVGY(available,row_number)  avey,
REGR_INTERCEPT(available,row_number) y_intercept,
REGR_COUNT(available,row_number) period_count,
STDDEV(available)  stddev
FROM a0
GROUP BY nap_storage_system_id, nap_volume_id
),
pop1 AS (--Get the Period over Period Numbers
SELECT
a0.nap_storage_system_id, 
a0.nap_volume_id,
SUM(DECODE(a0.row_number,1,a0.available,0)) first_period_available,
SUM(DECODE(a0.row_number,lin1.period_count,a0.available,0)) last_period_available
FROM a0,lin1
WHERE a0.nap_storage_system_id = lin1.nap_storage_system_id
AND a0.nap_volume_id = lin1.nap_volume_id
AND a0.row_number IN (1,lin1.period_count) --Only get the first and last period numbers
GROUP BY a0.nap_storage_system_id, a0.nap_volume_id
),
pop2 AS (--Calculate the Period Over Period Growth
SELECT
lin1.nap_storage_system_id, 
lin1.nap_volume_id,
pop1.first_period_available,
pop1.last_period_available,
ROUND((pop1.last_period_available - pop1.first_period_available ) / lin1.period_count,2) pop_trend
FROM pop1,lin1
WHERE pop1.nap_storage_system_id = lin1.nap_storage_system_id
AND pop1.nap_volume_id = lin1.nap_volume_id
)
SELECT 
lin1.nap_storage_system_id,
v.system_name,
lin1.nap_volume_id,
v.volume_name,
pop2.first_period_available,
pop2.last_period_available,
v.available_size_kb/div_by curr_available,
v.last_updated,
lin1.avey average_available,
period_count,
pop_trend,
linear_trend,
CASE 
WHEN period_count &lt; 3 THEN null
WHEN pop_trend &gt; 0  THEN null
WHEN pop_trend &lt; 0  THEN ROUND(pop2.last_period_available/DECODE(ABS(pop_trend),0,null,ABS(pop_trend)),0) 
ELSE NULL
END pop_periods_left,
CASE 
WHEN period_count &lt; 3 THEN null
WHEN linear_trend &gt; 0  THEN null
WHEN linear_trend &lt; 0  THEN ROUND(pop2.last_period_available/DECODE(ABS(linear_trend),0,null,ABS(linear_trend)),0) 
ELSE NULL
END linear_periods_left,
r2_value*100 r2_value,
lin1.y_intercept,
CASE
WHEN pop_trend &lt; 0 THEN &#039;red&#039;
WHEN pop_trend = 0 THEN &#039;white&#039;
WHEN pop_trend &gt; 0 THEN &#039;green&#039;
END pop_status,
CASE
WHEN pop_trend &lt; 0 THEN &#039;Available Capacity Decreasing by &#039;||ABS(pop_trend)||&#039;(GB) &#039;||the_group_by||&#039; Over &#039;||the_group_by
WHEN pop_trend = 0 THEN &#039;Available Capacity Staying Flat &#039;||the_group_by||&#039; Over &#039;||the_group_by
WHEN pop_trend &gt; 0 THEN &#039;Available Capacity Increasing by &#039;||pop_trend||&#039;(GB) &#039;||the_group_by||&#039; Over &#039;||the_group_by
END pop_status_name,
CASE 
WHEN pop2.last_period_available &lt;= 0 THEN &#039;Already out of capacity&#039;
WHEN pop_trend = 0 THEN &#039;Not changing&#039;
WHEN period_count &lt; 3 THEN &#039;Not enough data to calculate&#039;
WHEN pop_trend &gt; 0 THEN &#039;Available capacity increased&#039;
WHEN pop_trend &lt; 0 THEN &#039;Will run out on:&#039;|| to_char(sysdate+(d0.nbr_of_days*pop2.last_period_available/DECODE(ABS(pop_trend),0,null,ABS(pop_trend))),&#039;MM/DD/YYYY&#039;)
END pop_date_of_concern,
CASE
WHEN linear_trend &lt; 0 THEN &#039;red&#039;
WHEN linear_trend = 0 THEN &#039;white&#039;
WHEN linear_trend &gt; 0 THEN &#039;green&#039;
END linear_status,
CASE
WHEN linear_trend &lt; 0 THEN &#039;Available Capacity Decreasing by &#039;||ABS(linear_trend)||&#039;(GB) &#039;||the_group_by||&#039; Over &#039;||the_group_by
WHEN linear_trend = 0 THEN &#039;Available Capacity Staying Flat &#039;||the_group_by||&#039; Over &#039;||the_group_by
WHEN linear_trend &gt; 0 THEN &#039;Available Capacity Increasing by &#039;||linear_trend||&#039;(GB) &#039;||the_group_by||&#039; Over &#039;||the_group_by
END linear_status_name,
CASE 
WHEN pop2.last_period_available/div_by &lt;= 0 THEN &#039;Already out of capacity&#039;
WHEN linear_trend = 0 THEN &#039;Not changing&#039;
WHEN period_count &lt; 3 THEN &#039;Not enough data to calculate&#039;
WHEN linear_trend &gt; 0 THEN &#039;Available capacity increased&#039;
WHEN linear_trend &lt; 0 THEN &#039;Will run out on:&#039;|| to_char(sysdate+(d0.nbr_of_days*pop2.last_period_available/DECODE(ABS(linear_trend),0,null,ABS(linear_trend))),&#039;MM/DD/YYYY&#039;)
END linear_date_of_concern,
d0.nbr_of_days, 
d0.the_group_by
FROM d0, lin1, pop2, aps_v_nap_volume v
WHERE lin1.nap_volume_id = v.nap_volume_id 
AND lin1.nap_storage_system_id = v.nap_storage_system_id
AND lin1.nap_volume_id = pop2.nap_volume_id
AND lin1.nap_storage_system_id = pop2.nap_storage_system_id
AND lin1.nap_volume_id = pop2.nap_volume_id</string>
          </entry>
