<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>descriptiveName</string>
            <string>NBU Images About to Expire with x Nbr of Copies</string>
          </entry>
          <entry>
            <string>drilldown</string>
            <boolean>false</boolean>
          </entry>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 11/06/2015
WITH t1 as (
SELECT 
j.backup_id,
count(j.job_id) num_copies
FROM apt_v_nbu_job j
WHERE j.client_id IN (${hosts})
AND j.backup_id is not null
AND &#039;${freeCombo1}&#039; IN 
  CASE 
    WHEN &#039;${freeCombo1}&#039; NOT IN (&#039;All&#039;) THEN
      CASE
        WHEN j.expiration_date IS NULL THEN  &#039;Null&#039;
        WHEN j.expiration_date &lt; sysdate THEN  &#039;Expired&#039;
        WHEN j.expiration_date BETWEEN sysdate AND sysdate+1 THEN  &#039;1 Day&#039; 
        WHEN j.expiration_date BETWEEN sysdate AND sysdate+2 THEN  &#039;2 Days&#039; 
        WHEN j.expiration_date BETWEEN sysdate AND sysdate+3 THEN  &#039;3 Days&#039; 
        WHEN j.expiration_date BETWEEN sysdate AND sysdate+7 THEN  &#039;7 Days&#039; 
        WHEN j.expiration_date BETWEEN sysdate AND sysdate+31 THEN  &#039;1 Month&#039; 
        WHEN j.expiration_date BETWEEN sysdate AND sysdate+93 THEN  &#039;3 Months&#039;
        WHEN j.expiration_date BETWEEN sysdate AND sysdate+186 THEN &#039;6 Months&#039;
        WHEN j.expiration_date BETWEEN sysdate AND sysdate+365.25 THEN &#039;1 Yr&#039;
        WHEN j.expiration_date &gt; sysdate+365.25 THEN &#039;Over 1 Yr&#039;
      END
   ELSE &#039;All&#039;
 END
GROUP BY j.backup_id
HAVING count(j.job_id) &gt; 1
),
t2 as (
SELECT 
j.backup_id,
count(j.job_id) num_copies
FROM apt_v_nbu_job j
WHERE j.client_id IN (${hosts})
AND j.backup_id is not null
AND &#039;${freeCombo1}&#039; IN 
  CASE 
    WHEN &#039;${freeCombo1}&#039; NOT IN (&#039;All&#039;) THEN
      CASE
        WHEN j.expiration_date IS NULL THEN  &#039;Null&#039;
        WHEN j.expiration_date &lt; sysdate THEN  &#039;Expired&#039;
        WHEN j.expiration_date BETWEEN sysdate AND sysdate+1 THEN  &#039;1 Day&#039; 
        WHEN j.expiration_date BETWEEN sysdate AND sysdate+2 THEN  &#039;2 Days&#039; 
        WHEN j.expiration_date BETWEEN sysdate AND sysdate+3 THEN  &#039;3 Days&#039; 
        WHEN j.expiration_date BETWEEN sysdate AND sysdate+7 THEN  &#039;7 Days&#039; 
        WHEN j.expiration_date BETWEEN sysdate AND sysdate+31 THEN  &#039;1 Month&#039; 
        WHEN j.expiration_date BETWEEN sysdate AND sysdate+93 THEN  &#039;3 Months&#039;
        WHEN j.expiration_date BETWEEN sysdate AND sysdate+186 THEN &#039;6 Months&#039;
        WHEN j.expiration_date BETWEEN sysdate AND sysdate+365.25 THEN &#039;1 Yr&#039;
        WHEN j.expiration_date &gt; sysdate+365.25 THEN &#039;Over 1 Yr&#039;
      END
   ELSE &#039;All&#039;
 END
GROUP BY j.backup_id
HAVING count(j.job_id) = 1
),
t3 as (
SELECT
j.client_id, 
j.backup_id, 
j.client_host_name,
j.expiration_date,
t1.num_copies,
j.expiration_date-sysdate expire_days,
j.finish_date
FROM apt_v_nbu_job j,t1
WHERE j.backup_id = t1.backup_id
UNION ALL
SELECT
DISTINCT
j.client_id, 
j.backup_id, 
j.client_host_name,
j.expiration_date,
t2.num_copies,
j.expiration_date-sysdate expire_days,
j.finish_date
FROM apt_v_nbu_job j,t2
WHERE j.backup_id = t2.backup_id
),
t4 as (
SELECT DISTINCT
client_id, 
backup_id, 
client_host_name,
finish_date,
expiration_date,
num_copies,
expire_days
FROM t3
WHERE &#039;${freeCombo2}&#039; IN 
  CASE 
    WHEN &#039;${freeCombo2}&#039; NOT IN (&#039;All&#039;) THEN
      CASE
        WHEN num_copies = 1  THEN &#039;1 Copy&#039;
        WHEN num_copies &gt; 1  THEN &#039;2 or More Copies&#039;
      END
   ELSE &#039;All&#039;
 END
)
SELECT 
client_id, 
backup_id, 
client_host_name,
finish_date,
expiration_date,
num_copies,
expire_days
FROM t4</string>
          </entry>
