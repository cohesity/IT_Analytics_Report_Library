          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 03/05/2011
WITH 
t1 AS (
SELECT
host_id,host_name,
&apos;DAS&apos; storage_type,
filesystem_capacity_kb/1024/1024 capacity_gb,
filesystem_used_kb/1024/1024 used_gb
FROM aps_v_file_system_path
WHERE mount_point IS NOT NULL
AND host_id IN (${hosts})
AND storage_type = &apos;D&apos;
UNION ALL
SELECT
host_id,host_name,
&apos;SAN&apos; storage_type,
filesystem_capacity_kb/1024/1024 capacity_gb,
filesystem_used_kb/1024/1024 used_gb
FROM aps_v_file_system_path
WHERE mount_point IS NOT NULL
AND host_id IN (${hosts})
AND storage_type = &apos;S&apos;
UNION ALL
SELECT DISTINCT
fs.host_id,fs.host_name,
&apos;NAS&apos; storage_type,
fs.capacity_kb/1024/1024 capacity_gb,
fs.used_kb/1024/1024 used_gb
FROM aps_v_file_system fs
WHERE 
fs.mount_point IS NOT NULL
AND fs.host_id in (${hosts})
AND fs.file_system_type LIKE &apos;nfs%&apos;
),
t2 AS (
SELECT
host_id,host_name,
SUM(DECODE(storage_type,&apos;DAS&apos;,capacity_gb,0)) das_capacity,
SUM(DECODE(storage_type,&apos;DAS&apos;,used_gb,0)) das_used,
SUM(DECODE(storage_type,&apos;SAN&apos;,capacity_gb,0)) san_capacity,
SUM(DECODE(storage_type,&apos;SAN&apos;,used_gb,0)) san_used,
SUM(DECODE(storage_type,&apos;NAS&apos;,capacity_gb,0)) nas_capacity,
SUM(DECODE(storage_type,&apos;NAS&apos;,used_gb,0)) nas_used
FROM t1
GROUP BY host_id,host_name
)
SELECT 
host_id,host_name,
das_capacity,
das_used,
(das_capacity - das_used) das_free,
DECODE(das_used,0,null,das_used)/das_capacity*100 das_used_pct,
DECODE(das_used,0,null,das_used)/das_capacity das_pct,
san_capacity,
san_used,
(san_capacity - san_used) san_free,
DECODE(san_used,0,null,san_used)/san_capacity*100 san_used_pct,
DECODE(san_used,0,null,san_used)/san_capacity san_pct,
nas_capacity,
nas_used,
(nas_capacity - nas_used) nas_free,
DECODE(nas_used,0,null,nas_used)/nas_capacity*100 nas_used_pct,
DECODE(nas_used,0,null,nas_used)/nas_capacity nas_pct
FROM t2</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
