<com.aptare.sc.dal.versioning.ObjectMap>
  <version>1</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>SELECT 
nvl(rtd.getObjectAttributeValue(storage_array_id,&#039;Site&#039;,&#039;A&#039;),&#039;Other&#039;) site,
count(DISTINCT host_id) nbr_of_hosts,
count(DISTINCT storage_array_id) nbr_of_arrays,
count(DISTINCT storage_domain_id) nbr_storage_domains,
sum(nbr_of_luns) nbr_of_luns,
sum(nbr_allocated_luns) nbr_allocated_luns,
sum(nbr_of_luns-nbr_allocated_luns) available_luns,
sum(total_capacity_kb/1024/1024/1024) total_capacity_tb
FROM aps_v_storage_path
GROUP BY nvl(rtd.getObjectAttributeValue(storage_array_id,&#039;Site&#039;,&#039;A&#039;),&#039;Other&#039;)</string>
          </entry>
          <entry>
            <string>designerScript</string>
            <null/>
          </entry>
