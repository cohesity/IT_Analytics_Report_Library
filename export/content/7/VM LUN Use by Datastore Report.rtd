          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 10/10/2018
--Minimum version required: 10.2.0
SELECT 
vm_host_id, 
vm_host_name, 
vmw_datastore_id, 
datastore_name,
storage_array_id, 
array_name,  
logical_unit_id, 
logical_unit_name,
file_name, 
SUM(file_size/1024) file_size
FROM 
apt_v_vmw_vmfile
WHERE
vmw_datastore_id IN (${datastores})
AND storage_array_id IS NOT NULL
GROUP BY
vm_host_id, 
vm_host_name, 
vmw_datastore_id, 
datastore_name,
storage_array_id, 
array_name,  
logical_unit_id, 
logical_unit_name,
file_name
ORDER BY vm_host_name</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
