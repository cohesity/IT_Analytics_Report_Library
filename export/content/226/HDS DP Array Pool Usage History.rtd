<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>WITH 
a0 as (
SELECT
trunc(log_date,DECODE(&#039;${freeCombo1}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;)) log_date,
array_name,
max(allocated_kb/1024/1024) allocated_gb,
max(unallocated_kb/1024/1024) unallocated_gb,
max(available_kb/1024/1024) available_gb,
max(capacity_kb/1024/1024) capacity_gb,
max(capacity_of_vvols_kb/1024/1024) capacity_of_vvols_gb,
max(touched_kb/1024/1024) touched_gb,
max(associated_warn_kb/1024/1024) associated_warn_gb,
max(allocated_warn_kb/1024/1024) allocated_warn_gb
FROM aps_v_hds_journal_pool_log
WHERE log_date BETWEEN ${startDate} AND ${endDate}
AND  array_name||&#039;-Pool:&#039;||pool_id = &#039;${queryCombo1}&#039;
AND array_name is not null
GROUP BY trunc(log_date,DECODE(&#039;${freeCombo1}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;)),array_name
HAVING max(allocated_kb) &gt; 0
)
SELECT to_char(log_date,&#039;MM/DD/YY&#039;) the_date,
a0.array_name,a0.allocated_gb,
a0.unallocated_gb,
a0.capacity_gb,
a0.capacity_of_vvols_gb, 
a0.touched_gb,
a0.available_gb,
a0.touched_gb + a0.available_gb associated_gb,
a0.associated_warn_gb,
a0.allocated_warn_gb
FROM a0</string>
          </entry>
          <entry>
            <string>designerScript</string>
            <null/>
          </entry>
          <entry>
            <string>advancedComponents</string>
            <list/>
          </entry>
          <entry>
            <string>systemName</string>
            <null/>
          </entry>
          <entry>
            <string>supportsPagenation</string>
            <null/>
          </entry>
          <entry>
