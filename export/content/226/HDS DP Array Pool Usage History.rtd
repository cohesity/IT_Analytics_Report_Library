          <entry>
            <string>designerComponents</string>
            <list>
              <com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
                <name>timePeriod</name>
                <componentScript>
                  <before/>
                  <after/>
                </componentScript>
                <referenceData/>
              </com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
              <com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
                <name>freeCombo</name>
                <componentScript>
                  <before/>
                  <after/>
                </componentScript>
                <configuration>
                  <entry>
                    <string>freeComboValues1</string>
                    <string>Day,Week,Month,Quarter,Year</string>
                  </entry>
                  <entry>
                    <string>freeComboHeading1</string>
                    <string>Group By:</string>
                  </entry>
                </configuration>
                <referenceData/>
              </com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
              <com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
                <name>freeQueryCombo</name>
                <componentScript>
                  <before/>
                  <after/>
                </componentScript>
                <configuration>
                  <entry>
                    <string>queryComboValues1</string>
                    <string>SELECT DISTINCT array_name||&#039;-Pool:&#039;||pool_id array_pool,array_name||&#039;-Pool:&#039;||pool_id array_pool_key FROM aps_v_hds_journal_pool_log order by upper(1)</string>
                  </entry>
                  <entry>
                    <string>queryComboHeading1</string>
                    <string>Array-Pool:</string>
                  </entry>
                </configuration>
                <referenceData/>
              </com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
            </list>
          </entry>
          <entry>
            <string>composedReports</string>
            <null/>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
