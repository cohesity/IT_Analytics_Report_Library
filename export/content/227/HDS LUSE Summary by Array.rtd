<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author:paul.hogan@aptare.com
--Last Updated: 10/4/2012
--This will list all LDEV&#039;s that make up a LUSE
WITH t1 AS
  (SELECT a.logical_unit_id,
    a.logical_unit_name,
    a.storage_array_id,
    c.device_nbr,
    c.array_name,
    c.capacity_gb ldev_capacity_gb,
    c.raid_type,
    c.array_group_name,
    a.dp_type,
    a.dp_pool_id,
    CASE
      WHEN a.logical_unit_name=SUBSTR(logical_unit_name,0,3)
        ||regexp_replace(SUBSTR(TO_CHAR(c.device_nbr,&#039;XXXX&#039;),-2,1)
        ||NVL(SUBSTR(TO_CHAR(c.device_nbr,&#039;XXXX&#039;),           -1,1),&#039;0&#039;),&#039; &#039;,&#039;0&#039;)
      THEN b.luse_capacity_gb
      ELSE NULL
    END luse_capacity_gb,
    CASE
      WHEN a.logical_unit_name=SUBSTR(logical_unit_name,0,3)
        ||regexp_replace(SUBSTR(TO_CHAR(c.device_nbr,&#039;XXXX&#039;),-2,1)
        ||NVL(SUBSTR(TO_CHAR(c.device_nbr,&#039;XXXX&#039;),           -1,1),&#039;0&#039;),&#039; &#039;,&#039;0&#039;)
      THEN c.path_exists
      ELSE NULL
    END allocated,
    --c.path_exists allocated,
    CASE
      WHEN a.logical_unit_name=SUBSTR(logical_unit_name,0,3)
        ||regexp_replace(SUBSTR(TO_CHAR(c.device_nbr,&#039;XXXX&#039;),-2,1)
        ||NVL(SUBSTR(TO_CHAR(c.device_nbr,&#039;XXXX&#039;),           -1,1),&#039;0&#039;),&#039; &#039;,&#039;0&#039;)
      THEN logical_unit_name
      ELSE NULL
    END luse_head,
    CASE
      WHEN a.logical_unit_name&lt;&gt;SUBSTR(logical_unit_name,0,3)
        ||regexp_replace(SUBSTR(TO_CHAR(c.device_nbr,&#039;XXXX&#039;),-2,1)
        ||NVL(SUBSTR(TO_CHAR(c.device_nbr,&#039;XXXX&#039;),           -1,1),&#039;0&#039;),&#039; &#039;,&#039;0&#039;)
      THEN logical_unit_name
      ELSE NULL
    END luse_sub,
    SUBSTR(logical_unit_name,0,3)
    ||regexp_replace(SUBSTR(TO_CHAR(c.device_nbr,&#039;XXXX&#039;),-2,1)
    ||NVL(SUBSTR(TO_CHAR(c.device_nbr,&#039;XXXX&#039;),           -1,1),&#039;0&#039;),&#039; &#039;,&#039;0&#039;) ldev
  FROM
    (SELECT *
    FROM aps_v_hds_ldev
    WHERE logical_unit_id IN
      (SELECT logical_unit_id
      FROM aps_v_hds_ldev
      GROUP BY logical_unit_id
      HAVING (COUNT(logical_unit_id ) &gt; 1)
      )
    ) c,
    (SELECT SUM(c.capacity_gb) luse_capacity_gb,
      a.logical_unit_id
    FROM
      (SELECT *
      FROM aps_v_hds_ldev
      WHERE logical_unit_id IN
        (SELECT logical_unit_id
        FROM aps_v_hds_ldev
        GROUP BY logical_unit_id
        HAVING (COUNT(logical_unit_id ) &gt; 1)
        )
      ) c,
      aps_v_hds_logical_unit a
    WHERE c.logical_unit_id=a.logical_unit_id
    GROUP BY a.logical_unit_id
    ) b,
    aps_v_hds_logical_unit a
  WHERE c.logical_unit_id=a.logical_unit_id
  AND c.logical_unit_id  =b.logical_unit_id
  )
SELECT array_name,
  logical_unit_name,
  SUM(ldev_capacity_gb) luse_capacity_gb,
  REPLACE(aptStringConcat(DISTINCT ldev),&#039;+&#039;,&#039;,&#039;) ldev_list
FROM t1
WHERE array_name = DECODE(&#039;${queryCombo1}&#039;,&#039; All&#039;,array_name,&#039;${queryCombo1}&#039;)
GROUP BY array_name,
  logical_unit_name</string>
          </entry>
