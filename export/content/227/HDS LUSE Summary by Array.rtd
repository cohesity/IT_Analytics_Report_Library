              <com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
                <name>freeQueryCombo</name>
                <componentScript>
                  <before/>
                  <after/>
                </componentScript>
                <configuration>
                  <entry>
                    <string>sql</string>
                    <string>SELECT DISTINCT array_name, array_name FROM aps_v_hds_logical_unit UNION ALL SELECT  &#039; All&#039;, &#039; All&#039; from dual order by 1</string>
                  </entry>
                  <entry>
                    <string>queryComboValues1</string>
                    <string>SELECT DISTINCT array_name, array_name FROM aps_v_hds_logical_unit UNION ALL SELECT  &#039; All&#039;, &#039; All&#039; from dual order by 1</string>
                  </entry>
                  <entry>
                    <string>queryComboHeading1</string>
                    <string>Array:</string>
                  </entry>
                </configuration>
                <referenceData/>
              </com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
            </list>
          </entry>
          <entry>
