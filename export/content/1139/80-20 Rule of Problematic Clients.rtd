          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 01/19/2015
WITH t1 AS (
SELECT 
j.client_name,
j.server_name,
aptStringConcat(DISTINCT j.job_type_name) job_types,
SUM(j.duration_secs) duration,
SUM(j.kilobytes/1024/1024) size_gb,
AVG(CASE WHEN j.kilobytes &gt; 4096 THEN j.mbytes_sec ELSE NULL END) mbytes_sec,
SUM(j.nbr_of_files) nbr_of_files,
SUM(DECODE(j.summary_status,2,1,0)) most_failures,
SUM(DECODE(j.summary_status,1,1,0)) most_partials
FROM apt_v_job j
WHERE start_date between ${startDate} and ${endDate}
AND j.client_id IN (${hosts})
AND j.client_id &lt;&gt; j.server_id
GROUP BY
j.client_name,
j.server_name
),
largest AS (
SELECT 1 sort_order,  &apos; Largest&apos; metric, 
client_name, server_name, job_types, 
CASE
WHEN size_gb &lt; 1024 THEN ROUND(size_gb,2)||&apos; GB&apos; 
WHEN size_gb &gt; 1024 THEN ROUND(size_gb/1024,2)||&apos; TB&apos; 
END value 
FROM t1
WHERE size_gb IS NOT NULL
ORDER BY size_gb DESC
),
longest AS (
SELECT 2 sort_order,  &apos; Longest Running&apos; metric, 
client_name, server_name, job_types, rtd.secsToHoursMinSecs(duration)||&apos; Hrs&apos; value
FROM t1
ORDER BY duration DESC
),
slowest AS (
SELECT 3 sort_order,  &apos; Slowest&apos; metric, 
client_name, server_name, job_types, ROUND(mbytes_sec,2)||&apos; MB/Sec&apos; value 
FROM t1
WHERE mbytes_sec &gt; 0
ORDER BY mbytes_sec ASC
),
most_files AS (
SELECT 4 sort_order,  &apos; Most Files&apos; metric, 
client_name, server_name, job_types, 
CASE 
WHEN nbr_of_files &gt; 1000000 THEN ROUND(nbr_of_files/1000000,1)||&apos; Million Files&apos;
WHEN nbr_of_files &lt; 1000000 THEN ROUND(nbr_of_files/1000,0)||&apos; Thousand Files&apos;
END value 
FROM t1
WHERE nbr_of_files IS NOT NULL
ORDER BY nbr_of_files DESC
),
most_failures AS (
SELECT 5 sort_order,  &apos; Most Failures&apos; metric, 
client_name, server_name, job_types, most_failures||&apos; Failed Jobs&apos; value  
FROM t1
WHERE most_failures &gt; 0
ORDER BY most_failures DESC
),
most_partials AS (
SELECT 6 sort_order,  &apos; Most Partials&apos; metric, 
client_name, server_name, job_types, most_partials||&apos; Partial Jobs&apos; value  
FROM t1
WHERE most_partials &gt; 0
ORDER BY most_partials DESC
),
t2 AS (
SELECT sort_order, rownum rank, rownum||DECODE(rownum,1,&apos;st&apos;,2,&apos;nd&apos;,3,&apos;rd&apos;,&apos;th&apos;)||metric metric,client_name, server_name, job_types, value FROM slowest
WHERE rownum &lt;= ${freeCombo1}
UNION
SELECT sort_order, rownum rank, rownum||DECODE(rownum,1,&apos;st&apos;,2,&apos;nd&apos;,3,&apos;rd&apos;,&apos;th&apos;)||metric metric,client_name, server_name, job_types, value FROM largest
WHERE rownum &lt;= ${freeCombo1}
UNION
SELECT sort_order,rownum  rank, rownum||DECODE(rownum,1,&apos;st&apos;,2,&apos;nd&apos;,3,&apos;rd&apos;,&apos;th&apos;)||metric metric,client_name, server_name, job_types, value FROM longest
WHERE rownum &lt;= ${freeCombo1}
UNION
SELECT sort_order,rownum rank, rownum||DECODE(rownum,1,&apos;st&apos;,2,&apos;nd&apos;,3,&apos;rd&apos;,&apos;th&apos;)||metric metric,client_name, server_name, job_types, value FROM most_files
WHERE rownum &lt;= ${freeCombo1}
UNION
SELECT sort_order,rownum rank, rownum||DECODE(rownum,1,&apos;st&apos;,2,&apos;nd&apos;,3,&apos;rd&apos;,&apos;th&apos;)||metric metric,client_name, server_name, job_types, value FROM most_partials
WHERE rownum &lt;= ${freeCombo1}
UNION
SELECT sort_order,rownum rank, rownum||DECODE(rownum,1,&apos;st&apos;,2,&apos;nd&apos;,3,&apos;rd&apos;,&apos;th&apos;)||metric metric,client_name, server_name, job_types, value FROM most_failures
WHERE rownum &lt;= ${freeCombo1}
),
occurrences AS (
SELECT
client_name,
COUNT(*) occurrences,
aptStringConcat(metric) other_bad_things
FROM t2
GROUP BY client_name
)
SELECT t2.*, occurrences,
DECODE(occurrences,1,&apos;white&apos;,2,&apos;yellow&apos;,&apos;red&apos;) status_dot,
other_bad_things,
REPLACE(REPLACE(other_bad_things,&apos;,&apos;,&apos; &apos;),metric,&apos;&apos;) also
FROM t2, occurrences occ
WHERE
t2.client_name = occ.client_name
ORDER BY
sort_order ASC, rank ASC</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
