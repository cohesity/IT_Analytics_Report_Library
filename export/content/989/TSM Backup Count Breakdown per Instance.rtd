          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 09/09/2011
SELECT
instance_name,
count(job_id) job_count,
sum(DECODE(job_type_name,&apos;Incr Backup&apos;,1,0)) Incr_Backup,
sum(DECODE(job_type_name,&apos;Archive&apos;,1,0)) Archive,
sum(DECODE(job_type_name,&apos;Command&apos;,1,0)) Command,
sum(DECODE(job_type_name,&apos;Restore&apos;,1,0)) restore,
sum(DECODE(job_type_name,&apos;Selective Backup&apos;,1,0)) selective_backup
FROM apt_v_tsm_job
WHERE start_date BETWEEN ${startDate} AND ${endDate}
AND server_id IN (${hosts})
AND job_type_name IN (&apos;Incr Backup&apos;,&apos;Archive&apos;,&apos;Command&apos;,&apos;Restore&apos;,&apos;Selective Backup&apos;)
GROUP BY instance_name
ORDER BY 2 DESC</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
