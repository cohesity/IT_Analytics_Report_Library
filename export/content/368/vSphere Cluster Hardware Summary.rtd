          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 05/23/2018
WITH 
g1 AS (
SELECT
vc.vmw_cluster_id,
COUNT(DISTINCT vs.virtual_system_id) esx_host_count,
COUNT(DISTINCT p.partition_id) guest_count,
SUM(p.memory_size_kb/1024/1024) vmemory_size,
SUM(p.nbr_cpu) nbr_vcpu
FROM apt_v_partition p, apt_v_virtual_system vs, apt_v_vmw_cluster vc
WHERE 
vs.host_id IN (${hosts})
AND vc.vmw_cluster_id = vs.vmw_cluster_id
AND vs.virtual_system_id = p.virtual_system_id
AND p.partition_type = &#039;VM&#039;
GROUP BY
vc.vmw_cluster_id
),
t1 AS (
SELECT
vc.vmw_cluster_id,
vc.cluster_name,
vh.system_vendor||&#039; &#039;||vh.system_model||&#039; &#039;||cpu_description hardware,
COUNT(*) hardware_count,
SUM((vc.total_memory_kb/1024/1024) / vc.nbr_of_hosts) total_memory_gb,
SUM((vc.total_memory_kb/1024/1024) / vc.nbr_of_hosts) / MAX(vc.nbr_of_hosts) avg_memory_per_host,
SUM(vc.nbr_of_cpu_cores  / vc.nbr_of_hosts) nbr_of_cpu_cores
FROM apt_v_vmw_cluster vc,apt_v_virtual_system vs, apt_v_vmw_hardware vh
WHERE 
vs.host_id IN (${hosts})
AND vs.vmw_cluster_id = vc.vmw_cluster_id
AND vs.virtual_system_id = vh.virtual_system_id
GROUP BY
vc.vmw_cluster_id,
vc.cluster_name,
vh.system_vendor||&#039; &#039;||vh.system_model||&#039; &#039;||cpu_description
),
t2 AS (
SELECT
t1.vmw_cluster_id,
t1.cluster_name,
REPLACE(aptStringConcat(DISTINCT t1.hardware),&#039;,&#039;,&#039;&lt;br&gt;&#039;) hardware,
SUM(t1.hardware_count) hardware_count,
SUM(t1.total_memory_gb) total_memory_gb,
MAX(avg_memory_per_host) avg_memory_per_host,
SUM(t1.nbr_of_cpu_cores) nbr_of_cpu_cores
FROM t1
GROUP BY
vmw_cluster_id,
cluster_name
)
SELECT
t2.vmw_cluster_id,
t2.cluster_name,
t2.hardware,
t2.hardware_count,
t2.total_memory_gb,
t2.avg_memory_per_host,
t2.nbr_of_cpu_cores,
g1.esx_host_count,
g1.guest_count,
g1.nbr_vcpu,
g1.vmemory_size,
g1.vmemory_size/t2.total_memory_gb*100 memory_pct,
g1.vmemory_size/t2.total_memory_gb pct_memory
FROM g1, t2
WHERE t2.vmw_cluster_id = g1.vmw_cluster_id (+)
ORDER BY t2.cluster_name</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
