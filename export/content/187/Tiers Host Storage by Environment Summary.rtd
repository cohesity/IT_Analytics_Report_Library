  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>
--Author: rich.rose@aptare.com
--Last Modified: 05/10/2012
SELECT
nvl(rtd.getServerAttributeValue(cl.host_id,&#039;Environment&#039;),&#039;Unassigned&#039;) environment,
cl.policy_name,
count(cl.host_id) nbr_of_hosts,
sum(cl.total_gb/1024) total_size
FROM aps_v_chargeback_log cl
WHERE cl.host_id in (${hosts})
GROUP BY 
nvl(rtd.getServerAttributeValue(cl.host_id,&#039;Environment&#039;),&#039;Unassigned&#039;),
cl.policy_name</string>
          </entry>
