<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last modified: 04/29/2013
WITH 
pol AS ( 
SELECT  
j.policy_id,
COUNT(DISTINCT client_id) clients,
MIN(start_date) min_start,
MAX(finish_date) max_finish,
SUM(kilobytes/1024/1024) total_size_gb
FROM apt_v_nbu_job j
WHERE j.client_id IN (${hosts})
AND j.start_date BETWEEN ${startDate} AND ${endDate}
AND j.finish_date IS NOT NULL
AND j.finish_date &gt; j.start_date
AND j.kilobytes &gt; 1024
AND j.summary_status &lt;= 1
GROUP BY j.policy_id
), 
ap AS (
SELECT policy_id, the_date, min_start, max_finish, total_size_gb
FROM pol, (SELECT the_date FROM TABLE(CAST(rtd.APTlistOfDates(${startDate}, ${endDate}, 10) AS dateListType))) d
), 
jobs AS (
SELECT ap.policy_id, ap.the_date, 
COUNT(job_id) jobs,
COUNT(DISTINCT client_id) clients,
ROUND(SUM(j.kilobytes/1024/1024),2) size_gb
FROM ap, apt_v_nbu_job j
WHERE ap.policy_id = j.policy_id
AND j.client_id IN (${hosts})
AND j.start_date &lt;= (ap.the_date + 3599/86400)
AND j.finish_date &gt;= ap.the_date
AND j.finish_date IS NOT NULL
AND j.finish_date &gt; j.start_date
AND j.kilobytes &gt; 1024
AND j.summary_status &lt;= 1
GROUP BY ap.policy_id, ap.the_date
),
t1 AS ( 
SELECT ap.the_date, np.policy_name,
ap.min_start, ap.max_finish, ap.total_size_gb,
--Number of jobs running at the time (number will go down as they complete)
NVL2(jobs,&#039;&lt;table width=&quot;100%&quot; border=&quot;0&quot; cellspacing=&quot;0&quot; cellpadding=&quot;0&quot;&gt;&lt;td NOWRAP bgcolor=&quot;#CCCCFF&quot; align=left&gt;&#039;||jobs||DECODE(jobs,1,&#039; Job&#039;,&#039; Jobs&#039;)||&#039;&lt;/td&gt;&lt;/table&gt;&#039;,null) jobs,
--Number of clients doing backups at that time (number will go down as they complete)
NVL2(clients,&#039;&lt;table width=&quot;100%&quot; border=&quot;0&quot; cellspacing=&quot;0&quot; cellpadding=&quot;0&quot;&gt;&lt;td NOWRAP bgcolor=&quot;#CCCCFF&quot; align=left&gt;&#039;||clients||DECODE(clients,1,&#039; Client&#039;,&#039; Clients&#039;)||&#039;&lt;/td&gt;&lt;/table&gt;&#039;,null) clients,
--Amount of total data set was processing at that time (number will go down as clients complete)
NVL2(size_gb,&#039;&lt;table width=&quot;100%&quot; border=&quot;0&quot; cellspacing=&quot;0&quot; cellpadding=&quot;0&quot;&gt;&lt;td NOWRAP bgcolor=&quot;#CCCCFF&quot; align=left&gt;&#039;||size_gb||&#039; GB&lt;/td&gt;&lt;/table&gt;&#039;,null) size_gb,
jobs the_jobs,
clients the_clients,
size_gb the_size
FROM ap, jobs, apt_v_nbu_policy np
WHERE ap.policy_id = jobs.policy_id (+)
AND ap.policy_id = np.policy_id
AND ap.the_date = jobs.the_date (+)
ORDER BY UPPER(np.policy_name), ap.the_date
)
SELECT
to_char(the_date,&#039;MM/DD hh24:MI&#039;) the_date,
policy_name,
DECODE(&#039;${freeCombo1}&#039;,
&#039;GB&#039;,size_gb,
&#039;Clients&#039;,clients,
&#039;Jobs&#039;,jobs) the_metric,
to_char(the_date,&#039;hh:MI AM&#039;) the_time,
the_size,
the_clients,
the_jobs
FROM t1
ORDER BY UPPER(policy_name), the_date</string>
          </entry>
