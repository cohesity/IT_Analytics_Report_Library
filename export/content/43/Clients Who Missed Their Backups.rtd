  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>-- Of the jobs run within the specified time frame, display the clients
-- that are in the same server group, who did not have a job present.
-- In addition to displaying the client, also display the last tbackup they had, and what was
-- it&#039;s status.
WITH 
t1 as (--All clients in the server group
SELECT DISTINCT server_id
FROM apt_v_server
WHERE server_id IN (${hosts})
),
t2 as (--Clients which had backups in the last x days
SELECT 
DISTINCT client_id
FROM apt_v_job  j
WHERE  j.client_id IN (${hosts})
AND j.start_date BETWEEN ${startDate} AND ${endDate}
)
SELECT t1.server_id, s.hostname, lcj.job_id, lcj.finish_date,
DECODE(lcj.summary_status,0,&#039;blue&#039;,1,&#039;yellow&#039;,2,&#039;red&#039;) summary_status
FROM t1, apt_v_server s, apt_v_last_client_job lcj
WHERE t1.server_id NOT IN (SELECT client_id FROM t2)
AND t1.server_id = s.server_id
AND t1.server_id = lcj.client_id (+)</string>
          </entry>
          <entry>
            <string>designerScript</string>
            <null/>
          </entry>
          <entry>
            <string>advancedComponents</string>
            <list/>
          </entry>
