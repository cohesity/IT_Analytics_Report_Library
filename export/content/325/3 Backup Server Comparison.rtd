  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>descriptiveName</string>
            <string>3 Backup Server Comparison</string>
          </entry>
          <entry>
            <string>drilldown</string>
            <boolean>false</boolean>
          </entry>
          <entry>
            <string>dataSource</string>
            <string>WITH 
t1 AS (
SELECT
to_char(trunc(start_date,DECODE(&#039;${freeCombo2}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;,&#039;YY&#039;)),&#039;MM/DD/YYYY&#039;) the_date,
to_char(trunc(start_date,DECODE(&#039;${freeCombo2}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;,&#039;YY&#039;)),&#039;YYYYMMDD&#039;) sort_order,
server_name entity,
trunc(SUM(kilobytes/1024/1024)) job_size_gb,
COUNT(DISTINCT client_id) client_count,
SUM(nbr_of_files) file_count,
COUNT(DISTINCT job_id) job_count,
SUM(DECODE(summary_status,0,1)) successful_jobs,
SUM(DECODE(summary_status,1,1)) partial_jobs,
SUM(DECODE(summary_status,2,1)) failed_jobs,
AVG(mbytes_sec) mbytes_sec,
AVG(duration_secs/60) duration_min
FROM apt_v_job
WHERE 
server_name IN (&#039;${queryCombo1}&#039;,&#039;${queryCombo2}&#039;,&#039;${queryCombo3}&#039;)
AND start_date BETWEEN ${startDate} AND ${endDate}
GROUP BY
to_char(trunc(start_date,DECODE(&#039;${freeCombo2}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;,&#039;YY&#039;)),&#039;MM/DD/YYYY&#039;),
to_char(trunc(start_date,DECODE(&#039;${freeCombo2}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;,&#039;YY&#039;)),&#039;YYYYMMDD&#039;),
server_name
),
t2 AS (
SELECT
the_date,
sort_order,
entity,
DECODE(&#039;${freeCombo1}&#039;,
&#039;Job Size(GB)&#039;,job_size_gb,
&#039;Client Count&#039;,client_COUNT,
&#039;File Count&#039;,file_COUNT,
&#039;Job Count&#039;,job_COUNT,
&#039;Successful Jobs&#039;,successful_jobs,
&#039;Partial Jobs&#039;,partial_jobs,
&#039;Failed Jobs&#039;,failed_jobs,
&#039;MB/sec&#039;,mbytes_sec,
&#039;Duration(Min)&#039;,duration_MIN
) metric
FROM t1
),
t3 AS (
SELECT
the_date,
sort_order,
SUM(DECODE(entity,&#039;${queryCombo1}&#039;,metric,0)) metric1,
SUM(DECODE(entity,&#039;${queryCombo2}&#039;,metric,0)) metric2,
SUM(DECODE(entity,&#039;${queryCombo3}&#039;,metric,0)) metric3
FROM t2
GROUP BY 
the_date,
sort_order
)
SELECT
the_date,
sort_order,
&#039;${freeCombo1}&#039; report_on,
&#039;${queryCombo1}&#039; entity1,
metric1,
&#039;${queryCombo2}&#039; entity2,
metric2,
&#039;${queryCombo3}&#039; entity3,
metric3
FROM t3
ORDER BY sort_order</string>
          </entry>
