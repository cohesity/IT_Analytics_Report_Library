<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>longDescription</string>
      <string>The report predicts the availability of media based on the expiration date of the media. Using this report, you can determine what media will be available for reuse. The stacked bar chart represents the number of media of a specific type that are expired or going to expire on a particular day. Different colors are used for different media types in the stacked bar chart. Mouseover for the bar segments provide the media type and count of the media that is available on that day. Run this report by selecting future start and end date range from the scope selector.</string>
    </entry>
    <entry>
      <string>reportVersion</string>
      <string>1.0</string>
    </entry>
    <entry>
      <string>isCloudTemplate</string>
      <boolean>false</boolean>
    </entry>
    <entry>
      <string>inventoryType</string>
      <list>
        <long>0</long>
      </list>
    </entry>
    <entry>
      <string>reportGuid</string>
      <string>d72aa1d4-0d0f-4465-b3c5-ef1ec5bc664b</string>
    </entry>
    <entry>
