            <string>designerScript</string>
            <null/>
          </entry>
          <entry>
            <string>dataSource</string>
            <string>SELECT expiration_date,&#xd;
       DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,&apos;mm-dd-yyyy&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM-YYYY&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YYYY&apos;) date_format,&#xd;
       media_type,&#xd;
       media_count &#xd;
FROM&#xd;
(&#xd;
SELECT TO_CHAR(TRUNC(ntmd.expiration_date),DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,&apos;mm-dd-yyyy&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM-YYYY&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YYYY&apos;)) expiration_date,&#xd;
       ntmd.vendor_media_type_name media_type,&#xd;
       COUNT(*) media_count&#xd;
FROM apt_v_nbu_tape_media_detail ntmd&#xd;
WHERE ntmd.expiration_date BETWEEN ${startDate} AND ${endDate}&#xd;
GROUP BY TO_CHAR(TRUNC(ntmd.expiration_date),DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,&apos;mm-dd-yyyy&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM-YYYY&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YYYY&apos;)),&#xd;
         ntmd.vendor_media_type_name&#xd;
ORDER BY expiration_date asc&#xd;
)</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
