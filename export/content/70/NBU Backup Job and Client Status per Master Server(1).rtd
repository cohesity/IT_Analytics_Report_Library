<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>descriptiveName</string>
            <string>NBU Backup Job and Client Status per Master Server</string>
          </entry>
          <entry>
            <string>drilldown</string>
            <boolean>false</boolean>
          </entry>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 07/06/2015
--NOTE: Requires drilldown report &quot;Client Status Summary.D&quot;
--from the Drilldown Components menu
WITH 
d1 AS (--Dates Required for Drilldown 
SELECT
TO_CHAR(${startDate},&#039;MM/DD/YYYY&#039;) start_date_char,
TO_CHAR(${startDate},&#039;HH24&#039;) start_hour_char,
TO_CHAR(${endDate},&#039;MM/DD/YYYY&#039;) finish_date_char,
TO_CHAR(${endDate},&#039;HH24&#039;) finish_hour_char
FROM DUAL
),
j1 AS (--Gathers Job Status
SELECT 
j.server_id,
j.master_host_name,
COUNT(DISTINCT j.media_server_id) media_server_count,
COUNT(DISTINCT policy_id) policy_count,
SUM(j.kilobytes/1024/1024/1024) job_volume,
COUNT(j.job_id) job_count,
SUM(DECODE(j.vendor_status_name,&#039;Successful&#039;,1,0)) successful_job_count,
SUM(DECODE(j.vendor_status_name,&#039;Failed&#039;,1,0)) failed_job_count,
SUM(DECODE(j.vendor_status_name,&#039;Partial&#039;,1,0)) partial_job_count,
ROUND((sum(DECODE(j.vendor_status_name,&#039;Successful&#039;,1,0))+sum(DECODE(j.vendor_status_name,&#039;Partial&#039;,1,0)))
/count(j.job_id)*100,2) job_success_rate,
ROUND(SUM(DECODE(j.summary_status,0,1,0))/COUNT(j.job_id)*100,2) job_strict_success_rate,
ROUND(SUM(DECODE(j.summary_status,1,1,0))/COUNT(j.job_id)*100,2) job_partial_rate,
ROUND(SUM(DECODE(j.summary_status,2,1,0))/COUNT(j.job_id)*100,2) job_failed_rate
FROM apt_v_nbu_job_detail j
WHERE j.start_date BETWEEN ${startDate} AND ${endDate}
AND j.client_id IN (${hosts})
GROUP BY 
j.server_id,
j.master_host_name
),
fc1 AS (--Gathers Clients Status
SELECT
j.server_id,
j.client_id,
MIN(summary_status) min_summary_status,
MAX(summary_status) max_summary_status
FROM apt_v_job j
WHERE j.client_id IN (${hosts})
AND j.start_date BETWEEN ${startDate} AND ${endDate}
AND summary_status IS NOT NULL
GROUP BY
j.server_id,
j.client_id
),
fc2 AS (
SELECT
server_id,
COUNT(DISTINCT client_id) client_count,
SUM(CASE WHEN min_summary_status = 2 AND max_summary_status = 2 THEN 1 ELSE 0 END) failed_clients,
SUM(CASE WHEN min_summary_status = 1 AND max_summary_status = 1 THEN 1 ELSE 0 END) partial_clients,
SUM(CASE WHEN min_summary_status = 0 AND max_summary_status = 0 THEN 1 ELSE 0 END) successful_clients,
SUM(CASE WHEN min_summary_status = 0 AND max_summary_status = 1 THEN 1 ELSE 0 END) successful_partial_clients,
SUM(CASE WHEN min_summary_status &lt;&gt; max_summary_status THEN 1 ELSE 0 END) mixed_clients
FROM fc1
GROUP BY server_id
), 
fc3 AS (
SELECT
server_id,
failed_clients,
partial_clients,
successful_clients,
mixed_clients,
client_count,
ROUND(failed_clients/client_count*100,2) client_failure_rate,
ROUND(partial_clients/client_count*100,2) client_partial_rate,
ROUND(mixed_clients/client_count*100,2) client_mixed_rate,
ROUND((successful_clients+partial_clients+successful_partial_clients)/client_count*100,2) client_success_rate
FROM fc2
)
SELECT 
s.location,
j1.server_id,
master_host_name,
media_server_count,
policy_count,
job_volume,
job_count,
CASE 
WHEN job_success_rate BETWEEN ${freeCombo2} AND 99.999 THEN &#039;green&#039;
WHEN job_success_rate BETWEEN ${freeCombo1} AND ${freeCombo2} THEN &#039;yellow&#039;
WHEN job_success_rate &lt; ${freeCombo1} THEN &#039;red&#039;
WHEN job_success_rate = 100 THEN &#039;blue&#039;
ELSE &#039;white&#039;
END job_status_dot,
successful_job_count,
job_strict_success_rate,
partial_job_count,
job_partial_rate,
failed_job_count,
job_failed_rate,
job_success_rate,
client_count,
CASE 
WHEN client_success_rate BETWEEN ${freeCombo2} AND 99.999 THEN &#039;green&#039;
WHEN client_success_rate BETWEEN ${freeCombo1} AND ${freeCombo2} THEN &#039;yellow&#039;
WHEN client_success_rate &lt; ${freeCombo1} THEN &#039;red&#039;
WHEN client_success_rate = 100 THEN &#039;blue&#039;
ELSE &#039;white&#039;
END client_status_dot,
successful_clients,
partial_clients,
failed_clients,
mixed_clients,
client_success_rate,
start_date_char,
start_hour_char,
finish_date_char,
finish_hour_char
FROM d1, j1, fc3, apt_v_server s
WHERE j1.server_id = fc3.server_id 
AND j1.server_id = s.server_id
ORDER BY 10 asc
</string>
          </entry>
