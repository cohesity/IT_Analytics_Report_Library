  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 08/09/2012
--This will display job Information for the selected policy type
SELECT
nj.master_host_name,
nj.client_host_name,
np.policy_id,
np.policy_name, 
np.policy_type_name,
schedule_name,
schedule_type_name,
retention_days,
CASE
  WHEN ns.retention_days &gt; 0    AND ns.retention_days &lt;= 7     THEN &#039;1 Week&#039;
  WHEN ns.retention_days &gt; 7    AND ns.retention_days &lt;= 14    THEN &#039;2 Weeks&#039;
  WHEN ns.retention_days &gt; 14   AND ns.retention_days &lt;= 31    THEN &#039;1 Month&#039;
  WHEN ns.retention_days &gt; 31   AND ns.retention_days &lt;= 90    THEN &#039;3 Months&#039;
  WHEN ns.retention_days &gt; 90   AND ns.retention_days &lt;= 186   THEN &#039;6 Months&#039;
  WHEN ns.retention_days &gt; 186  AND ns.retention_days &lt;= 365   THEN &#039;1 Yr&#039;
  WHEN ns.retention_days &gt; 365  AND ns.retention_days &lt;= 1095  THEN &#039;3 Yrs&#039;
  WHEN ns.retention_days &gt; 1095 AND ns.retention_days &lt;= 2555  THEN &#039;7 Yrs&#039;
  WHEN ns.retention_days &gt; 2555 AND ns.retention_days &lt;= 5475  THEN &#039;15 Yrs&#039;
  WHEN ns.retention_days &gt; 5475 OR  ns.retention_days = 0 THEN &#039;Over 15 Yrs&#039;
END retention_period,
count(nj.job_id) nbr_of_jobs,
sum(nj.kilobytes/1024/1024) size_gb,
REPLACE(aptStringConcat(DISTINCT pf.pathname),&#039;,&#039;,&#039;&lt;br /&gt;&#039;) paths,
REPLACE(aptStringConcat(DISTINCT ntm.media_name),&#039;,&#039;,&#039;&lt;br /&gt;&#039;) tapes
FROM apt_v_nbu_job nj, apt_v_nbu_policy np, apt_v_nbu_schedule ns,apt_v_nbu_policy_file pf, apt_v_nbu_job_tape_media jtm, apt_v_nbu_tape_media ntm
WHERE nj.start_date BETWEEN ${startDate} AND ${endDate}
AND nj.client_id IN (${hosts})
AND nj.policy_id = np.policy_id
AND nj.policy_id = pf.policy_id
AND nj.schedule_id = ns.schedule_id (+)
AND nj.job_id = jtm.job_id (+)
AND jtm.tape_media_id = ntm.tape_media_id
AND &#039;${freeCombo1}&#039; IN 
CASE 
WHEN &#039;${freeCombo1}&#039;     LIKE &#039;All&#039; THEN &#039;${freeCombo1}&#039; 
WHEN np.policy_type_name LIKE &#039;NDMP&#039; THEN &#039;NDMP&#039;
WHEN np.policy_type_name LIKE &#039;Standard&#039; THEN &#039;Standard&#039;
WHEN np.policy_type_name LIKE &#039;MS-Windows&#039; THEN &#039;MS-Windows&#039;
WHEN np.policy_type_name LIKE &#039;Oracle&#039; THEN &#039;Oracle&#039;
WHEN np.policy_type_name LIKE &#039;Vault&#039; THEN &#039;Vault&#039;
WHEN np.policy_type_name LIKE &#039;FlashBackup&#039; THEN &#039;FlashBackup&#039;
WHEN np.policy_type_name LIKE &#039;MS-Exchange Server&#039; THEN &#039;MS-Exchange Server&#039;
WHEN np.policy_type_name LIKE &#039;MS-SQL&#039; THEN &#039;MS-SQL&#039;
WHEN np.policy_type_name LIKE &#039;MS-Sharepoint&#039; THEN &#039;MS-Sharepoint&#039;
WHEN np.policy_type_name LIKE &#039;NBU-Catalog&#039; THEN &#039;NBU-Catalog&#039;
END
GROUP BY
nj.master_host_name,
nj.client_host_name,
np.policy_id,
np.policy_name, 
np.policy_type_name,
schedule_name,
schedule_type_name,
retention_days,
CASE
  WHEN ns.retention_days &gt; 0    AND ns.retention_days &lt;= 7     THEN &#039;1 Week&#039;
  WHEN ns.retention_days &gt; 7    AND ns.retention_days &lt;= 14    THEN &#039;2 Weeks&#039;
  WHEN ns.retention_days &gt; 14   AND ns.retention_days &lt;= 31    THEN &#039;1 Month&#039;
  WHEN ns.retention_days &gt; 31   AND ns.retention_days &lt;= 90    THEN &#039;3 Months&#039;
  WHEN ns.retention_days &gt; 90   AND ns.retention_days &lt;= 186   THEN &#039;6 Months&#039;
  WHEN ns.retention_days &gt; 186  AND ns.retention_days &lt;= 365   THEN &#039;1 Yr&#039;
  WHEN ns.retention_days &gt; 365  AND ns.retention_days &lt;= 1095  THEN &#039;3 Yrs&#039;
  WHEN ns.retention_days &gt; 1095 AND ns.retention_days &lt;= 2555  THEN &#039;7 Yrs&#039;
  WHEN ns.retention_days &gt; 2555 AND ns.retention_days &lt;= 5475  THEN &#039;15 Yrs&#039;
  WHEN ns.retention_days &gt; 5475 OR  ns.retention_days = 0 THEN &#039;Over 15 Yrs&#039;
END</string>
          </entry>
