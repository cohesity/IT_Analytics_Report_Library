          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 09/18/2015
--Compare SAN metrics today vs same time last month
WITH 
VAR AS (
SELECT 
&apos;${freeCombo1}&apos; unit,
DECODE(&apos;${freeCombo1}&apos;, &apos;KB&apos;,1,&apos;MB&apos;,1024,&apos;GB&apos;,(1024*1024),&apos;TB&apos;,(1024*1024*1024),&apos;PB&apos;,(1024*1024*1024*1024)) div_by,
ADD_MONTHS(TRUNC(sysdate,&apos;MM&apos;),-1) p_first, 
LAST_DAY(ADD_MONTHS(sysdate,-1)) p_last, 
ADD_MONTHS(TRUNC(sysdate,&apos;DD&apos;),-1) p_day,
TRUNC(sysdate,&apos;MM&apos;) c_first, 
LAST_DAY(sysdate) c_last,
TRUNC(sysdate,&apos;DD&apos;) c_day,
domain_id  
FROM aps_v_domain d
WHERE domain_name = &apos;${queryCombo1}&apos;
),
p0 AS (
SELECT 
p.switch_id,
p.switch_fc_port_id,
MAX(l.total_bytes_tx_counter) tx_counter,
MAX(l.total_bytes_rx_counter) rx_counter
FROM aps_v_swi_perform_daily_log l, aps_v_swi_switch_fc_port p, var
WHERE p.switch_fc_port_id = l.switch_fc_port_id 
AND p.domain_id = var.domain_id 
AND l.log_date BETWEEN p_first AND p_day
GROUP BY
p.switch_id,
p.switch_fc_port_id
),
p1 AS (
SELECT
COUNT(DISTINCT switch_id) switches,
COUNT(DISTINCT switch_fc_port_id) ports,
ROUND(SUM(tx_counter/1000000000),2) tx_counter,
ROUND(SUM(rx_counter/1000000000),2) rx_counter
FROM p0, var
),
c0 AS (
SELECT 
p.switch_id,
p.switch_fc_port_id,
MAX(l.total_bytes_tx_counter) tx_counter,
MAX(l.total_bytes_rx_counter) rx_counter
FROM aps_v_swi_perform_daily_log l, aps_v_swi_switch_fc_port p, var
WHERE p.switch_fc_port_id = l.switch_fc_port_id 
AND p.domain_id = var.domain_id 
AND l.log_date BETWEEN c_first AND c_day
GROUP BY
p.switch_id,
p.switch_fc_port_id
),
c1 AS (
SELECT
COUNT(DISTINCT switch_id) switches,
COUNT(DISTINCT switch_fc_port_id) ports,
ROUND(SUM(tx_counter/1000000000),2) tx_counter,
ROUND(SUM(rx_counter/1000000000),2) rx_counter
FROM c0, var
)
-- Metrics Begin Here  --
SELECT
1 sort_order,
&apos;SAN Switches&apos; metric,
p1.switches p_value,
c1.switches c_value, 
(c1.switches - p1.switches) delta, 
ROUND((c1.switches - p1.switches) / DECODE(p1.switches,0,NULL,p1.switches),2) delta_pct,
ABS(ROUND((c1.switches - p1.switches) / DECODE(p1.switches,0,NULL,p1.switches),2)) pct_delta
FROM p1, c1
UNION
SELECT
2 sort_order,
&apos;SAN Switch Ports&apos; metric,
p1.ports p_value,
c1.ports c_value, 
(c1.ports - p1.ports) delta, 
ROUND((c1.ports - p1.ports) / DECODE(p1.ports,0,NULL,p1.ports),2) delta_pct,
ABS(ROUND((c1.ports - p1.ports) / DECODE(p1.ports,0,NULL,p1.ports),2)) pct_delta
FROM p1, c1
UNION
SELECT
3 sort_order,
&apos;Port Tx Traffic (Billion Packets)&apos; metric,
p1.tx_counter p_value,
c1.tx_counter c_value, 
(c1.tx_counter - p1.tx_counter) delta, 
ROUND((c1.tx_counter - p1.tx_counter) / DECODE(p1.tx_counter,0,NULL,p1.tx_counter),2) delta_pct,
ABS(ROUND((c1.tx_counter - p1.tx_counter) / DECODE(p1.tx_counter,0,NULL,p1.tx_counter),2)) pct_delta
FROM p1, c1
UNION
SELECT
4 sort_order,
&apos;Port Rx Traffic (Billion Packets)&apos; metric,
p1.rx_counter p_value,
c1.rx_counter c_value, 
(c1.rx_counter - p1.rx_counter) delta, 
ROUND((c1.rx_counter - p1.rx_counter) / DECODE(p1.rx_counter,0,NULL,p1.rx_counter),2) delta_pct,
ABS(ROUND((c1.rx_counter - p1.rx_counter) / DECODE(p1.rx_counter,0,NULL,p1.rx_counter),2)) pct_delta
FROM p1, c1</string>
          </entry>
        </data>
