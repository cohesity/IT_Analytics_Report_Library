          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 04/02/2018
SELECT 
storage_array_id,
array_name,
logical_unit_id,
logical_unit_name,
rtd.collectString(CAST(COLLECT(TO_CHAR(read_io) ORDER BY log_date) AS StringListType),&#039;, &#039;) read_io_spk,
MAX(read_io) max_read_io,
AVG(read_io) avg_read_io,
rtd.collectString(CAST(COLLECT(TO_CHAR(write_io) ORDER BY log_date) AS StringListType),&#039;, &#039;) write_io_spk,
MAX(write_io) max_write_io,
AVG(write_io) avg_write_io,
rtd.collectString(CAST(COLLECT(TO_CHAR(total_io) ORDER BY log_date) AS StringListType),&#039;, &#039;) total_io_spk,
MAX(total_io) max_total_io,
AVG(total_io) avg_total_io,
rtd.collectString(CAST(COLLECT(TO_CHAR(read_io_response_time) ORDER BY log_date) AS StringListType),&#039;, &#039;) read_io_response_spk,
MAX(read_io_response_time) max_read_io_response,
AVG(read_io_response_time) avg_read_io_response,
rtd.collectString(CAST(COLLECT(TO_CHAR(write_io_response_time) ORDER BY log_date) AS StringListType),&#039;, &#039;) write_io_response_spk,
MAX(write_io_response_time) max_write_io_response,
AVG(write_io_response_time) avg_write_io_response
FROM aps_v_lun_perform_log pl
WHERE pl.storage_array_id IN (${arrays})
AND log_date BETWEEN ${startDate} AND ${endDate}
GROUP BY
storage_array_id,
array_name, 
logical_unit_id,
logical_unit_name</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
