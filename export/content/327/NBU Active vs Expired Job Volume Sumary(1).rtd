<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>descriptiveName</string>
            <string>NBU Active vs Expired Job Volume Sumary</string>
          </entry>
          <entry>
            <string>drilldown</string>
            <boolean>false</boolean>
          </entry>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 01/20/2015
WITH 
var AS (
SELECT
ROUND((${endDate} - ${startDate}),2) nbrOfDays,
DECODE(&#039;${freeCombo2}&#039;,
&#039;KB&#039;,1,&#039;MB&#039;,1024,&#039;GB&#039;,(1024*1024),&#039;TB&#039;,(1024*1024*1024),&#039;PB&#039;,(1024*1024*1024*1024)) div_by 
FROM dual
),
t1 AS (
SELECT
TRUNC(start_date,DECODE(&#039;${freeCombo1}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;,&#039;YY&#039;)) the_date,
COUNT(DISTINCT client_id) client_count,
ROUND(SUM(CASE WHEN expiration_date &lt; sysdate THEN (kilobytes/div_by) ELSE 0 END),2) exp_job_volume,
ROUND(SUM(CASE WHEN expiration_date &gt; sysdate THEN (kilobytes/div_by) ELSE 0 END),2) job_volume
FROM apt_v_nbu_job_detail j, var
WHERE j.client_id IN (${hosts})
AND j.start_date BETWEEN ${startDate} AND ${endDate}
AND REGEXP_LIKE(j.policy_name,&#039;${freeText1}&#039;)
GROUP BY
TRUNC(start_date,DECODE(&#039;${freeCombo1}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;,&#039;YY&#039;))
)
SELECT
TO_CHAR(the_date,&#039;MM/DD/YY&#039;) the_date,
TO_CHAR(the_date,&#039;YYYYMMDD&#039;) sort_order,
client_count,
exp_job_volume,
job_volume
FROM t1
ORDER BY 2</string>
          </entry>
