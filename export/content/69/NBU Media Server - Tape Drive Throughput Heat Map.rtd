<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author: dave.king@aptare.com
--Last Updated: 05/01/2012
--NBU Media Server Tape Drive Throughput Heat Map
WITH 
avg_tpt AS (
SELECT 
AVG((j.kilobytes/1024) / ((j.finished_readwrite-j.started_readwrite)*24*60*60)) avgThroughput
FROM apt_v_nbu_job_try j
WHERE j.media_server_id IN (${hosts})
AND j.started_readwrite BETWEEN ${startDate} AND ${endDate}
AND j.finished_readwrite  IS NOT NULL
AND j.finished_readwrite &gt; j.started_readwrite
AND j.kilobytes &gt; 1024
AND j.summary_status &lt;= 1
),
pol AS ( 
SELECT 
DISTINCT jtm.drive_id, j.media_host_name
FROM apt_v_nbu_job_try j, apt_v_job_tape_media jtm
WHERE j.job_id = jtm.job_id
AND j.media_server_id IN (${hosts})
AND j.started_readwrite BETWEEN ${startDate} AND ${endDate}
AND j.finished_readwrite IS NOT NULL
AND j.finished_readwrite &gt; j.started_readwrite
AND j.kilobytes &gt; 1024
AND j.summary_status &lt;= 1
), 
ap AS (
SELECT 
pol.drive_id, pol.media_host_name, d.the_date
FROM pol, (SELECT the_date FROM TABLE(CAST(rtd.APTlistOfDates(${startDate}, ${endDate},10) AS dateListType))) d
), 
jobs AS (
SELECT 
ap.drive_id, 
ap.media_host_name, 
ap.the_date,
0 throughput
FROM ap
UNION ALL
SELECT 
ap.drive_id, 
j.media_host_name, 
ap.the_date, 
ROUND(NVL(SUM(j.kilobytes/1024)/(SUM(j.finished_readwrite-j.started_readwrite)*24*60*60),0 ),2) throughput
FROM ap, apt_v_nbu_job_try j, apt_v_job_tape_media jtm
WHERE j.job_id = jtm.job_id 
AND ap.drive_id = jtm.drive_id
AND j.media_server_id  IN (${hosts})
AND j.started_readwrite &lt;= (ap.the_date + 3599/86400)
AND j.finished_readwrite &gt;= ap.the_date
AND j.finished_readwrite IS NOT NULL
AND j.finished_readwrite &gt; j.started_readwrite
AND j.kilobytes &gt; 1024
AND j.summary_status &lt;= 1
GROUP BY ap.drive_id, j.media_host_name, ap.the_date
),
jobs1 AS (
SELECT 
drive_id, 
media_host_name, 
the_date,
max(throughput) throughput
FROM jobs
GROUP BY 
drive_id, 
media_host_name, 
the_date
)   
SELECT 
to_char(jobs1.the_date,&#039;MM/DD hh:AM&#039;) the_date, 
jobs1.media_host_name||&#039; - &#039;||td.drive_name media_server_tape_drive,  
throughput,
CASE 


WHEN throughput &gt; 0 AND throughput &lt;= avgThroughput-(avgThroughput*.3333) THEN
    &#039;&lt;table width=&quot;100%&quot; border=&quot;0&quot; cellspacing=&quot;0&quot; cellpadding=&quot;0&quot;&gt;&lt;td bgcolor=&quot;#B30505&quot; align=right&gt;&lt;font color=&quot;white&quot;&gt;&#039;||throughput||&#039;&lt;/td&gt;&lt;/table&gt;&#039;
  WHEN throughput &gt;= avgThroughput-(avgThroughput*.3333) AND throughput &lt;= avgThroughput+(avgThroughput*.3333) THEN
    &#039;&lt;table width=&quot;100%&quot; border=&quot;0&quot; cellspacing=&quot;0&quot; cellpadding=&quot;0&quot;&gt;&lt;td bgcolor=&quot;#DBD611&quot; align=right&gt;&lt;font color=&quot;black&quot;&gt;&#039;||throughput||&#039;&lt;/td&gt;&lt;/table&gt;&#039;
  WHEN throughput &gt;= avgThroughput+(avgThroughput*.3333) THEN
    &#039;&lt;table width=&quot;100%&quot; border=&quot;0&quot; cellspacing=&quot;0&quot; cellpadding=&quot;0&quot;&gt;&lt;td bgcolor=&quot;#347800&quot; align=right&gt;&lt;font color=&quot;white&quot;&gt;&#039;||throughput||&#039;&lt;/td&gt;&lt;/table&gt;&#039;
  WHEN throughput = 0 THEN
    &#039; &#039;

END throughput_dot

FROM jobs1, avg_tpt, apt_v_tape_drive td
WHERE jobs1.drive_id = td.drive_id
AND jobs1.media_host_name    is not null
ORDER BY upper(jobs1.media_host_name), upper(td.drive_name), jobs1.the_date</string>
          </entry>
