  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 09/14/2011
WITH t1 as (
SELECT
pp.partition_id, 
vd.vm_guest_name,
vd.virtual_system_id,
vd.virtual_system_name,
vd.host_id,
vd.host_name guest_host,
pp.os,
sum(vd.capacity_gb) cap_seen_by_host,
sum(vd.capacity_gb) host_fs_capacity,
sum(vd.used_space_gb) host_fs_used,
sum(vd.free_space_gb) host_free_gb
FROM apt_v_vmw_vmguest_disk vd, apt_v_vmw_partition_profile pp
WHERE host_id IN (${hosts}) 
AND vd.partition_id = pp.partition_id
GROUP BY 
pp.partition_id,
vd.vm_guest_name,
vd.virtual_system_id,
vd.virtual_system_name,
vd.host_id,
vd.host_name,
pp.os
),
rd AS (
SELECT 
vd.partition_id,
sum(pd.capacity_kb/1024/1024) rdisk_capacity_gb
FROM apt_v_vmw_physical_disk pd, apt_v_vmw_virtual_disk vd
WHERE vd.disk_type = &#039;RDISK&#039;
AND pd.canonical_name  = NVL(SUBSTR (vd.rdisk_lun_name, 1,INSTR (vd.rdisk_lun_name, &#039;:&#039;, 1, 3) - 1),vd.rdisk_lun_name)
GROUP BY vd.partition_id
)
SELECT 
t1.virtual_system_id,
t1.virtual_system_name,
t1.partition_id, 
t1.vm_guest_name,
t1.host_id,
t1.guest_host,
CASE 
WHEN upper(t1.os) LIKE &#039;%WINDOWS%&#039; THEN &#039;Windows&#039;
WHEN upper(t1.os) LIKE &#039;%LINUX%&#039; THEN &#039;Linux&#039;
WHEN upper(t1.os) LIKE &#039;%VMNIX-X86%&#039; THEN &#039;ESX&#039;
WHEN upper(t1.os) LIKE &#039;%AIX%&#039; THEN &#039;AIX&#039;
WHEN upper(t1.os) LIKE &#039;%SOLARIS%&#039; THEN &#039;Solaris&#039;
ELSE os
END os_shortname,
cap_seen_by_host,
host_fs_capacity,
host_fs_used,
host_free_gb,
rd.rdisk_capacity_gb raw_fs_capacity
FROM t1, rd
WHERE 
t1.partition_id = rd.partition_id (+)
AND &#039;${freeCombo1}&#039; IN 
  CASE 
    WHEN &#039;${freeCombo1}&#039; NOT IN (&#039;All&#039;) THEN
      CASE
        WHEN upper(t1.os) LIKE &#039;%WINDOWS%&#039; THEN &#039;Windows&#039;
        WHEN upper(t1.os) LIKE &#039;%LINUX%&#039; THEN &#039;Linux&#039;
        WHEN upper(t1.os) LIKE &#039;%VMNIX-X86%&#039; THEN &#039;ESX&#039;
        WHEN upper(t1.os) LIKE &#039;%AIX%&#039; THEN &#039;AIX&#039;
      END
   ELSE &#039;All&#039;
 END</string>
          </entry>
