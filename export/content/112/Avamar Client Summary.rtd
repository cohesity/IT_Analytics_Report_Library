  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>
--Author: rich.rose@aptare.com
--Last Modified: 05/10/2012
SELECT
client_id, 
c.hostname client,
agent_version, 
os_type, 
plugin_backup, 
master_server_id, 
s.hostname master_server,
avm_domain_name, 
allow_overtime, 
allow_user_snapup, 
allow_user_snapup_filesel, 
can_page, 
override_dataset, 
enabled, 
has_backups, 
override_init_ret_policy, 
is_registered, 
restore_only, 
is_override_ret_policy, 
backup_date, 
checkin_date, 
created_date, 
modified_date, 
registered_date, 
cid, 
overtime_option, 
page_address, 
page_addr_locked,
page_port, 
override_retry_count, 
retry_count, 
contact_email, 
contact_location, 
contact_name,
contact_notes, 
contact_phone,
timeout, 
override_timeout
FROM apt_v_avm_clients avc, apt_v_server c, apt_v_server s
WHERE client_id IN (${hosts})
AND client_id = c.server_id
AND master_server_id = s.server_id</string>
          </entry>
