<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 09/09/2011
SELECT
to_char(${startDate},&#039;MM/DD/YYYY&#039;) start_date_char,
to_char(${startDate},&#039;HH24&#039;) start_hour_char,
to_char(${endDate},&#039;MM/DD/YYYY&#039;) finish_date_char,
to_char(${endDate},&#039;HH24&#039;) finish_hour_char,
server_id,
server_name,
sum(DECODE(summary_status,2,1)) failed_count,
sum(DECODE(job_type_name,&#039;Expiration&#039;,1,0)) Expiration,
sum(DECODE(job_type_name,&#039;Full DB Backup&#039;,1,0)) Full_DB_Backup,
sum(DECODE(job_type_name,&#039;Incremental DB Backup&#039;,1,0)) Incr_DB_Backup,
sum(DECODE(job_type_name,&#039;Migration&#039;,1,0)) migration,
sum(DECODE(job_type_name,&#039;Move Media&#039;,1,0)) move_media,
sum(DECODE(job_type_name,&#039;Reclamation&#039;,1,0)) reclamation,
sum(DECODE(job_type_name,&#039;Storage Pool Backup&#039;,1,0)) stg_pool_backup,
sum(DECODE(job_type_name,&#039;Incr Backup&#039;,1,0)) Incr_Backup,
sum(DECODE(job_type_name,&#039;Archive&#039;,1,0)) Archive,
sum(DECODE(job_type_name,&#039;Command&#039;,1,0)) Command,
sum(DECODE(job_type_name,&#039;Restore&#039;,1,0)) restore,
sum(DECODE(job_type_name,&#039;Selective Backup&#039;,1,0)) selective_backup
FROM apt_v_job
WHERE start_date BETWEEN ${startDate} AND ${endDate}
AND client_id IN (${hosts})
GROUP BY server_id,server_name</string>
          </entry>
