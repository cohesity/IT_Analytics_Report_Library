                </componentScript>
                <configuration>
                  <entry>
                    <string>queryComboValues1</string>
                    <string>SELECT &apos; All&apos; key, &apos; All&apos; value FROM apt_v_dual UNION SELECT nsu.master_internal key, nsu.master_internal value FROM  apt_v_nbu_storage_unit nsu, apt_v_nbu_disk_volume ndv,  apt_v_ddm_logical_strg_unit ddsu, apt_v_server dds WHERE nsu.disk_pool_id = ndv.disk_pool_id AND ndv.external_link_id = ddsu.logical_storage_unit_id AND ddsu.host_id = dds.server_id</string>
                  </entry>
                  <entry>
                    <string>queryComboHeading1</string>
                    <string>Master Server:</string>
                  </entry>
                  <entry>
                    <string>sql</string>
                    <string>SELECT &apos; All&apos; key, &apos; All&apos; value FROM apt_v_dual UNION SELECT nsu.master_internal key, nsu.master_internal value FROM  apt_v_nbu_storage_unit nsu, apt_v_nbu_disk_volume ndv,  apt_v_ddm_logical_strg_unit ddsu, apt_v_server dds WHERE nsu.disk_pool_id = ndv.disk_pool_id AND ndv.external_link_id = ddsu.logical_storage_unit_id AND ddsu.host_id = dds.server_id</string>
                  </entry>
                </configuration>
                <referenceData/>
              </com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
            </list>
