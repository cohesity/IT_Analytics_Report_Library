          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 08/06/2015
WITH 
var AS (
SELECT
ROUND((${endDate} - ${startDate}),2) nbrOfDays,
DECODE(&apos;${freeCombo1}&apos;,
&apos;KB&apos;,1,&apos;MB&apos;,1024,&apos;GB&apos;,(1024*1024),&apos;TB&apos;,(1024*1024*1024),&apos;PB&apos;,(1024*1024*1024*1024)) div_by 
FROM apt_v_dual
),
ddsu AS (
SELECT
nsu.server_id,
nsu.master_internal master_server,
nsu.storage_unit_id,
nsu.storage_unit_label,
nsu.disk_pool_id,
ndv.disk_volume_id,
ndv.disk_volume_name,
ddsu.host_id data_domain_host_id,
dds.hostname data_domain_name
FROM 
apt_v_nbu_storage_unit nsu,
apt_v_nbu_disk_volume ndv, 
apt_v_ddm_logical_strg_unit ddsu,
apt_v_server dds
WHERE nsu.disk_pool_id = ndv.disk_pool_id
AND ndv.external_link_id = ddsu.logical_storage_unit_id
AND ddsu.host_id = dds.server_id
AND nsu.server_id IN (${hosts})
AND nsu.master_internal LIKE DECODE(&apos;${queryCombo1}&apos;,&apos; All&apos;,&apos;%&apos;,&apos;${queryCombo1}&apos;)
)
SELECT
d.server_id,
d.master_server,
d.storage_unit_id,
d.storage_unit_label,
d.data_domain_host_id,
d.data_domain_name,
COUNT(DISTINCT client_id) clients,
SUM(kilobytes/div_by) total_written,
ROUND(SUM(CASE WHEN expiration_date BETWEEN sysdate AND sysdate+30 THEN kilobytes END /div_by),2) less_than_30,
ROUND(SUM(CASE WHEN expiration_date BETWEEN sysdate+30 AND sysdate+60 THEN kilobytes END /div_by),2) bt_30_and_90,
ROUND(SUM(CASE WHEN expiration_date BETWEEN sysdate+60 AND sysdate+90 THEN kilobytes END /div_by),2) bt_60_and_90,
ROUND(SUM(CASE WHEN expiration_date &gt; sysdate+90 THEN kilobytes END /div_by),2) over_90,
ROUND(SUM(CASE WHEN expiration_date &lt; sysdate THEN kilobytes END/div_by),2) expired
FROM ddsu d, apt_v_nbu_job j, var
WHERE
j.client_id IN (${hosts})
AND j.server_id = d.server_id
AND j.storage_unit_id = d.storage_unit_id
AND j.start_date BETWEEN ${startDate} AND ${endDate}
AND expiration_date IS NOT NULL
GROUP BY 
d.server_id,
d.master_server,
d.storage_unit_id,
d.storage_unit_label,
d.data_domain_host_id,
d.data_domain_name</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
