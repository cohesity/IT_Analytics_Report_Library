<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Server Group Aggregation 1 level up
WITH 
g0 as (
SELECT max(group_id) server_group
FROM apt_v_group 
WHERE group_id IN (decode(&#039;${serverGroups}&#039;,&#039;&#039;,-1,&#039;${serverGroups}&#039;))
),
t1 as 
(
SELECT DISTINCT server_id
FROM apt_v_server
WHERE server_id IN
(SELECT m.child_id
FROM apt_v_group_member m,g0
WHERE m.child_type = 2
START WITH m.group_id =  g0.server_group 
CONNECT BY m.group_id = PRIOR m.child_id AND PRIOR m.child_type = 1)
),
t2 as (
SELECT
rtd.getServerGroupContextById(g0.server_group,client_id,1) Server_Group ,
count(DISTINCT client_id) Client_Count,
trunc(sum(kilobytes/1024/1024)) Backup_Volume_GB,
trunc(sum(nbr_of_files)) File_Count,
count(DISTINCT job_id) Job_Count,
sum(1*(1-abs(sign(summary_status-0)))) Success,
sum(1*(1-abs(sign(summary_status-1)))) Partial,
sum(1*(1-abs(sign(summary_status-2)))) Failed
FROM apt_v_job j,t1,g0
WHERE j.client_id = t1.server_id
AND start_date BETWEEN  ${startDate} AND ${endDate}
GROUP BY rtd.getServerGroupContextById(g0.server_group,client_id,1)
)
SELECT
server_group AS &quot;Group&quot;,
client_count AS &quot;Client Count&quot;,
Backup_Volume_GB AS &quot;Backup Volume (GB)&quot;,
File_Count AS &quot;File Count&quot;,
Job_Count &quot;Job Count&quot;,
Success AS &quot;Success&quot;,
Partial AS &quot;Partial&quot;,
Failed AS &quot;Failed&quot;,
trunc(Success/DECODE(Job_Count,0,null,Job_Count)*100) AS &quot;Success Pct&quot;
FROM t2</string>
          </entry>
