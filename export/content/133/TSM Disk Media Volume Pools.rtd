    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>SELECT s.hostname, dm.media_name,sp.storage_pool_name, dm.est_mbyte_capacity, dm.pct_utilized 
FROM apt_v_tsm_disk_media dm, apt_v_tsm_storage_pool sp, apt_v_server s
WHERE dm.storage_pool_id=sp.storage_pool_id
AND dm.server_id=s.server_id
AND dm.server_id IN (${hosts})
ORDER BY s.hostname, dm.media_name</string>
          </entry>
          <entry>
            <string>designerScript</string>
            <null/>
          </entry>
