          <entry>
            <string>dataSource</string>
            <string>WITH 
t1 AS (
SELECT
to_char(trunc(start_date,DECODE(&apos;${freeCombo2}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YY&apos;)),&apos;MM/DD/YYYY&apos;) the_date,
to_char(trunc(start_date,DECODE(&apos;${freeCombo2}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YY&apos;)),&apos;YYYYMMDD&apos;) sort_order,
server_name entity,
trunc(SUM(kilobytes/1024/1024)) job_size_gb,
COUNT(DISTINCT client_id) client_count,
SUM(nbr_of_files) file_count,
COUNT(DISTINCT job_id) job_count,
SUM(DECODE(summary_status,0,1)) successful_jobs,
SUM(DECODE(summary_status,1,1)) partial_jobs,
SUM(DECODE(summary_status,2,1)) failed_jobs,
AVG(mbytes_sec) mbytes_sec,
AVG(duration_secs/60) duration_min
FROM apt_v_job
WHERE 
server_name IN (&apos;${queryCombo1}&apos;,&apos;${queryCombo2}&apos;,&apos;${queryCombo3}&apos;)
AND start_date BETWEEN ${startDate} AND ${endDate}
GROUP BY
to_char(trunc(start_date,DECODE(&apos;${freeCombo2}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YY&apos;)),&apos;MM/DD/YYYY&apos;),
to_char(trunc(start_date,DECODE(&apos;${freeCombo2}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YY&apos;)),&apos;YYYYMMDD&apos;),
server_name
),
t2 AS (
SELECT
the_date,
sort_order,
entity,
DECODE(&apos;${freeCombo1}&apos;,
&apos;Job Size(GB)&apos;,job_size_gb,
&apos;Client Count&apos;,client_COUNT,
&apos;File Count&apos;,file_COUNT,
&apos;Job Count&apos;,job_COUNT,
&apos;Successful Jobs&apos;,successful_jobs,
&apos;Partial Jobs&apos;,partial_jobs,
&apos;Failed Jobs&apos;,failed_jobs,
&apos;MB/sec&apos;,mbytes_sec,
&apos;Duration(Min)&apos;,duration_MIN
) metric
FROM t1
),
t3 AS (
SELECT
the_date,
sort_order,
SUM(DECODE(entity,&apos;${queryCombo1}&apos;,metric,0)) metric1,
SUM(DECODE(entity,&apos;${queryCombo2}&apos;,metric,0)) metric2,
SUM(DECODE(entity,&apos;${queryCombo3}&apos;,metric,0)) metric3
FROM t2
GROUP BY 
the_date,
sort_order
)
SELECT
the_date,
sort_order,
&apos;${freeCombo1}&apos; report_on,
&apos;${queryCombo1}&apos; entity1,
metric1,
&apos;${queryCombo2}&apos; entity2,
metric2,
&apos;${queryCombo3}&apos; entity3,
metric3
FROM t3
ORDER BY sort_order</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
