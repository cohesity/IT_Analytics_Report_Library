              <com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
                <name>freeCombo</name>
                <componentScript>
                  <before/>
                  <after/>
                </componentScript>
                <configuration>
                  <entry>
                    <string>freeComboValues2</string>
                    <string>Day,Week,Month,Quarter,Year</string>
                  </entry>
                  <entry>
                    <string>freeComboHeading2</string>
                    <string>Group by:</string>
                  </entry>
                  <entry>
                    <string>freeComboValues1</string>
                    <string>Job Size(GB),Client Count,File Count,Job Count,Successful Jobs,Partial Jobs,Failed Jobs,MB/sec,Duration(Min)</string>
                  </entry>
                  <entry>
                    <string>freeComboHeading1</string>
                    <string>Report on:</string>
                  </entry>
                </configuration>
                <referenceData/>
              </com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
              <com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
                <name>freeQueryCombo</name>
                <componentScript>
                  <before/>
                  <after/>
                </componentScript>
                <configuration>
                  <entry>
                    <string>queryComboValues1</string>
                    <string>SELECT DISTINCT hostname key,hostname value FROM apt_v_server WHERE server_type_name IN (&apos;NetBackup Master&apos;,&apos;TSM Server&apos;,&apos;CommVault Simpana Server&apos;,&apos;EMC Avamar Server&apos;,&apos;NetWorker Server&apos;,&apos;Data Protector Cell Manager&apos;) AND date_modified &gt;= sysdate -31 ORDER BY UPPER(hostname)</string>
                  </entry>
                  <entry>
                    <string>queryComboValues2</string>
                    <string>SELECT DISTINCT hostname key,hostname value FROM apt_v_server WHERE server_type_name IN (&apos;NetBackup Master&apos;,&apos;TSM Server&apos;,&apos;CommVault Simpana Server&apos;,&apos;EMC Avamar Server&apos;,&apos;NetWorker Server&apos;,&apos;Data Protector Cell Manager&apos;) AND date_modified &gt;= sysdate -31 ORDER BY UPPER(hostname)</string>
                  </entry>
                  <entry>
                    <string>queryComboValues3</string>
                    <string>SELECT DISTINCT hostname key,hostname value FROM apt_v_server WHERE server_type_name IN (&apos;NetBackup Master&apos;,&apos;TSM Server&apos;,&apos;CommVault Simpana Server&apos;,&apos;EMC Avamar Server&apos;,&apos;NetWorker Server&apos;,&apos;Data Protector Cell Manager&apos;) AND date_modified &gt;= sysdate -31 ORDER BY UPPER(hostname)</string>
                  </entry>
                  <entry>
                    <string>queryComboHeading3</string>
                    <string>Backup Server 3:</string>
                  </entry>
                  <entry>
                    <string>queryComboHeading2</string>
                    <string>Backup Server 2:</string>
                  </entry>
                  <entry>
                    <string>queryComboHeading1</string>
                    <string>Backup Server 1:</string>
                  </entry>
                  <entry>
                    <string>sql</string>
                    <string>SELECT DISTINCT hostname key,hostname value FROM apt_v_server WHERE server_type_name IN (&apos;NetBackup Master&apos;,&apos;TSM Server&apos;,&apos;CommVault Simpana Server&apos;,&apos;EMC Avamar Server&apos;,&apos;NetWorker Server&apos;,&apos;Data Protector Cell Manager&apos;) AND date_modified &gt;= sysdate -31 ORDER BY UPPER(hostname)</string>
                  </entry>
                </configuration>
                <referenceData/>
              </com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
