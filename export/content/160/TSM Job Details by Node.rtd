<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.colm
--Last Modified: 04/05/2012
SELECT 
tj.server_name,
tj.client_id,
tj.client_name tcp_name,
tj.node_id,
tj.node_name,
tj.job_type_name,
tj.domain_name,
tj.schedule_name,
tsp.storage_pool_name,
CASE tj.summary_status 
WHEN 0 THEN &#039;blue&#039;
WHEN 1 THEN &#039;yellow&#039;
ELSE &#039;red&#039;
END status_color,
CASE tj.summary_status 
WHEN 0 THEN &#039;Successful&#039;
WHEN 1 THEN &#039;Partial&#039;
ELSE &#039;Failed&#039;
END status_name,
CASE tj.vendor_status
WHEN 1 THEN &#039;Completed&#039;
WHEN 2 THEN &#039;Missed&#039;
WHEN 3 THEN &#039;Failed&#039;
WHEN 4 THEN &#039;Started&#039;
WHEN 5 THEN &#039;Restarted&#039;
WHEN 6 THEN &#039;Severed&#039;
WHEN 7 THEN &#039;Future&#039;
WHEN 8 THEN &#039;Pending&#039;
WHEN 9 THEN &#039;Uncertain&#039;
WHEN 10 THEN &#039;In Progress&#039;
WHEN null THEN &#039;Unknown&#039;
ELSE &#039;Unknown&#039;
END state,
tj.start_date,
tj.finish_date,
rtd.secsToHoursMinSecs((finish_date-start_date)*24*60*60) duration,
tj.kilobytes/1024/1024 size_gb, 
tj.nbr_of_files, 
tj.mbytes_sec 
FROM apt_v_tsm_job tj, apt_v_tsm_storage_pool tsp
WHERE tj.client_id IN (${hosts})
AND tj.finish_date BETWEEN ${startDate} AND ${endDate}
AND tj.storage_pool_id = tsp.storage_pool_id(+)
ORDER BY tj.finish_date DESC</string>
          </entry>
