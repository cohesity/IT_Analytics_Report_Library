          <entry>
            <string>dataSource</string>
            <string>
--Author: rich.rose@aptare.com
--Last Modified: 05/10/2012
SELECT to_char(start_date,&apos;Mon DD&apos;) run_date, master_host_name||&apos; - &apos;||policy_name master_server_policy,  
DECODE(max(summary_status),0,&apos;&lt;img src=&quot;../skins/aptare/statusBlue.gif&quot;&gt;&amp;nbsp;&lt;/img&gt;&apos; ,1,&apos;&lt;img src=&quot;../skins/aptare/statusYellow.gif&quot;&gt;&amp;nbsp;&lt;/img&gt;&apos;,2,&apos;&lt;img src=&quot;../skins/aptare/statusRed.gif&quot;&gt;&amp;nbsp;&lt;/img&gt;&apos;
)
status 
FROM apt_v_nbu_job_detail
WHERE start_date BETWEEN ${startDate} AND ${endDate}
AND client_id in (${hosts})
AND policy_name IS NOT NULL
AND start_date IS NOT NULL
GROUP BY to_char(start_date,&apos;Mon DD&apos;), master_host_name||&apos; - &apos;||policy_name</string>
          </entry>
