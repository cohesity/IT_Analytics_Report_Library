<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>WITH t1 as (
SELECT
trunc(aa.recorded_date,DECODE(&#039;${freeCombo1}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;)) the_date,
sum(scanned_kb/1024/1024) scanned_gb,
sum(new_kb/1024/1024) new_gb
FROM 
apt_v_avm_activities aa, apt_v_job j
WHERE 
aa.job_id = j.job_id
AND aa.recorded_date BETWEEN ${startDate} AND ${endDate}
AND aa.server_id = DECODE(${queryCombo1},999,aa.server_id,${queryCombo1})
GROUP BY trunc(aa.recorded_date,DECODE(&#039;${freeCombo1}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;))
)
SELECT
the_date,
scanned_gb,
new_gb,
100-((new_gb/scanned_gb)*100) dedup_pct
FROM t1</string>
          </entry>
          <entry>
            <string>designerScript</string>
            <null/>
          </entry>
