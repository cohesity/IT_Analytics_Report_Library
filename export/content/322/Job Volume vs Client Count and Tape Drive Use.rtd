  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>descriptiveName</string>
            <string>Job Volume vs Client Count and Tape Drive Use</string>
          </entry>
          <entry>
            <string>drilldown</string>
            <boolean>false</boolean>
          </entry>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 12/03/2014
WITH 
j1 AS (
SELECT 
TO_CHAR(TRUNC(j.start_date,&#039;HH24&#039;),&#039;HH24&#039;) the_date,
TO_CHAR(j.start_date,&#039;MM/DD/YY HH24&#039;) pretty_date,
COUNT(DISTINCT job_id) job_count,
RATIO_TO_REPORT(COUNT(DISTINCT job_id)) OVER() rr_job_count,
COUNT(DISTINCT client_id) client_count,
RATIO_TO_REPORT(COUNT(DISTINCT client_id)) OVER() rr_client_count,
SUM(kilobytes/1024/1024) gb_written,
RATIO_TO_REPORT(SUM(kilobytes/1024/1024)) OVER() rr_gb_written
FROM apt_v_job j
WHERE
j.server_name = &#039;${queryCombo1}&#039;
AND j.start_date BETWEEN ${startDate} AND ${endDate}
GROUP BY
TO_CHAR(TRUNC(j.start_date,&#039;HH24&#039;),&#039;HH24&#039;),
TO_CHAR(j.start_date,&#039;MM/DD/YY HH24&#039;)
),
t1 AS (
SELECT 
TO_CHAR(TRUNC(tdl.poll_time,&#039;HH24&#039;),&#039;HH24&#039;) the_date,
TO_CHAR(tdl.poll_time,&#039;MM/DD/YY HH24&#039;) pretty_date,
SUM(DECODE(tdl.in_use,&#039;Y&#039;,1,0)) in_use_count
FROM
apt_v_tape_drive td, apt_v_tape_drive_log tdl
WHERE 
td.drive_id = tdl.drive_id
AND td.management_server_name = &#039;${queryCombo1}&#039;
AND poll_time BETWEEN ${startDate} AND ${endDate}
GROUP BY
TO_CHAR(TRUNC(tdl.poll_time,&#039;HH24&#039;),&#039;HH24&#039;),
TO_CHAR(tdl.poll_time,&#039;MM/DD/YY HH24&#039;) 
)
SELECT
j1.the_date,
j1.pretty_date,
t1.in_use_count,
j1.job_count,
ROUND((j1.rr_job_count*100),2) rr_job_count,
j1.client_count,
j1.rr_client_count,
ROUND((j1.rr_client_count*100),2) rr_client_count, 
ROUND(gb_written,2) gb_written,
ROUND((rr_gb_written*100),2) rr_gb_written,
DECODE(&#039;${freeCombo1}&#039;,&#039;Job Count&#039;,j1.job_count,&#039;Job Volume&#039;,j1.gb_written) the_metric
FROM j1, t1
WHERE j1.pretty_date = t1.pretty_date (+)</string>
          </entry>
