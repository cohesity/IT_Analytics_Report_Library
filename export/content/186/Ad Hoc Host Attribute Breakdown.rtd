                <configuration>
                  <entry>
                    <string>freeComboValues1</string>
                    <string># Hosts,SAN Allocated Capacity,NAS Capacity</string>
                  </entry>
                  <entry>
                    <string>freeComboHeading1</string>
                    <string>Metric:</string>
                  </entry>
                </configuration>
                <referenceData/>
              </com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
              <com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
                <name>freeQueryCombo</name>
                <componentScript>
                  <before/>
                  <after/>
                </componentScript>
                <configuration>
                  <entry>
                    <string>sql</string>
                    <string>SELECT replace(attribute_name,&#039; &#039;,&#039;_&#039;) attribute_name,attribute_name FROM apt_v_attribute where attribute_type = &#039;S&#039;</string>
                  </entry>
                  <entry>
                    <string>queryComboValues1</string>
                    <string>SELECT replace(attribute_name,&#039; &#039;,&#039;_&#039;) attribute_name,attribute_name FROM apt_v_attribute where attribute_type = &#039;S&#039;</string>
                  </entry>
                  <entry>
                    <string>queryComboHeading1</string>
                    <string>Attribute:</string>
                  </entry>
                </configuration>
                <referenceData/>
              </com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
            </list>
          </entry>
