<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>
--Author: rich.rose@aptare.com
--Last Modified: 05/10/2012
WITH 
t1 AS (
SELECT ${queryCombo1} attribute,
count(hs.host_id) nbr_of_hosts,
sum(hs.allocated_capacity_gb) allocated_capacity_gb,
sum(hs.total_nas_capacity_gb) total_nas_capacity_gb
FROM apt_v_server_attribute sa, aps_v_host_storage hs
WHERE hs.host_id IN (${hosts})
AND hs.host_id = sa.host_id
GROUP BY ${queryCombo1}
)
SELECT
attribute,
DECODE(&#039;${freeCombo1}&#039;,
&#039;# Hosts&#039;,nbr_of_hosts,
&#039;SAN Allocated Capacity&#039;,allocated_capacity_gb,
&#039;NAS Capacity&#039;,total_nas_capacity_gb) 
metric
FROM t1
WHERE 
DECODE(&#039;${freeCombo1}&#039;,
&#039;# Hosts&#039;,nbr_of_hosts,
&#039;SAN Allocated Capacity&#039;,allocated_capacity_gb,
&#039;NAS Capacity&#039;,total_nas_capacity_gb) &gt; 0</string>
          </entry>
          <entry>
            <string>designerScript</string>
            <null/>
          </entry>
