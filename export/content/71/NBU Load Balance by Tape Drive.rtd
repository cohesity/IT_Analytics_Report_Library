<com.aptare.sc.dal.versioning.ObjectMap>
  <version>1</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>WITH 
avg_tpt AS (
SELECT to_char(j.start_date,&#039;MM/DD/YY&#039;) avg_run_date,  
ROUND(NVL(avg(jtm.kilobytes/1024/1024),0 ) , 2) avgSize
FROM apt_v_nbu_job_detail j, apt_v_nbu_job_tape_media jtm, apt_v_nbu_tape_drive td
WHERE j.job_id = jtm.job_id
  AND jtm.drive_id = td.drive_id
  AND j.start_date BETWEEN ${startDate} AND ${endDate}
  AND j.finish_date        IS NOT NULL
  AND j.client_id in (${hosts})
  AND j.kilobytes          &gt; 1024
  AND j.summary_status     &lt;= 1
GROUP BY to_char(j.start_date,&#039;MM/DD/YY&#039;)
),
t1 AS (
SELECT to_char(j.start_date,&#039;MM/DD/YY&#039;) run_date, td.drive_name,  
ROUND(NVL(avg(jtm.kilobytes/1024/1024),0 ) , 2) size_gb
FROM apt_v_nbu_job_detail j, apt_v_nbu_job_tape_media jtm, apt_v_nbu_tape_drive td
WHERE j.job_id = jtm.job_id
  AND jtm.drive_id = td.drive_id
  AND j.start_date BETWEEN ${startDate} AND ${endDate}
  AND j.finish_date        IS NOT NULL
  AND j.client_id in (${hosts})
  AND j.kilobytes          &gt; 1024
  AND j.summary_status     &lt;= 1
GROUP BY to_char(start_date,&#039;MM/DD/YY&#039;), td.drive_name
)
SELECT run_date, drive_name, 
CASE WHEN size_gb &gt;= avgSize+(avgSize*(${freeCombo1}*.01))
  THEN &#039;&lt;font color=&quot;red&quot;&gt;&#039;||size_gb||&#039;&lt;/font&gt;&#039;
  ELSE &#039;&lt;font color=&quot;blue&quot;&gt;&#039;||size_gb||&#039;&lt;/font&gt;&#039;
END size_gb
FROM t1, avg_tpt</string>
          </entry>
          <entry>
