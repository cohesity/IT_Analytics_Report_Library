  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 02/15/2012
WITH 
t1 AS (
SELECT
to_number(to_char(log_date,&#039;YYYYMMDD&#039;)) the_date,
storage_array_id,
max(allocated_gb) allocated_gb
FROM aps_v_storage_array_log
WHERE log_date BETWEEN ${startDate} AND ${endDate}
GROUP BY to_number(to_char(log_date,&#039;YYYYMMDD&#039;)),
storage_array_id
),
t2 AS (
SELECT
to_number(to_char(log_date,&#039;YYYYMMDD&#039;)) the_date,
storage_array_id,
max(allocated_gb) allocated_gb
FROM aps_v_storage_array_log
WHERE log_date BETWEEN ${startDate} AND ${endDate}
GROUP BY to_number(to_char(log_date,&#039;YYYYMMDD&#039;)),
storage_array_id
)
SELECT 
t1.storage_array_id,
sa.array_name,
to_date(t2.the_date,&#039;YYYYMMDD&#039;) the_date,
t1.allocated_gb t1_allocated_gb,
t2.allocated_gb t2_allocated_gb,
t2.allocated_gb-t1.allocated_gb alloc_de_alloc
FROM t1,t2, aps_v_storage_array sa
WHERE t1.storage_array_id = sa.storage_array_id
AND t1.storage_array_id=t2.storage_array_id 
AND t1.the_date = t2.the_date+1
AND t2.allocated_gb-t1.allocated_gb &lt;&gt; 0
ORDER BY 3</string>
          </entry>
