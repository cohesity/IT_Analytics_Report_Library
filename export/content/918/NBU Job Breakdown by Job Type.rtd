          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 05/07/2012
SELECT
to_char(trunc(start_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;)),&apos;MM/DD/YY&apos;) the_date,
SUM(DECODE(job_type,101,1,0)) AS &quot;Full&quot;,
SUM(DECODE(job_type,102,1,0)) AS &quot;Incremental&quot;,
SUM(DECODE(job_type,103,1,0)) AS &quot;Catalog&quot;,
SUM(DECODE(job_type,104,1,0)) AS &quot;Archive&quot;,
SUM(DECODE(job_type,105,1,0)) AS &quot;Restore&quot;,
SUM(DECODE(job_type,106,1,0)) AS &quot;Verify&quot;,
SUM(DECODE(job_type,107,1,0)) AS &quot;Duplication&quot;,
SUM(DECODE(job_type,108,1,0)) AS &quot;Import&quot;,
SUM(DECODE(job_type,109,1,0)) AS &quot;Vault&quot;,
SUM(DECODE(job_type,110,1,0)) AS &quot;Label&quot;,
SUM(DECODE(job_type,111,1,0)) AS &quot;Media Erase&quot;,
SUM(DECODE(job_type,112,1,0)) AS &quot;Application&quot;,
SUM(DECODE(job_type,113,1,0)) AS &quot;Tape Request&quot;,
SUM(DECODE(job_type,114,1,0)) AS &quot;Drive Cleaning&quot;,
SUM(DECODE(job_type,115,1,0)) AS &quot;Optical Format&quot;,
SUM(DECODE(job_type,116,1,0)) AS &quot;Inventory Library&quot;,
SUM(DECODE(job_type,117,1,0)) AS &quot;DB Recover&quot;,
SUM(DECODE(job_type,118,1,0)) AS &quot;Media Listing&quot;,
SUM(DECODE(job_type,119,1,0)) AS &quot;Job Qualification&quot;
FROM apt_v_nbu_job
WHERE client_id IN (${hosts})
AND start_date BETWEEN ${startDate} AND ${endDate}
GROUP BY to_char(trunc(start_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;)),&apos;MM/DD/YY&apos;)</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
