<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 10/03/2011
WITH 
var AS (
SELECT
--User Defined Threshholds
1 AS yellow_threshold,
2 AS red_threshold
FROM dual
),
q1 AS (
SELECT
to_char(${startDate},&#039;MM/DD/YYYY&#039;) start_date_char,
to_char(${startDate},&#039;HH24&#039;) start_hour_char,
to_char(${endDate},&#039;MM/DD/YYYY&#039;) finish_date_char,
to_char(${endDate},&#039;HH24&#039;) finish_hour_char,
server_id,
server_name,
sum(DECODE(job_type_name,&#039;Expiration&#039;,1,0)) Expiration,
sum(DECODE(job_type_name,&#039;Full DB Backup&#039;,1,0)) Full_DB_Backup,
sum(DECODE(job_type_name,&#039;Incremental DB Backup&#039;,1,0)) Incr_DB_Backup,
sum(DECODE(job_type_name,&#039;Migration&#039;,1,0)) migration,
sum(DECODE(job_type_name,&#039;Move Media&#039;,1,0)) move_media,
sum(DECODE(job_type_name,&#039;Reclamation&#039;,1,0)) reclamation,
sum(DECODE(job_type_name,&#039;Storage Pool Backup&#039;,1,0)) stg_pool_backup,
sum(DECODE(job_type_name,&#039;Incr Backup&#039;,1,0)) Incr_Backup,
sum(DECODE(job_type_name,&#039;Archive&#039;,1,0)) Archive,
sum(DECODE(job_type_name,&#039;Command&#039;,1,0)) Command,
sum(DECODE(job_type_name,&#039;Restore&#039;,1,0)) restore,
sum(DECODE(job_type_name,&#039;Selective Backup&#039;,1,0)) selective_backup
FROM apt_v_job
WHERE start_date BETWEEN ${startDate} AND ${endDate}
AND server_id IN (${hosts})
AND summary_status = 2
GROUP BY server_id,server_name
)
SELECT
start_date_char,
start_hour_char,
finish_date_char,
finish_hour_char,
server_id,
server_name,
expiration,
CASE WHEN expiration &gt;= var.red_threshold THEN &#039;red&#039; WHEN expiration &gt;= var.yellow_threshold THEN &#039;yellow&#039;  ELSE &#039;green&#039; END expiration_dot,
full_DB_Backup,
CASE WHEN full_DB_Backup &gt;= var.red_threshold THEN &#039;red&#039; WHEN full_DB_Backup &gt;= var.yellow_threshold THEN &#039;yellow&#039;  ELSE &#039;green&#039; END full_DB_Backup_dot,
incr_DB_Backup,
CASE WHEN incr_DB_Backup &gt;= var.red_threshold THEN &#039;red&#039; WHEN incr_DB_Backup &gt;= var.yellow_threshold THEN &#039;yellow&#039; ELSE &#039;green&#039; END incr_DB_Backup_dot,
migration,
CASE WHEN migration &gt;= var.red_threshold THEN &#039;red&#039; WHEN migration &gt;= var.yellow_threshold THEN &#039;yellow&#039; ELSE &#039;green&#039; END migration_dot,
move_media,
CASE WHEN move_media &gt;= var.red_threshold THEN &#039;red&#039; WHEN move_media &gt;= var.yellow_threshold THEN &#039;yellow&#039; ELSE &#039;green&#039; END move_media_dot,
reclamation,
CASE WHEN reclamation &gt;= var.red_threshold THEN &#039;red&#039; WHEN reclamation &gt;= var.yellow_threshold THEN &#039;yellow&#039; ELSE &#039;green&#039; END reclamation_dot,
stg_pool_backup,
CASE WHEN stg_pool_backup &gt;= var.red_threshold THEN &#039;red&#039; WHEN stg_pool_backup &gt;= var.yellow_threshold THEN &#039;yellow&#039; ELSE &#039;green&#039; END stg_pool_backup_dot,
incr_backup,
CASE WHEN incr_backup &gt;= var.red_threshold THEN &#039;red&#039; WHEN incr_backup &gt;= var.yellow_threshold THEN &#039;yellow&#039; ELSE &#039;green&#039; END incr_backup_dot,
Archive,
CASE WHEN archive &gt;= var.red_threshold THEN &#039;red&#039; WHEN archive &gt;= var.yellow_threshold THEN &#039;yellow&#039; ELSE &#039;green&#039; END archive_dot,
command,
CASE WHEN command &gt;= var.red_threshold THEN &#039;red&#039; WHEN command &gt;= var.yellow_threshold THEN &#039;yellow&#039; ELSE &#039;green&#039; END command_dot,
restore,
CASE WHEN restore &gt;= var.red_threshold THEN &#039;red&#039; WHEN restore &gt;= var.yellow_threshold THEN &#039;yellow&#039; ELSE &#039;green&#039; END restore_dot,
selective_backup,
CASE WHEN selective_backup &gt;= var.red_threshold THEN &#039;red&#039; WHEN selective_backup &gt;= var.yellow_threshold THEN &#039;yellow&#039; ELSE &#039;green&#039; END selective_backup_dot,
var.yellow_threshold,var.red_threshold
FROM q1,var</string>
          </entry>
