          <entry>
            <string>dataSource</string>
            <string>
--Author: rich.rose@aptare.com
--Last Modified: 05/10/2012
WITH 
t1 AS (
SELECT
DISTINCT
lh.host_id,
lu.storage_array_id,
lu.logical_unit_id,
lu.total_capacity_gb
FROM aps_v_lun_hosts lh, aps_v_logical_unit lu
WHERE lh.logical_unit_id = lu.logical_unit_id
AND host_id IN (${hosts})
),
t2 AS (
SELECT
nvl(rtd.getObjectAttributeValue(t1.storage_array_id,&apos;Site&apos;,&apos;A&apos;),&apos;Other&apos;) Site,
t1.host_id,
h.host_name,
t1.storage_array_id,
sa.array_name,
sa.array_family,
sa.capacity_gb array_capacity_gb,
count(t1.logical_unit_id) nbr_of_luns,
sum(t1.total_capacity_gb) total_capacity_gb
FROM t1, aps_v_host h, aps_v_storage_array sa
WHERE t1.host_id = h.host_id
AND t1.storage_array_id = sa.storage_array_id
GROUP BY 
nvl(rtd.getObjectAttributeValue(t1.storage_array_id,&apos;Site&apos;,&apos;A&apos;),&apos;Other&apos;),
t1.host_id,
h.host_name,
t1.storage_array_id,
sa.array_name,
sa.array_family,
sa.capacity_gb
)
SELECT
site,
host_id,
host_name,
nbr_of_luns,
total_capacity_gb,
total_capacity_gb/array_capacity_gb*100 pct_of_array,
storage_array_id,
array_name,
array_family
FROM t2</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
