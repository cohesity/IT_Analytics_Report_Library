          <entry>
            <string>dataSource</string>
            <string>--failed or no backup for last 3 days
WITH 
t_3 as (
  SELECT client_id, min(summary_status) min_status
  FROM apt_v_job
  WHERE 
  start_date BETWEEN TRUNC(SYSDATE-3) AND TRUNC(SYSDATE-2)
  AND client_id IN (${hosts})
  GROUP BY client_id
),
t_2 as (
  SELECT client_id, min(summary_status) min_status
  FROM apt_v_job
  WHERE 
  start_date BETWEEN TRUNC(SYSDATE-2) AND TRUNC(SYSDATE-1)
  AND client_id IN (${hosts})
  GROUP BY client_id
),
t_1 as (
  SELECT client_id, min(summary_status) min_status
  FROM apt_v_job
  WHERE 
  start_date BETWEEN TRUNC(SYSDATE-1) AND SYSDATE
  AND client_id IN (${hosts})
  GROUP BY client_id
),
ts as (
  SELECT s.server_id,s.display_name, 
  DECODE(t_3.min_status,2,&apos;1&apos;,null,&apos;0&apos;) three_days_ago,
  DECODE(t_2.min_status,2,&apos;1&apos;,null,&apos;0&apos;) two_days_ago,
  DECODE(t_1.min_status,2,&apos;1&apos;,null,&apos;0&apos;) Last_Night
  FROM  t_3, t_2, t_1, apt_v_server s
  WHERE s.server_id IN (${hosts})
  AND s.server_id=t_3.client_id (+)
  AND s.server_id=t_2.client_id (+) 
  AND s.server_id=t_1.client_id (+)
)
SELECT 
&apos;&lt;a href=&quot;#&quot; onclick=&quot;drilldown(&apos;&apos;../report/drillDown.mvc?systemName=displayServerDetail&amp;amp;serverId=&apos;||ts.server_id||&apos;&apos;&apos;, this, &apos;&apos;&apos;&apos; );&quot;&gt;&apos;||ts.display_name||&apos;&lt;/a&gt;&apos; Client,
  DECODE ((ts.three_days_ago+ts.two_days_ago+ts.Last_Night),
           0,&apos;No backup for 3 days&apos;,
           2,&apos;2 Failed backups in last 3 days&apos;,
           3,&apos;Failed backups 3 days in a row&apos;,
           &apos;No backup at all&apos;
         ) status
  FROM ts
  WHERE (ts.three_days_ago+ts.two_days_ago+ts.Last_Night) IS NOT NULL
  ORDER BY Upper(ts.display_name)</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
