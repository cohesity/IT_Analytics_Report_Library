          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 02/13/2020
WITH
VAR AS (
SELECT
DECODE(&apos;${freeCombo1}&apos;, &apos;KB&apos;,1,&apos;MB&apos;,1024,&apos;GB&apos;,(1024*1024),&apos;TB&apos;,(1024*1024*1024),&apos;PB&apos;,(1024*1024*1024*1024)) div_by 
FROM apt_v_dual 
)
SELECT
vs.host_id AS virtual_system_host_id,
vs.virtual_system_id,
vs.virtual_system_name,
vf.partition_id,
vf.vm_id,
vf.vm_name,
vf.host_id AS vm_guest_host_id,
vf.host_name AS vm_guest_host_name,
SUM(vf.file_size/div_by) total_vm_size,
SUM(DECODE(vf.file_type,&apos;VmDisk&apos;,vf.file_size/div_by,0)) VmDisk,
SUM(DECODE(vf.file_type,&apos;VmSuspendState&apos;,vf.file_size/div_by,0)) VmSuspendState,
SUM(DECODE(vf.file_type,&apos;VmSwapFile&apos;,vf.file_size/div_by,0)) VmSwapFile,
(SUM(DECODE(vf.file_type,&apos;VmSnapshot&apos;,vf.file_size/div_by,0)) +
SUM(DECODE(vf.file_type,&apos;VmSnapshotMetaData&apos;,vf.file_size/div_by,0))) VmSnapshot,
SUM(DECODE(vf.file_type,&apos;FolderFile&apos;,vf.file_size/div_by,0)) FolderFile,
(SUM(DECODE(vf.file_type,&apos;VmConfigFile&apos;,vf.file_size/div_by,0)) +
SUM(DECODE(vf.file_type,&apos;VmConfigTeam&apos;,vf.file_size/div_by,0))) VmConfig,
SUM(DECODE(vf.file_type,&apos;VmLog&apos;,vf.file_size/div_by,0)) VmLog,
SUM(DECODE(vf.file_type,&apos;VmNvram&apos;,vf.file_size/div_by,0)) VmNvram,
SUM(DECODE(vf.file_type,&apos;Other&apos;,vf.file_size/div_by,0)) Other
FROM 
  apt_v_virtual_system vs, apt_v_vmw_vmfile vf, var
WHERE 
  vf.virtual_system_id = vs.virtual_system_id
  AND vs.host_id IN (${hosts})
GROUP BY
  vs.host_id,
  vs.virtual_system_id,
  vs.virtual_system_name,
  vf.partition_id,
  vf.vm_id,
  vf.vm_name,
  vf.host_id,
  vf.host_name</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
