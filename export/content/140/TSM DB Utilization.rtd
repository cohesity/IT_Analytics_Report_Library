<com.aptare.sc.dal.versioning.ObjectMap>
  <version>1</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>WITH 
s1 AS (        
SELECT i.server_instance_id, i.instance_name, d.avail_space_mbytes, d.capacity_mbytes,
               (d.page_size_bytes/(1024*1024) * d.used_pages) / (d.capacity_mbytes+.001) * 100 pct_utilized
    FROM apt_v_tsm_database d,  apt_v_server_instance i
    WHERE d.server_id  IN (${hosts})
      AND d.server_instance_id = i.server_instance_id
    ),
s2 AS (
SELECT l.server_instance_id, MAX((l.page_size_bytes/(1024*1024) * l.used_pages) / (l.capacity_mbytes+.001) * 100) max_pct_used
    FROM apt_v_tsm_database_log l, s1
    WHERE l.server_instance_id = s1.server_instance_id
      AND l.log_date BETWEEN ${startDate} AND ${endDate}
    GROUP BY l.server_instance_id
)
SELECT s1.instance_name,
   s1.avail_space_mbytes/1024 avail_space_gbytes,
   s1.capacity_mbytes/1024 capacity_gbytes,
   s1.pct_utilized,
   s2.max_pct_used
   FROM s1, s2
   WHERE s1.server_instance_id = s2.server_instance_id</string>
          </entry>
          <entry>
            <string>designerScript</string>
            <null/>
          </entry>
