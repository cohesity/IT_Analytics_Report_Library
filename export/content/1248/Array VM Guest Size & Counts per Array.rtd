          <entry>
            <string>dataSource</string>
            <string>--Author rich.rose@aptare.com
--Last Updated: 10/18/2018
WITH 
VAR AS (
SELECT
&apos;${freeCombo1}&apos; unit,
DECODE(&apos;${freeCombo1}&apos;, &apos;GB&apos;,(1024*1024),&apos;TB&apos;,(1024*1024*1024),&apos;PB&apos;,(1024*1024*1024*1024)) div_by
FROM apt_v_dual
),
t1 AS (
SELECT
vf.vm_id, vf.vm_name, 
vf.host_id, vf.host_name, 
vf.vm_host_id, vf.vm_host_name, vf.vm_status,
vf.vmw_datastore_id, vf.datastore_name, 
vf.file_name, 
vf.file_path, 
vf.file_type, 
ROUND(vf.file_size/div_by,2) file_size, 
vf.storage_array_id, vf.array_name, 
vf.logical_unit_id, vf.logical_unit_name, 
vf.last_updated
FROM var, apt_v_vmw_vmfile vf 
WHERE
vf.storage_array_id IN (${arrays})
AND vf.logical_unit_id IS NOT NULL
)
SELECT
array_name,
COUNT(DISTINCT vm_id) nbr_of_guests,
COUNT(DISTINCT vmw_datastore_id) nbr_of_datastores,
SUM(CASE WHEN file_type = &apos;VmDisk&apos; THEN file_size ELSE 0 END) vmdk_size,
SUM(CASE WHEN file_type = &apos;VmDisk&apos; THEN 0 ELSE file_size END) other_size
FROM t1
GROUP BY
array_name
ORDER BY 4 DESC</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
