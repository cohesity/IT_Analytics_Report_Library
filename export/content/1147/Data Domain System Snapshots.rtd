          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 08/06/2015
WITH 
var AS (
SELECT
DECODE(&apos;${freeCombo1}&apos;,
&apos;KB&apos;,1,&apos;MB&apos;,(1024),&apos;GB&apos;,(1024*1024),&apos;TB&apos;,(1024*1024*1024),&apos;PB&apos;,(1024*1024*1024*1024)) div_by 
FROM apt_v_dual
)
SELECT
ss.host_id,
h.host_name,
ss.snapshot_name,
ss.pre_compression_kb/div_by pre_compression,
ss.created_date,
ss.retain_until_date,
ss.snapshot_status,
ss.mtree_name,
ss.last_updated
FROM apt_v_ddm_system_snapshot ss, aps_v_host h, var
WHERE ss.created_date BETWEEN ${startDate} AND ${endDate}
AND ss.host_id = h.host_id
AND ss.host_id IN (${hosts})</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
