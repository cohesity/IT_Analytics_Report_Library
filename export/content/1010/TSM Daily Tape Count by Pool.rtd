          <entry>
            <string>dataSource</string>
            <string>
--Author: rich.rose@aptare.com
--Last Modified: 05/10/2012
SELECT to_char(poll_date,&apos;MM/DD/YY&apos;) poll_date, storage_pool_name,
    sum(nbr_of_volumes) nbr_of_volumes
    FROM apt_v_tsm_occupancy_log 
    WHERE client_id IN (${hosts})
      AND poll_date BETWEEN ${startDate} AND ${endDate}
    GROUP BY to_char(poll_date,&apos;MM/DD/YY&apos;), storage_pool_name</string>
          </entry>
