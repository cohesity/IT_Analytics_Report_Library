          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 12/13/2018
SELECT
x.server_id,
x.server_name master_server,
x.client_id,
c.hostname client,
x.policy_id,
p.policy_name policy,
REPLACE(aptStringConcat(DISTINCT x.path),&#039;,&#039;,&#039;&lt;br&gt;&#039;) excluded_paths
FROM
apt_v_nbu_incld_excld_path x, apt_v_server c, apt_v_nbu_policy p
WHERE
x.server_id IN (${hosts}) 
AND x.include_exclude = &#039;Exclude&#039;
AND x.client_id = c.server_id
AND x.policy_id = p.policy_id
GROUP BY
x.server_id,
x.server_name,
x.client_id,
c.hostname,
x.policy_id,
p.policy_name</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
