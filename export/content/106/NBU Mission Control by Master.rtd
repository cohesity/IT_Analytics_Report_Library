  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 07/11/2012
WITH t1 AS (
SELECT
to_char(start_date,&#039;MM/DD/YY&#039;) the_date,
master_host_name,
count(job_id) total_jobs,
sum(DECODE(summary_status,0,1,0)) success,
sum(DECODE(summary_status,1,1,0)) partial,
sum(DECODE(summary_status,2,1,0)) failed
FROM apt_v_nbu_job
WHERE client_id IN (${hosts})
AND start_date BETWEEN ${startDate} AND ${endDate}
AND summary_status IS NOT NULL
GROUP BY to_char(start_date,&#039;MM/DD/YY&#039;),master_host_name
)
SELECT 
the_date,
master_host_name,
success,
partial,
failed,
CASE 
WHEN
round(success/total_jobs*100,2) &lt; ${freeCombo1} THEN &#039;red&#039;
WHEN
round(success/total_jobs*100,2) BETWEEN ${freeCombo1} AND ${freeCombo2} THEN &#039;yellow&#039;
WHEN
round(success/total_jobs*100,2) &gt; ${freeCombo2} THEN &#039;green&#039;
ELSE &#039;white&#039;
END success_pct,
round(success/total_jobs*100,2) pct_success
FROM t1</string>
          </entry>
