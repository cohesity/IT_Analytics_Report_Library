  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 12/14/2011
--FS Size,Pre Comp,FS Used, Avg Compression,Cleanable,Est Available
WITH 
t1 AS (
SELECT
s.server_id,
s.hostname,
s.location,
s.ip_address,
de.model_number,
ds.serial_number,
s.os_version,
sum(dfs.filesystem_size_kb/1024/1024/1024) filesystem_size_tb,
sum(dfs.pre_comp_size_kb/1024/1024/1024) pre_comp_size_tb,
sum(dfs.filesystem_used_kb/1024/1024/1024) filesystem_used_tb,
sum(dfs.filesystem_cleanable_kb/1024/1024/1024) filesystem_cleanable_tb
FROM apt_v_server s, apt_v_ddm_system ds, apt_v_ddm_enclosure de, apt_v_ddm_file_system dfs
WHERE ds.host_id = s.server_id
AND ds.host_id = de.host_id
AND ds.host_id = dfs.host_id
AND de.enclosure_id = 1
GROUP BY
s.server_id,
s.hostname,
s.location,
s.ip_address,
de.model_number,
ds.serial_number,
s.os_version
),
t2 AS(
SELECT
location,
round(sum(filesystem_size_tb),2) filesystem_size_tb,
round(sum(pre_comp_size_tb),2) pre_comp_size_tb,
round(sum(filesystem_used_tb),2) filesystem_used_tb,
round(avg((pre_comp_size_tb/filesystem_used_tb)),2) avg_comp_ratio,
round(sum(filesystem_cleanable_tb),2) filesystem_cleanable_tb,
round(sum((filesystem_size_tb-filesystem_used_tb)*(pre_comp_size_tb/filesystem_used_tb)),2) est_available
FROM t1
GROUP BY location
)
SELECT
location,
DECODE(&#039;${freeCombo1}&#039;,
&#039;FS Size&#039;,filesystem_size_tb,
&#039;Pre Comp&#039;,pre_comp_size_tb,
&#039;FS Used&#039;,filesystem_used_tb, 
&#039;Avg Compression&#039;,avg_comp_ratio,
&#039;Cleanable&#039;,filesystem_cleanable_tb,
&#039;Est Available&#039;,est_available
) metric
FROM t2
ORDER BY 2</string>
          </entry>
