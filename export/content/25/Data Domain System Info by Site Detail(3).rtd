  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>descriptiveName</string>
            <string>Data Domain System Info by Site Detail</string>
          </entry>
          <entry>
            <string>drilldown</string>
            <boolean>false</boolean>
          </entry>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 07/09/2015
WITH 
var AS (
SELECT
ROUND((${endDate} - ${startDate}),2) nbrOfDays,
DECODE(&#039;${freeCombo1}&#039;,
&#039;KB&#039;,1,&#039;MB&#039;,1024,&#039;GB&#039;,(1024*1024),&#039;TB&#039;,(1024*1024*1024),&#039;PB&#039;,(1024*1024*1024*1024)) div_by 
FROM dual
),
t1 AS (
SELECT
s.server_id,
s.hostname,
s.location,
s.ip_address,
de.model_number,
ds.serial_number,
s.os_version,
SUM(dfs.filesystem_size_kb/div_by) filesystem_size,
SUM(dfs.pre_comp_size_kb/div_by) pre_comp_size,
SUM(dfs.filesystem_used_kb/div_by) filesystem_used,
SUM(dfs.filesystem_cleanable_kb/div_by) filesystem_cleanable
FROM apt_v_server s, apt_v_ddm_system ds, apt_v_ddm_enclosure de, apt_v_ddm_file_system dfs, var
WHERE ds.host_id IN (${hosts}) 
AND ds.host_id = s.server_id
AND ds.host_id = de.host_id
AND ds.host_id = dfs.host_id
AND de.enclosure_id = 1
GROUP BY
s.server_id,
s.hostname,
s.location,
s.ip_address,
de.model_number,
ds.serial_number,
s.os_version
)
SELECT
server_id,
hostname,
location,
ip_address,
model_number,
serial_number,
REPLACE(os_version,&#039;Data Domain OS&#039;,&#039;&#039;) os_version,
filesystem_size,
pre_comp_size,
filesystem_used,
ROUND((pre_comp_size/filesystem_used),0) comp_ratio,
filesystem_cleanable,
(filesystem_size-filesystem_used)*(pre_comp_size/filesystem_used) est_available,
(filesystem_used/filesystem_size)*100 pct_used,
(filesystem_used/filesystem_size) used_pct
FROM t1
ORDER BY 2</string>
          </entry>
