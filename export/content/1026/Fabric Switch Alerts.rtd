          <entry>
            <string>dataSource</string>
            <string>SELECT
&apos;Alert&apos; source,
DECODE(ai.alerting_managed_element_type
,&apos;PHYSICAL_SWITCH_FC_PORT&apos;,&apos;PORT&apos;
,ai.alerting_managed_element_type
) element_type,
DECODE(ai.alerting_managed_element_type
,&apos;PHYSICAL_SWITCH_FC_PORT&apos;,sw1.element_name||&apos; Port &apos;||fcp.port_nbr 
,&apos;SWITCH&apos;,sw.element_name
,&apos;OTHER&apos;
) element_name,
ai.perceived_severity severity,
DECODE(
ai.perceived_severity,
0,&apos;blue&apos; ,
5,&apos;yellow&apos;,
2,&apos;red&apos;,
3,&apos;red&apos;,
&apos;white&apos;
) status,
ai.indication_date, 
ai.description 
FROM aps_v_swi_alert_ind ai, aps_v_swi_switch sw, aps_v_swi_switch_fc_port fcp, aps_v_swi_switch sw1
WHERE ai.switch_id = sw.switch_id(+)
AND ai.switch_fc_port_id = fcp.switch_fc_port_id(+)
AND fcp.physical_switch_id = sw1.physical_switch_id(+)</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
