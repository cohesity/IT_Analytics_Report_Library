          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 10/02/2012
--NOTE: This is a drilldown report only and will not run standalone
--The templateName is ClientStatusSummary.D
WITH 
d1 AS (
SELECT
--Dates Required for Drilldown 
TO_CHAR(${startDate},&#039;MM/DD/YYYY&#039;) start_date_char,
TO_CHAR(${startDate},&#039;HH24&#039;) start_hour_char,
TO_CHAR(${endDate},&#039;MM/DD/YYYY&#039;) finish_date_char,
TO_CHAR(${endDate},&#039;HH24&#039;) finish_hour_char
FROM DUAL
),
t1 AS (
SELECT
server_id,
server_name,
client_id,
client_name,
COUNT(job_id) job_count,
min(summary_status) min_summary_status,
max(summary_status) max_summary_status,
SUM(DECODE(summary_status,0,1,0)) successful_jobs,
SUM(DECODE(summary_status,1,1,0)) partial_jobs,
SUM(DECODE(summary_status,2,1,0)) failed_jobs
FROM apt_v_job 
WHERE
client_id IN (${hosts})
AND start_date BETWEEN ${startDate} AND ${endDate}
AND summary_status IS NOT NULL
AND server_id = ${the_server_id}
GROUP BY 
server_id,
server_name,
client_id,
client_name
),
t2 AS (
SELECT
server_id,
server_name,
client_id,
client_name,
CASE 
WHEN min_summary_status = 2 AND max_summary_status = 2 THEN &#039;Failed&#039;
WHEN min_summary_status = 1 AND max_summary_status = 1 THEN &#039;Partial&#039;
WHEN min_summary_status = 0 AND max_summary_status = 0 THEN &#039;Successful&#039;
WHEN min_summary_status &lt;&gt; max_summary_status THEN &#039;Mixed&#039;
END status,
(successful_jobs+partial_jobs+failed_jobs) total_jobs,
successful_jobs,
partial_jobs,
failed_jobs
FROM t1
)
SELECT t2.*,d1.* 
FROM t2, d1
WHERE status = DECODE(&#039;${the_status}&#039;,&#039;All&#039;,status,&#039;${the_status}&#039;)</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
