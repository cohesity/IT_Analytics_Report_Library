          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@veritas.com
--Last Modified: 03/25/2020
WITH 
c1 AS (
SELECT
  TRUNC(l.end_log_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Minutes&apos;,&apos;MI&apos;,&apos;Hours&apos;,&apos;HH24&apos;,&apos;Days&apos;,&apos;DD&apos;,&apos;Weeks&apos;,&apos;WW&apos;,&apos;Months&apos;,&apos;MM&apos;,&apos;Quarters&apos;,&apos;Q&apos;,&apos;Years&apos;)) AS the_date,
  p.partition_id,
  p.partition_name,
  ROUND(MAX(NVL(l.avg_cpu_usage_mhz,0)/1000),2) cpu_usage_ghz, --MHz converted to GHz
  ROUND(MAX(NVL(l.avg_cpu_usage_pct,0)),2) cpu_usage_pct,
  ROUND(MAX(NVL(l.avg_cpu_wait_ms,0)),2) cpu_wait_ms,
  ROUND(MAX(NVL(l.avg_cpu_ready_ms,0)),2) cpu_ready_ms
FROM 
  apt_v_vmw_perform_cpu_log l, apt_v_partition p
WHERE 
  p.partition_id IN (${vmGuests})
  AND p.partition_id = l.partition_id
  AND l.end_log_date  BETWEEN ${startDate} AND ${endDate}
  AND p.collection_status != 3
  AND p.partition_type = &apos;VM&apos;
GROUP BY 
  TRUNC(l.end_log_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Minutes&apos;,&apos;MI&apos;,&apos;Hours&apos;,&apos;HH24&apos;,&apos;Days&apos;,&apos;DD&apos;,&apos;Weeks&apos;,&apos;WW&apos;,&apos;Months&apos;,&apos;MM&apos;,&apos;Quarters&apos;,&apos;Q&apos;,&apos;Years&apos;)),
  p.partition_id,
  p.partition_name
),
s1 AS (--Generate Sparklines
SELECT
  c1.partition_id,
  c1.partition_name,
  rtd.collectString(CAST(COLLECT(TO_CHAR(ROUND(cpu_usage_ghz,2)) ORDER BY the_date) AS StringListType),&apos;, &apos;) AS cpu_usage_ghz_spk,
  rtd.collectString(CAST(COLLECT(TO_CHAR(ROUND(cpu_usage_pct,2)) ORDER BY the_date) AS StringListType),&apos;, &apos;) AS cpu_usage_pct_spk,
  rtd.collectString(CAST(COLLECT(TO_CHAR(ROUND(cpu_wait_ms,2)) ORDER BY the_date) AS StringListType),&apos;, &apos;) AS cpu_wait_ms_spk,
  rtd.collectString(CAST(COLLECT(TO_CHAR(ROUND(cpu_ready_ms,2)) ORDER BY the_date) AS StringListType),&apos;, &apos;) AS cpu_ready_ms_spk
FROM 
  c1
GROUP BY 
  c1.partition_id,
  c1.partition_name
),
t1 AS (
SELECT
  c1.partition_id,
  MAX(c1.cpu_usage_ghz) AS max_cpu_usage_ghz,
  MAX(c1.cpu_usage_pct) AS max_cpu_usage_pct,
  MAX(c1.cpu_wait_ms) AS max_cpu_wait_ms,
  MAX(c1.cpu_ready_ms) AS max_cpu_ready_ms,
  AVG(c1.cpu_usage_ghz) AS avg_cpu_usage_ghz,
  AVG(c1.cpu_usage_pct) AS avg_cpu_usage_pct,
  AVG(c1.cpu_wait_ms) AS avg_cpu_wait_ms,
  AVG(c1.cpu_ready_ms) AS avg_cpu_ready_ms
FROM
  c1
GROUP BY 
  c1.partition_id
ORDER BY 
  2 DESC
),
t2 AS (
SELECT
  s1.partition_id,
  s1.partition_name,
  s1.cpu_usage_ghz_spk,
  t1.max_cpu_usage_ghz,
  t1.avg_cpu_usage_ghz,
  s1.cpu_usage_pct_spk,
  t1.max_cpu_usage_pct,
  t1.avg_cpu_usage_pct,
  s1.cpu_wait_ms_spk,
  t1.max_cpu_wait_ms,
  t1.avg_cpu_wait_ms,
  s1.cpu_ready_ms_spk,
  t1.max_cpu_ready_ms,
  t1.avg_cpu_ready_ms
FROM
  s1, t1
WHERE
  s1.partition_id = t1.partition_id
ORDER BY t1.max_cpu_usage_ghz DESC
)
SELECT 
  *
FROM 
  t2
WHERE 
  ROWNUM &lt;= ${freeCombo2}
ORDER BY 
 max_cpu_usage_ghz DESC</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
