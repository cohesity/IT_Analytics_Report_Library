          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 08/16/2018
WITH
p1 AS (--Get the master list of policies
SELECT  --Policies with SLP
p.server_id,
s.display_name master_server_name,
p.policy_id,
p.policy_name,
p.policy_type_name,
p.is_active,
p.lifecycle_policy_id,
p.lifecycle_policy_name,
COUNT(pc.client_id) nbr_of_clients
FROM
apt_v_nbu_policy p, apt_v_nbu_policy_client pc, apt_v_server s
WHERE
p.policy_id IN (SELECT DISTINCT pc.policy_id FROM apt_v_nbu_policy_client pc WHERE pc.client_id IN (${hosts}))
AND p.server_id = s.server_id
AND p.is_active = DECODE(&#039;${freeCombo1}&#039;,&#039;Active&#039;,&#039;Y&#039;,&#039;Inactive&#039;,&#039;N&#039;,&#039;All&#039;,p.is_active)
AND p.lifecycle_policy_id IS NOT NULL  
AND p.policy_id = pc.policy_id
AND pc.is_active = DECODE(&#039;${freeCombo1}&#039;,&#039;Active&#039;,&#039;Y&#039;,&#039;Inactive&#039;,&#039;N&#039;,&#039;All&#039;,pc.is_active)
GROUP BY
p.server_id,
s.display_name,
p.policy_id,
p.policy_name,
p.policy_type_name,
p.is_active,
p.lifecycle_policy_id,
p.lifecycle_policy_name
UNION
SELECT --Policies without SLP
p.server_id,
s.display_name master_server_name,
p.policy_id,
p.policy_name,
p.policy_type_name,
p.is_active,
NULL lifecycle_policy_id,
&#039;No Lifecycle Policy&#039; lifecycle_policy_name,
COUNT(pc.client_id) nbr_of_clients
FROM
apt_v_nbu_policy p, apt_v_nbu_policy_client pc, apt_v_server s
WHERE
p.policy_id IN (SELECT DISTINCT pc.policy_id FROM apt_v_nbu_policy_client pc WHERE pc.client_id IN (${hosts}))
AND p.server_id = s.server_id  
AND p.is_active = DECODE(&#039;${freeCombo1}&#039;,&#039;Active&#039;,&#039;Y&#039;,&#039;Inactive&#039;,&#039;N&#039;,&#039;All&#039;,p.is_active)
AND p.exists_in_catalog = DECODE(&#039;${freeCombo1}&#039;,&#039;Active&#039;,&#039;Y&#039;,&#039;Inactive&#039;,&#039;N&#039;,&#039;All&#039;,p.exists_in_catalog)
AND p.lifecycle_policy_id IS NULL  
AND p.policy_id = pc.policy_id
AND pc.is_active = DECODE(&#039;${freeCombo1}&#039;,&#039;Active&#039;,&#039;Y&#039;,&#039;Inactive&#039;,&#039;N&#039;,&#039;All&#039;,pc.is_active)
AND pc.exists_in_catalog = DECODE(&#039;${freeCombo1}&#039;,&#039;Active&#039;,&#039;Y&#039;,&#039;Inactive&#039;,&#039;N&#039;,&#039;All&#039;,pc.exists_in_catalog)
GROUP BY
p.server_id,
s.display_name,
p.policy_id,
p.policy_name,
p.policy_type_name,
p.is_active,
p.lifecycle_policy_id,
p.lifecycle_policy_name
),
pf1 AS (
SELECT
p.policy_id,
rtd.collectString(CAST(COLLECT(TO_CHAR(
SUBSTR(pf.pathname,1,60)
) ORDER BY pf.pathname) AS StringListType),&#039;&lt;br&gt;&#039;) directives
FROM
apt_v_nbu_policy p, apt_v_nbu_policy_file pf
WHERE
p.policy_id IN (SELECT DISTINCT pc.policy_id FROM apt_v_nbu_policy_client pc WHERE pc.client_id IN (${hosts}))
AND p.policy_id = pf.policy_id
AND p.is_active = &#039;Y&#039;
AND p.exists_in_catalog = &#039;Y&#039;
AND pf.include_exclude_flag = &#039;I&#039;
GROUP BY 
p.policy_id
),
s1 AS (--get the Schedule configs grouped by policy
SELECT
p.policy_id,
MAX(s.retention_days) max_retention_days,
rtd.collectString(CAST(COLLECT(TO_CHAR(
  s.schedule_name  
  ||&#039; - &#039;||
  DECODE(s.selection_type,1,&#039;&#039;,2,&#039;Calendar - &#039;)
  ||
  CASE 
  WHEN s.frequency &lt; 3600 THEN s.frequency||&#039; Secs&#039;
  WHEN s.frequency = 3600 THEN &#039;Every Hour&#039;
  WHEN s.frequency BETWEEN 3601 AND 86400 THEN &#039;Every &#039;||ROUND(s.frequency/60/60,2)||&#039; Hours&#039;
  WHEN s.frequency = 86400 THEN &#039;Every day&#039;
  WHEN s.frequency BETWEEN 86401 AND 31536000 THEN &#039;Every &#039;||ROUND(s.frequency/60/60/24,2)||&#039; Days&#039;
  WHEN s.frequency &gt; 31536000 THEN &#039;Every &#039;||ROUND(s.frequency/60/60/24/365,2)||&#039; Years&#039;
  ELSE TO_CHAR(s.frequency)
  END 
  ||&#039; - Retain: &#039;||
  DECODE(s.retention_days,
    9999,&#039;Forever&#039;,
    -1,&#039;No&#039;,
    null,&#039; &#039;,
   DECODE(lp.lifecycle_policy_name,NULL,s.retention_days||&#039; Days&#039;,&#039;SLP*&#039;))
  ||NVL2(s.volume_pool_name,&#039; - Vol pool: &#039;||SUBSTR(s.volume_pool_name,1,25),&#039;&#039;)
  ||NVL2(su.storage_unit_label,&#039; - Stg Unit:&#039;||SUBSTR(su.storage_unit_label,1,25),&#039;&#039;)
  ||NVL2(lp.lifecycle_policy_name,&#039; - Res:&#039;||SUBSTR(lp.lifecycle_policy_name,1,25),&#039;&#039;)
) ORDER BY s.schedule_name) AS StringListType),&#039;&lt;br&gt;&#039;) sched_config
FROM 
apt_v_nbu_policy p, apt_v_nbu_schedule s, apt_v_nbu_storage_unit su, apt_v_nbu_lifecycle_policy lp
WHERE 
p.policy_id IN (SELECT DISTINCT pc.policy_id FROM apt_v_nbu_policy_client pc WHERE pc.client_id IN (${hosts}))
AND p.is_active = &#039;Y&#039;
AND p.exists_in_catalog = &#039;Y&#039;
AND p.policy_id = s.policy_id
AND s.exists_in_catalog = &#039;Y&#039;
AND s.storage_unit_id = su.storage_unit_id (+)
AND s.lifecycle_policy_id = lp.lifecycle_policy_id (+)
GROUP BY p.policy_id
),
c1 AS (--get the Lifecycle Policy Destinations
SELECT
&#039;Policy&#039; lp_source,
p.policy_id,
p.lifecycle_policy_id,
lp.lifecycle_policy_name,
MAX(lpd.destination_index_nbr) nbr_of_destinations,
rtd.collectString(CAST(COLLECT(TO_CHAR(
  &#039;Copy: &#039;
  ||
  lpd.destination_index_nbr
  ||&#039; - &#039;||
  DECODE(lpd.used_for,
    0,&#039;Backup&#039;,
    1,&#039;Duplication&#039;,
    2,&#039;Snapshot&#039;,
    3,&#039;Remote Server Duplication&#039;,
    4,&#039;Import&#039;,
    5,&#039;Backup Snapshot&#039;,
    6,&#039;Index Snapshot&#039;,
    7,&#039;Replication&#039;) 
  ||&#039; - Retain: &#039;||
  DECODE(lpd.retention_days,
    9999,&#039;Never Expires&#039;,
    -1,&#039;Expires Immediately&#039;,
    null,&#039; &#039;,
   lpd.retention_days||&#039; Days&#039;)
  ||&#039; - Store to: &#039;||
  su.storage_unit_label
  ||&#039; &#039;||
  vp.volume_pool_name
) ORDER BY lpd.destination_index_nbr) AS StringListType),&#039;&lt;br&gt;&#039;) slp_config
FROM
apt_v_nbu_policy p, apt_v_nbu_lifecycpolicy_dest lpd, apt_v_nbu_lifecycle_policy lp, 
apt_v_nbu_storage_unit su, apt_v_nbu_volume_pool vp
WHERE
p.policy_id IN (SELECT DISTINCT pc.policy_id FROM apt_v_nbu_policy_client pc WHERE pc.client_id IN (${hosts}))
AND p.exists_in_catalog =&#039;Y&#039;
AND p.is_active = &#039;Y&#039;
AND p.lifecycle_policy_id = lp.lifecycle_policy_id
AND lp.lifecycle_policy_id = lpd.lifecycle_policy_id
AND lpd.storage_unit_id = su.storage_unit_id (+)
AND lpd.volume_pool_id = vp.volume_pool_id (+)
GROUP BY
p.policy_id,
p.lifecycle_policy_id,
lp.lifecycle_policy_name
UNION
SELECT
&#039;Schedule&#039; lp_source,
p.policy_id,
s.lifecycle_policy_id,
lp.lifecycle_policy_name,
MAX(lpd.destination_index_nbr) nbr_of_destinations,
rtd.collectString(CAST(COLLECT(TO_CHAR(
  &#039;Copy: &#039;
  ||
  lpd.destination_index_nbr
  ||&#039; - &#039;||
  DECODE(lpd.used_for,
    0,&#039;Backup&#039;,
    1,&#039;Duplication&#039;,
    2,&#039;Snapshot&#039;,
    3,&#039;Remote Server Duplication&#039;,
    4,&#039;Import&#039;,
    5,&#039;Backup Snapshot&#039;,
    6,&#039;Index Snapshot&#039;,
    7,&#039;Replication&#039;) 
  ||&#039; - Retain: &#039;||
  DECODE(lpd.retention_days,
    9999,&#039;Never Expires&#039;,
    -1,&#039;Expires Immediately&#039;,
    null,&#039; &#039;,
   lpd.retention_days||&#039; Days&#039;)
  ||&#039; - Store to: &#039;||
  su.storage_unit_label
  ||&#039; &#039;||
  vp.volume_pool_name
) ORDER BY lpd.destination_index_nbr) AS StringListType),&#039;&lt;br&gt;&#039;) slp_config
FROM
apt_v_nbu_policy p, apt_v_nbu_lifecycpolicy_dest lpd, apt_v_nbu_lifecycle_policy lp, 
apt_v_nbu_storage_unit su, apt_v_nbu_volume_pool vp, apt_v_nbu_schedule s
WHERE
p.policy_id IN (SELECT DISTINCT pc.policy_id FROM apt_v_nbu_policy_client pc WHERE pc.client_id IN (${hosts}))
AND p.exists_in_catalog =&#039;Y&#039;
AND p.is_active = &#039;Y&#039;
AND p.policy_id = s.policy_id
AND s.lifecycle_policy_id = lp.lifecycle_policy_id
AND p.lifecycle_policy_id IS NULL
AND lp.lifecycle_policy_id = lpd.lifecycle_policy_id
AND lpd.storage_unit_id = su.storage_unit_id (+)
AND lpd.volume_pool_id = vp.volume_pool_id (+)
GROUP BY
p.policy_id,
s.lifecycle_policy_id,
lp.lifecycle_policy_name
)
SELECT
p1.server_id,
p1.master_server_name,
p1.policy_id,
p1.policy_name,
p1.policy_type_name,
p1.is_active,
p1.nbr_of_clients,
pf1.directives,
s1.sched_config,
c1.lp_source,
c1.lifecycle_policy_id,
NVL(c1.lifecycle_policy_name,&#039;No Lifecycle Policy&#039;) lifecycle_policy_name,
c1.nbr_of_destinations,
c1.slp_config
FROM
p1, pf1, s1, c1
WHERE
p1.policy_id = pf1.policy_id (+)
AND p1.policy_id = s1.policy_id (+)
AND p1.policy_id = c1.policy_id (+)
</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
