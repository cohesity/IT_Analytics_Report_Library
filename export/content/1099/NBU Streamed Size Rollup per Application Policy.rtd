          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last updated: 03/26/2013
--This report assumes the first characters in the policy name to be the Application
--The first characters up to the first underscore _ or the first 4 characters if there is no _
WITH
VAR AS (
SELECT
ROUND((${endDate} - ${startDate}),2) nbrOfDays,
${startDate} startDate,
DECODE(&apos;${freeCombo1}&apos;,
&apos;KB&apos;,1,&apos;MB&apos;,1024,&apos;GB&apos;,(1024*1024),&apos;TB&apos;,(1024*1024*1024),&apos;PB&apos;,(1024*1024*1024*1024)) div_by
FROM dual
),
t1 AS (
SELECT
NVL(SUBSTR(j.policy_name,1,INSTR(j.policy_name,&apos;_&apos;,1)-1),SUBSTR(j.policy_name,1,4)) application,
j.policy_id,
j.policy_name,
COUNT(j.job_id) job_count,
SUM(j.kilobytes/var.div_by) job_size,
REPLACE(aptStringConcat(DISTINCT pf.pathname),&apos;,&apos;,&apos;&lt;br/&gt;&apos;) pathname
FROM apt_v_nbu_job_detail j,apt_v_nbu_policy_file pf, var
WHERE j.client_id IN (${hosts})
AND j.start_date BETWEEN ${startDate} AND ${endDate}
AND j.job_type &lt;&gt; 105
AND j.policy_id = pf.policy_id
GROUP BY
SUBSTR(j.policy_name,1,INSTR(j.policy_name,&apos;_&apos;,1)-1),
j.policy_id,
j.policy_name
ORDER BY 1,3
)
SELECT
application application_sort,
application,
policy_id,
policy_name,
job_count,
job_size,
pathname
FROM t1
UNION
SELECT
application application_sort,
&apos;&lt;B&gt; Total - &apos;||application||&apos;&lt;/b&gt;&apos; application,
NULL policy_id,
NULL policy_name,
SUM(job_count) job_count,
SUM(job_size) job_size,
NULL pathname
FROM t1
GROUP BY application,&apos;&lt;B&gt; Total - &apos;||application||&apos;&lt;/b&gt;&apos;
UNION
SELECT
&apos;zzzzzz&apos; application_sort,
&apos;&lt;B&gt; Grand Total&apos; application,
NULL policy_id,
NULL policy_name,
SUM(job_count) job_count,
SUM(job_size) job_size,
NULL pathname
FROM t1
GROUP BY &apos;zzzzzz&apos;,&apos;&lt;B&gt; Grand Total&apos;
ORDER BY 1,4</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
