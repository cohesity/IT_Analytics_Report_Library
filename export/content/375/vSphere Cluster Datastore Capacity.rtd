  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>descriptiveName</string>
            <string>vSphere Cluster Datastore Capacity</string>
          </entry>
          <entry>
            <string>drilldown</string>
            <boolean>false</boolean>
          </entry>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 06/20/2017
WITH 
VAR AS (
SELECT
&#039;${freeCombo1}&#039; unit,
DECODE(&#039;${freeCombo1}&#039;, &#039;GB&#039;,1024*1024,&#039;TB&#039;,1024*1024*1024,&#039;PB&#039;,(1024*1024*1024*1024)) div_by
FROM dual
),
d1 AS (--Datastore
SELECT DISTINCT
vc.vmw_cluster_id,
vc.cluster_name,
d.vmw_datastore_id,
d.tot_capacity_kb/div_by tot_capacity,
d.free_capacity_kb/div_by free_capacity
FROM apt_v_vmw_cluster vc, apt_v_virtual_system vs, apt_v_vmw_datastore d, apt_v_vmw_map_vsys_dtstore dm, var
WHERE 
vs.host_id IN (${hosts})
AND vs.vmw_cluster_id = vc.vmw_cluster_id
AND vs.virtual_system_id = dm.virtual_system_id
AND dm.vmw_datastore_id = d.vmw_datastore_id
)
SELECT
vmw_cluster_id,
cluster_name,
COUNT(vmw_datastore_id) nbr_of_datastores,
SUM(tot_capacity) tot_capacity,
SUM(free_capacity) free_capacity,
SUM(tot_capacity - free_capacity) used_capacity,
SUM(free_capacity)/SUM(DECODE(tot_capacity,0,null,tot_capacity))*100 used_pct,
SUM(free_capacity)/SUM(DECODE(tot_capacity,0,null,tot_capacity)) pct_used
FROM d1
GROUP BY 
vmw_cluster_id,
cluster_name
ORDER BY 8 DESC</string>
          </entry>
