  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>descriptiveName</string>
            <string>Host Network Packets Sent &amp; Received</string>
          </entry>
          <entry>
            <string>drilldown</string>
            <boolean>false</boolean>
          </entry>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 09/19/2018
WITH 
t1 AS (
SELECT 
server_id,
external_name,
NVL(NIC_NAME,&#039;NA&#039;) nic_name,
TRUNC(log_date,&#039;dd&#039;) + round(to_char(log_date,&#039;sssss&#039;) / 900) / 96  log_date, --Round up to nearest 15 Min
packets_received,
LEAD(packets_received, 1, 0) OVER (PARTITION BY server_id, NVL(NIC_NAME,&#039;NA&#039;) ORDER BY server_id, log_date) lead_packets_received,
(LEAD(packets_received, 1, 0) OVER (PARTITION BY server_id, NVL(NIC_NAME,&#039;NA&#039;) ORDER BY server_id, log_date) - packets_received) pkts_rec,
packets_sent,
LEAD(packets_sent, 1, 0) OVER (PARTITION BY server_id, NVL(NIC_NAME,&#039;NA&#039;) ORDER BY server_id, log_date) lead_packets_sent,
(LEAD(packets_sent, 1, 0) OVER (PARTITION BY server_id, NVL(NIC_NAME,&#039;NA&#039;) ORDER BY server_id, log_date) - packets_sent) pkts_sent
FROM 
apt_v_host_network_log
WHERE 
server_id IN (${hosts})
AND log_date BETWEEN ${startDate} AND ${endDate}
)
SELECT
log_date,
SUM(pkts_rec) pkts_rec,
SUM(pkts_sent) pkts_sent 
FROM t1
WHERE 
pkts_rec &gt; 0
GROUP BY
log_date</string>
          </entry>
