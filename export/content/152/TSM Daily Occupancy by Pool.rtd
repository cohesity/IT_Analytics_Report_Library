    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com    Date: 07/07/2011
--
--
SELECT to_char(poll_date,&#039;MM/DD/YY&#039;) poll_date, storage_pool_name,
sum(stg_pool_phy_mbytes)/1024 size_GB
FROM apt_v_tsm_occupancy_log 
WHERE client_id IN (${hosts})
AND poll_date BETWEEN ${startDate} AND ${endDate}
GROUP BY to_char(poll_date,&#039;MM/DD/YY&#039;), storage_pool_name
ORDER BY 1</string>
          </entry>
