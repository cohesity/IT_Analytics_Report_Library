          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 07/20/2018
WITH 
VAR AS (
SELECT
ROUND((${endDate} - ${startDate}),2) nbrOfDays,
${startDate} startDate,
DECODE(&#039;${freeCombo1}&#039;,
&#039;KB&#039;,1,&#039;MB&#039;,1024,&#039;GB&#039;,(1024*1024),&#039;TB&#039;,(1024*1024*1024),&#039;PB&#039;,(1024*1024*1024*1024)) div_by
FROM dual
)
SELECT
ia.idataagent_name,
ROUND(SUM(j.kilobytes/var.div_by),2) job_size
FROM apt_v_job j, apt_v_cmv_job cj, apt_v_cmv_idataagent ia, var
WHERE j.job_id = cj.job_id
AND cj.cmv_idataagent_id = ia.cmv_idataagent_id
AND j.server_id IN (${hosts})
AND j.start_date BETWEEN ${startDate} AND ${endDate}
GROUP BY ia.idataagent_name
ORDER BY 2 DESC</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
