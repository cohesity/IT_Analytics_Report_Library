<com.aptare.sc.dal.versioning.ObjectMap>
  <version>1</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>WITH p1 AS
(
select policy_name, host_id, total_gb 
FROM table (srm_rtd.listChargebackByLUNSummary(100000,
numberListType(),
numberListType(),
numberListType(),
numberListType(${serverGroups}),
1))
),
t1 as (
SELECT
host_id,  
sum(total_gb) total_tiered_gb,
sum(DECODE(policy_name,&#039;Tier 1&#039;,total_gb,0)) total_tier_1_gb,
sum(DECODE(policy_name,&#039;Tier 2&#039;,total_gb,0)) total_tier_2_gb,
sum(DECODE(policy_name,&#039;Tier 3&#039;,total_gb,0)) total_tier_3_gb,
sum(DECODE(policy_name,&#039;HDP Tier&#039;,total_gb,0)) total_HDP_Tier_gb
FROM p1
GROUP BY host_id
),
t3 as (
SELECT
hs.host_id,
hs.host_name,
s.display_name,
nvl(rtd.getServerAttributeValue(hs.host_id,&#039;Environment&#039;),&#039;Other&#039;) environment,
total_tiered_gb,
total_tier_1_gb,
total_tier_2_gb,
total_tier_3_gb,
total_HDP_Tier_gb,
total_tiered_gb - total_san_capacity_gb allocated_but_not_used_gb,
total_san_capacity_gb,
san_pct_used,
total_nas_capacity_gb,
nas_pct_used,
total_das_capacity_gb,
das_pct_used
FROM aps_v_host_storage hs,t1,apt_v_server s
WHERE hs.host_id in (${hosts})
AND hs.host_id = t1.host_id (+)
AND hs.host_id = s.server_id (+)
)
SELECT environment,
sum(total_tier_1_gb/1024) tier_1_tb,
sum(total_tier_2_gb/1024) tier_2_tb,
sum(total_tier_3_gb/1024) tier_3_tb,
sum(total_HDP_Tier_gb/1024) hdp_tb
FROM t3
group by environment</string>
          </entry>
