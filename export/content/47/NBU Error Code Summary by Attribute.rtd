FROM
apt_v_nbu_job nj, apt_v_server_attribute sa
WHERE nj.start_date BETWEEN ${startDate} AND ${endDate}
AND nj.server_id IN (${hosts})
AND nj.vendor_status IS NOT NULL
AND nj.client_id = sa.host_id
AND nj.client_host_name &lt;&gt; &#039;NONE&#039;
GROUP BY 
${queryCombo1}
)
SELECT
NVL(attribute,&#039;Unassigned&#039;) attribute,
master_servers,
clients,
total_jobs,
success,
parital,
failed,
clt_error,    
nbu_error,
CASE 
  WHEN failed = 0 THEN 0
  ELSE (clt_error/failed) * 100 
END clt_error_pct,
CASE 
  WHEN failed = 0 THEN 0
  ELSE (nbu_error/failed) * 100 
END nbu_error_pct,   
partial_pct,
success_pct,   
