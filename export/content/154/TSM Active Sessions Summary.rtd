  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 10/03/2011
WITH
var AS (
SELECT 
DECODE(&#039;${freeCombo1}&#039;,&#039;30min&#039;,.5,&#039;45min&#039;,.75,&#039;1hr&#039;,1,&#039;2hrs&#039;,2,&#039;3hrs&#039;,3,&#039;4hrs&#039;,4) avg_wait_threshold,
DECODE(&#039;${freeCombo2}&#039;,&#039;1hr&#039;,1,&#039;2hrs&#039;,2,&#039;4hrs&#039;,4,&#039;6hrs&#039;,6,&#039;8hrs&#039;,8,&#039;10hrs&#039;,10,&#039;12hrs&#039;,12) max_wait_threshold,
&#039;${freeCombo1}&#039; avg_wait_threshold_name,
&#039;${freeCombo2}&#039; max_wait_threshold_name
FROM dual
), 
q1 AS (
SELECT
tn.instance_name,
count(ts.node_session_id) session_count,
sum(ts.kilobytes_recd/1024/1024) gb_rx,
sum(ts.kilobytes_send/1024/1024) gb_tx,
avg(ts.wait_time_secs) avg_wait_time_secs,
max(ts.wait_time_secs) max_wait_time_secs,
avg(ts.wait_time_secs/60/60) avg_wait_time_hrs,
max(ts.wait_time_secs/60/60) max_wait_time_hrs,
count(ts.node_id) node_count
FROM apt_v_tsm_session ts, apt_v_tsm_node tn, apt_v_server_instance si
WHERE ts.start_date BETWEEN ${startDate} AND ${endDate}
AND ts.node_id = tn.node_id (+)
AND ts.is_active = &#039;Y&#039;
AND ts.job_id IS NULL
AND tn.server_instance_id = si.server_instance_id
AND si.server_id IN (${hosts})
GROUP BY tn.instance_name
)
SELECT
round(avg_wait_time_hrs,2) avg_wait_time_hrs,
CASE WHEN avg_wait_time_hrs &gt;= var.avg_wait_threshold THEN &#039;red&#039;
ELSE &#039;green&#039;
END avg_wait_dot,
round(max_wait_time_hrs,2) max_wait_time_hrs,
CASE WHEN max_wait_time_hrs &gt;= var.max_wait_threshold THEN &#039;red&#039;
ELSE &#039;green&#039;
END max_wait_dot,
instance_name,
session_count,
gb_rx,
gb_tx,
rtd.secsToHoursMinSecs(avg_wait_time_secs) avg_wait_time,
rtd.secsToHoursMinSecs(max_wait_time_secs) max_wait_time,
node_count,
var.avg_wait_threshold_name,
var.max_wait_threshold_name
FROM q1,var
ORDER BY 3 DESC</string>
          </entry>
