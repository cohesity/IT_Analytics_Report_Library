<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>descriptiveName</string>
            <string>VM Guest Disk Writes Heat Map</string>
          </entry>
          <entry>
            <string>drilldown</string>
            <boolean>false</boolean>
          </entry>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 12/17/2014
WITH 
t1 AS (
SELECT
TO_CHAR(TRUNC(l.start_log_date,&#039;HH24&#039;),&#039;YY/MM/DD HH24&#039;) the_date,
l.partition_id,
l.partition_name,
SUM(l.nbr_of_disk_write) nbr_of_disk_write,
ROUND((RATIO_TO_REPORT(SUM(l.nbr_of_disk_write)) OVER (PARTITION BY l.partition_id, l.partition_name))*100,2) rr_nbr_of_disk_write
FROM
apt_v_vmw_perform_disk_log l, apt_v_partition p
WHERE l.start_log_date BETWEEN ${startDate} AND ${endDate}
AND l.partition_id = p.partition_id 
AND p.host_id IN (${hosts})
AND l.partition_type = &#039;VM&#039;
GROUP BY
TO_CHAR(TRUNC(l.start_log_date,&#039;HH24&#039;),&#039;YY/MM/DD HH24&#039;),
l.partition_id,
l.partition_name
ORDER BY 1,2
),
t2 AS (--Rank them
SELECT
the_date,
partition_id,
partition_name,
nbr_of_disk_write,
rr_nbr_of_disk_write,
DENSE_RANK() OVER (PARTITION BY partition_id, partition_name ORDER BY nbr_of_disk_write) dr_nbr_of_disk_write
FROM t1
ORDER BY 1,2
),
t3 AS (--Assign colors to the rankings
SELECT
the_date,
partition_id,
partition_name,
nbr_of_disk_write,
rr_nbr_of_disk_write,
dr_nbr_of_disk_write,
CASE
WHEN dr_nbr_of_disk_write BETWEEN 0  AND 5  THEN &#039;#FBEFEF&#039;
WHEN dr_nbr_of_disk_write BETWEEN 5  AND 10 THEN &#039;#F6CECE&#039;
WHEN dr_nbr_of_disk_write BETWEEN 10 AND 15 THEN &#039;#F78181&#039;
WHEN dr_nbr_of_disk_write BETWEEN 15 AND 20 THEN &#039;#FE2E2E&#039;
WHEN dr_nbr_of_disk_write BETWEEN 20 AND 25 THEN &#039;#DF0101&#039;
WHEN dr_nbr_of_disk_write BETWEEN 25 AND 30 THEN &#039;#B40404&#039;
WHEN dr_nbr_of_disk_write BETWEEN 30 AND 35 THEN &#039;#8A0808&#039;
WHEN dr_nbr_of_disk_write BETWEEN 35 AND 100 THEN &#039;#610B0B&#039;
ELSE &#039;#FBEFEF&#039;
END cell_color
FROM t2
ORDER BY 1,2
)
SELECT
the_date,
partition_id,
partition_name,
nbr_of_disk_write,
rr_nbr_of_disk_write,
dr_nbr_of_disk_write,
&#039;&lt;table width=&quot;100%&quot; border=&quot;0&quot; cellspacing=&quot;0&quot; cellpadding=&quot;0&quot;&gt;&lt;td style=background-color:&#039;||cell_color||&#039; align=right&gt;&#039;||nbr_of_disk_write||&#039;&lt;/td&gt;&lt;/table&gt;&#039; heatmap
FROM t3
ORDER BY 1,2</string>
          </entry>
