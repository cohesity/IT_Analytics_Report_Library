          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 09/29/2015
--5:00am,6:00am,7:00am,8:00am,9:00am,10:00am,11:00am
--High,Med,High &amp; Med,Low,Med &amp; Low,High &amp; Med &amp; Low,No,All
WITH 
d0 AS (
SELECT TRUNC(sysdate-1)+(1/24) * DECODE(&apos;${freeCombo1}&apos;,&apos;5:00am&apos;,5,&apos;6:00am&apos;,6,&apos;7:00am&apos;,7,&apos;8:00am&apos;,8,&apos;9:00am&apos;,9,&apos;10:00am&apos;,10,&apos;11:00am&apos;,11) the_start_date,
TRUNC(sysdate)+(1/24) * DECODE(&apos;${freeCombo1}&apos;,&apos;5:00am&apos;,5,&apos;6:00am&apos;,6,&apos;7:00am&apos;,7,&apos;8:00am&apos;,8,&apos;9:00am&apos;,9,&apos;10:00am&apos;,10,&apos;11:00am&apos;,11) the_end_date  
FROM apt_v_dual
),
ss AS (--Count up the various summary status
SELECT					
the_start_date,
the_end_date,
product_type_name,
server_id,					
server_name,
client_id,
client_name,
COUNT(*) job_count,
SUM(DECODE(summary_status,0,1,0)) s_count,					
SUM(DECODE(summary_status,1,1,0)) w_count,					
SUM(DECODE(summary_status,2,1,0)) f_count,					
SUM(DECODE(is_active,&apos;Y&apos;,1,0)) i_count,
MIN(start_date) first_attempt,
MAX(start_date) last_attempt,
aptStringConcat(DISTINCT job_type_name) job_types,
aptStringConcat(DISTINCT vendor_status) status_states,
SUM(kilobytes/1024/1024)  job_size_gb					
FROM apt_v_job, d0					
WHERE 
start_date BETWEEN d0.the_start_date AND d0.the_end_date					
AND client_id IN (${hosts})	
AND summary_status IS NOT NULL				
GROUP BY 		
the_start_date,
the_end_date,
product_type_name,
server_id,					
server_name,
client_id,					
client_name
),
sc AS (--Assign the Secret Code
SELECT
the_start_date,
the_end_date,
product_type_name,
server_id,					
server_name,
client_id,					
client_name,
job_count,
--If the have any status 0,1,2 or NULL assign an exponential number to represent it
CASE WHEN s_count &gt; 0 THEN 1 ELSE 0 END s_code,					
CASE WHEN w_count &gt; 0 THEN 2 ELSE 0 END w_code,					
CASE WHEN f_count &gt; 0 THEN 4 ELSE 0 END f_code,					
CASE WHEN i_count &gt; 0 THEN 8 ELSE 0 END i_code,
--The secret code is the sum of the indiviapt_v_dual exponential numbers (every combination will be unique)
CASE WHEN s_count &gt; 0 THEN 1 ELSE 0 END +					
CASE WHEN w_count &gt; 0 THEN 2 ELSE 0 END +					
CASE WHEN f_count &gt; 0 THEN 4 ELSE 0 END +					
CASE WHEN i_count &gt; 0 THEN 8 ELSE 0 END secret_code,				
--The counts will represent how many actual successes vs failures 
s_count,
w_count,
f_count,
i_count,
first_attempt,
last_attempt,
job_types,
status_states,
job_size_gb
FROM ss
),
t0 AS (--Decode the secret_code and the overall client status 
SELECT 
the_start_date,
the_end_date,
product_type_name,
server_id,
server_name,
client_id,
client_name,
DECODE(secret_code,				
 1 , &apos;Successful&apos;, 				
 2 , &apos;Warnings&apos;, 				
 3 , &apos;Successful &amp; Warnings&apos;, 				
 4 , &apos;Failed&apos;, 				
 5 , &apos;Successful &amp; Failed&apos;, 				
 6 , &apos;Warnings &amp; Failed&apos;, 				
 7 , &apos;Successful &amp; Warnings &amp; Failed&apos;, 				
 8 , &apos;Incomplete&apos;, 				
 9 , &apos;Successful &amp; Incomplete&apos;, 				
10 , &apos;Warnings &amp; Incomplete&apos;, 				
11 , &apos;Successful &amp; Warnings &amp; Incomplete&apos;, 				
12 , &apos;Failed &amp; Incomplete&apos;, 				
13 , &apos;Successful &amp; Failed &amp; Incomplete&apos;, 				
14 , &apos;Warnings &amp; Failed &amp; Incomplete&apos;, 				
15 , &apos;Successful &amp; Warnings &amp; Failed &amp; Incomplete&apos;, 				
&apos;Other&apos;) overall_client_status,
/*
DECODE(secret_code,				
 1 , &apos;&lt;img src./skins/aptare/ostatus01.gif&gt;&apos;, 				
 2 , &apos;&lt;img src./skins/aptare/ostatus02.gif&gt;&apos;, 				
 3 , &apos;&lt;img src./skins/aptare/ostatus03.gif&gt;&apos;, 				
 4 , &apos;&lt;img src./skins/aptare/ostatus04.gif&gt;&apos;, 				
 5 , &apos;&lt;img src./skins/aptare/ostatus05.gif&gt;&apos;, 				
 6 , &apos;&lt;img src./skins/aptare/ostatus06.gif&gt;&apos;, 				
 7 , &apos;&lt;img src./skins/aptare/ostatus07.gif&gt;&apos;, 				
 8 , &apos;&lt;img src./skins/aptare/ostatus08.gif&gt;&apos;, 				
 9 , &apos;&lt;img src./skins/aptare/ostatus09.gif&gt;&apos;, 				
10 , &apos;&lt;img src./skins/aptare/ostatus10.gif&gt;&apos;, 				
11 , &apos;&lt;img src./skins/aptare/ostatus11.gif&gt;&apos;, 				
12 , &apos;&lt;img src./skins/aptare/ostatus12.gif&gt;&apos;, 				
13 , &apos;&lt;img src./skins/aptare/ostatus13.gif&gt;&apos;, 				
14 , &apos;&lt;img src./skins/aptare/ostatus14.gif&gt;&apos;, 				
15 , &apos;&lt;img src./skins/aptare/ostatus15.gif&gt;&apos;, 				
&apos;Other&apos;) ostatus_dot,
*/
DECODE(secret_code,
 1 , &apos;No&apos;, 				
 2 , &apos;Low&apos;, 				
 3 , &apos;Low&apos;, 				
 4 , &apos;High&apos;, 				
 5 , &apos;Med&apos;, 				
 6 , &apos;Med&apos;, 				
 7 , &apos;Med&apos;, 				
 8 , &apos;High&apos;, 				
 9 , &apos;Med&apos;, 				
10 , &apos;Med&apos;, 				
11 , &apos;Med&apos;, 				
12 , &apos;High&apos;, 				
13 , &apos;Med&apos;, 				
14 , &apos;Med&apos;, 				
15 , &apos;Med&apos;, 				
&apos;Other&apos;) client_risk_level,
secret_code,
job_count,
CASE WHEN s_count &gt; 0 THEN &apos;green&apos; ELSE null END s_dot,					
CASE WHEN w_count &gt; 0 THEN &apos;yellow&apos; ELSE null END w_dot,					
CASE WHEN f_count &gt; 0 THEN &apos;red&apos; ELSE null END f_dot,					
CASE WHEN i_count &gt; 0 THEN &apos;blue&apos; ELSE null END i_dot,
s_count,
w_count,
f_count,
i_count,
first_attempt,
last_attempt,
job_types,
status_states,
job_size_gb
FROM sc
)
SELECT
product_type_name,
server_id,
server_name,
client_id,
client_name,
secret_code,
job_count,
overall_client_status,
--ostatus_dot,
client_risk_level,
s_dot,					
w_dot,					
f_dot,					
i_dot,
s_count,
w_count,
f_count,
i_count,
first_attempt,
last_attempt,
job_types,
status_states,
job_size_gb
FROM t0
WHERE
--High,Med,High &amp; Med,Low,Med &amp; Low,No,All
REGEXP_LIKE (client_risk_level, DECODE(&apos;${freeCombo2}&apos;,
&apos;High&apos;,&apos;High&apos;,
&apos;Med&apos;,&apos;Med&apos;,
&apos;High &amp; Med&apos;,&apos;High|Med&apos;,
&apos;Low&apos;,&apos;Low&apos;,
&apos;Med &amp; Low&apos;,&apos;Med|Low&apos;,
&apos;High &amp; Med &amp; Low&apos;,&apos;High|Med|Low&apos;,
&apos;No&apos;,&apos;No&apos;,
&apos;All&apos;,&apos;High|Med|Low|No&apos;))
ORDER BY the_start_date, UPPER(client_name)</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
    <entry>
      <string>authorUserId</string>
      <long>100000</long>
    </entry>
    <entry>
      <string>templateName</string>
      <null/>
    </entry>
    <entry>
      <string>id</string>
      <long>100771</long>
    </entry>
    <entry>
