                    <string>High,Med,High &amp; Med,Low,Med &amp; Low,High &amp; Med &amp; Low,No,All</string>
                  </entry>
                  <entry>
                    <string>freeComboHeading2</string>
                    <string>Risk Level:</string>
                  </entry>
                  <entry>
                    <string>freeComboValues1</string>
                    <string>5:00am,6:00am,7:00am,8:00am,9:00am,10:00am,11:00am</string>
                  </entry>
                  <entry>
