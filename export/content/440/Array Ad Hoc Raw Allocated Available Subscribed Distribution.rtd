          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 09/22/2017
WITH 
var AS (
SELECT
DECODE(&#039;${freeCombo1}&#039;,
&#039;KB&#039;,1,&#039;MB&#039;,1024,&#039;GB&#039;,(1024*1024),&#039;TB&#039;,(1024*1024*1024),&#039;PB&#039;,(1024*1024*1024*1024)) div_by 
FROM dual
)SELECT
DECODE (&#039;${freeCombo2}&#039;,&#039;Array Vendor&#039;,vendor_name,&#039;Array Family&#039;,array_family,&#039;Array Name&#039;,array_name) report_on,
ROUND(SUM(raw_capacity_kb/div_by),2) raw_capacity,
ROUND(SUM(thin_pool_subscribed_kb/div_by),2) subscribed,
ROUND(SUM(allocated_kb/div_by),2) allocated,
ROUND(SUM(available_kb/div_by),2) available
FROM aps_v_storage_array sa, var
WHERE storage_array_id IN (${arrays})
GROUP BY 
DECODE(&#039;${freeCombo2}&#039;,&#039;Array Vendor&#039;,vendor_name,&#039;Array Family&#039;,array_family,&#039;Array Name&#039;,array_name)</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
