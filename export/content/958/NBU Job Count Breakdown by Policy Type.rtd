          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 12/06/2012
SELECT
to_char(trunc(start_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;)),&apos;MM/DD/YY&apos;) the_date,
ROUND(SUM(DECODE(policy_type_name,&apos;Standard&apos;,1,0)),2) Standard,
ROUND(SUM(DECODE(policy_type_name,&apos;MS-Windows&apos;,1,0)),2) MS_Windows,
ROUND(SUM(DECODE(policy_type_name,&apos;Oracle&apos;,1,0)),2) Oracle,
ROUND(SUM(DECODE(policy_type_name,&apos;NDMP&apos;,1,0)),2) NDMP,
ROUND(SUM(DECODE(policy_type_name,&apos;MS-Sharepoint&apos;,1,0)),2) MS_Sharepoint,
ROUND(SUM(DECODE(policy_type_name,&apos;MS-SQL&apos;,1,0)),2) MS_SQL,
ROUND(SUM(DECODE(policy_type_name,&apos;MS-Exchange Server&apos;,1,0)),2) MS_Exchange_Server,
ROUND(SUM(DECODE(policy_type_name,&apos;FlashBackup&apos;,1,0)),2) FlashBackup,
ROUND(SUM(DECODE(policy_type_name,&apos;Vault&apos;,1,0)),2) Vault
FROM apt_v_nbu_job_detail
WHERE client_id IN (${hosts})
AND start_date BETWEEN ${startDate} AND ${endDate}
GROUP BY to_char(trunc(start_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;)),&apos;MM/DD/YY&apos;)</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
