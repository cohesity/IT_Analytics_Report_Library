          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last updated: 09/07/2016
--Provides Several Key Performance Indicators for an Avamar Environment
WITH 
VAR AS (
SELECT
ROUND((${endDate} - ${startDate}),2) nbrOfDays,
${startDate} startDate,
DECODE(&#039;${freeCombo1}&#039;,
&#039;KB&#039;,1,&#039;MB&#039;,1024,&#039;GB&#039;,(1024*1024),&#039;TB&#039;,(1024*1024*1024),&#039;PB&#039;,(1024*1024*1024*1024)) div_by,
&#039;${freeCombo1}&#039; the_unit 
FROM dual
),
t0 AS (--Calculates Individual Job Statistics
SELECT
count(DISTINCT j.client_id) client_count,
count(j.job_id) job_count,
SUM(DECODE(j.summary_status,0,1,0)) successful_job_count,
SUM(DECODE(j.summary_status,1,1,0)) partial_job_count,
SUM(DECODE(j.summary_status,2,1,0)) failed_job_count,
AVG(j.duration_secs) avg_duration1,
MAX(j.duration_secs) max_duration1,
SUM(CASE WHEN j.duration_secs/60/60 &gt;= 1 THEN 1 ELSE 0 END) job_g1_count,
SUM(CASE WHEN j.duration_secs/60/60 BETWEEN 1 AND 6 THEN 1 ELSE 0 END) job_16_count,
SUM(CASE WHEN j.duration_secs/60/60 BETWEEN 6 AND 12 THEN 1 ELSE 0 END) job_612_count,
SUM(CASE WHEN j.duration_secs/60/60 BETWEEN 12 AND 24 THEN 1 ELSE 0 END) job_1224_count,
SUM(CASE WHEN j.duration_secs/60/60 &gt;= 24 THEN 1 ELSE 0 END) job_g24_count,
ROUND(AVG(aa.scanned_kb/div_by),2) avg_scanned,
ROUND(MAX(aa.scanned_kb/div_by),2) max_scanned,
ROUND(SUM(aa.modified_not_sent_kb/div_by),2) modified_not_sent,
ROUND(SUM(aa.modified_sent_kb/div_by),2) modified_sent,
ROUND(SUM(j.kilobytes/div_by),2) job_volume,
ROUND(SUM(CASE WHEN j.job_type IN (701) THEN aa.modified_sent_kb/div_by ELSE 0 END),2) on_demand_job_volume,
ROUND(SUM(CASE WHEN j.job_type IN (702) THEN aa.modified_sent_kb/div_by ELSE 0 END),2) sched_job_volume,
ROUND(SUM(CASE WHEN j.job_type IN (703) THEN aa.modified_sent_kb/div_by ELSE 0 END),2) restore_job_volume,
ROUND(SUM(CASE WHEN j.job_type IN (706) THEN aa.modified_sent_kb/div_by ELSE 0 END),2) rep_dst_job_volume,
ROUND(SUM(CASE WHEN j.job_type IN (707) THEN aa.modified_sent_kb/div_by ELSE 0 END),2) rep_src_job_volume,
ROUND(SUM(CASE WHEN j.job_type NOT IN (701,702,703,706,707) THEN j.kilobytes/var.div_by ELSE 0 END),2) other_job_volume,
AVG(j.duration_secs/60 ) avg_duration,
AVG(j.nbr_of_files/1000000) avg_nbr_of_files,
MAX(j.nbr_of_files/1000000) max_nbr_of_files,
(SUM(aa.modified_sent_kb)/(SUM(aa.modified_not_sent_kb)+.0001))*100 dedupe_pct
FROM apt_v_job j, apt_v_avm_activities aa, var
WHERE j.client_id IN (${hosts})
AND j.server_name LIKE &#039;${queryCombo1}&#039;
AND j.start_date BETWEEN ${startDate} AND ${endDate}
AND j.job_id = aa.job_id 
),
t1 AS (--Get all the special plugins
SELECT
SUM(DECODE(pc.plugin_name,&#039;AIX&#039;,aa.modified_sent_kb/div_by,0)) aix,
SUM(DECODE(pc.plugin_name,&#039;AIX Agent&#039;,aa.modified_sent_kb/div_by,0)) aix_agent,
SUM(DECODE(pc.plugin_name,&#039;DB2&#039;,aa.modified_sent_kb/div_by,0)) db2,
SUM(DECODE(pc.plugin_name,&#039;dto&#039;,aa.modified_sent_kb/div_by,0)) dto,
SUM(DECODE(pc.plugin_name,&#039;dtorestore&#039;,aa.modified_sent_kb/div_by,0)) dtorrestore,
SUM(DECODE(pc.plugin_name,&#039;EMC Celerra&#039;,aa.modified_sent_kb/div_by,0)) emc_celerra,
SUM(DECODE(pc.plugin_name,&#039;Exchange Database&#039;,aa.modified_sent_kb/div_by,0)) exchange_database,
SUM(DECODE(pc.plugin_name,&#039;Exchange GLR&#039;,aa.modified_sent_kb/div_by,0)) exchange_glr,
SUM(DECODE(pc.plugin_name,&#039;Exchange Message&#039;,aa.modified_sent_kb/div_by,0)) exchange_message,
SUM(DECODE(pc.plugin_name,&#039;Exchange VSS Writer 2007&#039;,aa.modified_sent_kb/div_by,0)) exchange_vss_writer,
SUM(DECODE(pc.plugin_name,&#039;Exchange Webservice 2007&#039;,aa.modified_sent_kb/div_by,0)) exchange_webservice,
SUM(DECODE(pc.plugin_name,&#039;ExchangeDB03-07&#039;,aa.modified_sent_kb/div_by,0)) exchangedb,
SUM(DECODE(pc.plugin_name,&#039;FreeBSD Agent&#039;,aa.modified_sent_kb/div_by,0)) freebsd_agent,
SUM(DECODE(pc.plugin_name,&#039;HP-UX&#039;,aa.modified_sent_kb/div_by,0)) hp_ux,
SUM(DECODE(pc.plugin_name,&#039;HP-UX Agent&#039;,aa.modified_sent_kb/div_by,0)) hpux_agent,
SUM(DECODE(pc.plugin_name,&#039;Hyper-V GLR&#039;,aa.modified_sent_kb/div_by,0)) hyper_v_glr,
SUM(DECODE(pc.plugin_name,&#039;Hyper-V VSS&#039;,aa.modified_sent_kb/div_by,0)) hyper_v_vss,
SUM(DECODE(pc.plugin_name,&#039;Isilon Filer&#039;,aa.modified_sent_kb/div_by,0)) isilon_filer,
SUM(DECODE(pc.plugin_name,&#039;Linux Agent&#039;,aa.modified_sent_kb/div_by,0)) linux_agent,
SUM(DECODE(pc.plugin_name,&#039;lotus&#039;,aa.modified_sent_kb/div_by,0)) lotus,
SUM(DECODE(pc.plugin_name,&#039;Macintosh Agent&#039;,aa.modified_sent_kb/div_by,0)) mac_agent,
SUM(DECODE(pc.plugin_name,&#039;MacOSX&#039;,aa.modified_sent_kb/div_by,0)) macos,
SUM(DECODE(pc.plugin_name,&#039;moss&#039;,aa.modified_sent_kb/div_by,0)) moss,
SUM(DECODE(pc.plugin_name,&#039;NDMP&#039;,aa.modified_sent_kb/div_by,0)) ndmp,
SUM(DECODE(pc.plugin_name,&#039;Netapp Filer&#039;,aa.modified_sent_kb/div_by,0)) netapp_filer,
SUM(DECODE(pc.plugin_name,&#039;netware&#039;,aa.modified_sent_kb/div_by,0)) netware,
SUM(DECODE(pc.plugin_name,&#039;Netware Agent&#039;,aa.modified_sent_kb/div_by,0)) netware_agent,
SUM(DECODE(pc.plugin_name,&#039;Novell Netware&#039;,aa.modified_sent_kb/div_by,0)) novell_netware,
SUM(DECODE(pc.plugin_name,&#039;Oracle&#039;,aa.modified_sent_kb/div_by,0)) oracle,
SUM(DECODE(pc.plugin_name,&#039;Oracle ZFS&#039;,aa.modified_sent_kb/div_by,0)) oracle_zfs,
SUM(DECODE(pc.plugin_name,&#039;Replicate&#039;,aa.modified_sent_kb/div_by,0)) replicate,
SUM(DECODE(pc.plugin_name,&#039;SAP&#039;,aa.modified_sent_kb/div_by,0)) sap,
SUM(DECODE(pc.plugin_name,&#039;SCO OpenServer Agent&#039;,aa.modified_sent_kb/div_by,0)) sco,
SUM(DECODE(pc.plugin_name,&#039;SharePoint GLR&#039;,aa.modified_sent_kb/div_by,0)) sharepoint_glr,
SUM(DECODE(pc.plugin_name,&#039;SharePoint VSS&#039;,aa.modified_sent_kb/div_by,0)) sharepoint_vss,
SUM(DECODE(pc.plugin_name,&#039;Solaris Agent&#039;,aa.modified_sent_kb/div_by,0)) solaris_agent,
SUM(DECODE(pc.plugin_name,&#039;SQL&#039;,aa.modified_sent_kb/div_by,0)) sql_agent,
SUM(DECODE(pc.plugin_name,&#039;SQLVSS&#039;,aa.modified_sent_kb/div_by,0)) sql_vss,
SUM(DECODE(pc.plugin_name,&#039;Sybase&#039;,aa.modified_sent_kb/div_by,0)) sybase,
SUM(DECODE(pc.plugin_name,&#039;Unix&#039;,aa.modified_sent_kb/div_by,0)) unix,
SUM(DECODE(pc.plugin_name,&#039;UnixWare Agent&#039;,aa.modified_sent_kb/div_by,0)) unixware_agent,
SUM(DECODE(pc.plugin_name,&#039;UNKNOWN&#039;,aa.modified_sent_kb/div_by,0)) unknown,
SUM(DECODE(pc.plugin_name,&#039;update&#039;,aa.modified_sent_kb/div_by,0)) update_agent,
SUM(DECODE(pc.plugin_name,&#039;vappimage&#039;,aa.modified_sent_kb/div_by,0)) vappimage,
SUM(DECODE(pc.plugin_name,&#039;vdrmigration&#039;,aa.modified_sent_kb/div_by,0)) vdrmigration,
SUM(DECODE(pc.plugin_name,&#039;vmglr&#039;,aa.modified_sent_kb/div_by,0)) vmglr,
SUM(DECODE(pc.plugin_name,&#039;vmimage&#039;,aa.modified_sent_kb/div_by,0)) vmimage,
SUM(DECODE(pc.plugin_name,&#039;vmimagel&#039;,aa.modified_sent_kb/div_by,0)) vmimagel,
SUM(DECODE(pc.plugin_name,&#039;vmimagew&#039;,aa.modified_sent_kb/div_by,0)) vmimagew,
SUM(DECODE(pc.plugin_name,&#039;vmir&#039;,aa.modified_sent_kb/div_by,0)) vmir,
SUM(DECODE(pc.plugin_name,&#039;vmwfile&#039;,aa.modified_sent_kb/div_by,0)) vmwfile,
SUM(DECODE(pc.plugin_name,&#039;vmwfilel&#039;,aa.modified_sent_kb/div_by,0)) vmwfilel,
SUM(DECODE(pc.plugin_name,&#039;vmwfilew&#039;,aa.modified_sent_kb/div_by,0)) vmwfilew,
SUM(DECODE(pc.plugin_name,&#039;VSS&#039;,aa.modified_sent_kb/div_by,0)) vss,
SUM(DECODE(pc.plugin_name,&#039;winclusterfs&#039;,aa.modified_sent_kb/div_by,0)) winclusterfs,
SUM(DECODE(pc.plugin_name,&#039;Windows&#039;,aa.modified_sent_kb/div_by,0)) windows,
SUM(DECODE(pc.plugin_name,&#039;Windows Agent&#039;,aa.modified_sent_kb/div_by,0)) windows_agent
FROM apt_v_avm_activities aa, apt_v_avm_plugin_catalog pc, var
WHERE aa.plugin_id = pc.plugin_id
AND aa.start_date BETWEEN ${startDate} AND ${endDate}
AND aa.server_name LIKE &#039;${queryCombo1}&#039;
)
SELECT 001 sort_order, &#039;&lt;b&gt;Total Modified Sent&lt;/b&gt;&#039; kpi_metric, TO_CHAR(modified_sent,&#039;999,999,999.00&#039;)||the_unit kpi_value1, 
&#039; &#039; kpi_value2 
FROM t0,t1, var UNION
SELECT 002 sort_order, &#039;-- AIX Plugin Sent&#039; kpi_metric, TO_CHAR((aix+aix_agent),&#039;999,999,999.00&#039;)||the_unit kpi_value1, 
TO_CHAR(ROUND((aix+aix_agent)/DECODE(modified_sent,0,null,modified_sent)*100,2))||&#039;%&#039; kpi_value2 
FROM t0,t1, var UNION
SELECT 002 sort_order, &#039;-- DB2 Plugin Sent&#039; kpi_metric, TO_CHAR(db2,&#039;999,999,999.00&#039;)||the_unit kpi_value1, 
TO_CHAR(ROUND((db2)/DECODE(modified_sent,0,null,modified_sent)*100,2))||&#039;%&#039; kpi_value2 
FROM t0,t1, var UNION
SELECT 002 sort_order, &#039;-- DTO Plugin Sent&#039; kpi_metric, TO_CHAR((dto+dtorrestore),&#039;999,999,999.00&#039;)||the_unit kpi_value1, 
TO_CHAR(ROUND((dto+dtorrestore)/DECODE(modified_sent,0,null,modified_sent)*100,2))||&#039;%&#039; kpi_value2 
FROM t0,t1, var UNION
SELECT 002 sort_order, &#039;-- EMC Celerra Plugin Sent&#039; kpi_metric, TO_CHAR(emc_celerra,&#039;999,999,999.00&#039;)||the_unit kpi_value1, 
TO_CHAR(ROUND((emc_celerra)/DECODE(modified_sent,0,null,modified_sent)*100,2))||&#039;%&#039; kpi_value2 
FROM t0,t1, var UNION
SELECT 002 sort_order, &#039;-- Exchange Plugin Sent&#039; kpi_metric, TO_CHAR((exchange_database+exchange_glr+exchange_message+exchange_vss_writer+exchange_webservice+exchangedb),&#039;999,999,999.00&#039;)||the_unit kpi_value1, 
TO_CHAR(ROUND((exchange_database+exchange_glr+exchange_message+exchange_vss_writer+exchange_webservice+exchangedb)/DECODE(modified_sent,0,null,modified_sent)*100,2))||&#039;%&#039; kpi_value2 
FROM t0,t1, var UNION
SELECT 002 sort_order, &#039;-- Oracle and Oracle ZFS Plugin Sent&#039; kpi_metric, TO_CHAR((oracle+oracle_zfs),&#039;999,999,999.00&#039;)||the_unit kpi_value1, 
TO_CHAR(ROUND((oracle+oracle_zfs)/DECODE(modified_sent,0,null,modified_sent)*100,2))||&#039;%&#039; kpi_value2 
FROM t0,t1, var UNION
SELECT 002 sort_order, &#039;-- NetApp and NDMP Plugin Sent&#039; kpi_metric, TO_CHAR((netapp_filer+ndmp),&#039;999,999,999.00&#039;)||the_unit kpi_value1, 
TO_CHAR(ROUND((netapp_filer+ndmp)/DECODE(modified_sent,0,null,modified_sent)*100,2))||&#039;%&#039; kpi_value2 
FROM t0,t1, var UNION
SELECT 002 sort_order, &#039;-- VMWARE Plugin Sent&#039; kpi_metric, TO_CHAR((vappimage+vdrmigration+vmglr+vmimage+vmimagel+vmimagew+vmir+vmwfile+vmwfilel+vmwfilew),&#039;999,999,999.00&#039;)||the_unit kpi_value1, 
TO_CHAR(ROUND((vappimage+vdrmigration+vmglr+vmimage+vmimagel+vmimagew+vmir+vmwfile+vmwfilel+vmwfilew)/DECODE(modified_sent,0,null,modified_sent)*100,2))||&#039;%&#039; kpi_value2 
FROM t0,t1, var UNION
SELECT 002 sort_order, &#039;-- Windows Plugin Sent&#039; kpi_metric, TO_CHAR((winclusterfs+windows+windows_agent),&#039;999,999,999.00&#039;)||the_unit kpi_value1, 
TO_CHAR(ROUND((winclusterfs+windows+windows_agent)/DECODE(modified_sent,0,null,modified_sent)*100,2))||&#039;%&#039; kpi_value2 
FROM t0,t1, var</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
