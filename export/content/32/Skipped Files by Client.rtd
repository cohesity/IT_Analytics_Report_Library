  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 04/30/2012
SELECT
j.server_name,
j.client_name,
REPLACE(aptStringConcat(sbf.skipped_filename),&#039;,&#039;,&#039;&lt;br&gt;&#039;) skipped_file,
COUNT(j.job_id) skipped_file_count
FROM apt_v_job j, apt_v_skipped_backup_file sbf
WHERE j.client_id IN (${hosts})
AND j.start_date BETWEEN ${startDate} AND ${endDate}
AND j.job_id = sbf.job_id
AND j.summary_status = 1
AND sbf.skipped_filename IS NOT NULL
GROUP BY 
j.server_name,
j.client_name</string>
          </entry>
