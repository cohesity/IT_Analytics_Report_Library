  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 09/12/2011
--Pie charted version 
SELECT
&#039;Used&#039; the_metric,
round(total_used_tracks_kb/1024/1024/1024,2) the_value
FROM aps_v_emc_sym_storage_pool
WHERE array_name||&#039; - &#039;||pool_name LIKE &#039;${queryCombo1}&#039;
UNION
SELECT
&#039;Available&#039; the_metric,
round((total_tracks_kb-total_used_tracks_kb)/1024/1024/1024,2) avail_tracks_tb
FROM aps_v_emc_sym_storage_pool
WHERE array_name||&#039; - &#039;||pool_name LIKE &#039;${queryCombo1}&#039;
UNION
SELECT
&#039;Over Subscribed&#039; the_metric,
CASE 
  WHEN subscribed_pct &lt;= 100 THEN 0
  ELSE round(((total_tracks_kb * (subscribed_pct/100))/1024/1024/1024) - (total_tracks_kb/1024/1024/1024),2) 
END over_subscribed
FROM aps_v_emc_sym_storage_pool
WHERE array_name||&#039; - &#039;||pool_name LIKE &#039;${queryCombo1}&#039;</string>
          </entry>
