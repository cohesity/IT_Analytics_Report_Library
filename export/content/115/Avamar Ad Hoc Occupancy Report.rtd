<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 07/10/2012
SELECT 
DECODE(&#039;${freeCombo1}&#039;,
&#039;Client&#039;,client_name,
&#039;Avamar Server&#039;,server_name,
&#039;Job Type&#039;,job_type_name) unit,
SUM(modified_sent_kb)/1024/1024 total_unexpired_data,
SUM(CASE WHEN expiration_date BETWEEN sysdate AND sysdate+30 THEN modified_sent_kb END)/1024/1024 less_than_30,
SUM(CASE WHEN expiration_date BETWEEN sysdate+30 AND sysdate+90 THEN modified_sent_kb END)/1024/1024 bt_30_and_90,
SUM(CASE WHEN expiration_date BETWEEN sysdate+90 AND sysdate+365.25 THEN modified_sent_kb END)/1024/1024 bt_90_and_1yr,
SUM(CASE WHEN expiration_date BETWEEN sysdate+365.25 AND sysdate+1825 THEN modified_sent_kb END)/1024/1024 bt_1_and_5yrs,
SUM(CASE WHEN expiration_date &gt; sysdate+1825 THEN modified_sent_kb END)/1024/1024 over_5yrs
FROM apt_v_avm_activities
WHERE client_id IN (${hosts})
AND expiration_date &gt; sysdate
AND DECODE(&#039;${freeCombo1}&#039;,
&#039;Client&#039;,client_name,
&#039;Avamar Server&#039;,server_name,
&#039;Job Type&#039;,job_type_name) IS NOT NULL
GROUP BY 
DECODE(&#039;${freeCombo1}&#039;,
&#039;Client&#039;,client_name,
&#039;Avamar Server&#039;,server_name,
&#039;Job Type&#039;,job_type_name)
ORDER BY 1</string>
          </entry>
