  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 11/02/2012
WITH 
t1 AS (
SELECT job_id
FROM apt_v_nbu_job_detail
WHERE nbr_of_copies = ${freeCombo1}
AND client_id IN (${hosts})
AND start_date BETWEEN ${startDate} AND ${endDate}

),
t2 AS (--copies
SELECT
jdm.job_id,
&#039;Disk&#039; the_source,
jdm.copy_index,
jdm.written_kilobytes kilobytes,
jdm.expiration_date
FROM t1, apt_v_nbu_job_disk_media jdm
WHERE t1.job_id = jdm.job_id
UNION ALL
SELECT
jtm.job_id,
&#039;Tape&#039; the_source,
jtm.copy_index,
jtm.kilobytes kilobytes,
jtm.expiration_date
FROM t1, apt_v_nbu_job_tape_media jtm
WHERE t1.job_id = jtm.job_id
),
t3 AS (
SELECT
njd.job_id,
njd.server_id,
njd.master_host_name,
njd.client_id,
njd.client_host_name,
DECODE(copy_index,1,t2.copy_index) copy_index1,
DECODE(copy_index,1,t2.the_source) the_source1,
DECODE(copy_index,1,t2.kilobytes) kilobytes1,
DECODE(copy_index,1,t2.expiration_date) expiration_date1,
DECODE(copy_index,2,t2.copy_index) copy_index2,
DECODE(copy_index,2,t2.the_source) the_source2,
DECODE(copy_index,2,t2.kilobytes) kilobytes2,
DECODE(copy_index,2,t2.expiration_date) expiration_date2,
DECODE(copy_index,3,t2.copy_index) copy_index3,
DECODE(copy_index,3,t2.the_source) the_source3,
DECODE(copy_index,3,t2.kilobytes) kilobytes3,
DECODE(copy_index,3,t2.expiration_date) expiration_date3
FROM t2,apt_v_nbu_job_detail njd
WHERE t2.job_id = njd.job_id
)
SELECT
job_id,
server_id,
master_host_name,
client_id,
client_host_name,
MAX(copy_index1) copy_index1,
MAX(the_source1) the_source1,
SUM(kilobytes1/1024/1024) size1,
MAX(expiration_date1) expiration_date1, 
CASE WHEN MAX(expiration_date1) &lt;= sysdate THEN &#039;yellow&#039; ELSE &#039;green&#039; END date1_dot,
MAX(copy_index2) copy_index2,
MAX(the_source2) the_source2,
SUM(kilobytes2/1024/1024) size2,
MAX(expiration_date2) expiration_date2,
CASE WHEN MAX(expiration_date2) &lt;= sysdate THEN &#039;yellow&#039; ELSE &#039;green&#039; END date2_dot,
MAX(copy_index3) copy_index3,
MAX(the_source3) the_source3,
SUM(kilobytes3/1024/1024) size3,
MAX(expiration_date3) expiration_date3,
CASE WHEN MAX(expiration_date3) &lt;= sysdate THEN &#039;yellow&#039; ELSE &#039;green&#039; END date3_dot
FROM t3
GROUP BY
job_id,
server_id,
master_host_name,
client_id,
client_host_name</string>
          </entry>
