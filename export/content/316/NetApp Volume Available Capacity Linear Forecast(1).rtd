<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>descriptiveName</string>
            <string>NetApp Volume Available Capacity Linear Forecast</string>
          </entry>
          <entry>
            <string>drilldown</string>
            <boolean>false</boolean>
          </entry>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 05/22/2014
--Computes the future capacity of Data Domain based on 
--Linear Regression (Linear) Sum of squares linear algorithm y=mX+b
WITH 
d0 AS (
SELECT
DECODE(&#039;${freeCombo1}&#039;,&#039;Day&#039;,1,&#039;Week&#039;,7,&#039;Month&#039;,31,&#039;Quarter&#039;,93,&#039;Year&#039;,365.24) nbr_of_days,
to_number(&#039;${freeCombo2}&#039;) forecast_periods,
DECODE(&#039;${freeCombo3}&#039;,
&#039;KB&#039;,1,&#039;MB&#039;,(1024),&#039;GB&#039;,(1024*1024),&#039;TB&#039;,(1024*1024*1024),&#039;PB&#039;,(1024*1024*1024*1024)) div_by 
FROM dual
),
a0 AS (--Get all the capacity merics for each period
SELECT 
vl.nap_volume_id,
TRUNC(log_date,DECODE(&#039;${freeCombo1}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;,&#039;YY&#039;)) log_date,
ROW_NUMBER() OVER (PARTITION BY vl.nap_volume_id ORDER BY vl.nap_volume_id) row_number,
ROUND(MAX((vl.total_size_kb - vl.used_size_kb)/div_by),2) available
FROM aps_v_nap_volume_log vl, aps_v_nap_volume v, d0 
WHERE log_date BETWEEN ${startDate} AND ${endDate}
AND vl.nap_volume_id = v.nap_volume_id
AND v.system_name|| &#039;-&#039; ||v.volume_name = &#039;${queryCombo1}&#039;
GROUP BY vl.nap_volume_id, trunc(log_date,DECODE(&#039;${freeCombo1}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;,&#039;YY&#039;))
),
a1 AS (
SELECT 
ROWNUM period,
log_date,
available,
REGR_SLOPE(available,ROWNUM) OVER (PARTITION BY nap_volume_id) slope,
REGR_INTERCEPT(available, ROWNUM) OVER (PARTITION BY nap_volume_id) y_intercept
FROM a0
ORDER BY 1
),
p0 AS (--Find the last period so you can forecast past it
SELECT 
MAX(period) last_period,
MAX(log_date) last_date
FROM a1
)
SELECT
log_date,
round(available,2) available,
0 future_available,
period*slope+y_intercept trend_line--Future values can be determined for any period using this formula
FROM a1, p0
UNION ALL --Future
SELECT 
TRUNC(the_date,DECODE(&#039;${freeCombo1}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;,&#039;YY&#039;)) log_date,
0 available,
ROUND((period+ROWNUM)*slope+y_intercept,2) future_available,
(period+ROWNUM)*slope+y_intercept trend_line
FROM a1,p0,d0, TABLE(rtd.APTlistOfDates(p0.last_date+d0.nbr_of_days,p0.last_date+(d0.forecast_periods*d0.nbr_of_days),DECODE(&#039;${freeCombo1}&#039;,&#039;Day&#039;,11,&#039;Week&#039;,12,&#039;Month&#039;,13,&#039;Quarter&#039;,14,&#039;Year&#039;,15))) the_dates
WHERE period = p0.last_period</string>
          </entry>
          <entry>
            <string>postReportInterceptor</string>
            <null/>
          </entry>
