          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 06/21/2018
WITH 
lb AS (--Last backup
SELECT
lb.client_id,
MAX(lb.finish_date) last_backup
FROM apt_v_last_nbu_backup lb
WHERE
lb.client_id IN (${hosts})
AND lb.finish_date &gt; sysdate -7
GROUP BY lb.client_id
)
SELECT
pc.server_id,
s.hostname,
cd.client_id,
pc.client_name,
cd.version,
cd.patch_level,
cd.platform,
cd.installation_path,
REPLACE(aptStringConcat(DISTINCT pc.policy_name||DECODE(pc.is_active,&apos;Y&apos;,&apos;&apos;,&apos;N&apos;,&apos;*&apos;)),&apos;,&apos;,&apos;&lt;br&gt;&apos;) policies,
MAX(cd.last_updated) last_updated,
MAX(lb.last_backup) last_backup
FROM apt_v_nbu_client_detail cd, apt_v_nbu_policy_client pc, apt_v_server s, lb
WHERE 
cd.client_id IN (${hosts})
AND pc.client_id IN (${hosts})
AND cd.client_id = pc.client_id (+)
AND pc.server_id = s.server_id
AND pc.client_id = lb.client_id (+)
AND pc.is_active LIKE DECODE(&apos;${freeCombo1}&apos;,&apos;All&apos;,&apos;%&apos;,&apos;Active&apos;,&apos;Y&apos;,&apos;Inactive&apos;,&apos;N&apos;)
AND REGEXP_LIKE(pc.policy_name,&apos;${freeText1}&apos;)
GROUP BY
pc.server_id,
s.hostname,
cd.client_id,
pc.client_name,
cd.version,
cd.patch_level,
cd.platform,
cd.installation_path</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
