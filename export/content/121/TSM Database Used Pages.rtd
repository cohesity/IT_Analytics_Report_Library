  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>SELECT to_char(log_date, &#039;MM/DD/YY&#039;) log_date,hostname server,  
cache_hit_pct, cache_wait_pct,
avail_space_mbytes, capacity_mbytes, max_extension_mbytes, max_reduction_mbytes, 
page_size_bytes, used_pages
FROM apt_v_tsm_database_log d,  apt_v_server s
WHERE d.server_id=s.server_id
AND d.server_id IN (${hosts})
AND log_date BETWEEN ${startDate} AND ${endDate}</string>
          </entry>
          <entry>
            <string>designerScript</string>
            <null/>
          </entry>
