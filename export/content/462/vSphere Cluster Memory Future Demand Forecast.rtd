            <string>designerScript</string>
            <null/>
          </entry>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 03/31/2020
WITH 
var AS (
SELECT 
  DECODE(&apos;${queryCombo1}&apos;,&apos;95%&apos;,.95,&apos;90%&apos;,.90,&apos;85%&apos;,.85,&apos;80%&apos;,.80,&apos;75%&apos;,.75,&apos;70%&apos;,.70) pct_1,
  DECODE(&apos;${queryCombo2}&apos;,&apos;95%&apos;,.95,&apos;90%&apos;,.90,&apos;85%&apos;,.85,&apos;80%&apos;,.80,&apos;75%&apos;,.75,&apos;70%&apos;,.70) pct_2,
  DECODE(&apos;${freeCombo1}&apos;,&apos;GB&apos;,1,&apos;TB&apos;,1024,&apos;PB&apos;,1024*1024) div_by,
  DECODE(&apos;${freeCombo2}&apos;,&apos;Days&apos;,1,&apos;Weeks&apos;,7,&apos;Months&apos;,31,&apos;Quarters&apos;,93,&apos;Years&apos;,365.25) day_multiplier,
  TO_NUMBER(&apos;${freeCombo3}&apos;) forecast_periods
FROM dual
),
/***********************************************/
l1 AS (--First get 1 entry per period
SELECT DISTINCT
  TRUNC(log_date,DECODE(&apos;${freeCombo2}&apos;,&apos;Days&apos;,&apos;DD&apos;,&apos;Weeks&apos;,&apos;WW&apos;,&apos;Months&apos;,&apos;MM&apos;,&apos;Quarters&apos;,&apos;Q&apos;,&apos;Years&apos;,&apos;YY&apos;)) log_date,
  vs.vmw_cluster_id,
  l.virtual_system_id,
  l.partition_id,
  l.partition_type,
  MAX(l.nbr_cpu) nbr_cpu,
  MAX(l.host_memory_usage_kb) host_memory_usage_kb,
  MAX(l.guest_memory_usage_kb) guest_memory_usage_kb,
  MAX(l.memory_size_kb) memory_size_kb,
  MAX(l.overall_cpu_usage) overall_cpu_usage
FROM 
  apt_v_vmw_partition_stats_log l, apt_v_virtual_system vs, apt_v_vmw_cluster vc
WHERE
  vc.vmw_cluster_id = vs.vmw_cluster_id
  AND vs.virtual_system_id = l.virtual_system_id
  AND l.log_date BETWEEN ${startDate} AND ${endDate}
  AND vs.data_center_name||&apos; - &apos;||vc.cluster_name LIKE &apos;${queryCombo3}&apos;
GROUP BY 
  TRUNC(log_date,DECODE(&apos;${freeCombo2}&apos;,&apos;Days&apos;,&apos;DD&apos;,&apos;Weeks&apos;,&apos;WW&apos;,&apos;Months&apos;,&apos;MM&apos;,&apos;Quarters&apos;,&apos;Q&apos;,&apos;Years&apos;,&apos;YY&apos;)),
  vs.vmw_cluster_id,
  l.virtual_system_id,
  l.partition_id,
  l.partition_type
),
l2 AS (
SELECT
  l1.log_date,
  vs.vmw_cluster_id,
  l1.virtual_system_id,
  SUM(DECODE(l1.partition_type,&apos;VM&apos;,1,0)) nbr_vms,
  SUM(DECODE(l1.partition_type,&apos;HOST&apos;,nbr_cpu,0)) nbr_hcpu,
  SUM(DECODE(l1.partition_type,&apos;VM&apos;,nbr_cpu,0)) nbr_vcpu,
  ROUND(SUM(host_memory_usage_kb/1024/1024),2) host_mem_used,
  ROUND(SUM(guest_memory_usage_kb/1024/1024),2) guest_mem_used,
  ROUND(SUM(DECODE(l1.partition_type,&apos;HOST&apos;,memory_size_kb/1024/1024,0)),2) host_mem_size,
  ROUND(SUM(DECODE(l1.partition_type,&apos;VM&apos;,memory_size_kb/1024/1024,0)),2) guest_mem_size,
  SUM(DECODE(l1.partition_type,&apos;HOST&apos;,overall_cpu_usage,0)) host_cpu_usage,
  SUM(DECODE(l1.partition_type,&apos;VM&apos;,overall_cpu_usage,0)) vm_cpu_usage
FROM 
  l1, apt_v_virtual_system vs
WHERE
  l1.virtual_system_id = vs.virtual_system_id
GROUP BY 
  l1.log_date,
  vs.vmw_cluster_id,
  l1.virtual_system_id
ORDER BY 2,3,1	
),
t1 AS (
SELECT
  ROW_NUMBER() OVER (ORDER BY log_date ASC) the_period,
  log_date the_date,
  COUNT(DISTINCT vmw_cluster_id) nbr_vmw_clusters,
  COUNT(DISTINCT virtual_system_id) nbr_virtual_systems,
  TRUNC(SUM(nbr_hcpu)) nbr_hcpu,
  TRUNC(SUM(host_mem_used)) the_value,
  TRUNC(SUM(host_mem_size)) the_capacity,
  ROUND(SUM(host_mem_used) / NULLIF(SUM(host_mem_size),0) * 100,2) host_mem_pct_used,
  TRUNC(SUM(host_cpu_usage)) host_cpu_usage,
  TRUNC(SUM(nbr_vms)) nbr_vms,
  TRUNC(SUM(nbr_vcpu)) nbr_vcpu,
  TRUNC(SUM(guest_mem_used)) guest_mem_used,
  TRUNC(SUM(guest_mem_size)) guest_mem_size,
  ROUND(SUM(guest_mem_used) / NULLIF(SUM(guest_mem_size),0) * 100,2) guest_mem_pct_used,
  TRUNC(SUM(vm_cpu_usage)) vm_cpu_usage
FROM 
  l2
GROUP BY
  log_date
ORDER BY 
  log_date
),
f0 AS (--Gather the forecasting variables - This will return 1 row
SELECT DISTINCT
  COUNT(*) OVER () nbr_of_periods,
  MAX(the_capacity) OVER () max_the_capacity,
  MAX(the_value) OVER () max_of_the_value,
  FIRST_VALUE(the_date) OVER (ORDER BY the_date ASC) first_date,
  FIRST_VALUE(the_date) OVER (ORDER BY the_date DESC) last_date,
  FIRST_VALUE(the_value) OVER (ORDER BY the_date ASC) first_value, 
  FIRST_VALUE(the_value) OVER (ORDER BY the_date DESC) last_value,
  REGR_INTERCEPT(the_value, the_period) OVER () lin_y_intercept,
  REGR_SLOPE(the_value, the_period) OVER () lin_slope,
  REGR_R2(the_value, the_period) OVER () r2_value,
  REGR_COUNT(the_value, the_period) OVER () r_count,
  (FIRST_VALUE(the_value) OVER (ORDER BY the_date DESC) - 
  FIRST_VALUE(the_value) OVER (ORDER BY the_date ASC)) /
  NULLIF(COUNT(*) OVER (),0) pop_slope,
  (FIRST_VALUE(the_value) OVER (ORDER BY the_date DESC) -
  (((FIRST_VALUE(the_value) OVER (ORDER BY the_date DESC) - 
  FIRST_VALUE(the_value) OVER (ORDER BY the_date ASC)) /
  NULLIF(COUNT(*) OVER (),0))) * (COUNT(*) OVER ())) pop_y_intercept
FROM 
  t1
),
d0 AS (--Future Dates
SELECT 
f0.nbr_of_periods + ROW_NUMBER() OVER (ORDER BY the_date ASC) the_period, 
ROW_NUMBER() OVER (ORDER BY the_date ASC) the_future_period, --Will start as 1 in the future 
the_date the_date
FROM var, f0, TABLE(rtd.APTlistOfDates(f0.last_date+var.day_multiplier,f0.last_date+(var.forecast_periods*var.day_multiplier),DECODE(&apos;${freeCombo2}&apos;,&apos;Days&apos;,11,&apos;Weeks&apos;,12,&apos;Months&apos;,13,&apos;Quarters&apos;,14,&apos;Years&apos;,15))) the_dates
)
SELECT
&apos;Past&apos; the_tense,
t1.the_period,
TO_CHAR(t1.the_date,&apos;YYYY/MM/DD&apos;) AS the_date,
f0.max_the_capacity,
ROUND(t1.the_value,2) the_past_value,
0 the_future_value,
(f0.max_the_capacity - t1.the_value)  available_capacity,
f0.max_the_capacity*pct_1 stop_allocating,
f0.max_the_capacity*pct_2 order_new,
f0.nbr_of_periods,
f0.max_of_the_value,
f0.first_date,
f0.last_date,
f0.first_value, 
f0.last_value,
f0.lin_slope,
f0.lin_y_intercept,
ROUND((t1.the_period * f0.lin_slope) + f0.lin_y_intercept,2) lin_trend_line, 
f0.pop_slope,
f0.pop_y_intercept,
ROUND((t1.the_period * f0.pop_slope) + f0.pop_y_intercept,2) pop_trend_line 
FROM f0, t1, var
UNION
SELECT
&apos;Future&apos; the_tense,
d0.the_period,
TO_CHAR(d0.the_date,&apos;YYYY/MM/DD&apos;) AS the_date,
f0.max_the_capacity,
0 the_past_value,
ROUND(f0.last_value + (f0.lin_slope * d0.the_future_period),2) the_future_value,
f0.max_the_capacity - (f0.last_value + (f0.lin_slope * d0.the_future_period)) available_capacity,
f0.max_the_capacity*pct_1 stop_allocating,
f0.max_the_capacity*pct_2 order_new,
f0.nbr_of_periods,
f0.max_of_the_value,
f0.first_date,
f0.last_date,
f0.first_value, 
f0.last_value,
f0.lin_slope,
f0.lin_y_intercept,
ROUND((d0.the_period * f0.lin_slope) + f0.lin_y_intercept,2) lin_trend_line, 
f0.pop_slope,
f0.pop_y_intercept,
ROUND((d0.the_period * f0.pop_slope) + f0.pop_y_intercept,2) pop_trend_line 
FROM d0, f0, var
ORDER BY the_date</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
    <entry>
      <string>authorUserId</string>
      <long>100230</long>
    </entry>
    <entry>
      <string>templateName</string>
      <null/>
    </entry>
    <entry>
      <string>id</string>
      <long>104781</long>
    </entry>
    <entry>
      <string>reportDecorator</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>2</version>
        <className>com.aptare.sc.domain.report.Decorator</className>
        <data>
          <entry>
            <string>excludes</string>
