  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 07/19/2013
SELECT
s.server_id,
s.hostname,
client_id,
client_name,
effective_path,
SUM(nbr_files_skipped) nbr_files_skipped,
MAX(job_id) job_id,
MAX(recorded_date) last_backup
FROM apt_v_avm_activities j,apt_v_server s
WHERE
j.server_id = s.server_id
AND recorded_date BETWEEN ${startDate} AND ${endDate}
AND nbr_files_skipped &gt; 0
AND client_id IN (${hosts})
GROUP BY 
s.server_id,
s.hostname,
client_id,
client_name,
effective_path
ORDER BY 2,4,8</string>
          </entry>
