                    <string>Group by:</string>
                  </entry>
                  <entry>
                    <string>freeComboHeading2</string>
                    <string>Values in:</string>
                  </entry>
                </configuration>
                <referenceData/>
              </com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
              <com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
                <name>freeQueryCombo</name>
                <componentScript>
                  <before/>
                  <after/>
                </componentScript>
                <configuration>
                  <entry>
                    <string>sql</string>
                    <string>SELECT &#039; All&#039; array_name, &#039;All&#039; array_name FROM DUAL UNION SELECT DISTINCT array_name, array_name FROM aps_v_emc_sym_storage_pool </string>
                  </entry>
                  <entry>
                    <string>queryComboValues1</string>
                    <string>SELECT &#039; All&#039; array_name, &#039;All&#039; array_name FROM DUAL UNION SELECT DISTINCT array_name, array_name FROM aps_v_emc_sym_storage_pool </string>
                  </entry>
                  <entry>
                    <string>queryComboHeading1</string>
                    <string>Array:</string>
                  </entry>
                </configuration>
                <referenceData/>
              </com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
            </list>
          </entry>
