  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>descriptiveName</string>
            <string>EMC VMAX Pool Usage History</string>
          </entry>
          <entry>
            <string>drilldown</string>
            <boolean>false</boolean>
          </entry>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 02/03/2014
--Plots a stacked bar graph depicting the Used vs Available values in 
--EMC VMAX storage pools.
WITH 
var AS (
SELECT
DECODE(&#039;${freeCombo2}&#039;,&#039;KB&#039;,1,&#039;MB&#039;,1024,&#039;GB&#039;,(1024*1024),&#039;TB&#039;,(1024*1024*1024),&#039;PB&#039;,(1024*1024*1024*1024)) div_by 
FROM dual
),
a0 AS (
SELECT
TRUNC(log_date,DECODE(&#039;${freeCombo1}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;,&#039;YY&#039;)) the_date,
array_name,
pool_name,
ROUND(MAX(total_capacity_kb/div_by),2) total_capacity,
ROUND(MAX(used_capacity_kb/div_by),2) used,
ROUND(MAX(available_capacity_kb/div_by),2) available,
ROUND(MAX(subscribed_capacity_kb/div_by),2) subscribed
FROM aps_v_emc_sym_storage_pool_log spl, var
WHERE log_date BETWEEN ${startDate} AND ${endDate}
AND array_name LIKE DECODE(&#039;${queryCombo1}&#039;,&#039; All&#039;,&#039;%&#039;,&#039;${queryCombo1}&#039;)
AND array_name IS NOT NULL
GROUP BY 
trunc(log_date,DECODE(&#039;${freeCombo1}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;,&#039;YY&#039;)),
array_name,pool_name
)
SELECT 
to_char(the_date,&#039;MM/DD/YY&#039;) the_date,
SUM(total_capacity) total_capacity,
SUM(used) used,
SUM(available) available,
SUM(subscribed) subscribed
FROM a0
GROUP BY to_char(the_date,&#039;MM/DD/YY&#039;)</string>
          </entry>
