  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 09/19/2013
WITH 
VAR AS (
SELECT
DECODE(&#039;${freeCombo1}&#039;,
&#039;KB&#039;,1,&#039;MB&#039;,1024,&#039;GB&#039;,(1024*1024),&#039;TB&#039;,(1024*1024*1024),&#039;PB&#039;,(1024*1024*1024*1024)) div_by
FROM dual
),
t1 AS (--Get all the LUNs that are host sees but pick only 1 host if clustered
SELECT sp.logical_unit_id, 
MIN(sp.host_id) a_host_id,
COUNT(DISTINCT sp.host_id) related_host_ids,
aptStringConcat(DISTINCT h.host_name) related_host_names
FROM aps_v_storage_path sp, aps_v_host h
WHERE sp.host_id IN (${hosts})
AND sp.host_id = h.host_id (+)
GROUP BY sp.logical_unit_id
),
vs AS (--Fetch all VM ESX Servers
SELECT 
host_id,
virtual_system_id
FROM apt_v_virtual_system
WHERE host_id IN (${hosts})
),
t2 AS (
SELECT 
t1.a_host_id,
LOWER(h.host_name) host_name,
DECODE(vs.host_id,NULL,&#039;N&#039;,&#039;Y&#039;) is_esx,
t1.related_host_ids,
lu.storage_array_id,
lu.array_name,
lu.logical_unit_id lun_id,
lu.logical_unit_name lun_name,
lu.total_capacity_kb/div_by lun_capacity,
t1.related_host_names related_host_names
FROM t1, aps_v_host h, aps_v_logical_unit lu,  aps_v_storage_array_attribute aa,vs, var
WHERE t1.a_host_id = h.host_id
AND t1.logical_unit_id = lu.logical_unit_id
AND t1.a_host_id = vs.host_id (+)
AND lu.storage_array_id = aa.storage_array_id
UNION
SELECT
host_id,
&#039;Array WWN &#039;||sp.array_port_wwn||&#039; - Host WWN &#039;||sp.host_port_wwn||&#039;Unknown&#039; host_name,
&#039;N&#039; is_esx,
0 related_host_ids,
lu.storage_array_id,
lu.array_name,
lu.logical_unit_id lun,
lu.logical_unit_name lun_name,
lu.total_capacity_kb/div_by lun_capacity,
NULL related_host_names
FROM aps_v_logical_unit lu, aps_v_storage_array sa,  
aps_v_storage_path sp, var
WHERE lu.storage_array_id = sa.storage_array_id
AND lu.logical_unit_id NOT IN (SELECT t1.logical_unit_id FROM t1)
AND lu.status LIKE &#039;allocated%&#039;
AND lu.logical_unit_id = sp.logical_unit_id (+)
ORDER BY 
2,6
)
SELECT
to_char(sysdate,&#039;MM/DD/YYYY&#039;) run_date,
a_host_id,
host_name,
is_esx,
storage_array_id,
array_name,
COUNT(lun_id) luns,
SUM(lun_capacity) lun_capacity,
related_host_names
FROM t2
WHERE host_name NOT LIKE DECODE(&#039;${freeCombo2}&#039;,&#039;Yes&#039;,&#039;ZZZZZZZZ&#039;,&#039;No&#039;,&#039;%Unknown&#039;)
GROUP BY
a_host_id,
host_name,
is_esx,
storage_array_id,
array_name,
related_host_names
ORDER BY 2,5</string>
          </entry>
