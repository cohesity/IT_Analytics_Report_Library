  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 01/28/2012
WITH 
t1 AS (
SELECT 
to_char(nss.mirror_timestamp,&#039;MM/DD/YY&#039;) the_date,
nsc.source_system_name source,
max(nss.summary_status) status,
sum(DECODE(nss.summary_status,2,1,0)) failed,
sum(DECODE(nss.summary_status,1,1,0)) partial,
sum(DECODE(nss.summary_status,0,1,0)) success
FROM 
aps_v_nap_snapvault_config nsc,
aps_v_nap_snapvault_status nss
WHERE
nsc.nap_snapvault_config_id = nss.nap_snapvault_config_id (+)
AND nss.mirror_timestamp BETWEEN ${startDate} AND ${endDate}
AND nsc.source_system_name LIKE DECODE(&#039;${queryCombo1}&#039;,&#039; All&#039;,&#039;%&#039;,&#039;${queryCombo1}&#039;)
AND nsc.source_storage_system_id IS NULL
GROUP BY
to_char(nss.mirror_timestamp,&#039;MM/DD/YY&#039;),
nsc.source_system_name
)
SELECT
the_date, lower(source) source,
DECODE(status,null,&#039;white&#039;,0,&#039;green&#039;,1,&#039;yellow&#039;,2,&#039;red&#039;) status,
failed, 
partial, 
success
FROM t1
ORDER BY the_date DESC</string>
          </entry>
