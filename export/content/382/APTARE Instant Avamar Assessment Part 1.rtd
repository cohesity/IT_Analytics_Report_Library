          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 09/07/2016
WITH 
var AS (
SELECT
ROUND((${endDate} - ${startDate}),2) nbrOfDays,
DECODE(&#039;${freeCombo1}&#039;,
&#039;KB&#039;,1,&#039;MB&#039;,(1024),&#039;GB&#039;,(1024*1024),&#039;TB&#039;,(1024*1024*1024),&#039;PB&#039;,(1024*1024*1024*1024)) div_by 
FROM dual
),
n1 AS (
SELECT
master_server_id,
COUNT(DISTINCT node_id) nodes,
SUM(total_capacity_kb/div_by) nodes_total_capacity,
SUM((total_capacity_kb-used_capacity_kb)/div_by) nodes_free_capacity,
SUM(used_capacity_kb/div_by) nodes_used_capacity
FROM apt_v_avm_node n, var, apt_v_server s
WHERE master_server_id IN (${hosts})
AND s.server_id = n.master_server_id
AND s.display_name LIKE &#039;${queryCombo1}&#039;
GROUP BY master_server_id
),
dp AS (
SELECT
ds.master_server_id,
MAX(data_protected_kb) data_protected_kb
FROM apt_v_avm_dpn_statistics ds, apt_v_server s
WHERE ds.master_server_id IN (${hosts})
AND s.server_id = ds.master_server_id
AND s.display_name LIKE &#039;${queryCombo1}&#039;
--FIXME
--AND ds.last_updated &gt; sysdate - 7
GROUP BY ds.master_server_id
),
t2 AS (--Get the highest value for each client/plugin combination
SELECT 
aa.server_id, 
aa.client_id,
aa.plugin_id,
MAX(aa.scanned_kb/div_by) scanned
FROM apt_v_avm_activities aa, var, apt_v_server s
WHERE
aa.client_id IN (${hosts}) 
AND aa.scanned_kb &gt; 0
--FIXME
--AND aa.expiration_date &gt; sysdate
AND s.server_id = aa.server_id
AND s.display_name LIKE &#039;${queryCombo1}&#039;
GROUP BY 
aa.server_id,
aa.client_id,
aa.plugin_id
),
t3 AS (--Add them up and this should be the size of each client on the grid
SELECT 
server_id master_server_id,
COUNT(DISTINCT client_id) clients,
SUM(scanned) scanned
FROM t2
GROUP BY 
server_id
),
t4 AS (
SELECT 
axion_system_id,
gsan_system_id, 
ms.master_server_id, 
hfs_address,
local_hfs_address, 
hfs_port, 
mcs_port, 
gsan_run_level, 
DECODE(gsan_run_level,&#039;up&#039;,&#039;green&#039;,&#039;degraded&#039;,&#039;yellow&#039;,&#039;red&#039;) run_level_dot,
t3.clients,
t3.scanned,
dp.data_protected_kb/div_by data_protected,
ROUND((dp.data_protected_kb/used_capacity_kb),1)||&#039;:1&#039; dedup_ratio,
((total_capacity_kb-used_capacity_kb)*(dp.data_protected_kb/used_capacity_kb)) /div_by est_available_capacity,
total_capacity_kb/var.div_by total_capacity,
used_capacity_kb/var.div_by used_capacity,  
(total_capacity_kb-used_capacity_kb)/div_by available_capacity,
(used_capacity_kb/DECODE(total_capacity_kb,0,null,total_capacity_kb)) used_pct,
(used_capacity_kb/DECODE(total_capacity_kb,0,null,total_capacity_kb))*100 pct_used,
protected_bytes_quota, 
license_expiration_date, 
time_since_server_init, 
rtd.secsToHoursMinSecs(time_since_server_init) time_since_server_init_hrs, 
last_updated_in_avm, 
last_checkpoint, 
last_validated_checkpoint,
nodes,
nodes_total_capacity,
nodes_used_capacity, 
nodes_free_capacity
FROM apt_v_avm_axion_system ms, var, n1, dp, t3, apt_v_server s
WHERE ms.master_server_id IN (${hosts})
AND s.server_id = ms.master_server_id
AND s.display_name LIKE &#039;${queryCombo1}&#039;
AND ms.master_server_id = n1.master_server_id (+)
AND ms.master_server_id = dp.master_server_id (+)
AND ms.master_server_id = t3.master_server_id (+)
)
--SELECT &#039;01&#039; sort_order,&#039;&lt;b&gt;Server ID Primary Key&lt;/b&gt;&#039; metric, TO_CHAR(master_server_id) value FROM t4 UNION
--SELECT &#039;05&#039; sort_order,&#039;&lt;b&gt;MCS Port&lt;/b&gt;&#039; metric, TO_CHAR(mcs_port) value FROM t4 UNION 
SELECT &#039;02&#039; sort_order,&#039;&lt;b&gt;HFS IP Address&lt;/b&gt;&#039; metric, hfs_address value FROM t4 UNION
SELECT &#039;03&#039; sort_order,&#039;&lt;b&gt;HFS Name&lt;/b&gt;&#039; metric, local_hfs_address value FROM t4 UNION
SELECT &#039;04&#039; sort_order,&#039;&lt;b&gt;HFS / MCS Port&lt;/b&gt;&#039; metric, TO_CHAR(hfs_port)||&#039; / &#039;||TO_CHAR(mcs_port) value FROM t4 UNION
SELECT &#039;05&#039; sort_order,&#039;&lt;b&gt;Run Level&lt;/b&gt;&#039; metric, gsan_run_level value FROM t4 UNION 
SELECT &#039;06&#039; sort_order,&#039;&lt;b&gt;License Expiration&lt;/b&gt;&#039; metric, NVL(TO_CHAR(license_expiration_date,&#039;MM/DD/YYYY&#039;),&#039;Never&#039;) FROM t4 UNION 
SELECT &#039;07&#039; sort_order,&#039;&lt;b&gt;Time Since Server Intitialization&lt;/b&gt;&#039; metric, time_since_server_init_hrs FROM t4 UNION 
SELECT &#039;08&#039; sort_order,&#039;&lt;b&gt;Last Checkpoint&lt;/b&gt;&#039; metric, TO_CHAR(last_checkpoint,&#039;MM/DD/YYYY&#039;) FROM t4 UNION 
SELECT &#039;09&#039; sort_order,&#039;&lt;b&gt;Last Validated Checkpoint&lt;/b&gt;&#039; metric, TO_CHAR(last_validated_checkpoint,&#039;MM/DD/YYYY&#039;) FROM t4 UNION 
SELECT &#039;10&#039; sort_order,&#039;&lt;b&gt;Protected Quota&lt;/b&gt;&#039; metric, protected_bytes_quota FROM t4 UNION 
SELECT &#039;12&#039; sort_order,&#039;&lt;b&gt;Number of Clients&lt;/b&gt;&#039; metric, TO_CHAR(clients) value FROM t4 UNION 
SELECT &#039;13&#039; sort_order,&#039;&lt;b&gt;Client Data&lt;/b&gt;&#039; metric, TO_CHAR(scanned,&#039;999G999G999D99&#039;)||&#039; ${freeCombo1}&#039; value FROM t4 UNION 
SELECT &#039;14&#039; sort_order,&#039;&lt;b&gt;Data Protected&lt;/b&gt;&#039; metric, TO_CHAR(data_protected,&#039;999G999G999D99&#039;)||&#039;${freeCombo1}&#039; value FROM t4 UNION 
SELECT &#039;15&#039; sort_order,&#039;&lt;b&gt;Dedup Ratio&lt;/b&gt;&#039; metric, dedup_ratio value FROM t4 UNION 
SELECT &#039;17&#039; sort_order,&#039;&lt;b&gt;Estimated Available Capacity*&lt;/b&gt;&#039; metric, TO_CHAR(est_available_capacity,&#039;999G999G999D99&#039;)||&#039; ${freeCombo1}&#039; FROM t4 UNION 
SELECT &#039;19&#039; sort_order,&#039;&lt;b&gt;Total Disk Capacity&lt;/b&gt;&#039; metric, TO_CHAR(total_capacity,&#039;999G999G999D99&#039;)||&#039; ${freeCombo1}&#039; FROM t4 UNION 
SELECT &#039;20&#039; sort_order,&#039;&lt;b&gt;Used Disk Capacity&lt;/b&gt;&#039; metric, TO_CHAR(used_capacity,&#039;999G999G999D99&#039;)||&#039; ${freeCombo1}&#039; FROM t4 UNION 
SELECT &#039;22&#039; sort_order,&#039;&lt;b&gt;Available Disk Capacity&lt;/b&gt;&#039; metric, TO_CHAR(available_capacity,&#039;999G999G999D99&#039;)||&#039; ${freeCombo1}&#039; FROM t4 UNION 
SELECT &#039;24&#039; sort_order,&#039;&lt;b&gt;Percent Used&lt;/b&gt;&#039; metric, TO_CHAR(pct_used,&#039;999D99&#039;)||&#039;%&#039; FROM t4 UNION 
SELECT &#039;26&#039; sort_order,&#039;&lt;b&gt;Number of Nodes&lt;/b&gt;&#039; metric, TO_CHAR(nodes) FROM t4 UNION 
SELECT &#039;28&#039; sort_order,&#039;&lt;b&gt;Nodes Disk Capacity&lt;/b&gt;&#039; metric, TO_CHAR(nodes_total_capacity,&#039;999G999G999D99&#039;)||&#039; ${freeCombo1}&#039; FROM t4 UNION 
SELECT &#039;30&#039; sort_order,&#039;&lt;b&gt;Nodes Used Capacity&lt;/b&gt;&#039; metric, TO_CHAR(nodes_used_capacity,&#039;999G999G999D99&#039;)||&#039; ${freeCombo1}&#039; FROM t4 UNION 
SELECT &#039;32&#039; sort_order,&#039;&lt;b&gt;Nodes Available Capacity&lt;/b&gt;&#039; metric, TO_CHAR(nodes_free_capacity,&#039;999G999G999D99&#039;)||&#039; ${freeCombo1}&#039; FROM t4 ORDER BY 1,2</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
