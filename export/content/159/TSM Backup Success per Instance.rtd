<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>WITH q1 AS (
SELECT 
tj.instance_name,
count(j.job_id) job_count,
sum(DECODE(vendor_status_name,&#039;Successful&#039;,1,0)) Successful_job_count,
sum(DECODE(vendor_status_name,&#039;Failed&#039;,1,0)) failed_job_count,
sum(DECODE(vendor_status_name,&#039;Missed&#039;,1,0)) missed_job_count,
sum(DECODE(vendor_status_name,&#039;Partial&#039;,1,0)) partial_job_count,
round((sum(DECODE(vendor_status_name,&#039;Successful&#039;,1,0))+sum(DECODE(vendor_status_name,&#039;Partial&#039;,1,0)))
/count(j.job_id)*100,2) success_rate
FROM apt_v_job j,apt_v_tsm_job tj
WHERE j.start_date BETWEEN ${startDate} AND ${endDate}
AND j.job_id = tj.job_id
GROUP BY 
tj.instance_name
)SELECT instance_name,
CASE 
WHEN success_rate BETWEEN ${freeCombo2} AND 99.999 THEN &#039;green&#039;
WHEN success_rate BETWEEN ${freeCombo1} AND ${freeCombo2} THEN &#039;yellow&#039;
WHEN success_rate &lt; ${freeCombo1} THEN &#039;red&#039;
WHEN success_rate = 100 THEN &#039;blue&#039;
ELSE &#039;white&#039;
END status_dot,
job_count,
successful_job_count,
failed_job_count,missed_job_count,
partial_job_count,
success_rate
FROM q1</string>
          </entry>
