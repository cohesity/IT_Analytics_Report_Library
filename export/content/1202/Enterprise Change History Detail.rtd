  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>longDescription</string>
      <string>Lists daily changes by comparing the log entries using the LAG() function.Detects changes in:--Array Thin Pool Availabe GB--VMWare # Guests--Array Group Free Capacity GB--Array Raw Available GB--Array Allocated GB--VNX Pool Availabe GB --HDS Journal Pool Allocated--VPLEX</string>
    </entry>
