          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 09/12/2011
WITH q1 AS (
SELECT
array_name,
pool_name,
sp.dev_config raid_type,
round(total_tracks_kb/1024/1024/1024,2) total_tracks_tb,
round(total_used_tracks_kb/1024/1024/1024,2) used_tracks_tb,
round((total_tracks_kb-total_used_tracks_kb)/1024/1024/1024,2) avail_tracks_tb,
CASE
  WHEN total_tracks_kb = 0 THEN 0
  ELSE total_used_tracks_kb/total_tracks_kb*100
END pool_used_pct,
round((total_tracks_kb * (subscribed_pct/100))/1024/1024/1024,2) subscribed_tb,  
subscribed_pct,
CASE 
  WHEN subscribed_pct &lt;= 100 THEN 0
  ELSE round(((total_tracks_kb * (subscribed_pct/100))/1024/1024/1024) - (total_tracks_kb/1024/1024/1024),2) 
END over_subscribed
FROM aps_v_emc_sym_storage_pool sp
WHERE array_name LIKE DECODE(&apos;${queryCombo1}&apos;,&apos; All&apos;,&apos;%&apos;,&apos;${queryCombo1}&apos;)
)
SELECT
array_name||&apos; - &apos;||pool_name array_pool,
sum(total_tracks_tb) total_tracks_tb,
sum(used_tracks_tb) used_tracks_tb,
sum(avail_tracks_tb) avail_tracks_tb,
sum(subscribed_tb) subscribed_tb,
sum(over_subscribed) over_subscribed
FROM q1 
GROUP BY array_name||&apos; - &apos;||pool_name</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
