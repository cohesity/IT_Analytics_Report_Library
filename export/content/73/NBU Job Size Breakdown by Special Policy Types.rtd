  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 10/27/2012
--Breakdown by Special Policy Types: Oracle,NDMP,MS-Exchange Server,MS-SQL
WITH 
var AS (
SELECT
DECODE(&#039;${freeCombo2}&#039;,
&#039;KB&#039;,1,&#039;MB&#039;,1024,&#039;GB&#039;,(1024*1024),&#039;TB&#039;,(1024*1024*1024),&#039;PB&#039;,(1024*1024*1024*1024)) div_by 
FROM dual
)
SELECT
to_char(trunc(start_date,DECODE(&#039;${freeCombo1}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;)),&#039;YYYY/MM/DD&#039;) the_date,
ROUND(SUM(DECODE(policy_type_name,&#039;NDMP&#039;,kilobytes/var.div_by,0)),2) NDMP,
ROUND(SUM(DECODE(policy_type_name,&#039;Oracle&#039;,kilobytes/var.div_by,0)),2) Oracle,
ROUND(SUM(DECODE(policy_type_name,&#039;MS-SQL&#039;,kilobytes/var.div_by,0)),2) MS_SQL,
ROUND(SUM(DECODE(policy_type_name,&#039;MS-Exchange Server&#039;,kilobytes/var.div_by,0)),2) MS_Exchange_Server,
ROUND(SUM(CASE WHEN policy_type_name NOT IN (&#039;NDMP&#039;,&#039;Oracle&#039;,&#039;MS-SQL&#039;,&#039;MS-Exchange Server&#039;) THEN kilobytes/var.div_by ELSE 0 END),2) all_others
FROM apt_v_nbu_job_detail, var
WHERE client_id IN (${hosts})
AND start_date BETWEEN ${startDate} AND ${endDate}
GROUP BY to_char(trunc(start_date,DECODE(&#039;${freeCombo1}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;)),&#039;YYYY/MM/DD&#039;)
ORDER BY 1</string>
          </entry>
