<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>descriptiveName</string>
            <string>TSM Backups Size and Counts over Time</string>
          </entry>
          <entry>
            <string>drilldown</string>
            <boolean>false</boolean>
          </entry>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 10/30/2015
WITH
VAR AS (
SELECT
ROUND((${endDate} - ${startDate}),2) nbrOfDays, 
${startDate} startDate, 
&#039;${freeCombo2}&#039; unit,
DECODE(&#039;${freeCombo2}&#039;, &#039;KB&#039;,1,&#039;MB&#039;,1024,&#039;GB&#039;,(1024*1024),&#039;TB&#039;,(1024*1024*1024),&#039;PB&#039;,(1024*1024*1024*1024)) div_by 
FROM dual 
)
SELECT
TO_CHAR(trunc(start_date,DECODE(&#039;${freeCombo1}&#039;,&#039;Minute&#039;,&#039;MI&#039;,&#039;Hour&#039;,&#039;HH24&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;,&#039;YY&#039;)),&#039;MM/DD/YYYY HH24:MI&#039;) the_date,
TO_CHAR(trunc(start_date,DECODE(&#039;${freeCombo1}&#039;,&#039;Minute&#039;,&#039;MI&#039;,&#039;Hour&#039;,&#039;HH24&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;,&#039;YY&#039;)),&#039;YYYYMMDDHH24MI&#039;) sort_order,
var.unit,
SUM(DECODE(job_type_name,&#039;Archive&#039;,1,0)) archive,
ROUND(SUM(DECODE(job_type_name,&#039;Archive&#039;,kilobytes/div_by,0)),2) archive_size,
SUM(DECODE(job_type_name,&#039;Command&#039;,1,0)) command,
ROUND(SUM(DECODE(job_type_name,&#039;Command&#039;,kilobytes/div_by,0)),2) command_size,
SUM(DECODE(job_type_name,&#039;Selective Backup&#039;,1,0)) selective_backup,
ROUND(SUM(DECODE(job_type_name,&#039;Selective Backup&#039;,kilobytes/div_by,0)),2) selective_backup_size,
SUM(DECODE(job_type_name,&#039;Restore&#039;,1,0)) restore,
ROUND(SUM(DECODE(job_type_name,&#039;Restore&#039;,kilobytes/div_by,0)),2) restore_size,
SUM(DECODE(job_type_name,&#039;Incr Backup&#039;,1,0)) incr_Backup,
ROUND(SUM(DECODE(job_type_name,&#039;Incr Backup&#039;,kilobytes/div_by,0)),2) incr_Backup_size
FROM apt_v_tsm_job tj, var
WHERE start_date BETWEEN ${startDate} AND ${endDate}
AND server_id IN (${hosts})
AND instance_name = &#039;${queryCombo1}&#039;
GROUP BY 
TO_CHAR(trunc(start_date,DECODE(&#039;${freeCombo1}&#039;,&#039;Minute&#039;,&#039;MI&#039;,&#039;Hour&#039;,&#039;HH24&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;,&#039;YY&#039;)),&#039;MM/DD/YYYY HH24:MI&#039;),
TO_CHAR(trunc(start_date,DECODE(&#039;${freeCombo1}&#039;,&#039;Minute&#039;,&#039;MI&#039;,&#039;Hour&#039;,&#039;HH24&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;,&#039;YY&#039;)),&#039;YYYYMMDDHH24MI&#039;),
var.unit</string>
          </entry>
