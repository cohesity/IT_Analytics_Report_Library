<com.aptare.sc.dal.versioning.ObjectMap>
  <version>1</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>WITH t1 as (
  SELECT start_date, finish_date finish_date  FROM 
              TABLE(rtd.ListOfBackupWindowDates(${startDate},${endDate}, 
      apt_BackupWindowListType( 
        APT_BACKUPWINDOWTYPE(&#039;Mon&#039;,44,68), 
        APT_BACKUPWINDOWTYPE(&#039;Tue&#039;,68,92), 
        APT_BACKUPWINDOWTYPE(&#039;Wed&#039;,92,116), 
        APT_BACKUPWINDOWTYPE(&#039;Thu&#039;,116,140), 
        APT_BACKUPWINDOWTYPE(&#039;Weekend&#039;,140,212) ))) bw
),
t2 as (
  SELECT t1.start_date, t1.finish_date,
      count(j.job_id) Job_Count,
      sum(1*(1-abs(sign(j.summary_status-0)))) success,
      sum(1*(1-abs(sign(j.summary_status-1)))) partial,
      sum(1*(1-abs(sign(j.summary_status-2)))) failed
      FROM apt_v_tsm_job j,t1
      WHERE j.start_date BETWEEN t1.start_date AND t1.finish_date
      AND t1.start_date &gt;= ${startDate}
      AND j.client_id IN (${hosts})
      AND j.job_type_name like &#039;%Backup&#039;
      AND j.summary_status IS NOT null 
      AND j.vendor_state IS NOT null 
      GROUP BY  t1.start_date, t1.finish_date
      ORDER BY t1.start_date, t1.finish_date
) SELECT t2.start_date AS &quot;Window Start&quot;, t2.finish_date AS &quot;Window End&quot;, 
      t2.job_count AS &quot;Jobs&quot;, t2.success AS &quot;Successful&quot;, t2.partial AS &quot;Partial&quot;, 
      t2.failed AS &quot;Failed&quot;,
      (t2.success+t2.partial) / t2.job_count AS &quot;Success Rate&quot;
      FROM t2</string>
          </entry>
