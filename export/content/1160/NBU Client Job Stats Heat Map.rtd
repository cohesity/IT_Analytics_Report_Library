              <com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
                <name>freeQueryCombo</name>
                <componentScript>
                  <before/>
                  <after/>
                </componentScript>
                <configuration>
                  <entry>
                    <string>queryComboValues1</string>
                    <string>SELECT &apos; All&apos; key, &apos; All&apos; value FROM apt_v_dual UNION SELECT DISTINCT job_type_name key, job_type_name value FROM apt_v_nbu_job_detail WHERE start_date &gt; sysdate -7</string>
                  </entry>
                  <entry>
                    <string>queryComboHeading1</string>
                    <string>Job Type:</string>
                  </entry>
                  <entry>
                    <string>sql</string>
                    <string>SELECT &apos; All&apos; key, &apos; All&apos; value FROM apt_v_dual UNION SELECT DISTINCT job_type_name key, job_type_name value FROM apt_v_nbu_job_detail WHERE start_date &gt; sysdate -7</string>
