  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 06/13/2012
WITH t1 AS (
SELECT to_char(trunc(j.start_date,DECODE(&#039;${freeCombo2}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;,&#039;YY&#039;)),&#039;MM/DD/YY&#039;) the_date, 
j.server_name||&#039; - &#039;||tl.library_name master_library, 
count(DISTINCT tm.tape_media_id) tapes_used,
sum(jtm.kilobytes/1024/1024) tape_volume_gb,
sum(j.kilobytes/1024/1024) job_volume_gb,
count(DISTINCT j.client_id) distinct_clients,
sum(j.nbr_of_files) file_count,
count(DISTINCT j.job_id) job_count
FROM apt_v_tape_media tm,apt_v_tape_library tl, apt_v_job j,apt_v_nbu_job_tape_media jtm
WHERE j.client_id IN  (${hosts})
AND j.start_date BETWEEN ${startDate} AND ${endDate}
AND j.job_id = jtm.job_id 
AND jtm.tape_media_id = tm.tape_media_id       
AND tm.library_id=tl.library_id 
GROUP BY to_char(trunc(j.start_date,DECODE(&#039;${freeCombo2}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;,&#039;YY&#039;)),&#039;MM/DD/YY&#039;),j.server_name||&#039; - &#039;||tl.library_name
ORDER BY 1 DESC
)
SELECT
the_date,
master_library,
DECODE(&#039;${freeCombo1}&#039;,
&#039;Tape Volume(GB)&#039;,tape_volume_gb,
&#039;Job Volume(GB)&#039;,job_volume_gb,
&#039;Tapes Used&#039;,tapes_used,
&#039;Distinct Clients&#039;,distinct_clients,
&#039;File Count&#039;,file_count,
&#039;Job Count&#039;,job_count
) metric
FROM t1 
ORDER by 1 DESC</string>
          </entry>
