            <list>
              <com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
                <name>timePeriod</name>
                <componentScript>
                  <before/>
                  <after/>
                </componentScript>
                <referenceData/>
              </com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
              <com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
                <name>freeCombo</name>
                <componentScript>
                  <before/>
                  <after/>
                </componentScript>
                <configuration>
                  <entry>
                    <string>freeComboValues1</string>
                    <string>Day,Week,Month,Quarter,Year</string>
                  </entry>
                  <entry>
                    <string>freeComboHeading1</string>
                    <string>Group by:</string>
                  </entry>
                </configuration>
                <referenceData/>
              </com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
              <com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
                <name>freeQueryCombo</name>
                <componentScript>
                  <before/>
                  <after/>
                </componentScript>
                <configuration>
                  <entry>
                    <string>sql</string>
                    <string>SELECT DISTINCT nvl(rtd.getObjectAttributeValue(storage_array_id,&#039;Site&#039;,&#039;A&#039;),&#039;Other&#039;) site_key, nvl(rtd.getObjectAttributeValue(storage_array_id,&#039;Site&#039;,&#039;A&#039;),&#039;Other&#039;) site_value FROM aps_v_storage_array</string>
                  </entry>
                  <entry>
                    <string>queryComboValues1</string>
                    <string>SELECT DISTINCT nvl(rtd.getObjectAttributeValue(storage_array_id,&#039;Site&#039;,&#039;A&#039;),&#039;Other&#039;) site_key, nvl(rtd.getObjectAttributeValue(storage_array_id,&#039;Site&#039;,&#039;A&#039;),&#039;Other&#039;) site_value FROM aps_v_storage_array</string>
                  </entry>
                  <entry>
                    <string>queryComboHeading1</string>
                    <string>Site:</string>
                  </entry>
                </configuration>
                <referenceData/>
              </com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
            </list>
          </entry>
