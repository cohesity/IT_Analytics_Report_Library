<com.aptare.sc.dal.versioning.ObjectMap>
  <version>1</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Group By:Day,Week,Month,Quarter,Year
--Array:SELECT DISTINCT array_name, array_name FROM aps_v_hds_journal_pool_log order by upper(1)
WITH 
a0 as (
SELECT
trunc(log_date,DECODE(&#039;${freeCombo1}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;)) log_date,
nvl(rtd.getObjectAttributeValue(storage_array_id,&#039;Site&#039;,&#039;A&#039;),&#039;Other&#039;) site,
sum(allocated_gb/1024) allocated_tb,
sum(available_gb/1024) available_tb
FROM aps_v_storage_array_log
WHERE log_date BETWEEN ${startDate} AND ${endDate}
AND nvl(rtd.getObjectAttributeValue(storage_array_id,&#039;Site&#039;,&#039;A&#039;),&#039;Other&#039;) = &#039;${queryCombo1}&#039;
GROUP BY trunc(log_date,DECODE(&#039;${freeCombo1}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;)),
nvl(rtd.getObjectAttributeValue(storage_array_id,&#039;Site&#039;,&#039;A&#039;),&#039;Other&#039;)
)
SELECT to_char(log_date,&#039;MM/DD/YY&#039;) the_date,
a0.site,
a0.allocated_tb,
a0.available_tb
FROM a0</string>
          </entry>
