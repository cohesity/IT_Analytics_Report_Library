                </componentScript>
                <configuration>
                  <entry>
                    <string>queryComboValues1</string>
                    <string>SELECT &apos; All&apos; key, &apos; All&apos; value FROM apt_v_dual UNION SELECT category_name key, category_name value FROM apt_v_afa_category</string>
                  </entry>
                  <entry>
                    <string>queryComboHeading1</string>
