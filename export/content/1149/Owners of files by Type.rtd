          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 08/07/2015
WITH
VAR AS (
SELECT
DECODE(&apos;${freeCombo1}&apos;,
&apos;KB&apos;,1,&apos;MB&apos;,1024,&apos;GB&apos;,(1024*1024),&apos;TB&apos;,(1024*1024*1024),&apos;PB&apos;,(1024*1024*1024*1024)) div_by 
FROM apt_v_dual
)
SELECT 
h.host_name,
DECODE(x.context_type,&apos;S&apos;,&apos;Share&apos;,&apos;V&apos;,&apos;Volume&apos;,x.context_type) context_type,
x.context_name,
oc.owner,
c.category_name,
c.file_extension,
oc.total_files,
oc.total_size_kb/div_by total_size
FROM apt_v_afa_owner_category oc, apt_v_afa_category c, aps_v_host h, apt_v_afa_context x,var
WHERE oc.afa_category_id = c.afa_category_id
AND oc.host_id IN (${hosts})
AND oc.host_id = h.host_id
AND oc.total_files &gt; 0
AND oc.context_id = x.context_id
AND REGEXP_LIKE(x.context_name,&apos;${freeText1}&apos;)
AND REGEXP_LIKE(oc.owner,&apos;${freeText2}&apos;)
AND c.category_name LIKE DECODE(&apos;${queryCombo1}&apos;,&apos; All&apos;,&apos;%&apos;,&apos;${queryCombo1}&apos;)
ORDER BY oc.total_size_kb DESC</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
