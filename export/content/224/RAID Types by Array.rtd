  <version>1</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>SELECT sa.array_name||sa.serial_nbr array, 
decode(lu.raid_type,null,&#039;None&#039;,lu.raid_type) raid_type, 
sum(total_capacity_kb)/1024/1024 total_capacity_Gb
FROM aps_v_logical_unit lu, aps_v_storage_array sa
WHERE  sa.storage_array_id=lu.storage_array_id
AND sa.vendor_name LIKE DECODE(&#039;${freeCombo1}&#039;,&#039;All&#039;,&#039;%&#039;,&#039;%${freeCombo1}%&#039;)
GROUP BY sa.array_name||sa.serial_nbr, lu.raid_type</string>
          </entry>
          <entry>
            <string>designerScript</string>
            <null/>
          </entry>
          <entry>
