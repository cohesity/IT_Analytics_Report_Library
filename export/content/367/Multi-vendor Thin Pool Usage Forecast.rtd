            <string>descriptiveName</string>
            <string>Multi-Vendor Thin Pool Usage Forecast</string>
          </entry>
          <entry>
            <string>encodedDataSource</string>
            <null/>
          </entry>
          <entry>
            <string>productsSupported</string>
            <null/>
          </entry>
          <entry>
            <string>supportsPagenation</string>
            <null/>
          </entry>
          <entry>
            <string>specalisedReportBuilder</string>
            <null/>
          </entry>
          <entry>
            <string>advancedComponents</string>
            <list/>
          </entry>
          <entry>
            <string>systemName</string>
            <null/>
          </entry>
          <entry>
            <string>composedReports</string>
            <null/>
          </entry>
          <entry>
            <string>postReportInterceptor</string>
            <null/>
          </entry>
          <entry>
            <string>designerScript</string>
            <null/>
          </entry>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 06/21/2018
WITH 
var AS (
SELECT
DECODE(&#039;${freeCombo1}&#039;,&#039;KB&#039;,1,&#039;MB&#039;,1024,&#039;GB&#039;,(1024*1024),&#039;TB&#039;,(1024*1024*1024),&#039;PB&#039;,(1024*1024*1024*1024)) div_by 
FROM dual
),
--For each Array Vendor that has pools, put here
--
p1 AS (--Get the static current values from the thin pools
SELECT --EMC VMAX Thin Pools
sa.array_family,
sp.storage_array_id,
sp.array_name,
sp.emc_sym_storage_pool_id pool_id,
sp.pool_name,
sp.dev_config raid_type,
ROUND(sp.total_tracks_kb/div_by,2) pool_size,
ROUND(sp.total_used_tracks_kb/div_by,2) pool_used,
ROUND((sp.total_tracks_kb-sp.total_used_tracks_kb)/div_by,2) pool_avail,
ROUND(((sp.total_tracks_kb/div_by) * (sp.subscribed_pct/100)),2) subscribed,  
sp.subscribed_pct
FROM aps_v_emc_sym_storage_pool sp, aps_v_storage_array sa, var
WHERE sp.storage_array_id IN (${arrays})
AND sp.storage_array_id = sa.storage_array_id
AND sp.array_name IS NOT NULL
UNION ALL
SELECT --EMC Clariion VNX Thin Pools
sa.array_family,
sp.storage_array_id,
sp.array_name,
sp.emc_cla_storage_pool_id pool_id,
sp.pool_name,
sp.raid_type,
ROUND(((sp.consumed_capacity_gb+sp.available_capacity_gb)*1024*1024)/div_by,2) pool_size,
ROUND((sp.consumed_capacity_gb*1024*1024),2)/div_by pool_used,
ROUND((sp.available_capacity_gb*1024*1024),2)/div_by pool_avail,
ROUND((sp.total_subscribed_capacity_gb*1024*1024)/div_by,2) subscribed,  
ROUND(sp.total_subscribed_capacity_gb/(sp.consumed_capacity_gb+sp.available_capacity_gb)*100,2) subscribed_pct
FROM  aps_v_emc_cla_storage_pool sp, aps_v_storage_array sa, var
WHERE sp.storage_array_id IN (${arrays})
AND sp.storage_array_id = sa.storage_array_id
AND sp.array_name IS NOT NULL
UNION ALL
SELECT --HDS Journal Pools
sa.array_family,
hjp.storage_array_id,
sa.array_name,
hjp.journal_pool_id pool_id, 
DECODE(hjp.pool_name,NULL,TO_CHAR(hjp.pool_id),hjp.pool_id||&#039; - &#039;||hjp.pool_name) pool_name,
hjp.raid_level||&#039; - &#039;||hjp.COMBINATION raid_type,
ROUND(hjp.capacity_kb/div_by,2) pool_size,
ROUND((hjp.capacity_kb-hjp.free_capacity_kb)/div_by,2) pool_used,
ROUND(hjp.free_capacity_kb/div_by,2) pool_avail,
ROUND(hjp.capacity_of_vvols_kb/div_by,2) subscribed,
ROUND(hjp.capacity_of_vvols_kb/hjp.capacity_kb*100,2) subscribed_pct
FROM var, aps_v_hds_journal_pool hjp, aps_v_storage_array sa
WHERE hjp.storage_array_id IN (${arrays})
AND hjp.storage_array_id = sa.storage_array_id
),
--
--
--For each Array Vendor pool log, put here
--
f0 AS (-- Forecasting begins here. First, det 1 entry per day
SELECT --EMC VMAX
TRUNC(log_date) log_date,
storage_array_id,
emc_sym_storage_pool_id the_pool_id,
MAX(available_capacity_kb/div_by) avail_cap
FROM
aps_v_emc_sym_storage_pool_log, var
WHERE log_date BETWEEN ${startDate} AND ${endDate}
AND storage_array_id IN (${arrays})
GROUP BY
TRUNC(log_date),
storage_array_id,
emc_sym_storage_pool_id
UNION ALL
SELECT --EMC Clariion VNX Thin Pools
TRUNC(log_date) log_date,
storage_array_id,
emc_cla_storage_pool_id the_pool_id,
MAX((available_capacity_gb*1024*1024)/div_by) avail_cap
FROM  aps_v_emc_cla_storage_pool_log, var
WHERE log_date BETWEEN ${startDate} AND ${endDate}
AND storage_array_id IN (${arrays})
GROUP BY
TRUNC(log_date),
storage_array_id,
emc_cla_storage_pool_id
UNION ALL
SELECT --HDS
TRUNC(log_date) log_date,
storage_array_id,
journal_pool_id the_pool_id,
MAX(available_kb/div_by) avail_cap
FROM aps_v_hds_journal_pool_log, var
WHERE log_date BETWEEN ${startDate} AND ${endDate}
AND storage_array_id IN (${arrays})
GROUP BY 
TRUNC(log_date),
storage_array_id,
journal_pool_id
),
f1 AS (--This step provides the row number needed to make the REGR_SLOPE() function to work properly
SELECT
log_date,
ROW_NUMBER() OVER (PARTITION BY storage_array_id, the_pool_id ORDER BY storage_array_id, the_pool_id) row_number,
storage_array_id,
the_pool_id,
avail_cap
FROM f0
ORDER BY storage_array_id,
the_pool_id, log_date
),
f2 AS (--This is the actual code block for calculating trends
SELECT DISTINCT
storage_array_id, the_pool_id,
COUNT(*) OVER (PARTITION BY storage_array_id, the_pool_id) nbr_of_days,
SUM(avail_cap) OVER (PARTITION BY storage_array_id, the_pool_id) sum_of_avail_cap,
FIRST_VALUE(log_date) OVER (PARTITION BY storage_array_id, the_pool_id ORDER BY log_date ASC) first_date, 
FIRST_VALUE(log_date) OVER (PARTITION BY storage_array_id, the_pool_id ORDER BY log_date DESC) last_date,
ROUND(FIRST_VALUE(avail_cap) OVER (PARTITION BY storage_array_id, the_pool_id ORDER BY log_date ASC),2) first_value, 
ROUND(FIRST_VALUE(avail_cap) OVER (PARTITION BY storage_array_id, the_pool_id ORDER BY log_date DESC),2) last_value,
ROUND(REGR_SLOPE(avail_cap, row_number) OVER (PARTITION BY storage_array_id, the_pool_id),2) avail_cap_lin,
ROUND((FIRST_VALUE(avail_cap) OVER (PARTITION BY storage_array_id, the_pool_id ORDER BY log_date DESC) - 
FIRST_VALUE(avail_cap) OVER (PARTITION BY storage_array_id, the_pool_id ORDER BY log_date ASC)) /
NULLIF(COUNT(*) OVER (PARTITION BY storage_array_id, the_pool_id),0),2) avail_cap_pop
FROM f1
ORDER BY storage_array_id, the_pool_id
),
f3 AS (--Format the results of the forecast 
SELECT
f2.the_pool_id,
f2.first_date,
f2.first_value,
f2.last_date, 
f2.last_value,
f2.nbr_of_days,
f2.avail_cap_lin,
f2.sum_of_avail_cap,
CASE 
  WHEN f2.avail_cap_lin &lt; 0 
    THEN (f2.last_value/NULLIF(ABS(f2.avail_cap_lin),0)) 
  WHEN f2.avail_cap_lin &gt; 0 
    THEN NULL
  ELSE 9999
END days_left_lin,
CASE 
WHEN f2.avail_cap_lin &lt; 0
THEN
  CASE --only show a run out date if less than 3 years from now
    WHEN  (f2.last_value/NULLIF(ABS(f2.avail_cap_lin),0)) &gt; 1095
    THEN &#039;Will Last Over 3 Years&#039;
    WHEN  (f2.last_value/NULLIF(ABS(f2.avail_cap_lin),0)) &lt; 1095
    THEN &#039;Will Run Out on &#039;|| ((f2.last_value/NULLIF(ABS(f2.avail_cap_lin),0)) + sysdate) 
  END
WHEN f2.avail_cap_lin = 0 
THEN &#039;Capacity not Changing&#039;
WHEN f2.avail_cap_lin &gt; 0 
THEN &#039;Capacity is Increasing&#039;
END lin_run_out_date,
--
f2.avail_cap_pop,
CASE 
  WHEN f2.avail_cap_pop&lt; 0 --Capacity is Decreasing 
    THEN (f2.last_value/NULLIF(ABS(f2.avail_cap_pop),0)) 
  WHEN f2.avail_cap_pop &gt; 0 
    THEN NULL 
  ELSE 9999
END days_left_pop,
CASE 
WHEN f2.avail_cap_pop &lt; 0
THEN
  CASE --only show a run out date if less than 3 years from now
    WHEN  (f2.last_value/NULLIF(ABS(f2.avail_cap_pop),0)) &gt; 1095
    THEN &#039;Will Last Over 3 Years&#039;
    WHEN  (f2.last_value/NULLIF(ABS(f2.avail_cap_pop),0)) &lt; 1095
    THEN &#039;Will Run Out on &#039;|| ((f2.last_value/NULLIF(ABS(f2.avail_cap_pop),0)) + sysdate) 
  END
WHEN f2.avail_cap_pop = 0 
THEN &#039;Capacity not Changing&#039;
WHEN f2.avail_cap_pop &gt; 0 
THEN &#039;Capacity is Increasing&#039;
END pop_run_out_date
FROM f2, var
),
--Forecasting ends here
s1 AS (-- Generate sparklines
SELECT
f1.the_pool_id,
rtd.collectString(CAST(COLLECT(TO_CHAR(ROUND(avail_cap,2)) ORDER BY log_date) AS StringListType),&#039;, &#039;) avail_spk
FROM f1
GROUP BY f1.the_pool_id
)
SELECT
p1.array_family,
p1.storage_array_id,
p1.array_name,
p1.pool_id, 
p1.pool_name,
p1.raid_type,
p1.pool_size,
p1.pool_avail,
s1.avail_spk,
CASE 
  WHEN (p1.pool_used/DECODE(p1.pool_size,0,null,p1.pool_size)*100) &gt;= ${freeCombo2} 
   AND (p1.subscribed_pct-100) &gt;= ${freeCombo3} 
   AND (f3.avail_cap_lin + f3.avail_cap_pop) &lt; 0 
  THEN &#039;red&#039; 
  WHEN (p1.pool_used/DECODE(p1.pool_size,0,null,p1.pool_size)*100) &gt;= ${freeCombo2} 
   AND (p1.subscribed_pct-100) &gt;= ${freeCombo3} 
  THEN &#039;yellow&#039; 
  WHEN (p1.pool_used/DECODE(p1.pool_size,0,null,p1.pool_size)*100) &gt;= ${freeCombo2} 
   AND (f3.avail_cap_lin + f3.avail_cap_pop) &lt; 0 
  THEN &#039;yellow&#039; 
  ELSE &#039;green&#039; 
END at_risk_dot,
CASE 
  WHEN (p1.pool_used/DECODE(p1.pool_size,0,null,p1.pool_size)*100) &gt;= ${freeCombo2} 
   AND (p1.subscribed_pct-100) &gt;= ${freeCombo3} 
   AND (f3.avail_cap_lin + f3.avail_cap_pop) &lt; 0 
  THEN 3 
  WHEN (p1.pool_used/DECODE(p1.pool_size,0,null,p1.pool_size)*100) &gt;= ${freeCombo2} 
   AND (p1.subscribed_pct-100) &gt;= ${freeCombo3} 
  THEN 2 
  WHEN (p1.pool_used/DECODE(p1.pool_size,0,null,p1.pool_size)*100) &gt;= ${freeCombo2} 
   AND (f3.avail_cap_lin + f3.avail_cap_pop) &lt; 0 
  THEN 1 
  ELSE 0 
END risk_level,
CASE 
  WHEN (p1.pool_used/DECODE(p1.pool_size,0,null,p1.pool_size)*100) &gt;= ${freeCombo2} 
   AND (p1.subscribed_pct-100) &gt;= ${freeCombo3} 
   AND (f3.avail_cap_lin + f3.avail_cap_pop) &lt; 0 
  THEN &#039;Pool is at risk because it is almost full, over subscribed and available capacity is decreasing&#039;  
  WHEN (p1.pool_used/DECODE(p1.pool_size,0,null,p1.pool_size)*100) &gt;= ${freeCombo2} 
   AND (p1.subscribed_pct-100) &gt;= ${freeCombo3} 
  THEN &#039;Pool is at risk because it is almost full and oversubscribed&#039;  
  WHEN (p1.pool_used/DECODE(p1.pool_size,0,null,p1.pool_size)*100) &gt;= ${freeCombo2} 
   AND (f3.avail_cap_lin + f3.avail_cap_pop) &lt; 0 
  THEN &#039;Pool is at risk because it is almost full and available capacity is decreasing&#039;  
  ELSE &#039;Not at risk&#039; 
END risk_assessment,
CASE 
  WHEN (p1.pool_used/DECODE(p1.pool_size,0,null,p1.pool_size)*100) &gt;= ${freeCombo2} 
   AND (p1.subscribed_pct-100) &gt;= ${freeCombo3} 
   AND (f3.avail_cap_lin + f3.avail_cap_pop) &lt; 0 
  THEN &#039;Y&#039; 
  WHEN (p1.pool_used/DECODE(p1.pool_size,0,null,p1.pool_size)*100) &gt;= ${freeCombo2} 
   AND (p1.subscribed_pct-100) &gt;= ${freeCombo3} 
  THEN &#039;Y&#039; 
  WHEN (p1.pool_used/DECODE(p1.pool_size,0,null,p1.pool_size)*100) &gt;= ${freeCombo2} 
   AND (f3.avail_cap_lin + f3.avail_cap_pop) &lt; 0 
  THEN &#039;Y&#039; 
  ELSE &#039;N&#039; 
END is_at_risk,
p1.pool_used,
CASE
  WHEN p1.pool_size = 0 THEN 0
  ELSE ROUND(p1.pool_used/DECODE(p1.pool_size,0,null,p1.pool_size),2)
END pool_used_pct,
CASE
  WHEN p1.pool_size = 0 THEN 0
  ELSE ROUND(p1.pool_used/DECODE(p1.pool_size,0,null,p1.pool_size)*100,2)
END pct_pool_used,
p1.subscribed,
p1.subscribed_pct,
CASE 
  WHEN p1.subscribed_pct &lt;= 100 THEN 0
  ELSE ABS((100-p1.subscribed_pct)/100) 
END over_subscribed_pct,
CASE 
  WHEN p1.subscribed_pct &lt;= 100 THEN 0
  ELSE ABS((100-p1.subscribed_pct)) 
END pct_over_subscribed,
f3.first_date,
f3.first_value, 
f3.last_date,
f3.last_value,
f3.nbr_of_days,
f3.sum_of_avail_cap/NULLIF(f3.nbr_of_days,0) avg_avail,
(f3.last_value - f3.first_value) avail_delta, 
(f3.last_value - f3.first_value)/NULLIF(f3.first_value,0)*100 avail_delta_pct,
f3.avail_cap_lin,
f3.avail_cap_pop,
f3.avail_cap_lin/NULLIF((f3.sum_of_avail_cap/f3.nbr_of_days),0)*100 avail_cap_lin_pct,
f3.avail_cap_pop/NULLIF((f3.sum_of_avail_cap/f3.nbr_of_days),0)*100 avail_cap_pop_pct,
CASE 
WHEN (f3.last_value - f3.first_value) &lt; 0 THEN &#039;Decreased&#039;
WHEN (f3.last_value - f3.first_value) = 0 THEN &#039;Did Not Change&#039;
WHEN (f3.last_value - f3.first_value) &gt; 0 THEN &#039;Increased&#039;
END usage_name,
f3.days_left_lin,
f3.lin_run_out_date,
f3.days_left_pop,
f3.pop_run_out_date
FROM p1, f3, s1
WHERE p1.pool_id = f3.the_pool_id (+)
AND p1.pool_id = s1.the_pool_id (+)
ORDER BY 11 DESC --Risk Level</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
    <entry>
      <string>authorUserId</string>
      <long>100545</long>
    </entry>
    <entry>
      <string>templateName</string>
      <null/>
    </entry>
    <entry>
      <string>id</string>
      <long>110770</long>
    </entry>
    <entry>
      <string>reportDecorator</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>2</version>
        <className>com.aptare.sc.domain.report.Decorator</className>
        <data>
          <entry>
            <string>excludes</string>
            <null/>
          </entry>
          <entry>
            <string>rightYAxisRangeName</string>
            <null/>
          </entry>
          <entry>
            <string>eventNotFoundComment</string>
            <null/>
          </entry>
          <entry>
            <string>footer</string>
            <string></string>
          </entry>
          <entry>
            <string>sqlReportData</string>
            <string>[{&quot;selected&quot;:true,&quot;name&quot;:&quot;array_family&quot;,&quot;typeName&quot;:&quot;varchar2&quot;,&quot;label&quot;:&quot;Array Family&quot;,&quot;formatter&quot;:&quot;&quot;,&quot;formatPattern&quot;:&quot;&quot;,&quot;alignment&quot;:&quot;&quot;,&quot;barType&quot;:&quot;bar&quot;,&quot;aggregation&quot;:&quot;&quot;,&quot;colour&quot;:&quot;&quot;,&quot;drilldown&quot;:&quot;&quot;,&quot;additionalDetail&quot;:&quot;&quot;,&quot;typeOverride&quot;:&quot;&quot;},{&quot;selected&quot;:false,&quot;name&quot;:&quot;storage_array_id&quot;,&quot;typeName&quot;:&quot;number&quot;,&quot;label&quot;:&quot;storage_array_id&quot;,&quot;formatter&quot;:&quot;CustomNumberFormatter&quot;,&quot;formatPattern&quot;:&quot;###&quot;,&quot;alignment&quot;:&quot;right&quot;,&quot;barType&quot;:&quot;bar&quot;,&quot;aggregation&quot;:&quot;&quot;,&quot;colour&quot;:&quot;&quot;,&quot;drilldown&quot;:&quot;&quot;,&quot;additionalDetail&quot;:&quot;&quot;,&quot;typeOverride&quot;:&quot;&quot;},{&quot;selected&quot;:true,&quot;name&quot;:&quot;array_name&quot;,&quot;typeName&quot;:&quot;varchar2&quot;,&quot;label&quot;:&quot;Array&quot;,&quot;formatter&quot;:&quot;&quot;,&quot;formatPattern&quot;:&quot;&quot;,&quot;alignment&quot;:&quot;&quot;,&quot;barType&quot;:&quot;bar&quot;,&quot;aggregation&quot;:&quot;&quot;,&quot;colour&quot;:&quot;&quot;,&quot;drilldown&quot;:&quot;systemName=arrayCapacity&amp;arrayIds=${row[&#039;storage_array_id&#039;]}&quot;,&quot;additionalDetail&quot;:&quot;&quot;,&quot;typeOverride&quot;:&quot;&quot;},{&quot;selected&quot;:false,&quot;name&quot;:&quot;pool_id&quot;,&quot;typeName&quot;:&quot;number&quot;,&quot;label&quot;:&quot;pool_id&quot;,&quot;formatter&quot;:&quot;CustomNumberFormatter&quot;,&quot;formatPattern&quot;:&quot;###&quot;,&quot;alignment&quot;:&quot;right&quot;,&quot;barType&quot;:&quot;bar&quot;,&quot;aggregation&quot;:&quot;&quot;,&quot;colour&quot;:&quot;&quot;,&quot;drilldown&quot;:&quot;&quot;,&quot