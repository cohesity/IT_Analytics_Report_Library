          <entry>
            <string>dataSource</string>
            <string>WITH 
t1 AS (
SELECT 
to_char(ns.access_time,&apos;MM/DD/YYYY&apos;) the_date, 
ns.system_name NetApp_filer, 
sum(ns.total) total_blocks
FROM aps_v_nap_snapshot ns
WHERE ns.access_time BETWEEN ${startDate} AND ${endDate}
GROUP BY
to_char(ns.access_time,&apos;MM/DD/YYYY&apos;), ns.system_name
), 
t2 AS (
SELECT netapp_filer, 
avg(total_blocks) avg_blocks
FROM t1
GROUP BY netapp_filer
)
SELECT
t1.the_date,
t1.netapp_filer,
CASE WHEN t1.total_blocks &gt; t2.avg_blocks+(t2.avg_blocks*(${freeCombo1}/100)) THEN &apos;&lt;font color=red&gt;&apos;||to_char(t1.total_blocks,&apos;999,999,999,999&apos;)||&apos;&lt;/font&gt;&apos;
ELSE to_char(t1.total_blocks,&apos;999,999,999,999&apos;) END total_blocks
FROM t1,t2
WHERE
t1.netapp_filer = t2.netapp_filer
ORDER by 1 DESC</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
