  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>SELECT
j.client_id,
j.client_name,
ROUND(MAX(scanned_kb/1024/1024),2) scanned,
ROUND(SUM(modified_not_sent_kb/1024/1024),2) modified_not_sent_gb,
ROUND(SUM(modified_sent_kb/1024/1024),2) modified_sent_gb,
(SUM(modified_sent_kb)/(SUM(modified_not_sent_kb)+.0001))*100 dedupe_pct,
(SUM(modified_sent_kb)/(SUM(modified_not_sent_kb)+.0001)) pct_dedupe
FROM 
apt_v_avm_activities aa, apt_v_job j
WHERE 
aa.job_id = j.job_id
AND j.start_date BETWEEN ${startDate} AND ${endDate}
AND j.client_id IN (${hosts})
GROUP BY
j.client_id, 
j.client_name
ORDER BY 7 DESC</string>
          </entry>
