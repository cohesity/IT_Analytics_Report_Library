          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 11/16/2012
WITH t1 AS (
SELECT 
e.storage_array_id,array_name,
i.port_id,port_name,port_wwn_id,port_role,
ROUND(SUM((diff_kbytes_transferred)/1024/1024),2) gb_transferred, 
RATIO_TO_REPORT(SUM((diff_kbytes_transferred/1024/1024))) OVER(PARTITION BY e.storage_array_id)*100 gb_transferred_pct, 
ROUND(SUM(diff_total_io)/SUM(((log_date-prev_log_date )*86400))) total_io,
RATIO_TO_REPORT(SUM(diff_total_io)/SUM(((log_date-prev_log_date )*86400))) OVER(PARTITION BY e.storage_array_id)*100 total_io_pct
FROM aps_v_array_port_stats_log l,aps_v_array_port i, aps_v_storage_array e
WHERE i.storage_array_id = e.storage_array_id
AND i.port_id = l.port_id(+)
AND l.log_date(+) BETWEEN ${startDate} AND ${endDate}
AND array_name = &apos;${queryCombo1}&apos;
GROUP BY e.storage_Array_id,array_name,
i.port_id,port_name,port_wwn_id,port_role
ORDER BY DECODE(&apos;${freeCombo1}&apos;,
&apos;Transferred GB&apos;,gb_transferred,
&apos;Transferred%&apos;,gb_transferred_pct,
&apos;I/O Per Sec&apos;,total_io,
&apos;I/O%&apos;,total_io_pct
) DESC
)
SELECT
port_name,
DECODE(&apos;${freeCombo1}&apos;,
&apos;Transferred GB&apos;,gb_transferred,
&apos;Transferred%&apos;,gb_transferred_pct,
&apos;I/O Per Sec&apos;,total_io,
&apos;I/O%&apos;,total_io_pct
) metric
FROM t1
WHERE t1.gb_transferred &gt; 0
AND ROWNUM &lt;=10</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
