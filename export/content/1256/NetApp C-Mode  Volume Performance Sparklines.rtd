          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 11/28/2018
WITH 
t1 AS (
SELECT
TRUNC(log_date) log_date,
ntc_storage_system_id,
array_name,
ntc_volume_id,
volume_name,
MAX(read_latency_ms) max_read_latency_ms,
MAX(read_BPS) max_read_BPS,
MAX(read_OPS) max_read_OPS
FROM 
aps_v_ntc_volume_perform_log
WHERE
ntc_storage_system_id IN (${arrays})
AND log_date BETWEEN ${startDate} AND ${endDate}
GROUP BY
TRUNC(log_date),
ntc_storage_system_id,
array_name,
ntc_volume_id,
volume_name
ORDER BY
1 DESC
),
t2 AS (
SELECT
ntc_storage_system_id,
array_name,
ntc_volume_id,
volume_name,
MIN(log_date) min_log_date,
MAX(log_date) max_log_date,
AVG(max_read_latency_ms) avg_read_latency_ms,
MAX(max_read_latency_ms) max_read_latency_ms,
rtd.collectString(CAST(COLLECT(TO_CHAR(max_read_latency_ms) ORDER BY log_date) AS StringListType),&apos;, &apos;) read_latency_spk,
ROUND(AVG(max_read_BPS/1024),2) avg_read_MPS,
ROUND(MAX(max_read_BPS/1024),2) max_read_MPS,
rtd.collectString(CAST(COLLECT(TO_CHAR(ROUND(max_read_BPS/1024,2)) ORDER BY log_date) AS StringListType),&apos;, &apos;) read_MPS_spk,
AVG(max_read_OPS) avg_read_OPS,
MAX(max_read_OPS) max_read_OPS,
rtd.collectString(CAST(COLLECT(TO_CHAR(max_read_OPS) ORDER BY log_date) AS StringListType),&apos;, &apos;) read_OPS_spk
FROM t1
GROUP BY 
ntc_storage_system_id,
array_name,
ntc_volume_id,
volume_name
)
SELECT
ntc_storage_system_id,
array_name,
ntc_volume_id,
volume_name,
min_log_date,
max_log_date,
--Convert dates to unix timestamps for the drilldown
ROUND((min_log_date - TO_DATE(&apos;1970-01-01&apos;,&apos;YYYY-MM-DD&apos;)) * 60 * 60 * 24) start_date,
ROUND((max_log_date - TO_DATE(&apos;1970-01-01&apos;,&apos;YYYY-MM-DD&apos;)) * 60 * 60 * 24)  end_date,
avg_read_latency_ms,
max_read_latency_ms,
read_latency_spk,
avg_read_MPS,
max_read_MPS,
read_MPS_spk,
avg_read_OPS,
max_read_OPS,
read_OPS_spk
FROM t2</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
