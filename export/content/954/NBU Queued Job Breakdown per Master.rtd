          <entry>
            <string>dataSource</string>
            <string>SELECT 
j.server_id,
j.master_host_name,
COUNT(j.job_id ) job_count,
SUM(CASE WHEN (started_readwrite - start_date)*24*60 &lt; 5 THEN 1 ELSE 0 END ) qjobl5_count,
SUM(CASE WHEN (started_readwrite - start_date)*24*60 BETWEEN 5 AND 15 THEN 1 ELSE 0 END ) qjob515_count,
SUM(CASE WHEN (started_readwrite - start_date)*24*60 &gt;= 15 THEN 1 ELSE 0 END ) qjobg15_count
FROM apt_v_nbu_job_detail j
WHERE j.client_id IN (${hosts})
AND j.start_date BETWEEN ${startDate} AND ${endDate}
AND j.job_type &lt;&gt; 105
GROUP BY 
j.server_id,
j.master_host_name
ORDER BY 3 DESC</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
