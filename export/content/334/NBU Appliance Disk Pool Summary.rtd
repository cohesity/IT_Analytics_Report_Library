          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 03/25/2020
WITH
var AS (
SELECT
DECODE(&apos;${freeCombo1}&apos;,
&apos;KB&apos;,1,&apos;MB&apos;,1024,&apos;GB&apos;,(1024*1024),&apos;TB&apos;,(1024*1024*1024),&apos;PB&apos;,(1024*1024*1024*1024)) div_by 
FROM dual
),
t1 AS (
SELECT 
  dp.management_server_id,
  h.display_name master_server,
  dp.disk_type,
  COUNT(dp.disk_volume_name) disk_volume_count,
  aptStringConcat(DISTINCT dp.disk_volume_name) disk_volumes,
  COUNT(DISTINCT dp.disk_pool_id) disk_pool_count,
  aptStringConcat(DISTINCT dp.disk_pool_name) disk_pools,
  COUNT(DISTINCT e.host_id) media_server_count, 
  aptStringConcat(DISTINCT e.display_name) media_servers,
  COUNT(DISTINCT dp.storage_unit_id) storage_unit_count, 
  aptStringConcat(DISTINCT dp.storage_unit_label) storage_units,
  MAX(dp.total_capacity_kb/div_by) total_capacity,
  MAX(dp.free_space_kb/div_by) free_space
FROM 
  apt_v_nbu_disk_pool dp, aps_v_host h, aps_v_host e, apt_v_nbu_strgunit_mediasrvr sm, var
WHERE
  dp.management_server_id = h.host_id
  AND h.host_id IN (${hosts})
  AND sm.storage_unit_id = dp.storage_unit_id
  AND sm.media_server_id = e.host_id
  AND dp.total_capacity_kb &gt; 0
GROUP BY
  dp.management_server_id,
  h.display_name,
  dp.disk_type
)
SELECT
  management_server_id,
  master_server,
  disk_type,
  disk_volume_count,
  REPLACE(disk_volumes,&apos;,&apos;,&apos;&lt;br&gt;&apos;) disk_volumes,
  disk_pool_count,
  REPLACE(disk_pools,&apos;,&apos;,&apos;&lt;br&gt;&apos;) disk_pools,
  media_server_count,
  REPLACE(media_servers,&apos;,&apos;,&apos;&lt;br&gt;&apos;) media_servers,
  storage_unit_count,
  REPLACE(storage_units,&apos;,&apos;,&apos;&lt;br&gt;&apos;) storage_units,
  total_capacity,
  free_space,
  (total_capacity - free_space) used,
  (total_capacity - free_space)/total_capacity*100 pct_used,
  (total_capacity - free_space)/total_capacity used_pct
FROM 
  t1
ORDER BY 
  15 DESC</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
