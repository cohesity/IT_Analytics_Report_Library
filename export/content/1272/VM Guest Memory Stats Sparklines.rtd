          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@veritas.com
--Last Modified: 04/01/2020
WITH 
c1 AS (
SELECT
  TRUNC(l.end_log_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Minutes&apos;,&apos;MI&apos;,&apos;Hours&apos;,&apos;HH24&apos;,&apos;Days&apos;,&apos;DD&apos;,&apos;Weeks&apos;,&apos;WW&apos;,&apos;Months&apos;,&apos;MM&apos;,&apos;Quarters&apos;,&apos;Q&apos;,&apos;Years&apos;)) AS the_date,
  p.partition_id,
  p.partition_name,
  ROUND(MAX(NVL(l.avg_memory_usage_kb/1024,0)/1000),2) mem_usage_gb,
  ROUND(MAX(NVL(l.avg_memory_usage_pct,0)),2) mem_usage_pct
FROM 
  apt_v_vmw_perform_memory_log l, apt_v_partition p
WHERE 
  p.partition_id IN (${vmGuests})
  AND p.partition_id = l.partition_id
  AND l.end_log_date  BETWEEN ${startDate} AND ${endDate}
  AND p.collection_status != 3
  AND p.partition_type = &apos;VM&apos;
GROUP BY 
  TRUNC(l.end_log_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Minutes&apos;,&apos;MI&apos;,&apos;Hours&apos;,&apos;HH24&apos;,&apos;Days&apos;,&apos;DD&apos;,&apos;Weeks&apos;,&apos;WW&apos;,&apos;Months&apos;,&apos;MM&apos;,&apos;Quarters&apos;,&apos;Q&apos;,&apos;Years&apos;)),
  p.partition_id,
  p.partition_name
),
s1 AS (--Generate Sparklines
SELECT
  c1.partition_id,
  c1.partition_name,
  rtd.collectString(CAST(COLLECT(TO_CHAR(ROUND(mem_usage_gb,2)) ORDER BY the_date) AS StringListType),&apos;, &apos;) AS mem_usage_gb_spk,
  rtd.collectString(CAST(COLLECT(TO_CHAR(ROUND(mem_usage_pct,2)) ORDER BY the_date) AS StringListType),&apos;, &apos;) AS mem_usage_pct_spk
FROM 
  c1
GROUP BY 
  c1.partition_id,
  c1.partition_name
),
t1 AS (
SELECT
  c1.partition_id,
  MAX(c1.mem_usage_gb) AS max_mem_usage_gb,
  MAX(c1.mem_usage_pct) AS max_mem_usage_pct,
  AVG(c1.mem_usage_gb) AS avg_mem_usage_gb,
  AVG(c1.mem_usage_pct) AS avg_mem_usage_pct
FROM
  c1
GROUP BY 
  c1.partition_id
),
t2 AS (
SELECT
  s1.partition_id,
  s1.partition_name,
  s1.mem_usage_gb_spk,
  t1.max_mem_usage_gb,
  t1.avg_mem_usage_gb,
  s1.mem_usage_pct_spk,
  t1.max_mem_usage_pct,
  t1.avg_mem_usage_pct
FROM
  s1, t1
WHERE
  s1.partition_id = t1.partition_id
ORDER BY 
  t1.max_mem_usage_gb DESC
)
SELECT *
FROM t2
WHERE
  rownum &lt;= ${freeCombo2}</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
