          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 10/03/2011
WITH 
var AS (
SELECT
--User Defined Threshholds
1 AS yellow_threshold,
2 AS red_threshold
FROM apt_v_dual
),
q1 AS (
SELECT
to_char(${startDate},&apos;MM/DD/YYYY&apos;) start_date_char,
to_char(${startDate},&apos;HH24&apos;) start_hour_char,
to_char(${endDate},&apos;MM/DD/YYYY&apos;) finish_date_char,
to_char(${endDate},&apos;HH24&apos;) finish_hour_char,
server_id,
server_name,
sum(DECODE(job_type_name,&apos;Expiration&apos;,1,0)) Expiration,
sum(DECODE(job_type_name,&apos;Full DB Backup&apos;,1,0)) Full_DB_Backup,
sum(DECODE(job_type_name,&apos;Incremental DB Backup&apos;,1,0)) Incr_DB_Backup,
sum(DECODE(job_type_name,&apos;Migration&apos;,1,0)) migration,
sum(DECODE(job_type_name,&apos;Move Media&apos;,1,0)) move_media,
sum(DECODE(job_type_name,&apos;Reclamation&apos;,1,0)) reclamation,
sum(DECODE(job_type_name,&apos;Storage Pool Backup&apos;,1,0)) stg_pool_backup,
sum(DECODE(job_type_name,&apos;Incr Backup&apos;,1,0)) Incr_Backup,
sum(DECODE(job_type_name,&apos;Archive&apos;,1,0)) Archive,
sum(DECODE(job_type_name,&apos;Command&apos;,1,0)) Command,
sum(DECODE(job_type_name,&apos;Restore&apos;,1,0)) restore,
sum(DECODE(job_type_name,&apos;Selective Backup&apos;,1,0)) selective_backup
FROM apt_v_job
WHERE start_date BETWEEN ${startDate} AND ${endDate}
AND server_id IN (${hosts})
AND summary_status = 2
GROUP BY server_id,server_name
)
SELECT
start_date_char,
start_hour_char,
finish_date_char,
finish_hour_char,
server_id,
server_name,
expiration,
CASE WHEN expiration &gt;= var.red_threshold THEN &apos;red&apos; WHEN expiration &gt;= var.yellow_threshold THEN &apos;yellow&apos;  ELSE &apos;green&apos; END expiration_dot,
full_DB_Backup,
CASE WHEN full_DB_Backup &gt;= var.red_threshold THEN &apos;red&apos; WHEN full_DB_Backup &gt;= var.yellow_threshold THEN &apos;yellow&apos;  ELSE &apos;green&apos; END full_DB_Backup_dot,
incr_DB_Backup,
CASE WHEN incr_DB_Backup &gt;= var.red_threshold THEN &apos;red&apos; WHEN incr_DB_Backup &gt;= var.yellow_threshold THEN &apos;yellow&apos; ELSE &apos;green&apos; END incr_DB_Backup_dot,
migration,
CASE WHEN migration &gt;= var.red_threshold THEN &apos;red&apos; WHEN migration &gt;= var.yellow_threshold THEN &apos;yellow&apos; ELSE &apos;green&apos; END migration_dot,
move_media,
CASE WHEN move_media &gt;= var.red_threshold THEN &apos;red&apos; WHEN move_media &gt;= var.yellow_threshold THEN &apos;yellow&apos; ELSE &apos;green&apos; END move_media_dot,
reclamation,
CASE WHEN reclamation &gt;= var.red_threshold THEN &apos;red&apos; WHEN reclamation &gt;= var.yellow_threshold THEN &apos;yellow&apos; ELSE &apos;green&apos; END reclamation_dot,
stg_pool_backup,
CASE WHEN stg_pool_backup &gt;= var.red_threshold THEN &apos;red&apos; WHEN stg_pool_backup &gt;= var.yellow_threshold THEN &apos;yellow&apos; ELSE &apos;green&apos; END stg_pool_backup_dot,
incr_backup,
CASE WHEN incr_backup &gt;= var.red_threshold THEN &apos;red&apos; WHEN incr_backup &gt;= var.yellow_threshold THEN &apos;yellow&apos; ELSE &apos;green&apos; END incr_backup_dot,
Archive,
CASE WHEN archive &gt;= var.red_threshold THEN &apos;red&apos; WHEN archive &gt;= var.yellow_threshold THEN &apos;yellow&apos; ELSE &apos;green&apos; END archive_dot,
command,
CASE WHEN command &gt;= var.red_threshold THEN &apos;red&apos; WHEN command &gt;= var.yellow_threshold THEN &apos;yellow&apos; ELSE &apos;green&apos; END command_dot,
restore,
CASE WHEN restore &gt;= var.red_threshold THEN &apos;red&apos; WHEN restore &gt;= var.yellow_threshold THEN &apos;yellow&apos; ELSE &apos;green&apos; END restore_dot,
selective_backup,
CASE WHEN selective_backup &gt;= var.red_threshold THEN &apos;red&apos; WHEN selective_backup &gt;= var.yellow_threshold THEN &apos;yellow&apos; ELSE &apos;green&apos; END selective_backup_dot,
var.yellow_threshold,var.red_threshold
FROM q1,var</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
