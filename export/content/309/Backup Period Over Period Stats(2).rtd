<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 10/01/2013
-- Compares the Period over Period values 
WITH
var AS (
SELECT
DECODE(&#039;${freeCombo1}&#039;,
&#039;KB&#039;,1,&#039;MB&#039;,1024,&#039;GB&#039;,(1024*1024),&#039;TB&#039;,(1024*1024*1024),&#039;PB&#039;,(1024*1024*1024*1024)) div_by 
FROM dual
),
d0 AS ( --Decode the date ranges
SELECT 
(TRUNC(${endDate}) - TRUNC(${startDate}))+1 day_num
FROM dual
),
d1 as (
SELECT
day_num,
TRUNC(sysdate - (day_num * 2)) prior_start_date,
TRUNC((sysdate - day_num))  prior_end_date,
TRUNC((sysdate - day_num)) current_start_date,
TRUNC(sysdate) current_end_date
FROM d0
),
j1 AS ( --Prior period client stats
SELECT 
j.client_id, 
SUM(kilobytes/div_by) job_volume_tot,
COUNT(job_id) job_count
FROM d1, apt_v_job j, var
WHERE j.client_id IN (${hosts})
AND j.start_date BETWEEN prior_start_date AND prior_end_date
AND j.summary_status IN (0,1)
GROUP BY j.client_id
),
p1 AS ( --Prior period totals
SELECT 
SUM(job_volume_tot) job_volume_tot,
COUNT(job_count) job_count,
COUNT(client_id) client_count
FROM j1
),
j2 AS ( --Current period stats
SELECT 
j.client_id, 
SUM(kilobytes/div_by) job_volume_tot,
COUNT(job_id) job_count
FROM d1, apt_v_job j, var
WHERE j.client_id IN (${hosts})
AND j.start_date BETWEEN current_start_date AND current_end_date
AND j.summary_status IN (0,1)
GROUP BY j.client_id
),
p2 AS ( --Prior period totals
SELECT 
SUM(job_volume_tot) job_volume_tot,
COUNT(job_count) job_count,
COUNT(client_id) client_count
FROM j2
),
c0 AS ( --Clients who stayed exactly the same
SELECT
j1.client_id,
j2.job_volume_tot-j1.job_volume_tot vol_change,
(j2.job_volume_tot-j1.job_volume_tot)/DECODE(j2.job_volume_tot,0,null,j2.job_volume_tot)*100 pct_change
FROM j1,j2
WHERE j1.client_id = j2.client_id
AND (j2.job_volume_tot-j1.job_volume_tot) = 0
),
c1 AS ( --Clients who increased
SELECT
j1.client_id,
j2.job_volume_tot-j1.job_volume_tot vol_change,
(j2.job_volume_tot-j1.job_volume_tot)/DECODE(j2.job_volume_tot,0,null,j2.job_volume_tot)*100 pct_change
FROM j1,j2
WHERE j1.client_id = j2.client_id
AND (j2.job_volume_tot-j1.job_volume_tot) &gt; 0
),
c2 AS ( --Clients who decreased
SELECT
j1.client_id,
j2.job_volume_tot-j1.job_volume_tot vol_change,
(j2.job_volume_tot-j1.job_volume_tot)/DECODE(j2.job_volume_tot,0,null,j2.job_volume_tot)*100 pct_change
FROM j1,j2
WHERE j1.client_id = j2.client_id
AND (j2.job_volume_tot-j1.job_volume_tot) &lt; 0
)
SELECT 
0 sort_order,
&#039;Clients Current Period: &#039;||TO_CHAR(current_start_date,&#039;MM/DD/YYYY&#039;)||&#039; - &#039;||TO_CHAR(current_end_date,&#039;MM/DD/YYYY&#039;) metric,
p2.client_count the_count, 
p2.job_volume_tot the_volume,
NULL the_pct
FROM d1, p2
UNION
SELECT 
1 sort_order,
&#039;Clients Prior Period: &#039;||TO_CHAR(prior_start_date,&#039;MM/DD/YYYY&#039;)||&#039; - &#039;||TO_CHAR(prior_end_date,&#039;MM/DD/YYYY&#039;) metric,
p1.client_count the_count, 
p1.job_volume_tot the_volume,
NULL the_pct
FROM d1, p1
UNION
SELECT 
2 sort_order,
&#039;&lt;b&gt;&#039;||day_num||&#039; Day Delta:&lt;/b&gt;&#039; metric,
p2.client_count - p1.client_count the_count, 
p2.job_volume_tot-p1.job_volume_tot the_volume,
(p2.job_volume_tot-p1.job_volume_tot)/p2.job_volume_tot*100 the_pct
FROM p1, p2, d0
UNION
SELECT 
3 sort_order,
&#039;Retired Clients&#039; metric,
COUNT(j1.client_id) the_count,
SUM(j1.job_volume_tot)*-1 the_volume,--Show this as a negative number so bottom line will add up
SUM(j1.job_volume_tot)/MAX(p2.job_volume_tot)*100 the_pct
FROM j1, p2
WHERE j1.client_id NOT IN (SELECT j2.client_id FROM j2)
UNION
SELECT 
4 sort_order,
&#039;New Clients&#039; metric,
COUNT(j2.client_id) the_count,
SUM(j2.job_volume_tot) the_volume,
SUM(j2.job_volume_tot)/MAX(p2.job_volume_tot)*100 the_pct
FROM j2, p2
WHERE j2.client_id NOT IN (SELECT j1.client_id FROM j1)
UNION
SELECT 
5 sort_order,
&#039;Clients who decreased&#039; metric,
COUNT(c2.client_id) the_count,
SUM(c2.vol_change) the_volume,
SUM(c2.vol_change)/MAX(p2.job_volume_tot)*100 the_pct
FROM c2, p2
UNION
SELECT 
6 sort_order,
&#039;Clients who stayed the same&#039; metric,
COUNT(c0.client_id) the_count,
SUM(c0.vol_change) the_volume,
SUM(c0.vol_change)/MAX(p2.job_volume_tot)*100 the_pct
FROM c0, p2
UNION
SELECT 
6 sort_order,
&#039;Clients with 1% to 20% increase&#039; metric,
COUNT(c1.client_id) the_count,
SUM(c1.vol_change) the_volume,
SUM(c1.vol_change)/MAX(p2.job_volume_tot)*100 the_pct
FROM c1, p2
WHERE c1.pct_change &lt; 20 
UNION
SELECT 
7 sort_order,
&#039;Clients with 20% to 50% increase&#039; metric,
COUNT(c1.client_id) the_count,
SUM(c1.vol_change) the_volume,
SUM(c1.vol_change)/MAX(p2.job_volume_tot)*100 the_pct
FROM c1, p2
WHERE c1.pct_change BETWEEN 20 AND 50
UNION
SELECT 
8 sort_order,
&#039;Clients with 50% to 100% increase&#039; metric,
COUNT(c1.client_id) the_count,
SUM(c1.vol_change) the_volume,
SUM(c1.vol_change)/MAX(p2.job_volume_tot)*100 the_pct
FROM c1, p2
WHERE c1.pct_change BETWEEN 50 AND 100
UNION
SELECT 
9 sort_order,
&#039;Clients with over 100% increase&#039; metric,
COUNT(c1.client_id) the_count,
SUM(c1.vol_change) the_volume,
SUM(c1.vol_change)/MAX(p2.job_volume_tot)*100 the_pct
FROM c1, p2
WHERE c1.pct_change &gt; 100</string>
          </entry>
