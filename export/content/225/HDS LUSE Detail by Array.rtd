  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author:paul.hogan@aptare.com
--Last Updated: 10/4/2012
--This will list all LDEV&#039;s that make up all LUSE&#039;s within an array
SELECT   a.logical_unit_id,
  a.logical_unit_name,
  c.device_nbr,
         c.array_name, 
         c.capacity_gb ldev_capacity_gb, 
         c.raid_type, 
         c.array_group_name, 
         a.dp_type, 
         a.dp_pool_id, 
         case when a.logical_unit_name=substr(logical_unit_name,0,3)||regexp_replace(substr(to_char(c.device_nbr,&#039;XXXX&#039;),-2,1)||nvl(substr(to_char(c.device_nbr,&#039;XXXX&#039;),-1,1),&#039;0&#039;),&#039; &#039;,&#039;0&#039;) then b.luse_capacity_gb else null end luse_capacity_gb,
         case when a.logical_unit_name=substr(logical_unit_name,0,3)||regexp_replace(substr(to_char(c.device_nbr,&#039;XXXX&#039;),-2,1)||nvl(substr(to_char(c.device_nbr,&#039;XXXX&#039;),-1,1),&#039;0&#039;),&#039; &#039;,&#039;0&#039;) then c.path_exists else null end allocated,
         --c.path_exists allocated, 
         case when a.logical_unit_name=substr(logical_unit_name,0,3)||regexp_replace(substr(to_char(c.device_nbr,&#039;XXXX&#039;),-2,1)||nvl(substr(to_char(c.device_nbr,&#039;XXXX&#039;),-1,1),&#039;0&#039;),&#039; &#039;,&#039;0&#039;) then logical_unit_name else null end luse_head, 
         case when a.logical_unit_name&lt;&gt;substr(logical_unit_name,0,3)||regexp_replace(substr(to_char(c.device_nbr,&#039;XXXX&#039;),-2,1)||nvl(substr(to_char(c.device_nbr,&#039;XXXX&#039;),-1,1),&#039;0&#039;),&#039; &#039;,&#039;0&#039;) then logical_unit_name else null end luse_sub,
         substr(logical_unit_name,0,3)||regexp_replace(substr(to_char(c.device_nbr,&#039;XXXX&#039;),-2,1)||nvl(substr(to_char(c.device_nbr,&#039;XXXX&#039;),-1,1),&#039;0&#039;),&#039; &#039;,&#039;0&#039;) ldev

FROM     (SELECT * FROM aps_v_hds_ldev WHERE logical_unit_id IN ( SELECT logical_unit_id FROM aps_v_hds_ldev 
         GROUP BY logical_unit_id HAVING (COUNT(logical_unit_id ) &gt; 1))) c, 
         
         (SELECT SUM(c.capacity_gb) luse_capacity_gb, a.logical_unit_id FROM (SELECT * FROM aps_v_hds_ldev WHERE logical_unit_id IN (SELECT logical_unit_id FROM aps_v_hds_ldev GROUP BY logical_unit_id HAVING (COUNT(logical_unit_id ) &gt; 1))) c,
  aps_v_hds_logical_unit a WHERE c.logical_unit_id=a.logical_unit_id GROUP BY a.logical_unit_id) b,
         
         aps_v_hds_logical_unit a
         
WHERE    c.logical_unit_id=a.logical_unit_id 
AND c.logical_unit_id=b.logical_unit_id
AND a.array_name = DECODE(&#039;${queryCombo1}&#039;,&#039; All&#039;,a.array_name,&#039;${queryCombo1}&#039;)
ORDER BY luse_head</string>
          </entry>
