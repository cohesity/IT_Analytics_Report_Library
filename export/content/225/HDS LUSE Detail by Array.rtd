                  </entry>
                  <entry>
                    <string>queryComboValues1</string>
                    <string>SELECT DISTINCT array_name, array_name FROM aps_v_hds_logical_unit UNION ALL SELECT  &#039; All&#039;, &#039; All&#039; from dual order by 1</string>
