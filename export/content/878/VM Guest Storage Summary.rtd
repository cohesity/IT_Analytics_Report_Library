          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 09/14/2011
WITH t1 as (
SELECT
pp.partition_id, 
vd.vm_guest_name,
vd.virtual_system_id,
vd.virtual_system_name,
vd.host_id,
vd.host_name guest_host,
pp.os,
sum(vd.capacity_gb) cap_seen_by_host,
sum(vd.capacity_gb) host_fs_capacity,
sum(vd.used_space_gb) host_fs_used,
sum(vd.free_space_gb) host_free_gb
FROM apt_v_vmw_vmguest_disk vd, apt_v_vmw_partition_profile pp
WHERE host_id IN (${hosts}) 
AND vd.partition_id = pp.partition_id
GROUP BY 
pp.partition_id,
vd.vm_guest_name,
vd.virtual_system_id,
vd.virtual_system_name,
vd.host_id,
vd.host_name,
pp.os
),
rd AS (
SELECT 
vd.partition_id,
sum(pd.capacity_kb/1024/1024) rdisk_capacity_gb
FROM apt_v_vmw_physical_disk pd, apt_v_vmw_virtual_disk vd
WHERE vd.disk_type = &apos;RDISK&apos;
AND pd.canonical_name  = NVL(SUBSTR (vd.rdisk_lun_name, 1,INSTR (vd.rdisk_lun_name, &apos;:&apos;, 1, 3) - 1),vd.rdisk_lun_name)
GROUP BY vd.partition_id
)
SELECT 
t1.virtual_system_id,
t1.virtual_system_name,
t1.partition_id, 
t1.vm_guest_name,
t1.host_id,
t1.guest_host,
CASE 
WHEN upper(t1.os) LIKE &apos;%WINDOWS%&apos; THEN &apos;Windows&apos;
WHEN upper(t1.os) LIKE &apos;%LINUX%&apos; THEN &apos;Linux&apos;
WHEN upper(t1.os) LIKE &apos;%VMNIX-X86%&apos; THEN &apos;ESX&apos;
WHEN upper(t1.os) LIKE &apos;%AIX%&apos; THEN &apos;AIX&apos;
WHEN upper(t1.os) LIKE &apos;%SOLARIS%&apos; THEN &apos;Solaris&apos;
ELSE os
END os_shortname,
cap_seen_by_host,
host_fs_capacity,
host_fs_used,
host_free_gb,
rd.rdisk_capacity_gb raw_fs_capacity
FROM t1, rd
WHERE 
t1.partition_id = rd.partition_id (+)
AND &apos;${freeCombo1}&apos; IN 
  CASE 
    WHEN &apos;${freeCombo1}&apos; NOT IN (&apos;All&apos;) THEN
      CASE
        WHEN upper(t1.os) LIKE &apos;%WINDOWS%&apos; THEN &apos;Windows&apos;
        WHEN upper(t1.os) LIKE &apos;%LINUX%&apos; THEN &apos;Linux&apos;
        WHEN upper(t1.os) LIKE &apos;%VMNIX-X86%&apos; THEN &apos;ESX&apos;
        WHEN upper(t1.os) LIKE &apos;%AIX%&apos; THEN &apos;AIX&apos;
      END
   ELSE &apos;All&apos;
 END</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
