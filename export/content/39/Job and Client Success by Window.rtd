<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>WITH t1 as (
  SELECT start_date, finish_date finish_date  FROM 
              TABLE(rtd.ListOfBackupWindowDates(${startDate},${endDate},${queryCombo1})) bw
),
t2 as (
  SELECT t1.start_date, t1.finish_date,
      count(DISTINCT client_id) Client_count,
      count(j.job_id) Job_Count,
      sum(1*(1-abs(sign(j.summary_status-0)))) success,
      sum(1*(1-abs(sign(j.summary_status-1)))) partial,
      sum(1*(1-abs(sign(j.summary_status-2)))) failed,
      sum(1*(1-abs(sign(j.vendor_state-1)))) running,
      sum(1*(1-abs(sign(j.vendor_state-0)))) queued,
      sum(1*(1-abs(sign(j.vendor_state-2)))) re_queued
      FROM apt_v_job j,t1
      WHERE j.start_date BETWEEN t1.start_date AND t1.finish_date
      AND t1.start_date &gt;= ${startDate}
      AND j.server_id IN (${hosts})
      AND j.job_type_name like &#039;%Backup&#039;
      AND j.vendor_status NOT IN (150)
      GROUP BY  t1.start_date, t1.finish_date
      ORDER BY t1.start_date, t1.finish_date
),
t3 as (
  SELECT t1.start_date, t1.finish_date, client_id, min(summary_status) 
      FROM apt_v_job j,t1
      WHERE j.start_date BETWEEN t1.start_date AND t1.finish_date
      AND t1.start_date &gt;= ${startDate}
      AND j.server_id IN (${hosts})
      AND j.vendor_status NOT IN (150)
      GROUP BY client_id, t1.start_date, t1.finish_date
      HAVING min(summary_status) &gt; 1
      ORDER BY client_id, t1.start_date, t1.finish_date
) 
SELECT DISTINCT t2.start_date AS &quot;Window Start&quot;, t2.finish_date AS &quot;Window End&quot;,
      t2.job_count AS &quot;Jobs&quot;, (t2.success+t2.partial) AS &quot;Successful&quot;, 
      t2.failed AS &quot;Failed&quot;, t2.running, t2.queued+t2.re_queued AS &quot;Queued&quot;, 
      (t2.success + t2.partial) / t2.job_count*100 AS &quot;Job Success Rate&quot;,
      t2.client_count AS &quot;Total Clients&quot;, 
      (SELECT count(*) FROM t3 WHERE t2.start_date = t3.start_date 
        AND t2.finish_date = t3.finish_date ) AS &quot;Failed Clients&quot;,
      (t2.client_count-(SELECT count(*) FROM t3 WHERE t2.start_date = t3.start_date 
        AND t2.finish_date = t3.finish_date )) / t2.client_count*100 AS &quot;Client Success Rate&quot;
      FROM t2,t3
      WHERE t2.start_date = t3.start_date (+)
      AND t2.finish_date = t3.finish_date (+)</string>
          </entry>
