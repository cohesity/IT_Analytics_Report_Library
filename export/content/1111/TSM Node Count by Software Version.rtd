          <entry>
            <string>dataSource</string>
            <string>SELECT 
nvl(client_software_version,&apos;??nknown&apos;) client_version,
count(*) client_count
FROM apt_v_tsm_node
WHERE client_id IN (${hosts})
GROUP BY nvl(client_software_version,&apos;??nknown&apos;)
ORDER BY 2 DESC</string>
