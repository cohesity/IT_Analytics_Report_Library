          <entry>
            <string>dataSource</string>
            <string>
--Author: rich.rose@aptare.com
--Last Modified: 05/10/2012
WITH 
t1 AS (
SELECT ${queryCombo1} attribute,
count(hs.host_id) nbr_of_hosts,
sum(hs.allocated_capacity_gb) allocated_capacity_gb,
sum(hs.total_nas_capacity_gb) total_nas_capacity_gb
FROM apt_v_server_attribute sa, aps_v_host_storage hs
WHERE hs.host_id IN (${hosts})
AND hs.host_id = sa.host_id
GROUP BY ${queryCombo1}
)
SELECT
attribute,
DECODE(&apos;${freeCombo1}&apos;,
&apos;# Hosts&apos;,nbr_of_hosts,
&apos;SAN Allocated Capacity&apos;,allocated_capacity_gb,
&apos;NAS Capacity&apos;,total_nas_capacity_gb) 
metric
FROM t1
WHERE 
DECODE(&apos;${freeCombo1}&apos;,
&apos;# Hosts&apos;,nbr_of_hosts,
&apos;SAN Allocated Capacity&apos;,allocated_capacity_gb,
&apos;NAS Capacity&apos;,total_nas_capacity_gb) &gt; 0</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
