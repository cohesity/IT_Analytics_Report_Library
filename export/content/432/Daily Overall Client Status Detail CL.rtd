,{&quot;selected&quot;:false,&quot;name&quot;:&quot;secret_code&quot;,&quot;typeName&quot;:&quot;number&quot;,&quot;label&quot;:&quot;Code&quot;,&quot;formatter&quot;:&quot;CustomNumberFormatter&quot;,&quot;formatPattern&quot;:&quot;###&quot;,&quot;alignment&quot;:&quot;right&quot;,&quot;barType&quot;:&quot;bar&quot;,&quot;aggregation&quot;:&quot;&quot;,&quot;colour&quot;:&quot;&quot;,&quot;drilldown&quot;:&quot;&quot;,&quot;additionalDetail&quot;:&quot;&quot;,&quot;typeOverride&quot;:&quot;&quot;},{&quot;selected&quot;:true,&quot;name&quot;:&quot;job_count&quot;,&quot;typeName&quot;:&quot;number&quot;,&quot;label&quot;:&quot;Job Count&quot;,&quot;formatter&quot;:&quot;CustomNumberFormatter&quot;,&quot;formatPattern&quot;:&quot;###,###,##0&quot;,&quot;alignment&quot;:&quot;right&quot;,&quot;barType&quot;:&quot;bar&quot;,&quot;aggregation&quot;:&quot;sum&quot;,&quot;colour&quot;:&quot;&quot;,&quot;drilldown&quot;:&quot;templateInstanceId=150&amp;dateRange.startDate=${row[&#039;start_date_char&#039;]}&amp;dateRange.startHour=0&amp;dateRange.startMinute=0&amp;dateRange.startSecond=0&amp;dateRange.finishDate=${row[&#039;start_date_char&#039;]}&amp;dateRange.finishHour=23&amp;dateRange.finishMinute=59&amp;dateRange.finishSecond=59&amp;dateRange.useFinishTime=false&amp;drilldownClientIds=${row[&#039;client_id&#039;]}&quot;,&quot;additionalDetail&quot;:&quot;${row[&#039;client_risk_level&#039;].data} risk... ${row[&#039;job_count&#039;].data} total jobs.  ${row[&#039;s_count&#039;].data} Successful, ${row[&#039;w_count&#039;].data} Ended with Warnings, ${row[&#039;f_count&#039;].data} Failed *${row[&#039;i_count&#039;].data} of those jobs ran for more than 24 hours or never completed&quot;,&quot;typeOverride&quot;:&quot;&quot;},{&quot;selected&quot;:true,&quot;name&quot;:&quot;first_attempt_started&quot;,&quot;typeName&quot;:&quot;date&quot;,&quot;label&quot;:&quot;First Job Started&quot;,&quot;formatter&quot;:&quot;DateFormatter&quot;,&quot;formatPattern&quot;:&quot;&quot