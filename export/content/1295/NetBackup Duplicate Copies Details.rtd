  <data>
    <entry>
      <string>longDescription</string>
      <string>This drilldown report provides detailed information about all the Duplication Jobs for the specific date that you drilldown to from the NetBackup Duplicate Copies report. Details about all duplication jobs that contributed to the data shown in the parent report  are displayed here.</string>
    </entry>
