          <entry>
            <string>dataSource</string>
            <string>SELECT h.hostname Client,&#xd;
       j.*&#xd;
FROM apt_v_nbu_duplication_job j,&#xd;
     apt_v_server h&#xd;
WHERE j.target_client_id=h.server_id&#xd;
  AND j.finish_date BETWEEN ${startDate} AND ${endDate}&#xd;
  AND j.target_client_id IN (${hosts})&#xd;
 -- AND TRUNC(j.finish_date) = TO_DATE(&apos;${the_date_char}&apos;)&#xd;
  AND TRUNC(j.finish_date) = sysdate&#xd;
ORDER BY j.target_client_id, j.finish_date</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
