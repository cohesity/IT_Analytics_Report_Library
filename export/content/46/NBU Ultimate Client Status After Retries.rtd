<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 05/03/2012
SELECT u.job_id,
u.nbu_job_id,
u.client_id,
c.hostname client,
u.server_id,
s.hostname master_server,
u.schedule_id, 
ns.policy_id,
p.policy_name,
ns.schedule_name schedule,
u.start_date, u.finish_date,
u.kilobytes/1024/1024 size_gb, 
DECODE(u.overall_status,0,&#039;green&#039;,1,&#039;yellow&#039;,2,&#039;white&#039;,3,&#039;white&#039;,4,&#039;red&#039;) status_dot,
DECODE(u.overall_status,0,&#039;Successful&#039;,1,&#039;Partial&#039;,2,&#039;Queued&#039;,3,&#039;Running&#039;,4,&#039;Failed&#039;) overall_status,
u.vendor_status, 
u.orig_vendor_status,
DECODE(was_restarted,0,&#039;No&#039;,1,&#039;Yes&#039;) was_restarted,  
u.file_pathlist
FROM TABLE(nbu_rtd.listJobSummaryAfterRestart(
${startDate}, 
${endDate},
100000,
${spHosts}, 
null,
null,
null) ) u, apt_v_server s, apt_v_server c, apt_v_nbu_schedule ns, apt_v_nbu_policy p
WHERE s.server_id = u.server_id
AND c.server_id = u.client_id
AND u.schedule_id = ns.schedule_id (+)
AND ns.policy_id = p.policy_id (+)
AND overall_status &gt; DECODE(&#039;${freeCombo1}&#039;,&#039;No&#039;,0,&#039;Yes&#039;,-1)
AND overall_status &gt; DECODE(&#039;${freeCombo2}&#039;,&#039;No&#039;,1,&#039;Yes&#039;,0)
ORDER BY u.start_date</string>
          </entry>
