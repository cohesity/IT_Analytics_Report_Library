      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>SELECT 
Array_name,
allocated_gb, available_gb
FROM aps_v_storage_array
WHERE
&#039;${queryCombo1}&#039; IN 
  CASE 
    WHEN &#039;${queryCombo1}&#039; NOT IN (&#039; All&#039;) THEN
      CASE
        WHEN vendor_name = &#039;${queryCombo1}&#039; THEN &#039;${queryCombo1}&#039;
      END
   ELSE &#039; All&#039;
END
ORDER BY available_gb DESC</string>
          </entry>
