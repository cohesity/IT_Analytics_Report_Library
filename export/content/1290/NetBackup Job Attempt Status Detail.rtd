          <entry>
            <string>dataSource</string>
            <string>--Author: tom.sprouse@veritas.com&#xd;
--Last Modified: 11.3.2023&#xd;
--Report: OpsCenter Report - Job Attempt Status Detail&#xd;
SELECT apt_v_nbu_job_detail.master_host_name,&#xd;
TRUNC(apt_v_nbu_job_detail.finish_date),&#xd;
apt_v_nbu_job_detail.vendor_status,&#xd;
COUNT(apt_v_nbu_job_detail.job_id)&#xd;
FROM apt_v_nbu_job_detail&#xd;
WHERE apt_v_nbu_job_detail.vendor_state = 3&#xd;
AND client_id IN (${hosts})&#xd;
AND start_date BETWEEN ${startDate} AND ${endDate}&#xd;
GROUP BY TRUNC(apt_v_nbu_job_detail.finish_date),apt_v_nbu_job_detail.vendor_status,apt_v_nbu_job_detail.master_host_name&#xd;
ORDER BY TRUNC(apt_v_nbu_job_detail.finish_date), apt_v_nbu_job_detail.master_host_name, COUNT(apt_v_nbu_job_detail.job_id)</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
