<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>
--Author: rich.rose@aptare.com
--Last Modified: 05/10/2012
--DD/WM/MM/Q/YY Job Volume by Storage Node
WITH t1 as (
SELECT 
to_char(trunc(j.start_date,&#039;${freeCombo1}&#039;),&#039;MM/DD/YY&#039;) the_date,
substr(jtm.drive_name,4,instr(jtm.drive_name,&#039;:&#039;,4,1)-4) storage_node,
sum(jtm.kilobytes/1024/1024) job_size_gb
FROM apt_v_job_tape_media jtm, apt_v_job j, apt_v_leg_job lj
WHERE j.job_id = lj.job_id
AND j.job_id = jtm.job_id
AND j.client_id IN (${hosts})
AND jtm.drive_name LIKE &#039;rd=%&#039;
AND j.start_date BETWEEN ${startDate} AND ${endDate}
AND &#039;${freeCombo2}&#039; IN 
  CASE 
    WHEN &#039;${freeCombo2}&#039; NOT IN (&#039;All&#039;) THEN
      CASE
        WHEN j.job_type_name LIKE &#039;Full%&#039; THEN &#039;Full&#039;
        WHEN j.job_type_name LIKE &#039;Incr%&#039; THEN &#039;Incremental&#039;
        WHEN j.job_type_name NOT LIKE &#039;Incr%&#039; AND j.job_type_name NOT LIKE &#039;Full%&#039; THEN &#039;Other&#039;
      END
   ELSE &#039;All&#039;
 END
GROUP BY to_char(trunc(j.start_date,&#039;${freeCombo1}&#039;),
&#039;MM/DD/YY&#039;),substr(jtm.drive_name,4,instr(jtm.drive_name,&#039;:&#039;,4,1)-4)
ORDER BY 1
)
SELECT 
the_date,
sum(DECODE(storage_node,&#039;${queryCombo1}&#039;,job_size_gb,0)) stg_node1,
sum(DECODE(storage_node,&#039;${queryCombo2}&#039;,job_size_gb,0)) stg_node2
FROM t1
GROUP BY the_date</string>
          </entry>
