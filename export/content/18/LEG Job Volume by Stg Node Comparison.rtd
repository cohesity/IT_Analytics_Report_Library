                </componentScript>
                <configuration>
                  <entry>
                    <string>queryComboValues1</string>
                    <string>SELECT DISTINCT substr(td.drive_name,4,instr(td.drive_name,&#039;:&#039;,4,1)-4) storage_node, substr(td.drive_name,4,instr(td.drive_name,&#039;:&#039;,4,1)-4) storage_node FROM apt_v_tape_drive td WHERE td.drive_name LIKE &#039;rd=%&#039;</string>
                  </entry>
                  <entry>
                    <string>queryComboValues2</string>
                    <string>SELECT DISTINCT substr(td.drive_name,4,instr(td.drive_name,&#039;:&#039;,4,1)-4) storage_node, substr(td.drive_name,4,instr(td.drive_name,&#039;:&#039;,4,1)-4) storage_node FROM apt_v_tape_drive td WHERE td.drive_name LIKE &#039;rd=%&#039;</string>
                  </entry>
                  <entry>
                    <string>queryComboHeading2</string>
                    <string>Stg Node 2:</string>
                  </entry>
                  <entry>
                    <string>queryComboHeading1</string>
                    <string>Stg Node 1:</string>
                  </entry>
                </configuration>
                <referenceData/>
              </com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
            </list>
          </entry>
