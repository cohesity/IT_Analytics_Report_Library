          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com&#xd;
--Last Updated: 11/26/2012&#xd;
WITH t1 AS (&#xd;
SELECT&#xd;
TRUNC(start_date,&apos;DD&apos;) the_date,&#xd;
server_name,&#xd;
ROUND(SUM(kilobytes/1024/1024),2) job_size&#xd;
FROM apt_v_job&#xd;
WHERE&#xd;
client_id IN (${hosts})&#xd;
AND start_date BETWEEN ${startDate} AND ${endDate}&#xd;
GROUP BY trunc(start_date,&apos;DD&apos;), server_name&#xd;
ORDER BY 1,2&#xd;
)&#xd;
SELECT &#xd;
the_date,server_name,job_size,&#xd;
avg(job_size) OVER (PARTITION BY server_name ORDER BY the_date ROWS BETWEEN ${freeCombo1} PRECEDING AND 0 FOLLOWING) moving_average FROM t1&#xd;
ORDER BY 2,1 DESC</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
