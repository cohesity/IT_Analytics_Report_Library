<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>descriptiveName</string>
            <string>Legato Daily Client Overall Status Detail</string>
          </entry>
          <entry>
            <string>drilldown</string>
            <boolean>false</boolean>
          </entry>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptaare.com
--Last Modified: 11/09/2015
--5:00am,6:00am,7:00am,8:00am,9:00am,10:00am,11:00am
--High,Med,High &amp; Med,Low,Med &amp; Low,High &amp; Med &amp; Low,No,All
WITH 
d0 AS (
SELECT TRUNC(sysdate-1)+(1/24) * DECODE(&#039;${freeCombo1}&#039;,&#039;5:00am&#039;,5,&#039;6:00am&#039;,6,&#039;7:00am&#039;,7,&#039;8:00am&#039;,8,&#039;9:00am&#039;,9,&#039;10:00am&#039;,10,&#039;11:00am&#039;,11) the_start_date,
TRUNC(sysdate)+(1/24) * DECODE(&#039;${freeCombo1}&#039;,&#039;5:00am&#039;,5,&#039;6:00am&#039;,6,&#039;7:00am&#039;,7,&#039;8:00am&#039;,8,&#039;9:00am&#039;,9,&#039;10:00am&#039;,10,&#039;11:00am&#039;,11) the_end_date  
FROM dual
),
ss AS (--Count up the various summary status
SELECT					
d0.the_start_date,
d0.the_end_date,
j.server_id,					
j.server_name,
j.client_id,
j.client_name,
lj.saveset_group_id,
lj.saveset_group_name,
COUNT(j.job_id) job_count,
SUM(DECODE(j.summary_status,0,1,0)) s_count,					
SUM(DECODE(j.summary_status,1,1,0)) w_count,					
SUM(DECODE(j.summary_status,2,1,0)) f_count,					
SUM(DECODE(j.summary_status,NULL,1,0)) i_count,
MIN(j.start_date) first_attempt,
MAX(j.start_date) last_attempt,
aptStringConcat(DISTINCT j.job_type_name) job_types,
aptStringConcat(DISTINCT j.vendor_status) status_states,
SUM(j.kilobytes/1024/1024)  job_size_gb					
FROM apt_v_job j, apt_v_leg_job lj, apt_v_leg_client_resource cr, d0 		
WHERE 
j.start_date BETWEEN d0.the_start_date AND d0.the_end_date			
AND j.client_id IN (${hosts})					
AND j.client_id = cr.client_id
AND j.job_id = lj.job_id
AND cr.scheduled_backup = &#039;Y&#039;
AND lj.is_save_group_active = &#039;Y&#039;
GROUP BY 		
d0.the_start_date,
d0.the_end_date,
j.server_id,					
j.server_name,
j.client_id,					
j.client_name,
lj.saveset_group_id,
lj.saveset_group_name
),
sc AS (--Assign the Secret Code
SELECT
the_start_date,
the_end_date,
server_id,					
server_name,
client_id,					
client_name,
saveset_group_id,
saveset_group_name,
job_count,
--If the have any status 0,1,2 or NULL assign an exponential number to represent it
CASE WHEN s_count &gt; 0 THEN 1 ELSE 0 END s_code,					
CASE WHEN w_count &gt; 0 THEN 2 ELSE 0 END w_code,					
CASE WHEN f_count &gt; 0 THEN 4 ELSE 0 END f_code,					
CASE WHEN i_count &gt; 0 THEN 8 ELSE 0 END i_code,
--The secret code is the sum of the individual exponential numbers (every combination will be unique)
CASE WHEN s_count &gt; 0 THEN 1 ELSE 0 END +					
CASE WHEN w_count &gt; 0 THEN 2 ELSE 0 END +					
CASE WHEN f_count &gt; 0 THEN 4 ELSE 0 END +					
CASE WHEN i_count &gt; 0 THEN 8 ELSE 0 END secret_code,				
--The counts will represent how many actual successes vs failures 
s_count,
w_count,
f_count,
i_count,
first_attempt,
last_attempt,
job_types,
status_states,
job_size_gb
FROM ss
),
t0 AS (--Decode the secret_code and the overall client status 
SELECT 
the_start_date,
the_end_date,
server_id,
server_name,
client_id,
client_name,
saveset_group_id,
saveset_group_name,
DECODE(secret_code,				
 1 , &#039;Successful&#039;, 				
 2 , &#039;Warnings&#039;, 				
 3 , &#039;Successful &amp; Warnings&#039;, 				
 4 , &#039;Failed&#039;, 				
 5 , &#039;Successful &amp; Failed&#039;, 				
 6 , &#039;Warnings &amp; Failed&#039;, 				
 7 , &#039;Successful &amp; Warnings &amp; Failed&#039;, 				
 8 , &#039;Incomplete&#039;, 				
 9 , &#039;Successful &amp; Incomplete&#039;, 				
10 , &#039;Warnings &amp; Incomplete&#039;, 				
11 , &#039;Successful &amp; Warnings &amp; Incomplete&#039;, 				
12 , &#039;Failed &amp; Incomplete&#039;, 				
13 , &#039;Successful &amp; Failed &amp; Incomplete&#039;, 				
14 , &#039;Warnings &amp; Failed &amp; Incomplete&#039;, 				
15 , &#039;Successful &amp; Warnings &amp; Failed &amp; Incomplete&#039;, 				
&#039;Other&#039;) overall_client_status,

DECODE(secret_code,
 1 , &#039;No&#039;, 				
 2 , &#039;Low&#039;, 				
 3 , &#039;Low&#039;, 				
 4 , &#039;High&#039;, 				
 5 , &#039;Med&#039;, 				
 6 , &#039;Med&#039;, 				
 7 , &#039;Med&#039;, 				
 8 , &#039;High&#039;, 				
 9 , &#039;Med&#039;, 				
10 , &#039;Med&#039;, 				
11 , &#039;Med&#039;, 				
12 , &#039;High&#039;, 				
13 , &#039;Med&#039;, 				
14 , &#039;Med&#039;, 				
15 , &#039;Med&#039;, 				
&#039;Other&#039;) client_risk_level,
secret_code,
job_count,
CASE WHEN s_count &gt; 0 THEN &#039;green&#039; ELSE null END s_dot,					
CASE WHEN w_count &gt; 0 THEN &#039;yellow&#039; ELSE null END w_dot,					
CASE WHEN f_count &gt; 0 THEN &#039;red&#039; ELSE null END f_dot,					
CASE WHEN i_count &gt; 0 THEN &#039;blue&#039; ELSE null END i_dot,
s_count,
w_count,
f_count,
i_count,
first_attempt,
last_attempt,
job_types,
status_states,
job_size_gb
FROM sc
)
SELECT
server_id,
server_name,
client_id,
client_name,
saveset_group_id,
saveset_group_name,
secret_code,
job_count,
overall_client_status,
--ostatus_dot,
client_risk_level,
s_dot,					
w_dot,					
f_dot,					
i_dot,
s_count,
w_count,
f_count,
i_count,
TO_CHAR(first_attempt,&#039;MM/DD/YYYY hh:mi AM&#039;) first_attempt,
TO_CHAR(last_attempt,&#039;MM/DD/YYYY hh:mi AM&#039;) last_attempt,
job_types,
status_states,
job_size_gb
FROM t0
WHERE
--High,Med,High &amp; Med,Low,Med &amp; Low,No,All
REGEXP_LIKE (client_risk_level, DECODE(&#039;${freeCombo2}&#039;,
&#039;High&#039;,&#039;High&#039;,
&#039;Med&#039;,&#039;Med&#039;,
&#039;High &amp; Med&#039;,&#039;High|Med&#039;,
&#039;Low&#039;,&#039;Low&#039;,
&#039;Med &amp; Low&#039;,&#039;Med|Low&#039;,
&#039;High &amp; Med &amp; Low&#039;,&#039;High|Med|Low&#039;,
&#039;No&#039;,&#039;No&#039;,
&#039;All&#039;,&#039;High|Med|Low|No&#039;))
ORDER BY the_start_date, UPPER(client_name)</string>
          </entry>
