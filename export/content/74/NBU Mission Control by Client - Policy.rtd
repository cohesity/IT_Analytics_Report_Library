    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>
--Author: rich.rose@aptare.com
--Last Modified: 05/10/2012
SELECT to_char(start_date,&#039;MM/DD&#039;) run_date, client_host_name||&#039; - &#039;||policy_name client_policy,  
DECODE(min(summary_status),0,&#039;green&#039; ,1,&#039;yellow&#039;,2,&#039;red&#039;
)
status 
FROM apt_v_nbu_job_detail
WHERE start_date BETWEEN ${startDate} AND ${endDate}
AND client_id in (${hosts})
AND policy_name IS NOT NULL
AND start_date IS NOT NULL
GROUP BY to_char(start_date,&#039;MM/DD&#039;), client_host_name||&#039; - &#039;||policy_name
ORDER BY 1</string>
          </entry>
