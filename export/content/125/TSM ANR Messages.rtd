<com.aptare.sc.dal.versioning.ObjectMap>
  <version>1</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>WITH t1 as (
SELECT count(jm.job_id) occurances, 
jm.msg_code, jm.message, jm.explanation, jm.msg_type 
FROM apt_v_tsm_job j, apt_v_tsm_job_message jm
WHERE j.job_id=jm.job_id
AND msg_date BETWEEN ${startDate} AND ${endDate}
AND j.client_id IN (${hosts})
AND upper(msg_code) LIKE upper(&#039;${freeText1}&#039;)
AND upper(message) LIKE upper(&#039;${freeText2}&#039;)
GROUP BY jm.msg_code, jm.message, jm.explanation, jm.msg_type
)
SELECT occurances, 
CASE msg_type
  WHEN &#039;E&#039; THEN &#039;&lt;font color=&quot;red&quot;&gt;Error&lt;/font&gt;&#039;
  WHEN &#039;W&#039; THEN &#039;&lt;font color=&quot;orange&quot;&gt;Warning&lt;/font&gt;&#039;
  ELSE &#039;&lt;font color=&quot;red&quot;&gt;Other&lt;/font&gt;&#039;
END type,
msg_code,
message,explanation
FROM T1 
ORDER by occurances DESC</string>
          </entry>
          <entry>
            <string>designerScript</string>
            <null/>
          </entry>
          <entry>
            <string>advancedComponents</string>
            <list/>
          </entry>
