          <entry>
            <string>dataSource</string>
            <string>
--Author: rich.rose@aptare.com
--Last Modified: 05/10/2012
SELECT os_version, count(ds.host_id) host_count
FROM apt_v_server s, apt_v_ddm_system ds, apt_v_ddm_enclosure de
WHERE s.server_id = ds.host_id
AND ds.host_id = de.host_id
AND s.server_id IN (${hosts})
AND de.model_number LIKE DECODE(&apos;${queryCombo1}&apos;,&apos;All&apos;,&apos;%&apos;,&apos;${queryCombo1}&apos;)
GROUP BY os_version</string>
          </entry>
