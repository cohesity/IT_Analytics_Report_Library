          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 02/03/2015
--SELECT &apos; All&apos; array_name, &apos;All&apos; array_name FROM apt_v_dual UNION SELECT DISTINCT array_name, array_name FROM aps_v_emc_sym_storage_pool 
WITH 
var AS (
SELECT
DECODE(&apos;${freeCombo1}&apos;,&apos;KB&apos;,1,&apos;MB&apos;,1024,&apos;GB&apos;,(1024*1024),&apos;TB&apos;,(1024*1024*1024),&apos;PB&apos;,(1024*1024*1024*1024)) div_by 
FROM apt_v_dual
)
SELECT
array_name,
pool_name,
sp.dev_config raid_type,
ROUND(total_tracks_kb/div_by,2) total_tracks,
ROUND(total_used_tracks_kb/div_by,2) used_tracks,
ROUND((total_tracks_kb-total_used_tracks_kb)/div_by,2) avail_tracks,
CASE
  WHEN total_tracks_kb = 0 THEN 0
  ELSE ROUND(total_used_tracks_kb/total_tracks_kb,2)
END pool_used_pct,
CASE
  WHEN total_tracks_kb = 0 THEN 0
  ELSE ROUND(total_used_tracks_kb/total_tracks_kb*100,2)
END pct_pool_used,
ROUND(((total_tracks_kb/div_by) * (subscribed_pct/100)),2) subscribed,  
subscribed_pct/100 subscribed_pct,
subscribed_pct pct_subscribed,
CASE 
  WHEN subscribed_pct &lt;= 100 THEN 0
  ELSE ((total_tracks_kb * (subscribed_pct/100))/1024/1024/1024) - (total_tracks_kb/1024/1024/1024) 
END over_subscribed,
CASE 
  WHEN subscribed_pct &lt;= 100 THEN 0
  ELSE ABS((100-subscribed_pct)/100) 
END over_subscribed_pct,
CASE 
  WHEN subscribed_pct &lt;= 100 THEN 0
  ELSE ABS((100-subscribed_pct)) 
END pct_over_subscribed
FROM aps_v_emc_sym_storage_pool sp, var
WHERE  
array_name LIKE DECODE(&apos;${queryCombo1}&apos;,&apos; All&apos;,&apos;%&apos;,&apos;${queryCombo1}&apos;)
AND array_name is not null</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
