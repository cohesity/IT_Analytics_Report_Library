          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 07/09/2011
--This will summarize the number of policies defined on each master server by their type.
--The drilldown report NBU Policy List.D is required for drilldowns to work.
SELECT
s.server_id,
s.hostname master_server,
&apos;${freeCombo1}&apos; the_state,
sum(DECODE(policy_type,0,1,0)) Standard,
sum(DECODE(policy_type,4,1,0)) Oracle,
sum(DECODE(policy_type,6,1,0)) Informix_OnBar,
sum(DECODE(policy_type,7,1,0)) sybase,
sum(DECODE(policy_type,8,1,0)) MS_SharePoint,
sum(DECODE(policy_type,10,1,0)) Netware,
sum(DECODE(policy_type,13,1,0)) MS_Windows,
sum(DECODE(policy_type,15,1,0)) MS_SQL_Server,
sum(DECODE(policy_type,16,1,0)) MS_Exchange_Server,
sum(DECODE(policy_type,17,1,0)) SAP,
sum(DECODE(policy_type,18,1,0)) DB2,
sum(DECODE(policy_type,19,1,0)) NDMP,
sum(DECODE(policy_type,20,1,0)) FlashBackup,
sum(DECODE(policy_type,22,1,0)) AFS,
sum(DECODE(policy_type,24,1,0)) DataStore,
sum(DECODE(policy_type,25,1,0)) Lotus_Notes,
sum(DECODE(policy_type,26,1,0)) NCR_Teradata,
sum(DECODE(policy_type,29,1,0)) FlashBackup2,
sum(DECODE(policy_type,30,1,0)) vault,
sum(DECODE(policy_type,35,1,0)) Catalog
FROM apt_v_nbu_policy np, apt_v_server s
WHERE np.server_id IN (${hosts})
AND np.server_id = s.server_id
AND is_active = DECODE(&apos;${freeCombo1}&apos;,&apos;All&apos;,is_active,&apos;Active&apos;,&apos;Y&apos;,&apos;Inactive&apos;,&apos;N&apos;)
GROUP BY s.server_id, s.hostname, &apos;${freeCombo1}&apos;</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
