          <entry>
            <string>dataSource</string>
            <string>
--Author: rich.rose@aptare.com
--Last Updated: 08/20/2012
SELECT 
gsan_system_id, gsan_system_name,
MAX(DECODE(job_type_name,&apos;Scheduled Backup&apos;,scanned_kb,0)/1024/1024) sb_scanned_gb,
MAX(DECODE(job_type_name,&apos;Restore&apos;,scanned_kb,0)/1024/1024) r_scanned_gb,
MAX(DECODE(job_type_name,&apos;On-Demand Backup&apos;,scanned_kb,0)/1024/1024) od_scanned_gb,
MAX(DECODE(job_type_name,&apos;Replication Source&apos;,scanned_kb,0)/1024/1024) rs_scanned_gb,
MAX(DECODE(job_type_name,&apos;Replication Destination&apos;,scanned_kb,0)/1024/1024) rd_scanned_gb
FROM apt_v_avm_activities
WHERE 
scanned_kb &gt; 0
AND recorded_date BETWEEN ${startDate} AND ${endDate}
GROUP BY 
gsan_system_id, gsan_system_name</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
