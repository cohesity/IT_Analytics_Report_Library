          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 05/11/2017
WITH 
VAR AS (
SELECT
ROUND((${endDate} - ${startDate}),2) nbrOfDays,
${startDate} startDate,
DECODE(&apos;${freeCombo1}&apos;,
&apos;GB&apos;,1,&apos;TB&apos;,1024,&apos;PB&apos;,(1024*1024)) div_by,
&apos;${freeCombo1}&apos; the_unit 
FROM apt_v_dual
)
SELECT 
host_id,host_name,
DECODE(di.database_vendor,&apos;O&apos;,&apos;Oracle&apos;,&apos;Other&apos;) vendor,
di.db_instance_name,
dt.tablespace_name,
dt.total_size_gb/div_by total_size,
(dt.total_size_gb - dt.free_size_gb)/div_by used_size,
dt.free_size_gb/div_by free_size
FROM aps_v_database_instance di, aps_v_database_tablespace dt, var
WHERE di.db_instance_id = dt.db_instance_id
AND di.host_id IN (${hosts})</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
