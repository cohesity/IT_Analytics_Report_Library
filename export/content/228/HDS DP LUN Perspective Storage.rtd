<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--This takes a pipe separated list of array names and pool numbers as wildcards NOTE: Use * for all 
--EXAMPLE Array(s): USP_12|USP_13 Pool: 1|2|3|4
--or Array(s): USP_12 Pool(s):*
--or Array(s):* Pool(s):*
WITH 
l1 as (--Get all the distinct LUNS
SELECT DISTINCT
hlu.array_name,
hlu.logical_unit_id,
hlu.logical_unit_name,
lu.status,
lu.total_capacity_gb,
hlu.consumed_capacity_gb
FROM aps_v_hds_logical_unit hlu, aps_v_logical_unit lu
WHERE lu.logical_unit_id = hlu.logical_unit_id 
AND hlu.dp_type = 0
AND REGEXP_LIKE(hlu.array_name,&#039;${freeText1}&#039;, &#039;i&#039;)
AND REGEXP_LIKE(hlu.dp_pool_id,&#039;${freeText2}&#039;, &#039;i&#039;)
),
h1 as (
SELECT 
hlu.array_name,
hlu.logical_unit_id,
hlu.logical_unit_name,
sp.total_capacity_gb,
hlu.consumed_capacity_gb,
count(DISTINCT sp.host_storage_domain) nbr_of_hosts,
aptStringConcat(DISTINCT sp.host_storage_domain) hosts
FROM aps_v_storage_path sp, aps_v_hds_logical_unit hlu
WHERE sp.logical_unit_id = hlu.logical_unit_id (+)
AND REGEXP_LIKE(hlu.array_name,&#039;${freeText1}&#039;, &#039;i&#039;)
AND REGEXP_LIKE(hlu.dp_pool_id,&#039;${freeText2}&#039;, &#039;i&#039;)
AND hlu.dp_type = 0
GROUP BY
hlu.array_name,
hlu.logical_unit_id,
hlu.logical_unit_name,
sp.total_capacity_gb,
hlu.consumed_capacity_gb
)
SELECT
l1.array_name,
l1.logical_unit_name,
l1.status,
l1.total_capacity_gb,
l1.consumed_capacity_gb,
(l1.consumed_capacity_gb/(l1.total_capacity_gb+.0001))*100 pct_consumed,
(l1.consumed_capacity_gb/(l1.total_capacity_gb+.0001)) pct_consumed_bar,
h1.nbr_of_hosts,
CASE WHEN h1.nbr_of_hosts &gt; 1
THEN SUBSTR(h1.hosts, 1 ,INSTR(h1.hosts, &#039;,&#039;, 1, 1)-1) 
ELSE h1.hosts
END hosts,
hosts all_hosts
FROM l1,h1
WHERE 
l1.logical_unit_id = h1.logical_unit_id(+)
ORDER BY 1,2</string>
          </entry>
