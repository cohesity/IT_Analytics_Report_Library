          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 05/30/2012
SELECT 
rtd.getObjectAttributeValue(storage_array_id,&apos;Site&apos;,&apos;A&apos;) site,
vendor_name,
array_name,
raw_capacity_gb/1024 raw_capacity_gb,
raw_allocated_gb/1024 raw_allocated_gb,
raw_available_gb/1024 raw_available_gb,
capacity_gb/1024 capacity_tb,
allocated_gb/1024 allocated_tb,
available_gb/1024 available_tb,
other_allocated_gb/1024 other_allocated_tb,
largest_free_space_gb/1024 largest_free_space_tb,
nbr_of_luns,
nbr_allocated_luns
FROM aps_v_storage_array
WHERE
&apos;${queryCombo1}&apos; IN 
  CASE 
    WHEN &apos;${queryCombo1}&apos; NOT IN (&apos; All Vendors&apos;) THEN
      CASE
        WHEN vendor_name = &apos;${queryCombo1}&apos; THEN &apos;${queryCombo1}&apos;
      END
   ELSE &apos; All Vendors&apos;
END</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
