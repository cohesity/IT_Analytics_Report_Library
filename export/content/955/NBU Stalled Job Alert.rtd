          <entry>
            <string>dataSource</string>
            <string>
--Author: rich.rose@aptare.com
--Last Modified: 05/10/2012
SELECT
job_id,
master_host_name,media_host_name,client_host_name,
vendor_state_name,vendor_status_name,
start_date,
(sysdate-start_date)*1440 job_duration_min,
rtd.secsToHoursMinSecs((sysdate-start_date)*86400) job_duration,
started_readwrite,
(sysdate - nvl(started_readwrite,sysdate))*1440 rw_duration_min,
rtd.secsToHoursMinSecs((sysdate - nvl(started_readwrite,sysdate))*86400) rw_duration,
(kilobytes/1024) mb_written,
((sysdate - nvl(started_readwrite,sysdate))*86400)/((kilobytes/1024)+.0001) mb_sec
FROM apt_v_nbu_job_try
WHERE client_id IN (${hosts})
AND start_date BETWEEN ${startDate} AND ${endDate}
AND is_active = &apos;Y&apos;</string>
          </entry>
        </data>
