  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>
--Author: rich.rose@aptare.com
--Last Modified: 09/09/2011
SELECT n.instance_name,
count(DISTINCT ca.client_id) client_count
FROM apt_v_tsm_client_association ca, apt_v_tsm_node n 
WHERE ca.client_id IN (${hosts})
AND modification_date BETWEEN ${startDate} AND ${endDate}
AND ca.node_id = n.node_id
GROUP BY n.instance_name
ORDER BY 2</string>
          </entry>
