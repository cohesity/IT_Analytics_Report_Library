<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>descriptiveName</string>
            <string>Data Domain Disk R/W System Stats </string>
          </entry>
          <entry>
            <string>drilldown</string>
            <boolean>false</boolean>
          </entry>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 12/10/2014
WITH 
var AS (
SELECT
DECODE(&#039;${freeCombo2}&#039;,&#039;KB&#039;,1,&#039;MB&#039;,1024,&#039;GB&#039;,(1024*1024),&#039;TB&#039;,(1024*1024*1024),&#039;PB&#039;,(1024*1024*1024*1024)) div_by 
FROM dual
)
SELECT
to_char(trunc(collection_time,DECODE(&#039;${freeCombo1}&#039;,&#039;Hour&#039;,&#039;HH24&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;,&#039;YY&#039;)),&#039;MM/DD/YYYY HH24&#039;) the_date,
to_char(trunc(collection_time,DECODE(&#039;${freeCombo1}&#039;,&#039;Hour&#039;,&#039;HH24&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;,&#039;YY&#039;)),&#039;YYYYMMDDHH24&#039;) sort_order,
MAX(cpu_avg_pct_busy) cpu_avg_pct_busy,
MAX(cpu_max_pct_busy) cpu_max_pct_busy,
SUM(disk_read_kb/div_by) disk_read,
SUM(disk_written_kb/div_by) disk_written,
MAX(disk_pct_busy) disk_pct_busy,
MAX(nfs_proc_pct_busy) nfs_proc_pct_busy,
SUM(net_kb_in/div_by) net_in,
SUM(net_kb_out/div_by) net_out,
SUM(replication_kb/div_by) replication
FROM apt_v_ddm_system_log sl, aps_v_host h, var
WHERE collection_time BETWEEN ${startDate} AND ${endDate}
AND sl.host_id = h.host_id
AND h.host_name = &#039;${queryCombo1}&#039;
GROUP BY
to_char(trunc(collection_time,DECODE(&#039;${freeCombo1}&#039;,&#039;Hour&#039;,&#039;HH24&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;,&#039;YY&#039;)),&#039;MM/DD/YYYY HH24&#039;),
to_char(trunc(collection_time,DECODE(&#039;${freeCombo1}&#039;,&#039;Hour&#039;,&#039;HH24&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;,&#039;YY&#039;)),&#039;YYYYMMDDHH24&#039;)</string>
          </entry>
          <entry>
            <string>postReportInterceptor</string>
            <null/>
          </entry>
          <entry>
            <string>designerScript</string>
            <null/>
          </entry>
