          <entry>
            <string>designerComponents</string>
            <list>
              <com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
                <name>timePeriod</name>
                <componentScript>
                  <before/>
                  <after/>
                </componentScript>
                <referenceData/>
              </com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
              <com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
                <name>freeCombo</name>
                <componentScript>
                  <before/>
                  <after/>
                </componentScript>
                <configuration>
                  <entry>
                    <string>freeComboValues1</string>
                    <string>Hour,Day,Week,Month,Qarter,Year</string>
                  </entry>
                  <entry>
                    <string>freeComboValues2</string>
                    <string>KB,MB,GB,TB,PB</string>
                  </entry>
                  <entry>
                    <string>freeComboHeading1</string>
                    <string>Group by:</string>
                  </entry>
                  <entry>
                    <string>freeComboHeading2</string>
                    <string>Values in:</string>
                  </entry>
                </configuration>
                <referenceData/>
              </com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
              <com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
                <name>freeQueryCombo</name>
                <componentScript>
                  <before/>
                  <after/>
                </componentScript>
                <configuration>
                  <entry>
                    <string>sql</string>
                    <string>SELECT DISTINCT host_name key, host_name value FROM apt_v_ddm_system_log s, aps_v_host h WHERE s.host_id = h.host_id AND collection_time &gt; sysdate - 7 ORDER BY 1</string>
                  </entry>
                  <entry>
                    <string>queryComboValues1</string>
                    <string>SELECT DISTINCT host_name key, host_name value FROM apt_v_ddm_system_log s, aps_v_host h WHERE s.host_id = h.host_id AND collection_time &gt; sysdate - 7 ORDER BY 1</string>
                  </entry>
                  <entry>
                    <string>queryComboHeading1</string>
                    <string>Data Domain:</string>
                  </entry>
                </configuration>
                <referenceData/>
              </com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
            </list>
          </entry>
          <entry>
            <string>composedReports</string>
            <null/>
          </entry>
        </data>
