                    <string>queryComboDefaultValue1</string>
                    <string> All</string>
                  </entry>
                  <entry>
                    <string>queryComboValues1</string>
                    <string>SELECT &#039; All&#039; the_key, &#039; All&#039; the_value FROM dual UNION SELECT DISTINCT CEIL(DECODE(compression_ratio,NULL,1,0,1,compression_ratio))||&#039;:1&#039; the_key , CEIL(DECODE(compression_ratio,NULL,1,0,1,compression_ratio))||&#039;:1&#039;  the_value FROM aps_v_h3p_logical_unit ORDER BY 1</string>
                  </entry>
                  <entry>
                    <string>queryComboHeading1</string>
