            <null/>
          </entry>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified 09/20/2018
WITH 
p1 AS (
SELECT 
 logical_unit_id,
 MAX(total_io) max_total_io_sample,
 MAX(read_io_response_time) max_read_io_response_sample,
 MAX(write_io_response_time) max_write_io_response_sample
 FROM aps_v_lun_perform_log 
 WHERE 
 log_date &gt;= sysdate-2 
 AND storage_array_id IN (${arrays})
GROUP BY
 logical_unit_id 
ORDER BY 
 2 DESC
),
t1 AS (
SELECT 
h3p_storage_system_id,
system_name,
user_dsp_name,
logical_unit_id,
logical_unit_name,
(NVL(tier1_user_kb,0)+NVL(tier2_user_kb,0)+NVL(tier3_user_kb,0))/1024/1024 t1t2t3_user_gb,
CEIL(DECODE(dedup_ratio,NULL,1,0,1,dedup_ratio))||&#039;:1&#039; dedup_ratio,
CEIL(DECODE(dedup_ratio,NULL,1,0,1,dedup_ratio)) dedup_ratio_num,
CEIL(DECODE(compression_ratio,NULL,1,0,1,compression_ratio))||&#039;:1&#039; compression_ratio,
CEIL(DECODE(compression_ratio,NULL,1,0,1,compression_ratio)) compression_ratio_num,
CEIL(DECODE(compaction_ratio,NULL,1,0,1,compaction_ratio))||&#039;:1&#039; compaction_ratio,
CEIL(DECODE(compaction_ratio,NULL,1,0,1,compaction_ratio)) compaction_ratio_num,
total_capacity_gb,
consumable_admin_gb,
consumable_copy_gb,
consumable_user_gb,
used_snapshot_admin_space_gb,
used_snapshot_data_space_gb,
used_user_space_gb,
is_compression_enabled,
is_dedup_enabled
FROM
aps_v_h3p_logical_unit
WHERE 
h3p_storage_system_id IN (${arrays})
AND NVL(is_compression_enabled,&#039;No&#039;) LIKE DECODE(&#039;${freeCombo1}&#039;,&#039;All&#039;,&#039;%&#039;,&#039;${freeCombo1}&#039;)
AND CEIL(DECODE(compression_ratio,NULL,1,0,1,compression_ratio))||&#039;:1&#039; LIKE DECODE(&#039;${queryCombo1}&#039;,&#039; All&#039;,&#039;%&#039;,&#039;${queryCombo1}&#039;)
)
SELECT
t1.h3p_storage_system_id storage_array_id,
t1.system_name,
t1.user_dsp_name,
t1.logical_unit_id,
t1.logical_unit_name,
t1.is_compression_enabled,
t1.compression_ratio,
NVL(p1.max_total_io_sample,0) max_total_io_sample,
NVL(p1.max_read_io_response_sample,0) max_read_io_response_sample,
NVL(p1.max_write_io_response_sample,0) max_write_io_response_sample,
t1.used_user_space_gb,
used_user_space_gb * compression_ratio_num AS actual_size_needed_gb,
(t1.used_user_space_gb * t1.compression_ratio_num) - t1.used_user_space_gb AS actual_savings_gb,
((t1.used_user_space_gb * t1.compression_ratio_num) - t1.used_user_space_gb) * ${freeText1} AS actual_savings_money
FROM t1, p1
WHERE 
t1.logical_unit_id = p1.logical_unit_id (+)
AND h3p_storage_system_id IN (${arrays})
AND NVL(p1.max_read_io_response_sample,0) &gt;= ${freeText2}
AND NVL(p1.max_write_io_response_sample,0) &gt;= ${freeText3}</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
