          <entry>
            <string>dataSource</string>
            <string>
--Author: rich.rose@aptare.com
--Last Modified: 05/10/2012
--DD/WM/MM/Q/YY Job Volume by Storage Node
WITH t1 as (
SELECT 
to_char(trunc(j.start_date,&apos;${freeCombo1}&apos;),&apos;MM/DD/YY&apos;) the_date,
substr(jtm.drive_name,4,instr(jtm.drive_name,&apos;:&apos;,4,1)-4) storage_node,
sum(jtm.kilobytes/1024/1024) job_size_gb
FROM apt_v_job_tape_media jtm, apt_v_job j, apt_v_leg_job lj
WHERE j.job_id = lj.job_id
AND j.job_id = jtm.job_id
AND j.client_id IN (${hosts})
AND jtm.drive_name LIKE &apos;rd=%&apos;
AND j.start_date BETWEEN ${startDate} AND ${endDate}
AND &apos;${freeCombo2}&apos; IN 
  CASE 
    WHEN &apos;${freeCombo2}&apos; NOT IN (&apos;All&apos;) THEN
      CASE
        WHEN j.job_type_name LIKE &apos;Full%&apos; THEN &apos;Full&apos;
        WHEN j.job_type_name LIKE &apos;Incr%&apos; THEN &apos;Incremental&apos;
        WHEN j.job_type_name NOT LIKE &apos;Incr%&apos; AND j.job_type_name NOT LIKE &apos;Full%&apos; THEN &apos;Other&apos;
      END
   ELSE &apos;All&apos;
 END
GROUP BY to_char(trunc(j.start_date,&apos;${freeCombo1}&apos;),
&apos;MM/DD/YY&apos;),substr(jtm.drive_name,4,instr(jtm.drive_name,&apos;:&apos;,4,1)-4)
ORDER BY 1
)
SELECT 
the_date,
sum(DECODE(storage_node,&apos;${queryCombo1}&apos;,job_size_gb,0)) stg_node1,
sum(DECODE(storage_node,&apos;${queryCombo2}&apos;,job_size_gb,0)) stg_node2
FROM t1
GROUP BY the_date</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
