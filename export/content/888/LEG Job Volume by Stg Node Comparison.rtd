                  </entry>
                  <entry>
                    <string>queryComboValues2</string>
                    <string>SELECT DISTINCT substr(td.drive_name,4,instr(td.drive_name,&apos;:&apos;,4,1)-4) storage_node, substr(td.drive_name,4,instr(td.drive_name,&apos;:&apos;,4,1)-4) storage_node FROM apt_v_tape_drive td WHERE td.drive_name LIKE &apos;rd=%&apos;</string>
