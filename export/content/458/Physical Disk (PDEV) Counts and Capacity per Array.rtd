          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 01/20/2019
WITH 
VAR AS (
SELECT 
&#039;${freeCombo1}&#039; unit,
DECODE(&#039;${freeCombo1}&#039;, &#039;KB&#039;,1,&#039;MB&#039;,1024,&#039;GB&#039;,(1024*1024),&#039;TB&#039;,(1024*1024*1024),&#039;PB&#039;,(1024*1024*1024*1024)) div_by
FROM dual
)
SELECT
sa.storage_array_id,
sa.array_name,
sa.array_family,
SUM(DECODE(pd.disk_type,&#039;FC&#039;,1,0)) fc_count,
SUM(DECODE(pd.disk_type,&#039;FC&#039;,pd.capacity_kb/div_by,0)) fc_capacity,
SUM(DECODE(pd.disk_type,&#039;EFD&#039;,1,0)) efd_count,
SUM(DECODE(pd.disk_type,&#039;EFD&#039;,pd.capacity_kb/div_by,0)) efd_capacity,
SUM(DECODE(pd.disk_type,&#039;LUN&#039;,1,0)) lun_count,
SUM(DECODE(pd.disk_type,&#039;LUN&#039;,pd.capacity_kb/div_by,0)) lun_capacity,
SUM(DECODE(pd.disk_type,&#039;SAS&#039;,1,0)) sas_count,
SUM(DECODE(pd.disk_type,&#039;SAS&#039;,pd.capacity_kb/div_by,0)) sas_capacity,
SUM(DECODE(pd.disk_type,&#039;SSD&#039;,1,0)) ssd_count,
SUM(DECODE(pd.disk_type,&#039;SSD&#039;,pd.capacity_kb/div_by,0)) ssd_capacity,
SUM(DECODE(pd.disk_type,&#039;BSAS&#039;,1,0)) bsas_count,
SUM(DECODE(pd.disk_type,&#039;BSAS&#039;,pd.capacity_kb/div_by,0)) bsas_capacity,
SUM(DECODE(pd.disk_type,&#039;SATA&#039;,1,0)) sata_count,
SUM(DECODE(pd.disk_type,&#039;SATA&#039;,pd.capacity_kb/div_by,0)) sata_capacity,
SUM(DECODE(pd.disk_type,&#039;NL SAS&#039;,1,0)) nlsas_count,
SUM(DECODE(pd.disk_type,&#039;NL SAS&#039;,pd.capacity_kb/div_by,0)) nlsas_capacity,
SUM(DECODE(pd.disk_type,&#039;Unknown&#039;,1,0)) unknown_count,
SUM(DECODE(pd.disk_type,&#039;Unknown&#039;,pd.capacity_kb/div_by,0)) unknown_capacity,
SUM(DECODE(pd.disk_type,&#039;SATA SSD&#039;,1,0)) satassd_count,
SUM(DECODE(pd.disk_type,&#039;SATA SSD&#039;,pd.capacity_kb/div_by,0)) satassd_capacity
FROM aps_v_pdev pd, aps_v_storage_array sa, var
WHERE 
sa.storage_array_id IN (${arrays})
AND sa.storage_array_id = pd.storage_array_id
GROUP BY 
sa.storage_array_id,
sa.array_name,
sa.array_family</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
