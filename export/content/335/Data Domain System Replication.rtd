  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>descriptiveName</string>
            <string>Data Domain System Replication</string>
          </entry>
          <entry>
            <string>drilldown</string>
            <boolean>false</boolean>
          </entry>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 08/06/2015
WITH 
var AS (
SELECT
DECODE(&#039;${freeCombo1}&#039;,
&#039;KB&#039;,1,&#039;MB&#039;,(1024),&#039;GB&#039;,(1024*1024),&#039;TB&#039;,(1024*1024*1024),&#039;PB&#039;,(1024*1024*1024*1024)) div_by 
FROM dual
)
SELECT
r.host_id,
h.host_name,
r.context_number,	
r.connection_time,
--r.source_directory,
r.dest_directory,
r.pre_comp_sent_kb/div_by pre_comp_sent,
r.pre_comp_remaining_kb/div_by pre_comp_remaining,
r.post_comp_sent_kb/div_by post_comp_sent,
r.post_comp_received_kb/div_by post_comp_received,
r.replication_throttle/1000 throttle_mbsec,
r.synced_of_time,
TO_DATE(r.synced_of_time,&#039;MON DD, YYYY HH:MIAM&#039;) synced_of_date,
r.state,
r.error,
r.last_updated-TO_DATE(r.synced_of_time,&#039;MON DD, YYYY HH:MIAM&#039;) sync_lag,
r.last_updated
FROM apt_v_ddm_system_replication r, aps_v_host h, var
WHERE r.last_updated BETWEEN ${startDate} AND ${endDate}
AND r.host_id = h.host_id
AND r.host_id IN (${hosts})</string>
          </entry>
          <entry>
            <string>postReportInterceptor</string>
            <null/>
          </entry>
