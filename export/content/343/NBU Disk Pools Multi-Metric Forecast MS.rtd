          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 07/27/2018
--Forecasting Framework
WITH 
var AS (
SELECT
DECODE(&#039;${freeCombo1}&#039;,&#039;KB&#039;,1,&#039;MB&#039;,1024,&#039;GB&#039;,(1024*1024),&#039;TB&#039;,(1024*1024*1024),&#039;PB&#039;,(1024*1024*1024*1024)) div_by 
FROM dual
),
--
--For each entry in the log, put here
-- NOTE: Substitute log_date as the_date and xxxxx_id as the_id and xxxxxx_value as the_value
f0 AS (-- Forecasting begins here. First, get 1 entry per day
SELECT --Forecasting NBU Disk Volumes
TRUNC(l.log_date) the_date,
l.management_server_id the_id_1, 
l.disk_pool_id the_id_2,
MAX(l.free_space_kb/div_by) the_value
FROM
apt_v_nbu_disk_volume_log l, var
WHERE l.log_date BETWEEN ${startDate} AND ${endDate}
AND l.management_server_id IN (${hosts})
GROUP BY
TRUNC(l.log_date),
l.management_server_id, 
l.disk_pool_id
),
--
--Everything from here down is calculated for you nothing else to do
--Except any final joins at the very end to pull in additional columns
--
f1 AS (--This step provides the row number needed to make the REGR_SLOPE() function to work properly
SELECT
the_date,
ROW_NUMBER() OVER (PARTITION BY the_id_1, the_id_2 ORDER BY the_id_1, the_id_2) row_number,
the_id_1,
the_id_2,
the_value
FROM f0
ORDER BY the_id_1,
the_id_2, the_date
),
f2 AS (--This is the actual code block for calculating trends
SELECT DISTINCT
the_id_1, 
the_id_2,
COUNT(*) OVER (PARTITION BY the_id_1, the_id_2) nbr_of_days,
SUM(the_value) OVER (PARTITION BY the_id_1, the_id_2) sum_of_the_value,
FIRST_VALUE(the_date) OVER (PARTITION BY the_id_1, the_id_2 ORDER BY the_date ASC) first_date, 
FIRST_VALUE(the_date) OVER (PARTITION BY the_id_1, the_id_2 ORDER BY the_date DESC) last_date,
FIRST_VALUE(the_value) OVER (PARTITION BY the_id_1, the_id_2 ORDER BY the_date ASC) first_value, 
FIRST_VALUE(the_value) OVER (PARTITION BY the_id_1, the_id_2 ORDER BY the_date DESC) last_value,
REGR_SLOPE(the_value, row_number) OVER (PARTITION BY the_id_1, the_id_2) the_value_lin,
(FIRST_VALUE(the_value) OVER (PARTITION BY the_id_1, the_id_2 ORDER BY the_date DESC) - 
FIRST_VALUE(the_value) OVER (PARTITION BY the_id_1, the_id_2 ORDER BY the_date ASC)) /
NULLIF(COUNT(*) OVER (PARTITION BY the_id_1, the_id_2),0) the_value_pop
FROM f1
ORDER BY the_id_1, the_id_2
),
f3 AS (--Format the results of the forecast 
SELECT
f2.the_id_1,
f2.the_id_2,
f2.first_date, 
f2.last_date,
f2.first_value, 
f2.last_value,
f2.nbr_of_days,
f2.the_value_lin,
f2.sum_of_the_value,
CASE 
  WHEN f2.the_value_lin &lt; 0 
    THEN (f2.last_value/NULLIF(ABS(f2.the_value_lin),0)) 
  WHEN f2.the_value_lin &gt;= 0 
    THEN 9999
END days_left_lin,
CASE 
WHEN f2.the_value_lin &lt; 0
THEN
  CASE --only show a run out date if less than 3 years from now
    WHEN  (f2.last_value/NULLIF(ABS(f2.the_value_lin),0)) &gt; 1095
    THEN &#039;Will Last Over 3 Years&#039;
    WHEN  (f2.last_value/NULLIF(ABS(f2.the_value_lin),0)) &lt; 1095
    THEN &#039;Will Run Out on &#039;|| ((f2.last_value/NULLIF(ABS(f2.the_value_lin),0)) + sysdate) 
  END
WHEN f2.the_value_lin = 0 
THEN &#039;Capacity not Changing&#039;
WHEN f2.the_value_lin &gt; 0 
THEN &#039;Capacity is Increasing&#039;
END lin_run_out_date,
f2.the_value_pop,
CASE 
  WHEN f2.the_value_pop &lt; 0 --Capacity is Decreasing 
    THEN (f2.last_value/NULLIF(ABS(f2.the_value_pop),0)) 
  WHEN f2.the_value_pop &gt;= 0 
    THEN 9999
END days_left_pop,
CASE 
WHEN f2.the_value_lin &lt; 0
THEN
  CASE --only show a run out date if less than 3 years from now
    WHEN  (f2.last_value/NULLIF(ABS(f2.the_value_pop),0)) &gt; 1095
    THEN &#039;Will Last Over 3 Years&#039;
    WHEN  (f2.last_value/NULLIF(ABS(f2.the_value_pop),0)) &lt; 1095
    THEN &#039;Will Run Out on &#039;|| ((f2.last_value/NULLIF(ABS(f2.the_value_pop),0)) + sysdate) 
  END
WHEN f2.the_value_lin = 0 
THEN &#039;Capacity not Changing&#039;
WHEN f2.the_value_lin &gt; 0 
THEN &#039;Capacity is Increasing&#039;
END pop_run_out_date
FROM f2, var
),
--Forecasting ends here
s1 AS (-- Generate sparklines
SELECT
f1.the_id_1,
f1.the_id_2,
rtd.collectString(CAST(COLLECT(TO_CHAR(ROUND(the_value,2)) ORDER BY the_date) AS StringListType),&#039;, &#039;) the_spk
FROM f1
GROUP BY 
f1.the_id_1,
f1.the_id_2
),-- END Sparklines
t1 AS (
SELECT
f3.the_id_1,
s.display_name,
f3.the_id_2,
ndp.disk_pool_name,
s1.the_spk,
f3.first_date, 
f3.last_date,
f3.nbr_of_days,
f3.sum_of_the_value/NULLIF(f3.nbr_of_days,0) avg_avail,
f3.first_value, 
f3.last_value,
(f3.last_value - f3.first_value) avail_delta, 
(f3.last_value - f3.first_value)/NULLIF(f3.first_value,0)*100 avail_delta_pct,
f3.the_value_lin,
f3.the_value_pop,
f3.the_value_lin/NULLIF((f3.sum_of_the_value/f3.nbr_of_days),0)*100 the_value_lin_pct,
f3.the_value_pop/NULLIF((f3.sum_of_the_value/f3.nbr_of_days),0)*100 the_value_pop_pct,
CASE 
WHEN (f3.last_value - f3.first_value) &lt; 0 THEN &#039;Decreased&#039;
WHEN (f3.last_value - f3.first_value) = 0 THEN &#039;Did Not Change&#039;
WHEN (f3.last_value - f3.first_value) &gt; 0 THEN &#039;Increased&#039;
END usage_name,
NVL(f3.days_left_lin,9999) days_left_lin,
f3.lin_run_out_date,
NVL(f3.days_left_pop,9999) days_left_pop,
f3.pop_run_out_date
FROM f3, s1, apt_v_nbu_disk_pool ndp, apt_v_server s
WHERE f3.the_id_1 = s1.the_id_1
AND f3.the_id_2 = s1.the_id_2
AND f3.the_id_1 = s.server_id
AND f3.the_id_2 = ndp.disk_pool_id
)
SELECT DISTINCT * 
FROM t1
WHERE 
usage_name LIKE DECODE(&#039;${freeCombo2}&#039;,&#039;All&#039;,&#039;%&#039;,&#039;${freeCombo2}&#039;)
AND nbr_of_days &gt;= ${freeCombo3}
ORDER BY NVL(days_left_pop,0) ASC</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
    <entry>
      <string>authorUserId</string>
      <long>101461</long>
    </entry>
    <entry>
