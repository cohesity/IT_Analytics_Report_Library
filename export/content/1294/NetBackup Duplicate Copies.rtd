          <entry>
            <string>designerScript</string>
            <null/>
          </entry>
          <entry>
            <string>dataSource</string>
            <string>-- Total Clients participating in Duplication Jobs for the given time frame&#xd;
WITH t1 AS (&#xd;
SELECT TRUNC(finish_date) finish_date,&#xd;
       COUNT(DISTINCT(target_client_id)) original_backups,&#xd;
       SUM(nbr_of_copies) total_duplication_images&#xd;
FROM apt_v_nbu_duplication_job&#xd;
WHERE finish_date BETWEEN ${startDate} AND ${endDate}&#xd;
  AND target_client_id IN (${hosts})&#xd;
  AND summary_status=0&#xd;
GROUP BY TRUNC(finish_date)&#xd;
)&#xd;
&#xd;
SELECT finish_date,&#xd;
       total_duplication_images - original_backups total_duplication_images_bar,   &#xd;
       ROUND((total_duplication_images - original_backups)/total_duplication_images * 100) pct_of_extra_backup_copies_bar, &#xd;
       total_duplication_images - original_backups,&#xd;
       ROUND((total_duplication_images - original_backups)/total_duplication_images * 100),&#xd;
       TO_CHAR(finish_date,&apos;DD-MON-YYYY&apos;) start_date_char &#xd;
FROM t1&#xd;
ORDER BY finish_date</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
