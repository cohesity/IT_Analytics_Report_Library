                <name>timePeriod</name>
                <componentScript>
                  <before/>
                  <after/>
                </componentScript>
                <referenceData/>
              </com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
              <com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
                <name>freeCombo</name>
                <componentScript>
                  <before/>
                  <after/>
                </componentScript>
                <configuration>
                  <entry>
                    <string>freeComboValues1</string>
                    <string>Minute,Hour,Day,Week,Month,Quarter,Year</string>
                  </entry>
                  <entry>
                    <string>freeComboValues2</string>
                    <string>KB,MB,GB,TB,PB</string>
                  </entry>
                  <entry>
                    <string>freeComboHeading1</string>
                    <string>Group by:</string>
                  </entry>
                  <entry>
                    <string>freeComboHeading2</string>
                    <string>Values in:</string>
                  </entry>
                </configuration>
                <referenceData/>
              </com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
              <com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
                <name>freeQueryCombo</name>
                <componentScript>
                  <before/>
                  <after/>
                </componentScript>
                <configuration>
                  <entry>
                    <string>sql</string>
                    <string>SELECT &#039; All&#039; key, &#039; All&#039; value FROM dual UNION SELECT display_name key, display_name value FROM apt_v_server s, apt_v_avm_axion_system av WHERE s.server_id = av.master_server_id</string>
                  </entry>
                  <entry>
                    <string>queryComboValues1</string>
                    <string>SELECT &#039; All&#039; key, &#039; All&#039; value FROM dual UNION SELECT display_name key, display_name value FROM apt_v_server s, apt_v_avm_axion_system av WHERE s.server_id = av.master_server_id</string>
                  </entry>
                  <entry>
                    <string>queryComboHeading1</string>
                    <string>Avamar Server:</string>
                  </entry>
                </configuration>
                <referenceData/>
              </com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
            </list>
          </entry>
