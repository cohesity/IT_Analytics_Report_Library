          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 01/07/2019
WITH 
gc AS (
SELECT 
ac.master_server_id, 
agm.avm_group_id, 
COUNT(agm.avm_group_id) client_count 
FROM 
apt_v_avm_group_members agm, apt_v_avm_clients ac
WHERE 
agm.client_id = ac.client_id 
AND ac.client_id IN (${hosts})
GROUP BY 
ac.master_server_id, 
agm.avm_group_id
) 
SELECT
gc.master_server_id,
avg.gsan_system_id, 
avg.gsan_system_name, 
avg.group_name, 
gc.client_count,
avg.avm_group_id, 
avg.avm_domain_id, 
avg.dataset_id, 
avd.dataset_name,
avg.retention_policy_id, 
avrp.retention_policy_name, 
avg.schedule_id, 
avs.schedule_name,
avg.created_date, 
avg.modified_date, 
avg.priority,
avg.is_enabled, 
avg.is_failed_stop,  
avg.is_read_only, 
avg.is_run_once, 
avg.is_skip_next, 
avg.retry_count,
avg.target_dpn, 
avg.timeout_min
FROM apt_v_avm_groups avg, apt_v_avm_datasets avd, apt_v_avm_schedules avs, apt_v_avm_retention_policies avrp, gc
WHERE avg.dataset_id = avd.dataset_id
AND avg.schedule_id = avs.schedule_id
AND avg.retention_policy_id = avrp.retention_policy_id
AND avg.avm_group_id = gc.avm_group_id (+)</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
