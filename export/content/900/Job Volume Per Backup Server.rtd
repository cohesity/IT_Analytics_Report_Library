          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 05/19/2012
--Job volume per backup master server
--Note: Key&apos;s off of the server_id rather than the client_id.
--Also plot max and average on a separate axis when mixing lines and bars on the same chart
--otherwise the average line will appear along the top instead of the center.
WITH 
t1 AS (
SELECT 
server_name,
ROUND(SUM(kilobytes/1024/1024/1024),2) job_size_tb
FROM apt_v_job
WHERE server_id IN (${hosts})
AND finish_date BETWEEN ${startDate} AND ${endDate}
AND &apos;${freeCombo1}&apos; IN 
  CASE 
    WHEN &apos;${freeCombo1}&apos; NOT IN (&apos;All&apos;) THEN
      CASE
        WHEN job_type_name like &apos;Full%&apos; THEN &apos;Full&apos;
        WHEN job_type_name like &apos;Incr%&apos; THEN &apos;Incremental&apos;
        WHEN job_type_name not like &apos;Incr%&apos; AND job_type_name not like &apos;Full%&apos; THEN &apos;Other&apos;
      END
   ELSE &apos;All&apos;
 END
GROUP BY server_name
),
t2 AS ( 
SELECT 
ROUND(MAX(job_size_tb),2) max_job_size_tb,
ROUND(AVG(job_size_tb),2) avg_job_size_tb
FROM t1
)
SELECT
t1.server_name,
t1.job_size_tb,
t2.max_job_size_tb,
t2.avg_job_size_tb
FROM t1,t2
ORDER BY 2 DESC</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
