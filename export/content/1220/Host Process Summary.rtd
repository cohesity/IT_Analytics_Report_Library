          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 06/19/2018
WITH
VAR AS (
SELECT
ROUND((${endDate} - ${startDate}),2) nbrOfDays, 
${startDate} startDate, 
DECODE(&apos;${freeCombo1}&apos;, &apos;KB&apos;,1,&apos;MB&apos;,1024,&apos;GB&apos;,(1024*1024),&apos;TB&apos;,(1024*1024*1024),&apos;PB&apos;,(1024*1024*1024*1024)) div_by 
FROM apt_v_dual 
)
SELECT
server_id,
external_name,
process_name,
process_owner,
COUNT(*) nbr_of_samples,
AVG(virtual_memory_size_kb/div_by) avg_memory,
MAX(virtual_memory_size_kb/div_by) max_memory,
AVG(cpu_usage_pct) avg_cpu_pct,
MAX(cpu_usage_pct) max_cpu_pct,
MAX(log_date) last_poll
FROM apt_v_host_process_log l, var
WHERE server_id IN (${hosts})
AND log_date BETWEEN ${startDate} AND ${endDate}
GROUP BY
server_id,
external_name,
process_name,
process_owner</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
