          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 10/27/2012
--Breakdown by Special Policy Types: Oracle,NDMP,MS-Exchange Server,MS-SQL
WITH 
var AS (
SELECT
DECODE(&apos;${freeCombo2}&apos;,
&apos;KB&apos;,1,&apos;MB&apos;,1024,&apos;GB&apos;,(1024*1024),&apos;TB&apos;,(1024*1024*1024),&apos;PB&apos;,(1024*1024*1024*1024)) div_by 
FROM apt_v_dual
)
SELECT
to_char(trunc(start_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;)),&apos;YYYY/MM/DD&apos;) the_date,
ROUND(SUM(DECODE(policy_type_name,&apos;NDMP&apos;,kilobytes/var.div_by,0)),2) NDMP,
ROUND(SUM(DECODE(policy_type_name,&apos;Oracle&apos;,kilobytes/var.div_by,0)),2) Oracle,
ROUND(SUM(DECODE(policy_type_name,&apos;MS-SQL&apos;,kilobytes/var.div_by,0)),2) MS_SQL,
ROUND(SUM(DECODE(policy_type_name,&apos;MS-Exchange Server&apos;,kilobytes/var.div_by,0)),2) MS_Exchange_Server,
ROUND(SUM(CASE WHEN policy_type_name NOT IN (&apos;NDMP&apos;,&apos;Oracle&apos;,&apos;MS-SQL&apos;,&apos;MS-Exchange Server&apos;) THEN kilobytes/var.div_by ELSE 0 END),2) all_others
FROM apt_v_nbu_job_detail, var
WHERE client_id IN (${hosts})
AND start_date BETWEEN ${startDate} AND ${endDate}
GROUP BY to_char(trunc(start_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;)),&apos;YYYY/MM/DD&apos;)
ORDER BY 1</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
