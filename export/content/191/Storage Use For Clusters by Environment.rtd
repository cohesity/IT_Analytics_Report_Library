  <version>1</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>
--Author: rich.rose@aptare.com
--Last Modified: 05/10/2012
WITH 
g0 as (
SELECT max(group_id) server_group_id
FROM apt_v_group 
WHERE group_id IN (decode(&#039;${serverGroups}&#039;,&#039;&#039;,-1,&#039;${serverGroups}&#039;))
),
t1 AS (
SELECT DISTINCT logical_unit_id, host_id
FROM aps_v_storage_path
WHERE host_id IN (${hosts})         
),
t2 as (
SELECT logical_unit_id,count(distinct host_id) host_count,
min(host_id) a_host_in_the_cluster 
from t1
group by logical_unit_id
having count(distinct host_id) &gt; 1
),
t3 as (
Select DISTINCT a_host_in_the_cluster,host_count from t2
)
SELECT
rtd.getServerGroupContextById(g0.server_group_id,hs.host_id,1) server_group, 
t3.host_count,hs.* 
FROM aps_v_host_storage hs, t3, g0
WHERE t3.a_host_in_the_cluster = hs.host_id</string>
          </entry>
