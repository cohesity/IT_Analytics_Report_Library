  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--failed or no backup for last 3 days
WITH 
t_3 as (
  SELECT client_id, min(summary_status) min_status
  FROM apt_v_job
  WHERE 
  start_date BETWEEN TRUNC(SYSDATE-3) AND TRUNC(SYSDATE-2)
  AND client_id IN (${hosts})
  GROUP BY client_id
),
t_2 as (
  SELECT client_id, min(summary_status) min_status
  FROM apt_v_job
  WHERE 
  start_date BETWEEN TRUNC(SYSDATE-2) AND TRUNC(SYSDATE-1)
  AND client_id IN (${hosts})
  GROUP BY client_id
),
t_1 as (
  SELECT client_id, min(summary_status) min_status
  FROM apt_v_job
  WHERE 
  start_date BETWEEN TRUNC(SYSDATE-1) AND SYSDATE
  AND client_id IN (${hosts})
  GROUP BY client_id
),
ts as (
  SELECT s.server_id,s.display_name, 
  DECODE(t_3.min_status,2,&#039;1&#039;,null,&#039;0&#039;) three_days_ago,
  DECODE(t_2.min_status,2,&#039;1&#039;,null,&#039;0&#039;) two_days_ago,
  DECODE(t_1.min_status,2,&#039;1&#039;,null,&#039;0&#039;) Last_Night
  FROM  t_3, t_2, t_1, apt_v_server s
  WHERE s.server_id IN (${hosts})
  AND s.server_id=t_3.client_id (+)
  AND s.server_id=t_2.client_id (+) 
  AND s.server_id=t_1.client_id (+)
)
SELECT 
&#039;&lt;a href=&quot;#&quot; onclick=&quot;drilldown(&#039;&#039;../report/drillDown.mvc?systemName=displayServerDetail&amp;amp;serverId=&#039;||ts.server_id||&#039;&#039;&#039;, this, &#039;&#039;&#039;&#039; );&quot;&gt;&#039;||ts.display_name||&#039;&lt;/a&gt;&#039; Client,
  DECODE ((ts.three_days_ago+ts.two_days_ago+ts.Last_Night),
           0,&#039;No backup for 3 days&#039;,
           2,&#039;2 Failed backups in last 3 days&#039;,
           3,&#039;Failed backups 3 days in a row&#039;,
           &#039;No backup at all&#039;
         ) status
  FROM ts
  WHERE (ts.three_days_ago+ts.two_days_ago+ts.Last_Night) IS NOT NULL
  ORDER BY Upper(ts.display_name)</string>
          </entry>
