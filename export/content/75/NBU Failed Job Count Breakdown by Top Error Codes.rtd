<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 12/06/2012
SELECT
to_char(trunc(start_date,DECODE(&#039;${freeCombo1}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;)),&#039;YYYY/MM/DD&#039;) the_date,
SUM(CASE WHEN vendor_status = 2074 THEN 1 ELSE 0 END ) e2074,
SUM(CASE WHEN vendor_status = 84 THEN 1 ELSE 0 END ) e84,
SUM(CASE WHEN vendor_status = 96 THEN 1 ELSE 0 END ) e96,
SUM(CASE WHEN vendor_status = 196 THEN 1 ELSE 0 END ) e196,
SUM(CASE WHEN vendor_status = 830 THEN 1 ELSE 0 END ) e830,
SUM(CASE WHEN vendor_status = 58 THEN 1 ELSE 0 END ) e58,
SUM(CASE WHEN vendor_status = 156 THEN 1 ELSE 0 END ) e156,
SUM(CASE WHEN vendor_status = 83 THEN 1 ELSE 0 END ) e83,
SUM(CASE WHEN vendor_status = 50 THEN 1 ELSE 0 END ) e50,
SUM(CASE WHEN vendor_status = 6 THEN 1 ELSE 0 END ) e6,
SUM(CASE WHEN vendor_status = 13 THEN 1 ELSE 0 END ) e13,
SUM(CASE WHEN vendor_status NOT IN (204,84,96,196,830,58,156,83,50,6,13) THEN 1 ELSE 0 END ) all_others
FROM apt_v_nbu_job_detail
WHERE client_id IN (${hosts})
AND start_date BETWEEN ${startDate} AND ${endDate}
AND vendor_status NOT IN (0,1,150)
GROUP BY to_char(trunc(start_date,DECODE(&#039;${freeCombo1}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;)),&#039;YYYY/MM/DD&#039;)
ORDER BY 1</string>
          </entry>
