            <string>designerScript</string>
            <null/>
          </entry>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 06/27/2018
WITH 
al AS (
SELECT 
ms.node_fc_port_id, 
sp.switch_fc_port_id, 
rtd.collectString(set(cast(collect(ma.collection_alias) as StringListType)),&#039;, &#039;) alias_list,   
rtd.collectString(set(cast(collect(ms.wwn) as StringListType)),&#039;, &#039;) wwn_list
FROM 
aps_v_swi_zone_membersetting ms,  
aps_v_swi_map_zalias_zmemb   mp,
aps_v_swi_zone_member_alias  ma, 
aps_v_swi_switch_fc_port sp
WHERE 
ms.zone_member_setting_id = mp.zone_member_setting_id
AND mp.zone_member_alias_id = ma.zone_member_alias_id
AND ms.node_fc_port_id = sp.connect_node_fc_port_id
GROUP BY 
ms.node_fc_port_id,sp.switch_fc_port_id
)
SELECT
d.domain_id,
d.domain_name,
s.san_id,
s.san_name,
s.element_name san_element_name,
f.fabric_id,
f.fabric_name,
f.element_name fabrc_element_name,
b.blade_id,
b.slot_nbr,
b.vendor_equipment_type,
t.fc_port_trunk_id,
t.element_name trunk_element_name,
t.load_balance_algorithm,
sw.switch_id,
sw.element_name switch_element_name,
psw.physical_switch_id,
psw.element_name physical_switch_element_name, 
psw.operational_status switch_status,
DECODE(psw.operational_status,&#039;OK&#039;,&#039;green&#039;,&#039;red&#039;) switch_status_dot,
p.switch_fc_port_id,
p.port_nbr,
LPAD(b.slot_nbr,4,&#039;0&#039;)||&#039;-&#039;||LPAD(p.port_nbr,4,&#039;0&#039;) slot_port_number,
p.port_index,
p.element_name port_element_name,
p.vsan_identifier,
p.enabled_state,
p.speed,
p.max_speed,
p.operational_status port_status,
DECODE(p.operational_status,&#039;OK&#039;,&#039;green&#039;,&#039;red&#039;) port_status_dot,
REPLACE(n.element_name,&#039;\&quot;&#039;,&#039;&#039;) node_element_name,
np.element_name node_port_element_name,
al.alias_list,
al.wwn_list,
st.address_errors,
st.bbc_credit_zero,
st.link_failures,
st.total_crc_error_received,
st.loss_of_signal_counter,
st.loss_of_sync_counter,
st.total_encoding_out_frame_err,
(CASE WHEN NVL(st.address_errors,0) &gt; 0 THEN 1 ELSE 0 END) +
(CASE WHEN NVL(st.bbc_credit_zero,0) &gt; 0 THEN 1 ELSE 0 END) +
(CASE WHEN NVL(st.link_failures,0) &gt; 0 THEN 1 ELSE 0 END) +
(CASE WHEN NVL(st.total_crc_error_received,0) &gt; 0 THEN 1 ELSE 0 END) +
(CASE WHEN NVL(st.loss_of_signal_counter,0) &gt; 0 THEN 1 ELSE 0 END) +
(CASE WHEN NVL(st.loss_of_sync_counter,0) &gt; 0 THEN 1 ELSE 0 END) +
(CASE WHEN NVL(st.total_encoding_out_frame_err,0) &gt; 0 THEN 1 ELSE 0 END)
nbr_of_strikes,
st.last_updated
FROM 
aps_v_swi_switch_fc_port p, 
aps_v_swi_switch sw,
aps_v_swi_physical_switch psw,
aps_v_swi_fc_port_stats st,
aps_v_domain d,
aps_v_swi_san s,
aps_v_swi_fabric f,
aps_v_swi_blade b,
aps_v_swi_fc_port_trunk t,
aps_v_swi_node n,
aps_v_swi_node_fc_port np,
al
WHERE
p.physical_switch_id = psw.physical_switch_id
AND p.physical_switch_id = sw.physical_switch_id
AND p.switch_fc_port_id = st.switch_fc_port_id
AND p.domain_id = d.domain_id
AND p.san_id = s.san_id
AND p.fabric_id = f.fabric_id
AND p.blade_id = b.blade_id
AND p.fc_port_trunk_id = t.fc_port_trunk_id (+)
AND p.connect_node_id = n.node_id (+)
AND p.connect_node_fc_port_id = np.node_fc_port_id (+)
AND (NVL(st.bbc_credit_zero,0) + NVL(st.link_failures,0) + NVL(st.total_crc_error_received,0)) &gt; 
DECODE(&#039;${freeCombo1}&#039;,&#039;All Ports&#039;,-1,&#039;Only Ports with Errors&#039;,0)
AND p.switch_fc_port_id = al.switch_fc_port_id (+)
ORDER BY 41 DESC</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
