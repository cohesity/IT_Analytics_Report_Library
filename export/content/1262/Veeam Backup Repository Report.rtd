          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 12/13/2018
WITH 
var AS (
SELECT
DECODE(&apos;${freeCombo1}&apos;,&apos;KB&apos;,1,&apos;MB&apos;,1024,&apos;GB&apos;,(1024*1024),&apos;TB&apos;,(1024*1024*1024),&apos;PB&apos;,(1024*1024*1024*1024)) div_by 
FROM apt_v_dual
)
SELECT 
(CASE 
WHEN r.parent_storage_resource_id IS NULL THEN r.storage_resource_id 
ELSE r.parent_storage_resource_id 
END) AS srId, 
r.server_name, 
r.storage_resource_type,
(CASE 
WHEN r.parent_storage_resource_name IS NULL THEN r.storage_resource_name 
ELSE r.parent_storage_resource_name 
END) AS Name,
(CASE 
WHEN r.parent_storage_resource_name IS NOT NULL THEN r.storage_resource_name 
END) AS Extent, r.description, 
r.total_capacity_kb/div_by AS  total_capacity, 
r.used_capacity_kb/div_by AS  used_capacity
FROM apt_v_dp_storage_resource r, var
WHERE r.product_type = 200700 
AND r.storage_resource_type &lt;&gt; &apos;Server&apos; 
AND r.server_id IN (${hosts})</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
