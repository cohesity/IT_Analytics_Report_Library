  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 10/31/2012
--Computes the future capacity of an array based on 
--Linear Regression (Linear) Sum of squares linear algorithm y=mX+b
--This is a drill down report that can&#039;t run stand alone
--TemplateName: HDSDPPoolAvailableCapacityLinearForecastD
WITH 
d0 AS (
SELECT
DECODE(&#039;${TheGroupBy}&#039;,&#039;Day&#039;,1,&#039;Week&#039;,7,&#039;Month&#039;,31,&#039;Quarter&#039;,93,&#039;Year&#039;,365.24) nbr_of_days,
--Limit the forecasting periods to 48
CASE 
WHEN to_number(&#039;${TheForecastPeriods}&#039;) &gt; 48 THEN 48 
ELSE to_number(&#039;${TheForecastPeriods}&#039;) END forecast_periods
FROM dual
),
a0 AS (--Get all the capacity merics for each period
SELECT 
array_name,
pool_id,
TRUNC(log_date,DECODE(&#039;${TheGroupBy}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;,&#039;YY&#039;)) log_date,
ROW_NUMBER() over (PARTITION BY array_name, pool_id ORDER BY array_name, pool_id) row_number,
MAX(available_kb/1024/1024) available
FROM aps_v_hds_journal_pool_log
WHERE log_date BETWEEN ${startDate} AND ${endDate}
AND array_name = &#039;${TheArrayName}&#039;
AND pool_id = &#039;${ThePoolID}&#039;
AND pool_function = 5
GROUP BY array_name, pool_id, trunc(log_date,DECODE(&#039;${freeCombo1}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;,&#039;YY&#039;))
),
a1 AS (
SELECT 
ROWNUM period,
log_date,
available,
REGR_SLOPE(available,ROWNUM) OVER (PARTITION BY array_name) slope,
REGR_INTERCEPT(available, ROWNUM) OVER (PARTITION BY array_name) y_intercept
FROM a0
ORDER BY 1
),
p0 AS (--Find the last period so you can forecast past it
SELECT 
MAX(period) last_period,
MAX(log_date) last_date
FROM a1
)
SELECT
log_date,
round(available,2) available,
0 future_available,
period*slope+y_intercept trend_line--Future values can be determined for any period unsing this formula
FROM a1, p0
UNION ALL --Future
SELECT 
TRUNC(the_date,DECODE(&#039;${TheGroupBy}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;,&#039;YY&#039;)) log_date,
0 available,
ROUND((period+ROWNUM)*slope+y_intercept,2) future_available,
(period+ROWNUM)*slope+y_intercept trend_line
FROM a1,p0,d0, TABLE(rtd.APTlistOfDates(p0.last_date+d0.nbr_of_days,p0.last_date+(d0.forecast_periods*d0.nbr_of_days),DECODE(&#039;${TheGroupBy}&#039;,&#039;Day&#039;,11,&#039;Week&#039;,12,&#039;Month&#039;,13,&#039;Quarter&#039;,14,&#039;Year&#039;,15))) the_dates
WHERE period = p0.last_period</string>
          </entry>
