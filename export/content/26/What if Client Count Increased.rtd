<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 05/25/2012
WITH t1 as (
SELECT
DECODE(&#039;${freeCombo1}&#039;,&#039;100%&#039;,1,&#039;90%&#039;,.90,&#039;80%&#039;,.80,&#039;70%&#039;,.70,&#039;60%&#039;,.60,&#039;50%&#039;,.50,&#039;40%&#039;,.40,&#039;30%&#039;,.30,&#039;20%&#039;,.20,&#039;10%&#039;,.10) pct_increase
FROM dual
)
SELECT  to_char(finish_date,&#039;DD-MM-YYYY&#039;) Backup_Date,
count(DISTINCT client_id) client_count,
sum(kilobytes/1024/1024) volume_gb,
sum(kilobytes/1024/1024) * t1.pct_increase what_if_gb,
${freeText1} max_client
FROM apt_v_job,t1
where client_id in (${hosts})
AND finish_date BETWEEN ${startDate} AND ${endDate}
group BY to_char(finish_date,&#039;DD-MM-YYYY&#039;)</string>
          </entry>
          <entry>
            <string>designerScript</string>
            <null/>
          </entry>
