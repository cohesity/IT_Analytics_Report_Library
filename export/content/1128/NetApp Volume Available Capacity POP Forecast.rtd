          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 05/22/2014
--Computes the future capacity of an Data Domain based on 
--a Period over Period forecasting method
--SELECT DISTINCT system_name|| &apos;-&apos; ||volume_name host_key, system_name|| &apos;-&apos; ||volume_name host_value FROM aps_v_nap_volume ORDER BY 1
WITH 
d0 AS (--Convert the human readable date selection to numeric values
SELECT
DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,1,&apos;Week&apos;,7,&apos;Month&apos;,31,&apos;Quarter&apos;,93,&apos;Year&apos;,365.24) nbr_of_days,
to_number(&apos;${freeCombo2}&apos;) forecast_periods,
DECODE(&apos;${freeCombo3}&apos;,
&apos;KB&apos;,1,&apos;MB&apos;,(1024),&apos;GB&apos;,(1024*1024),&apos;TB&apos;,(1024*1024*1024),&apos;PB&apos;,(1024*1024*1024*1024)) div_by 
FROM apt_v_dual
),
a0 AS (--Get all the capacity merics for each period
SELECT 
vl.nap_volume_id,
TRUNC(vl.log_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YY&apos;)) log_date,
ROW_NUMBER() OVER (PARTITION BY vl.nap_volume_id ORDER BY vl.nap_volume_id) row_number,
ROUND(MAX((vl.total_size_kb - vl.used_size_kb)/div_by),2) available
FROM aps_v_nap_volume_log vl, aps_v_nap_volume_log v, d0 
WHERE vl.log_date BETWEEN ${startDate} AND ${endDate}
AND vl.nap_volume_id = v.nap_volume_id
AND v.system_name|| &apos;-&apos; ||v.volume_name = &apos;${queryCombo1}&apos;
GROUP BY vl.nap_volume_id,trunc(vl.log_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YY&apos;))
),
a1 AS (
SELECT 
nap_volume_id,
log_date,
row_number,
ROUND(SUM(available),2) available
FROM a0
GROUP BY nap_volume_id,log_date,row_number
),
p0 AS (--Get the first and last period number for each array &amp; pool 
SELECT
nap_volume_id,
MIN(row_number) first_period_number, --First period will always be 1
MAX(row_number) last_period_number, --Last period is the current period or last time data was collected
min(log_date) first_period_date,
MAX(log_date) last_period_date,
COUNT(log_date) period_count
FROM a1
GROUP BY 
nap_volume_id
),
pop1 AS (--Get the first and last period metrics based on the row number of the periods
SELECT
a1.nap_volume_id, 
MAX(last_period_number) nbr_of_periods,
SUM(DECODE(a1.row_number,first_period_number,a1.available,0)) first_available,
SUM(DECODE(a1.row_number,last_period_number,a1.available,0)) last_available
FROM a1,p0
WHERE a1.nap_volume_id = p0.nap_volume_id
GROUP BY a1.nap_volume_id
),
pop2 AS (--Calculate the Period Over Period Changes
SELECT
nap_volume_id, 
first_available,
last_available,
ROUND((last_available - first_available),2) pop_available_delta,
ROUND((last_available - first_available) / DECODE(nbr_of_periods,0,null,nbr_of_periods),2) pop_available_trend
FROM pop1
) 
SELECT --Plot the prior history
a1.log_date, 
a1.available,
0 future_available,
pop2.last_available - (pop2.pop_available_trend*(period_count-ROWNUM)) available_trend_line
FROM a1, p0, pop2
WHERE a1.nap_volume_id = pop2.nap_volume_id
AND a1.nap_volume_id = p0.nap_volume_id
UNION ALL --Future values
SELECT 
trunc(the_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YY&apos;)) log_date,
0 available,
pop2.last_available + (pop2.pop_available_trend * ROWNUM) future_available,
pop2.last_available + (pop2.pop_available_trend * ROWNUM) available_trend_line
FROM a1, pop2, d0, p0, TABLE(rtd.APTlistOfDates(p0.last_period_date + d0.nbr_of_days,p0.last_period_date + (d0.forecast_periods*d0.nbr_of_days),DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,11,&apos;Week&apos;,12,&apos;Month&apos;,13,&apos;Quarter&apos;,14,&apos;Year&apos;,15))) the_dates
WHERE a1.nap_volume_id = pop2.nap_volume_id
AND a1.nap_volume_id = p0.nap_volume_id
AND a1.row_number = p0.period_count --Only need the last row
ORDER BY 1</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
