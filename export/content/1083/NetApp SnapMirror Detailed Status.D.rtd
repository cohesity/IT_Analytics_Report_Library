          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 06/12/2012
SELECT
nvl(rtd.getObjectAttributeValue(src.storage_array_id,&apos;${queryCombo1}&apos;,&apos;A&apos;),&apos;Unassigned&apos;) Attribute,
sc.source_storage_system_id,
sc.source_system_name,
sc.source_volume_id,
sc.source_volume_name,
sc.source_qtree_id,
sc.source_qtree_name,
sc.destination_storage_system_id,
sc.destination_system_name,
sc.destination_volume_id,
sc.destination_volume_name,
ss.nap_snapmirror_status_id,
ss.mirror_timestamp,
DECODE(ss.summary_status,0,&apos;blue&apos;,1,&apos;yellow&apos;,2,&apos;red&apos;) summary_status,
rtd.secsToHoursMinSecs(ss.lag_time) lag_time
FROM aps_v_nap_snapmirror_status ss, aps_v_nap_snapmirror_schd sc,
aps_v_storage_array src, aps_v_storage_array dest
WHERE ss.nap_snapmirror_schd_id = sc.nap_snapmirror_schd_id
AND sc.source_storage_system_id = src.storage_array_id
AND sc.destination_storage_system_id = dest.storage_array_id
AND ss.mirror_timestamp BETWEEN ${startDate} AND ${endDate}
AND ss.summary_status = ${the_status}
AND nvl(rtd.getObjectAttributeValue(src.storage_array_id,&apos;${queryCombo1}&apos;,&apos;A&apos;),&apos;Unassigned&apos;) = &apos;${the_attribute}&apos;</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
