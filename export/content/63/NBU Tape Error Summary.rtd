<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>WITH 
t1 AS (
SELECT 
  s.server_id, s.hostname, m.tape_media_id, m.media_name, 
  mn.nbr_of_mounts, mn.nbr_of_restores,
  COUNT(DISTINCT jm.job_id) error_count,
  MIN(j.finish_date) min_finish_time,
  MAX(j.finish_date) max_finish_time
FROM apt_v_job j, apt_v_job_message_log l, apt_v_job_tape_media jm, apt_v_tape_media m, apt_v_nbu_tape_media mn, apt_v_server s
WHERE j.client_id IN (${hosts})
  AND j.finish_date BETWEEN ${startDate} AND ${endDate}
  AND j.job_id = l.job_id
  AND (Instr(l.message, &#039;media write error&#039;) &gt; 0 OR Instr(l.message, &#039;media read error&#039;) &gt; 0)
  AND j.job_id = jm.job_id
  AND jm.tape_media_id = m.tape_media_id
  AND m.tape_media_id = mn.tape_media_id
  AND j.server_id = s.server_id
GROUP BY s.server_id, s.hostname, m.tape_media_id, m.media_name, mn.nbr_of_mounts, mn.nbr_of_restores
)
SELECT
  t1.server_id, t1.hostname, t1.tape_media_id, t1.media_name, d.drive_name, t1.nbr_of_mounts,
  t1.error_count, t1.min_finish_time, t1.max_finish_time,t1.nbr_of_restores, 
COUNT(DISTINCT jm.job_id) count_events
FROM t1, apt_v_job_tape_media jm, apt_v_tape_drive d, apt_v_job j, apt_v_nbu_job jn
WHERE t1.tape_media_id = jm.tape_media_id
  AND jm.job_id = j.job_id
  AND jm.drive_id = d.drive_id(+)
  AND j.job_id  = jn.job_id
  AND j.summary_status IN (0,1)
  AND jn.expiration_date &gt;= SYSDATE
GROUP BY t1.server_id, t1.hostname, t1.tape_media_id, t1.media_name, d.drive_name, t1.nbr_of_mounts, 
  nbr_of_restores, t1.error_count, t1.min_finish_time, t1.max_finish_time
ORDER BY t1.error_count DESC, t1.server_id, Upper(t1.media_name)</string>
          </entry>
