          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@veritas.com
--Last Modified: 03/26/2020
WITH 
var AS (
SELECT 
  DECODE(&apos;${freeCombo2}&apos;,&apos;Minutes&apos;,1,&apos;Hours&apos;,1,&apos;Days&apos;,1,&apos;Weeks&apos;,7,&apos;Months&apos;,31,&apos;Quarters&apos;,93,&apos;Years&apos;,365.25) AS the_multiplier,
  TO_NUMBER(&apos;${freeCombo3}&apos;) AS forecast_periods
FROM dual
), 
c1 AS (
SELECT
  TRUNC(l.end_log_date,DECODE(&apos;${freeCombo2}&apos;,&apos;Minutes&apos;,&apos;MI&apos;,&apos;Hours&apos;,&apos;HH24&apos;,&apos;Days&apos;,&apos;DD&apos;,&apos;Weeks&apos;,&apos;WW&apos;,&apos;Months&apos;,&apos;MM&apos;,&apos;Quarters&apos;,&apos;Q&apos;,&apos;Years&apos;)) AS the_date,
  p.partition_id, 
  p.partition_name, 
  ROUND(AVG(NVL(l.avg_cpu_usage_mhz,0)/1000),2) avg_cpu_usage_ghz, --MHz converted to GHz
  ROUND(AVG(NVL(l.avg_cpu_usage_pct,0)),2) avg_cpu_usage_pct,
  ROUND(AVG(NVL(l.avg_cpu_wait_ms,0)),2) avg_cpu_wait_ms,
  ROUND(AVG(NVL(l.avg_cpu_ready_ms,0)),2) avg_cpu_ready_ms,
  ROUND(MAX(NVL(l.avg_cpu_usage_mhz,0)/1000),2) max_cpu_usage_ghz, --MHz converted to GHz
  ROUND(MAX(NVL(l.avg_cpu_usage_pct,0)),2) max_cpu_usage_pct,
  ROUND(MAX(NVL(l.avg_cpu_wait_ms,0)),2) max_cpu_wait_ms,
  ROUND(MAX(NVL(l.avg_cpu_ready_ms,0)),2) max_cpu_ready_ms
FROM 
  apt_v_vmw_perform_cpu_log l, apt_v_partition p
WHERE 
  p.partition_id IN (${vmGuests})
  AND p.partition_id = l.partition_id
  AND l.end_log_date  BETWEEN ${startDate} AND ${endDate}
  AND p.collection_status != 3
  AND p.partition_type = &apos;VM&apos;
GROUP BY 
  TRUNC(l.end_log_date,DECODE(&apos;${freeCombo2}&apos;,&apos;Minutes&apos;,&apos;MI&apos;,&apos;Hours&apos;,&apos;HH24&apos;,&apos;Days&apos;,&apos;DD&apos;,&apos;Weeks&apos;,&apos;WW&apos;,&apos;Months&apos;,&apos;MM&apos;,&apos;Quarters&apos;,&apos;Q&apos;,&apos;Years&apos;)),
  p.partition_id, 
  p.partition_name 
)
SELECT
  TO_CHAR(the_date,&apos;YYYY/MM/DD HH24:MI&apos;) the_date,
  DECODE(&apos;${freeCombo1}&apos;,
    &apos;CPU Usage (GHz)&apos;,AVG(avg_cpu_usage_ghz),
    &apos;CPU Usage%&apos;,AVG(avg_cpu_usage_pct),
    &apos;CPU Wait (ms)&apos;,AVG(avg_cpu_wait_ms),
    &apos;CPU Ready (ms)&apos;,AVG(avg_cpu_ready_ms)
  ) AS avg_the_metric,
  DECODE(&apos;${freeCombo1}&apos;,
    &apos;CPU Usage (GHz)&apos;,MAX(max_cpu_usage_ghz),
    &apos;CPU Usage%&apos;,MAX(max_cpu_usage_pct),
    &apos;CPU Wait (ms)&apos;,MAX(max_cpu_wait_ms),
    &apos;CPU Ready (ms)&apos;,MAX(max_cpu_ready_ms)
  ) AS max_the_metric
FROM 
  c1
GROUP BY
  TO_CHAR(the_date,&apos;YYYY/MM/DD HH24:MI&apos;)
ORDER BY 
  the_date</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
