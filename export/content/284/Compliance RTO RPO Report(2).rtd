<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>descriptiveName</string>
            <string>Compliance RTO RPO Report</string>
          </entry>
          <entry>
            <string>drilldown</string>
            <boolean>false</boolean>
          </entry>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 06/24/2014
WITH
VAR AS (
SELECT
ROUND((${endDate} - ${startDate}),2) nbrOfDays,
${startDate} startDate,
DECODE(&#039;${freeCombo1}&#039;,
&#039;KB&#039;,1,&#039;MB&#039;,1024,&#039;GB&#039;,(1024*1024),&#039;TB&#039;,(1024*1024*1024),&#039;PB&#039;,(1024*1024*1024*1024)) div_by 
FROM dual
),
c0 AS (--Get all the servers in the group, rely on this list in case they never had a job
SELECT DISTINCT
server_id client_id,
display_name client_name
FROM apt_v_server
WHERE server_id IN (${hosts})
),
f0 AS (
SELECT
j.client_id,
MAX(j.job_id) last_full_job_id
FROM apt_v_job j
WHERE j.client_id IN (${hosts})
AND j.finish_date BETWEEN ${startDate} AND ${endDate}
AND j.job_type = 101
AND j.summary_status = 0
AND j.kilobytes &gt; 0 --Eliminate NBU Parent Jobs
GROUP BY j.client_id
),
f1 AS (--Go back and grab all the details of the last job
SELECT
f0.last_full_job_id,
f0.client_id,
j.job_type_name,
j.vendor_status,
j.vendor_status_name,
j.vendor_state_name,
j.vendor_state,
j.start_date,
j.finish_date fb_finish,
j.kilobytes/var.div_by fb_size,
j.duration_secs fb_dura,
j.product_type,
j.product_type_name
FROM apt_v_job j, f0, var
WHERE j.job_id = f0.last_full_job_id
),
i1 AS (--Add up all the incrementals in case there was no full
SELECT
j.client_id,
COUNT(j.job_id) ib_count,
SUM(j.kilobytes/var.div_by) ib_size,
SUM(j.duration_secs) ib_dura,
AVG(j.mbytes_sec) ib_avg_throughput,
MAX(j.finish_date) ib_finish
FROM apt_v_job j, var
WHERE j.client_id IN (${hosts})
AND j.finish_date BETWEEN ${startDate} AND ${endDate}
AND j.job_type = 102
AND j.summary_status = 0
GROUP BY j.client_id
),
i2 AS (--Add up all the incrementals after the last full
SELECT
j.client_id,
COUNT(j.job_id) ib_count,
SUM(j.kilobytes/var.div_by) ib_size,
SUM(j.duration_secs) ib_dura,
AVG(j.mbytes_sec) ib_avg_throughput,
MAX(j.finish_date) ib_finish
FROM apt_v_job j, f0, var
WHERE j.client_id = f0.client_id
AND j.job_id &gt; f0.last_full_job_id
AND j.finish_date BETWEEN ${startDate} AND ${endDate}
AND j.job_type = 102
AND j.summary_status = 0
GROUP BY j.client_id
)
SELECT 
CASE 
WHEN (f1.fb_dura/60/60) &gt;= ${freeCombo2} THEN &#039;red&#039;
WHEN f1.fb_finish IS NULL THEN &#039;red&#039;
ELSE &#039;green&#039;
END status_based_on_last_f, 
CASE WHEN
(f1.fb_dura/60/60) + (i2.ib_dura/60/60) &gt;= ${freeCombo2} THEN &#039;red&#039;
WHEN f1.fb_finish IS NULL THEN &#039;red&#039;
ELSE &#039;green&#039;
END status_based_on_last_f_and_i, 
c0.client_id,
c0.client_name,
f1.last_full_job_id,
CASE 
WHEN f1.fb_finish IS NULL AND i1.ib_finish IS NULL THEN &#039;&lt;font color=red&gt;No Backups!&lt;/font&gt;&#039;
WHEN f1.fb_finish IS NULL AND i1.ib_finish IS NOT NULL THEN &#039;&lt;font color=red&gt;Incr Only &lt;br&gt;No Full!&lt;/font&gt;&#039;
WHEN f1.fb_finish IS NOT NULL AND i2.ib_finish IS NULL THEN &#039;Full Only&#039;
WHEN f1.fb_finish IS NOT NULL AND i2.ib_finish IS NOT NULL THEN &#039;Full+Incr&#039;
END restore_plan,
to_char(f1.fb_finish,&#039;MM/DD/YYYY HH:mi AM&#039;) fb_finish, 
f1.fb_size,
f1.fb_dura fb_dura_secs,
f1.fb_dura/60/60 fb_dura_hrs,
rtd.secsToHoursMinSecs(f1.fb_dura) fb_duration,
TO_CHAR(i2.ib_finish,&#039;MM/DD/YYYY HH:mi AM&#039;) ib_finish2,
i2.ib_count ib_count2,
i2.ib_size ib_size2,
i2.ib_dura ib_dura2,
rtd.secsToHoursMinSecs(i2.ib_dura) ib_duration2,
(i2.ib_dura/60/60) hrs_of_incrementals2,
TO_CHAR(i1.ib_finish,&#039;MM/DD/YYYY HH:mi AM&#039;) ib_finish1,
i1.ib_count ib_count1,
i1.ib_size ib_size1,
i1.ib_dura ib_dura_secs1,
i1.ib_dura/60/60 ib_dura_hrs1,
rtd.secsToHoursMinSecs(i1.ib_dura) ib_duration1,
TO_CHAR(sysdate+NVL((f1.fb_dura/60/60),0)+NVL((i2.ib_dura/60/60),0),&#039;MM/DD/YYYY HH:mi AM&#039;) earliest_recovery,
(sysdate - f1.fb_finish)*24 hrs_since_last_full,
--
CASE 
WHEN f1.fb_finish IS NULL AND i1.ib_finish IS NULL THEN &#039;No full backup to restore from!&#039;
ELSE
&#039;It has been &#039;||TO_CHAR((sysdate - f1.fb_finish)*24,&#039;999,999.99&#039;)||&#039; Hrs since the last full backup&#039;
END status_msg_f,
--
CASE 
WHEN f1.fb_finish IS NULL AND i1.ib_finish IS NULL THEN 
&#039;No backups to restore from!&#039;
WHEN f1.fb_finish IS NOT NULL AND i1.ib_finish IS NOT NULL THEN 
&#039;It has been &#039;||TO_CHAR((sysdate - f1.fb_finish)*24,&#039;999,999.99&#039;)||&#039; Hrs since the last full backup which will take a minimum of &#039;||rtd.secsToHoursMinSecs(f1.fb_dura)||&#039; to restore, plus a minimum of &#039;||rtd.secsToHoursMinSecs(i2.ib_dura)||&#039; to apply the incrementals&#039; 
WHEN f1.fb_finish IS NOT NULL AND i1.ib_finish IS NULL THEN 
&#039;It has been &#039;||TO_CHAR((sysdate - f1.fb_finish)*24,&#039;999,999.99&#039;)||&#039; Hrs since the last full backup which will take a minimum of &#039;||rtd.secsToHoursMinSecs(f1.fb_dura)||&#039; to restore&#039; 
END status_msg_f_i,
TO_CHAR(GREATEST(f1.fb_finish,i2.ib_finish),&#039;MM/DD/YYYY HH:mi AM&#039;) recovery_point,
rtd.secsToHoursMinSecs(((sysdate+NVL((f1.fb_dura/60/60),0)+NVL((i2.ib_dura/60/60),0)) - (GREATEST(f1.fb_finish,i2.ib_finish)))*24*60*60) lost_time
FROM f1, i1, i2, c0 
WHERE
c0.client_id = f1.client_id (+) 
AND c0.client_id = i1.client_id (+)
AND c0.client_id = i2.client_id (+)

</string>
          </entry>
