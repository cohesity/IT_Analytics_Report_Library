          <entry>
            <string>dataSource</string>
            <string>SELECT
s.server_type_name,
po.server_id,	
po.server_name,
po.server_instance_id,	
po.server_instance_name,
po.object_type,	
po.policy_id,	
po.policy_name,	
po.object_name,	
po.protected_object_identifier,
po.host_id,
po.host_name,	
po.object_path_name,	
po.is_excluded,	
po.creation_date,	
po.last_updated
FROM apt_v_dp_protected_object po, apt_v_server s
WHERE 
po.server_id IN (${hosts})
AND po.server_id = s.server_id
AND UPPER(s.server_type_name) LIKE &apos;%VEEAM%&apos;
AND po.last_updated BETWEEN ${startDate} AND ${endDate}</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
