        <data>
          <entry>
            <string>dataSource</string>
            <string>
--Author: rich.rose@aptare.com
--Last Modified: 05/10/2012
SELECT
gsan_system_id, 
gsan_system_name, 
schedule_id, 
avm_domain_id, 
schedule_name, 
is_enabled, 
is_link, 
is_override_endtime, 
is_read_only, 
is_fixed_interval, 
interval_mod, 
parent_schedule_id, 
first_start_date, 
last_check_date, 
last_start_date, 
start_duration, 
start_date, 
end_date, 
recurrence_counter, 
recurrence_interval, 
time_zone_id, 
total_duration
end_policy, 
end_recurrence, 
description 
FROM apt_v_avm_schedules</string>
          </entry>
