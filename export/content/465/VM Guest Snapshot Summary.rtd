          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@veritas.com
--Last Updated: 05/11/2020
WITH 
VAR AS (
SELECT
  ROUND((${endDate} - ${startDate}),2) nbrOfDays,
  ${startDate} startDate,
  DECODE(&apos;${freeCombo1}&apos;,
  &apos;KB&apos;,1,&apos;MB&apos;,1024,&apos;GB&apos;,(1024*1024),&apos;TB&apos;,(1024*1024*1024),&apos;PB&apos;,(1024*1024*1024*1024)) div_by,
  &apos;${freeCombo1}&apos; the_unit 
FROM 
  dual
),
t1 AS (
SELECT 
  vs.virtual_system_id AS vm_host_id,
  vs.virtual_system_name AS vm_host_name,
  pt.partition_id AS vm_id,
  pt.partition_name AS vm_name,
  h.host_id,
  h.display_name AS host_name,
  ds.vmw_datastore_id,
  ds.datastore_name,
  df.file_name,
  st.full_snapshot_name||&apos; (&apos;||st.short_snapshot_name||&apos;)&apos; AS snapshot_name,
  df.size_kb/div_by AS df_size,
  st.create_date,
  (sysdate - create_date) AS age
FROM 
  var,
  apt_v_vmw_vmsnapshot_tree st,
  apt_v_vmw_map_snapshot_file mp,
  apt_v_vmw_datastore_file df,
  apt_v_vmw_datastore ds,
  apt_v_virtual_system vs,
  apt_v_partition pt,
  aps_v_host h
WHERE 
  pt.host_id IN (${hosts})
  AND pt.host_id = h.host_id
  AND pt.partition_id= st.partition_id
  AND st.vmw_snapshot_id= mp.vmw_snapshot_id
  AND mp.vmw_datastore_file_id= df.vmw_datastore_file_id
  AND df.vmw_datastore_id = ds.vmw_datastore_id
  AND st.virtual_system_id = vs.virtual_system_id
  AND vs.collection_status != 3
  AND st.create_date BETWEEN ${startDate} AND ${endDate}
ORDER BY 
  df.file_name, st.create_date
)
SELECT 
  vm_host_id,
  vm_host_name,
  vm_id,
  vm_name,
  host_id,
  host_name,
  vmw_datastore_id,
  datastore_name,
  REPLACE(aptStringConcat(file_name),&apos;,&apos;,&apos;&lt;br&gt;&apos;) files,
  snapshot_name,
  SUM(df_size) AS df_size,
  create_date,
  age
FROM 
  t1
GROUP BY
  vm_host_id,
  vm_host_name,
  vm_id,
  vm_name,
  host_id,
  host_name,
  vmw_datastore_id,
  datastore_name,
  snapshot_name,
  create_date,
  age
ORDER BY 
  UPPER(vm_name)</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
