          <entry>
            <string>designerScript</string>
            <null/>
          </entry>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 07/29/2015
WITH 
var AS (
SELECT
&apos;${freeCombo2}&apos; unit,
DECODE(&apos;${freeCombo2}&apos;,&apos;KB&apos;,1,&apos;MB&apos;,1024,&apos;GB&apos;,(1024*1024),&apos;TB&apos;,(1024*1024*1024),&apos;PB&apos;,(1024*1024*1024*1024)) div_by 
FROM apt_v_dual
)
SELECT
unit,
to_char(trunc(end_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Minute&apos;,&apos;MI&apos;,&apos;Hour&apos;,&apos;HH24&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YY&apos;)),&apos;MM/DD/YYYY HH24:MI&apos;) the_date,
to_char(trunc(end_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Minute&apos;,&apos;MI&apos;,&apos;Hour&apos;,&apos;HH24&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YY&apos;)),&apos;YYYYMMDDHH24MI&apos;) sort_order,
ROUND(SUM(elapsed_minutes/60/60),2) elapsed_hrs,--actually stored in seconds
ROUND(SUM((recovered_bytes)/div_by),2) recovered --actually stored in KB
FROM apt_v_avm_gc_status gc, apt_v_server s, var
WHERE 
end_date BETWEEN ${startDate} AND ${endDate}
AND s.server_id = gc.master_server_id
AND s.display_name LIKE DECODE(&apos;${queryCombo1}&apos;,&apos; All&apos;,&apos;%&apos;,&apos;${queryCombo1}&apos;)
GROUP BY
unit,
to_char(trunc(end_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Minute&apos;,&apos;MI&apos;,&apos;Hour&apos;,&apos;HH24&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YY&apos;)),&apos;MM/DD/YYYY HH24:MI&apos;),
to_char(trunc(end_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Minute&apos;,&apos;MI&apos;,&apos;Hour&apos;,&apos;HH24&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YY&apos;)),&apos;YYYYMMDDHH24MI&apos;)
ORDER BY 3</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
