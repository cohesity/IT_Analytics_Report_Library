                  </entry>
                </configuration>
                <referenceData/>
              </com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
              <com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
                <name>freeQueryCombo</name>
                <componentScript>
                  <before/>
                  <after/>
                </componentScript>
                <configuration>
                  <entry>
                    <string>queryComboValues1</string>
                    <string>SELECT &apos; All&apos; key, &apos; All&apos; value FROM apt_v_dual UNION SELECT display_name key, display_name value FROM apt_v_server s, apt_v_avm_axion_system av WHERE s.server_id = av.master_server_id</string>
                  </entry>
                  <entry>
                    <string>queryComboHeading1</string>
                    <string>Avamar Server:</string>
                  </entry>
                  <entry>
                    <string>sql</string>
                    <string>SELECT &apos; All&apos; key, &apos; All&apos; value FROM apt_v_dual UNION SELECT display_name key, display_name value FROM apt_v_server s, apt_v_avm_axion_system av WHERE s.server_id = av.master_server_id</string>
                  </entry>
                </configuration>
                <referenceData/>
              </com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
            </list>
