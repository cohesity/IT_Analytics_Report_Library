  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>descriptiveName</string>
            <string>TSM Process Type Throughput Histogram</string>
          </entry>
          <entry>
            <string>drilldown</string>
            <boolean>false</boolean>
          </entry>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 10/30/2015
WITH 
avg_tpt AS (
SELECT AVG((j.kilobytes/1024) / ((j.finish_date-j.start_date)*24*60*60)) avgThroughput
  FROM apt_v_job j, apt_v_tsm_process p
  WHERE j.server_id          IN (${hosts})
    AND j.start_date         BETWEEN ${startDate} AND ${endDate}
    AND j.finish_date        IS NOT NULL
    AND j.job_id = p.job_id
    AND j.finish_date        &gt; j.start_date
    AND j.kilobytes          &gt; 1024
    AND j.summary_status     &lt;= 1
),
pol AS ( 
SELECT DISTINCT p.job_type_name
  FROM apt_v_job j, apt_v_tsm_process p
  WHERE j.server_id          IN (${hosts})
    AND j.start_date         BETWEEN ${startDate} AND ${endDate}
    AND j.job_id = p.job_id
    AND j.finish_date        IS NOT NULL
    AND j.finish_date        &gt; j.start_date
    AND j.kilobytes          &gt;1024
    AND j.summary_status     &lt;= 1
), 
jt AS (
SELECT job_type_name, the_date
  FROM pol, (SELECT the_date FROM TABLE(CAST(rtd.APTlistOfDates(${startDate}, ${endDate}, 10) AS dateListType))) d
), 
jobs AS (
SELECT jt.job_type_name, jt.the_date, 
  ROUND(NVL(SUM(j.kilobytes/1024) / (SUM(j.finish_date-j.start_date)*24*60*60),0 ) , 2) throughput
  FROM jt, apt_v_job j, apt_v_tsm_process p
  WHERE jt.job_type_name   = p.job_type_name
    AND j.client_id          IN (${hosts})
    AND j.job_id = p.job_id
    AND j.start_date         &lt;= (jt.the_date + 3599/86400)
    AND j.finish_date        &gt;= jt.the_date
    AND j.finish_date        IS NOT NULL
    AND j.finish_date        &gt; j.start_date
    AND j.kilobytes          &gt; 1024
    AND j.summary_status     &lt;= 1
    GROUP BY jt.job_type_name, jt.the_date
)   
SELECT to_char(jt.the_date,&#039;MM/DD hh:AM&#039;) the_date, jt.job_type_name,  
  CASE 
  WHEN throughput &gt; 0 AND throughput &lt;= avgThroughput-(avgThroughput*.3333) THEN
    &#039;&lt;table width=100% border=0 cellspacing=0 cellpadding=0&gt;&lt;td style=background-color:red align=right&gt;&lt;font color=white&gt;&#039;||throughput||&#039;&lt;/td&gt;&lt;/table&gt;&#039;
  WHEN throughput &gt;= avgThroughput-(avgThroughput*.3333) AND throughput &lt;= avgThroughput+(avgThroughput*.3333) THEN
    &#039;&lt;table width=100% border=0 cellspacing=0 cellpadding=0&gt;&lt;td style=background-color:yellow align=right&gt;&lt;font color=black&gt;&#039;||throughput||&#039;&lt;/td&gt;&lt;/table&gt;&#039;
  WHEN throughput &gt;= avgThroughput+(avgThroughput*.3333) THEN
    &#039;&lt;table width=100% border=0 cellspacing=0 cellpadding=0&gt;&lt;td style=background-color:green align=right&gt;&lt;font color=white&gt;&#039;||throughput||&#039;&lt;/td&gt;&lt;/table&gt;&#039;
  WHEN throughput = 0 THEN
    &#039; &#039;
  END throughput  
  FROM jt, jobs, avg_tpt 
  WHERE jt.job_type_name       = jobs.job_type_name (+)
    AND jt.the_date        = jobs.the_date (+)
  ORDER BY upper(jt.job_type_name), jt.the_date</string>
          </entry>
