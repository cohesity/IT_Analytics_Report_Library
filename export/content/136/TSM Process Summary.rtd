<com.aptare.sc.dal.versioning.ObjectMap>
  <version>1</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>SELECT i.instance_name, 
       p.process_type_name,
       p.job_type_name,
       p.process_id,
       CASE j.summary_status 
         WHEN 0 THEN &#039;&lt;font color=&quot;blue&quot;&gt;Successful&lt;/font&gt;&#039;
         WHEN 1 THEN &#039;&lt;font color=&quot;orange&quot;&gt;Partial&lt;/font&gt;&#039;
         ELSE &#039;&lt;font color=&quot;red&quot;&gt;Failed&lt;/font&gt;&#039;
       END status,
       j.start_date, j.finish_date,
       p.source_stg_pool || &#039; -&gt; &#039; || p.destination_stg_pool transaction_desc,
       j.kilobytes/1024/1024 size_GB, j.nbr_of_files,
       p.nbr_examined_objects, p.nbr_failed_objects, p.media_wait_secs,
       p.idle_secs, p.nbr_of_processes
    FROM 
         apt_v_job j,
         apt_v_tsm_process p,
         apt_v_server s,
         apt_v_server_instance i
    WHERE j.server_id IN (${hosts})
      AND j.finish_date BETWEEN ${startDate} AND ${endDate}
      AND j.job_id = p.job_id
      AND p.job_type_name LIKE DECODE(&#039;${freeCombo}&#039;,&#039;All&#039;,&#039;%&#039;,&#039;${freeCombo}&#039;)
      AND j.server_id = s.server_id
      AND p.server_instance_id = i.server_instance_id</string>
          </entry>
          <entry>
            <string>designerScript</string>
            <null/>
          </entry>
          <entry>
            <string>advancedComponents</string>
            <list/>
          </entry>
          <entry>
            <string>systemName</string>
            <null/>
          </entry>
          <entry>
            <string>supportsPagenation</string>
            <null/>
          </entry>
          <entry>
            <string>descriptiveName</string>
            <string>TSM Process Summary</string>
          </entry>
          <entry>
            <string>drilldown</string>
            <boolean>false</boolean>
          </entry>
          <entry>
            <string>postReportInterceptor</string>
            <null/>
          </entry>
          <entry>
            <string>specalisedReportBuilder</string>
            <null/>
          </entry>
          <entry>
