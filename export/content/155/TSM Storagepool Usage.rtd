      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>
--Author:rich.rose@aptare.com &#xd;
--Last Updated:08/27/2012 &#xd;
SELECT &#xd;
instance_name,&#xd;
storage_pool_type,&#xd;
device_class_name,&#xd;
class_type,&#xd;
storage_pool_name,&#xd;
est_mbyte_capacity/1024 est_capacity,&#xd;
utilization_pct,&#xd;
utilization_pct/100 pct_util&#xd;
FROM apt_v_tsm_storage_pool&#xd;
WHERE est_mbyte_capacity &gt; 0&#xd;
ORDER BY 7 DESC</string>
          </entry>
