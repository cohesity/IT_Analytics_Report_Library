<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>-- Author: rich.rose@aptare.com
-- Last Updated: 09/22/2011
-- Produces many different kinds of reports based on Legato Jobs
--
--
-- Report on: Job Size(GB),Client Count,File Count,Job Count,Successful Jobs,Partial Jobs,Failed Jobs,MB/sec,Duration(Min)
-- by: Legato Server,Client,Client Resource,Saveset,Saveset Group,Job Type,Schedule,Directive,File Paths,Client Version,Networker Version,Retention Period,Retention Period Type,Browse Period,Browse Period Type
-- per: Day,Week,Month,Quarter,Year
WITH t1 as (
SELECT trunc(lj.start_date,DECODE(&#039;${freeCombo3}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;)) the_date, 
DECODE(&#039;${freeCombo2}&#039;,
&#039;Legato Server&#039;, lj.server_name,
&#039;Client&#039;, lj.client_name,
&#039;Client Resource&#039;, lj.client_resource_name,
&#039;Saveset&#039;, lj.saveset_name,
&#039;Saveset Group&#039;, lj.saveset_group_name,
&#039;Job Type&#039;, lj.job_type_name,
&#039;Schedule&#039;, cr.schedule_name,
&#039;Directive&#039;, cr.directive_name,
&#039;File Paths&#039;, cr.file_paths,
&#039;Client Version&#039;, cr.client_software_version,
&#039;Networker Version&#039;, cr.networker_version,
&#039;Retention Period&#039;, cr.retention_period_name,
&#039;Retention Period Type&#039;, cr.retention_period_type,
&#039;Browse Period&#039;, cr.browse_period_name,
&#039;Browse Period Type&#039;, cr.browse_period_type) unit,  
trunc(sum(lj.kilobytes/1024/1024)) job_size_gb,
count(DISTINCT lj.client_id) client_count,
sum(lj.nbr_of_files) file_count,
count(DISTINCT lj.job_id) job_count,
sum(DECODE(lj.summary_status,0,1)) successful_jobs,
sum(DECODE(lj.summary_status,1,1)) partial_jobs,
sum(DECODE(lj.summary_status,2,1)) failed_jobs,
avg(j.mbytes_sec) mbytes_sec,
avg(j.duration_secs/60) duration_min
FROM apt_v_job j, apt_v_leg_job lj, apt_v_leg_client_resource cr
WHERE lj.start_date BETWEEN ${startDate} AND ${endDate}
AND lj.client_id in (${hosts})
AND lj.job_id = j.job_id
AND lj.client_resource_id = cr.client_resource_id
GROUP BY trunc(lj.start_date,DECODE(&#039;${freeCombo3}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;)),
DECODE(&#039;${freeCombo2}&#039;,
&#039;Legato Server&#039;,lj.server_name,
&#039;Client&#039;,lj.client_name,
&#039;Client Resource&#039;,lj.client_resource_name,
&#039;Saveset&#039;,lj.saveset_name,
&#039;Saveset Group&#039;,lj.saveset_group_name,
&#039;Job Type&#039;,lj.job_type_name,
&#039;Schedule&#039;,cr.schedule_name,
&#039;Directive&#039;,cr.directive_name,
&#039;File Paths&#039;,cr.file_paths,
&#039;Client Version&#039;,cr.client_software_version,
&#039;Networker Version&#039;,cr.networker_version,
&#039;Retention Period&#039;,cr.retention_period_name,
&#039;Retention Period Type&#039;,cr.retention_period_type,
&#039;Browse Period&#039;,cr.browse_period_name,
&#039;Browse Period Type&#039;,cr.browse_period_type)
) 
SELECT to_char(the_date,&#039;MM/DD/YY&#039;) the_date,
nvl(unit,&#039;Unknown&#039;) unit,
DECODE(&#039;${freeCombo1}&#039;,
&#039;Job Size(GB)&#039;,job_size_gb,
&#039;Client Count&#039;,client_count,
&#039;File Count&#039;,file_count,
&#039;Job Count&#039;,job_count,
&#039;Successful Jobs&#039;,successful_jobs,
&#039;Partial Jobs&#039;,partial_jobs,
&#039;Failed Jobs&#039;,failed_jobs,
&#039;MB/sec&#039;,mbytes_sec,
&#039;Duration(Min)&#039;,duration_min
) the_metric
FROM t1 
ORDER BY 1</string>
          </entry>
