                </componentScript>
                <configuration>
                  <entry>
                    <string>nodes</string>
                    <string>SERVERS</string>
                  </entry>
                </configuration>
                <referenceData/>
              </com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
              <com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
                <name>freeCombo</name>
                <componentScript>
                  <before/>
                  <after/>
                </componentScript>
                <configuration>
                  <entry>
                    <string>freeComboValues1</string>
                    <string>Day,Week,Month,Quarter,Year</string>
                  </entry>
                  <entry>
                    <string>freeComboValues2</string>
                    <string>GB,TB,PB</string>
                  </entry>
                  <entry>
                    <string>freeComboHeading1</string>
                    <string>Group by:  </string>
                  </entry>
                  <entry>
                    <string>freeComboHeading2</string>
                    <string>Values in:  </string>
                  </entry>
                </configuration>
                <referenceData/>
              </com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
              <com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
                <name>freeQueryCombo</name>
                <componentScript>
                  <before/>
                  <after/>
                </componentScript>
                <configuration>
                  <entry>
                    <string>sql</string>
                    <string>SELECT DISTINCT s.display_name||&#039;-&#039;||v.disk_volume_name  key, s.display_name||&#039;-&#039;||v.disk_volume_name  value  FROM apt_v_nbu_disk_volume v, apt_v_server s WHERE v.management_server_id = s.server_id ORDER BY 1</string>
                  </entry>
                  <entry>
                    <string>queryComboValues1</string>
                    <string>SELECT DISTINCT s.display_name||&#039;-&#039;||v.disk_volume_name  key, s.display_name||&#039;-&#039;||v.disk_volume_name  value  FROM apt_v_nbu_disk_volume v, apt_v_server s WHERE v.management_server_id = s.server_id ORDER BY 1</string>
                  </entry>
                  <entry>
                    <string>queryComboHeading1</string>
                    <string>Disk Volume:</string>
                  </entry>
                </configuration>
                <referenceData/>
              </com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
            </list>
          </entry>
          <entry>
            <string>composedReports</string>
