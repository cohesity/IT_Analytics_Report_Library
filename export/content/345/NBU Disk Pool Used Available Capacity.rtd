<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>descriptiveName</string>
            <string>NBU Disk Pool Used Available Capacity</string>
          </entry>
          <entry>
            <string>drilldown</string>
            <boolean>false</boolean>
          </entry>
          <entry>
            <string>dataSource</string>
            <string>WITH
var AS (
SELECT
&#039;${freeCombo2}&#039; unit,
DECODE(&#039;${freeCombo2}&#039;,&#039;KB&#039;,1,&#039;MB&#039;,1024,&#039;GB&#039;,(1024*1024),&#039;TB&#039;,(1024*1024*1024),&#039;PB&#039;,(1024*1024*1024*1024)) div_by 
FROM dual
),
t1 AS (
SELECT
to_char(trunc(vl.log_date,DECODE(&#039;${freeCombo1}&#039;,&#039;Minute&#039;,&#039;MI&#039;,&#039;Hour&#039;,&#039;HH24&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;,&#039;YY&#039;)),&#039;MM/DD/YYYY&#039;) the_date,
to_char(trunc(vl.log_date,DECODE(&#039;${freeCombo1}&#039;,&#039;Minute&#039;,&#039;MI&#039;,&#039;Hour&#039;,&#039;HH24&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;,&#039;YY&#039;)),&#039;YYYYMMDDHH24MI&#039;) sort_order,
s.display_name||&#039;-&#039;||vl.disk_volume_name server_volume, 
ROUND(MAX(vl.free_space_kb/div_by),2) free_space,
ROUND(MAX((vl.total_capacity_kb - vl.free_space_kb)/div_by),2) used_space
FROM apt_v_nbu_disk_volume_log vl, apt_v_server s, var
WHERE
vl.management_server_id IN (${hosts})
AND vl.management_server_id = s.server_id
AND vl.log_date BETWEEN ${startDate} AND  ${endDate}
AND s.display_name||&#039;-&#039;||vl.disk_volume_name = &#039;${queryCombo1}&#039;
GROUP BY 
to_char(trunc(vl.log_date,DECODE(&#039;${freeCombo1}&#039;,&#039;Minute&#039;,&#039;MI&#039;,&#039;Hour&#039;,&#039;HH24&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;,&#039;YY&#039;)),&#039;MM/DD/YYYY&#039;),
to_char(trunc(vl.log_date,DECODE(&#039;${freeCombo1}&#039;,&#039;Minute&#039;,&#039;MI&#039;,&#039;Hour&#039;,&#039;HH24&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;,&#039;YY&#039;)),&#039;YYYYMMDDHH24MI&#039;),
s.display_name||&#039;-&#039;||vl.disk_volume_name
)
SELECT
the_date,
sort_order,
server_volume,
free_space,
used_space
FROM t1, var
ORDER BY 2 DESC,3</string>
          </entry>
          <entry>
            <string>postReportInterceptor</string>
            <null/>
          </entry>
