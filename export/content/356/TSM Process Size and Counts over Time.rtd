                </componentScript>
                <configuration>
                  <entry>
                    <string>sql</string>
                    <string>SELECT DISTINCT instance_name key, instance_name value FROM apt_v_tsm_process WHERE start_date  &gt; sysdate -3 ORDER BY  UPPER(instance_name)</string>
                  </entry>
                  <entry>
                    <string>queryComboValues1</string>
                    <string>SELECT DISTINCT instance_name key, instance_name value FROM apt_v_tsm_process WHERE start_date  &gt; sysdate -3 ORDER BY  UPPER(instance_name)</string>
                  </entry>
                  <entry>
                    <string>queryComboHeading1</string>
                    <string>TSM Iinstance:</string>
                  </entry>
                </configuration>
                <referenceData/>
              </com.aptare.sc.domain.reportDesigner.ReportDesignerComponent>
