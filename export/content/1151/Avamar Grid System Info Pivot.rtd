          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 04/03/2018
WITH 
var AS (
SELECT
ROUND((${endDate} - ${startDate}),2) nbrOfDays,
DECODE(&apos;${freeCombo1}&apos;,
&apos;KB&apos;,1,&apos;MB&apos;,(1024),&apos;GB&apos;,(1024*1024),&apos;TB&apos;,(1024*1024*1024),&apos;PB&apos;,(1024*1024*1024*1024)) div_by 
FROM apt_v_dual
),
n1 AS (--Get the nodes and their capacities
SELECT
n.master_server_id,
COUNT(DISTINCT n.node_id) nodes,
REPLACE(aptStringConcat(DISTINCT version),&apos;,&apos;,&apos;&lt;br&gt;&apos;) versions,
SUM(n.total_capacity_kb/div_by) nodes_total_capacity,
SUM((n.total_capacity_kb-n.used_capacity_kb)/div_by) nodes_free_capacity,
SUM(n.used_capacity_kb/div_by) nodes_used_capacity
FROM apt_v_avm_node n, var, apt_v_server s
WHERE
n.master_server_id IN (${hosts})
AND s.server_id = n.master_server_id
GROUP BY 
n.master_server_id
),
dp AS (--Data Protected according to Avamar
SELECT
ds.master_server_id,
MAX(ds.data_protected_kb) data_protected_kb
FROM apt_v_avm_dpn_statistics ds, apt_v_server s
WHERE 
ds.master_server_id IN (${hosts})
AND s.server_id = master_server_id
GROUP BY master_server_id
),
t2 AS (--Get the highest value for each client/plugin combination
SELECT 
aa.server_id, 
aa.client_id,
aa.plugin_id,
MAX(aa.scanned_kb) scanned_kb
FROM apt_v_avm_activities aa, var, apt_v_server s
WHERE
aa.server_id IN (${hosts}) 
AND aa.scanned_kb &gt; 0
AND aa.expiration_date &gt; sysdate
AND s.server_id = aa.server_id
GROUP BY 
aa.server_id,
client_id,
plugin_id
),
t3 AS (--Add them up and this should be the &quot;Front End &quot; size of each client on the grid
SELECT 
t2.server_id master_server_id,
COUNT(DISTINCT client_id) clients,
SUM(t2.scanned_kb) scanned_kb
FROM t2
GROUP BY 
t2.server_id
), t4 AS (
SELECT 
ms.axion_system_id,
ms.gsan_system_name, 
ms.gsan_system_id, 
ms.master_server_id, 
ms.hfs_address,
ms.local_hfs_address, 
ms.hfs_port, 
ms.mcs_port, 
ms.gsan_run_level, 
DECODE(ms.gsan_run_level,&apos;up&apos;,&apos;green&apos;,&apos;degraded&apos;,&apos;yellow&apos;,&apos;red&apos;) run_level_dot,
t3.clients,
t3.scanned_kb/div_by scanned,
dp.data_protected_kb/div_by data_protected,
ROUND((dp.data_protected_kb / used_capacity_kb),1)||&apos;:1&apos; dedup_ratio,
((ms.total_capacity_kb - ms.used_capacity_kb)*(dp.data_protected_kb / ms.used_capacity_kb))/div_by est_available_capacity,
ms.total_capacity_kb/var.div_by total_capacity,
(ms.total_capacity_kb - ms.used_capacity_kb)/div_by available_capacity,
ms.used_capacity_kb/var.div_by used_capacity,  
(ms.used_capacity_kb/DECODE(ms.total_capacity_kb,0,null,ms.total_capacity_kb)) used_pct,
(ms.used_capacity_kb/DECODE(ms.total_capacity_kb,0,null,ms.total_capacity_kb))*100 pct_used,
ms.protected_bytes_quota, 
ms.license_expiration_date, 
ms.time_since_server_init, 
rtd.secsToHoursMinSecs(ms.time_since_server_init) time_since_server_init_hrs, 
ms.last_updated_in_avm, 
ms.last_checkpoint, 
ms.last_validated_checkpoint,
n1.nodes,
n1.versions,
n1.nodes_total_capacity,
n1.nodes_used_capacity, 
n1.nodes_free_capacity
FROM apt_v_avm_axion_system ms, var, n1, dp, t3, apt_v_server s
WHERE 
ms.master_server_id IN (${hosts})
AND s.server_id = ms.master_server_id
AND ms.master_server_id = n1.master_server_id
AND ms.master_server_id = dp.master_server_id(+)
AND ms.master_server_id = t3.master_server_id(+)
)
SELECT gsan_system_name, &apos;01&apos; sort_order,&apos;&lt;b&gt;Server ID Primary Key&lt;/b&gt;&apos; metric, TO_CHAR(master_server_id) value FROM t4 UNION
SELECT gsan_system_name, &apos;02&apos; sort_order,&apos;&lt;b&gt;HFS IP Address&lt;/b&gt;&apos; metric, hfs_address value FROM t4 UNION
SELECT gsan_system_name, &apos;03&apos; sort_order,&apos;&lt;b&gt;HFS Name&lt;/b&gt;&apos; metric, local_hfs_address value FROM t4 UNION
SELECT gsan_system_name, &apos;04&apos; sort_order,&apos;&lt;b&gt;HFS Port&lt;/b&gt;&apos; metric, TO_CHAR(hfs_port) value FROM t4 UNION
SELECT gsan_system_name, &apos;05&apos; sort_order,&apos;&lt;b&gt;MCS Port&lt;/b&gt;&apos; metric, TO_CHAR(mcs_port) value FROM t4 UNION 
SELECT gsan_system_name, &apos;06&apos; sort_order,&apos;&lt;b&gt;Run Level&lt;/b&gt;&apos; metric, gsan_run_level value FROM t4 UNION 
SELECT gsan_system_name, &apos;07&apos; sort_order,&apos;&lt;b&gt;Number of Clients&lt;/b&gt;&apos; metric, TO_CHAR(clients) value FROM t4 UNION 
SELECT gsan_system_name, &apos;08&apos; sort_order,&apos;&lt;b&gt;Client Front End (Scanned)&lt;/b&gt;&apos; metric, TO_CHAR(scanned,&apos;999G999G999D99&apos;)||&apos; ${freeCombo1}&apos; value FROM t4 UNION 
SELECT gsan_system_name, &apos;09&apos; sort_order,&apos;&lt;b&gt;Data Protected&lt;/b&gt;&apos; metric, TO_CHAR(data_protected,&apos;999G999G999D99&apos;)||&apos;${freeCombo1}&apos; value FROM t4 UNION 
SELECT gsan_system_name, &apos;10&apos; sort_order,&apos;&lt;b&gt;Dedup Ratio&lt;/b&gt;&apos; metric, dedup_ratio value FROM t4 UNION 
SELECT gsan_system_name, &apos;11&apos; sort_order,&apos;&lt;b&gt;Estimated Available Capacity*&lt;/b&gt;&apos; metric, TO_CHAR(est_available_capacity,&apos;999G999G999D99&apos;)||&apos; ${freeCombo1}&apos; FROM t4 UNION 
SELECT gsan_system_name, &apos;12&apos; sort_order,&apos;&lt;b&gt;Total Disk Capacity&lt;/b&gt;&apos; metric, TO_CHAR(total_capacity,&apos;999G999G999D99&apos;)||&apos; ${freeCombo1}&apos; FROM t4 UNION 
SELECT gsan_system_name, &apos;13&apos; sort_order,&apos;&lt;b&gt;Used Disk Capacity&lt;/b&gt;&apos; metric, TO_CHAR(used_capacity,&apos;999G999G999D99&apos;)||&apos; ${freeCombo1}&apos; FROM t4 UNION 
SELECT gsan_system_name, &apos;14&apos; sort_order,&apos;&lt;b&gt;Available Disk Capacity&lt;/b&gt;&apos; metric, TO_CHAR(available_capacity,&apos;999G999G999D99&apos;)||&apos; ${freeCombo1}&apos; FROM t4 UNION 
SELECT gsan_system_name, &apos;15&apos; sort_order,&apos;&lt;b&gt;Percent Used&lt;/b&gt;&apos; metric, TO_CHAR(pct_used,&apos;999D99&apos;)||&apos;%&apos; FROM t4 UNION 
SELECT gsan_system_name, &apos;16&apos; sort_order,&apos;&lt;b&gt;Available Disk Capacity&lt;/b&gt;&apos; metric, TO_CHAR(available_capacity,&apos;999G999G999D99&apos;)||&apos; ${freeCombo1}&apos; FROM t4 UNION 
SELECT gsan_system_name, &apos;17&apos; sort_order,&apos;&lt;b&gt;Protected Quota&lt;/b&gt;&apos; metric, protected_bytes_quota FROM t4 UNION 
SELECT gsan_system_name, &apos;18&apos; sort_order,&apos;&lt;b&gt;License Expiration&lt;/b&gt;&apos; metric, NVL(TO_CHAR(license_expiration_date,&apos;MM/DD/YYYY&apos;),&apos;Never&apos;) FROM t4 UNION 
SELECT gsan_system_name, &apos;19&apos; sort_order,&apos;&lt;b&gt;Time Since Server Intitialization&lt;/b&gt;&apos; metric, time_since_server_init_hrs FROM t4 UNION 
SELECT gsan_system_name, &apos;20&apos; sort_order,&apos;&lt;b&gt;Last Checkpoint&lt;/b&gt;&apos; metric, TO_CHAR(last_checkpoint,&apos;MM/DD/YYYY&apos;) FROM t4 UNION 
SELECT gsan_system_name, &apos;21&apos; sort_order,&apos;&lt;b&gt;Last Validated Checkpoint&lt;/b&gt;&apos; metric, TO_CHAR(last_validated_checkpoint,&apos;MM/DD/YYYY&apos;) FROM t4 UNION 
SELECT gsan_system_name, &apos;22&apos; sort_order,&apos;&lt;b&gt;Number of Nodes&lt;/b&gt;&apos; metric, TO_CHAR(nodes) FROM t4 UNION 
SELECT gsan_system_name, &apos;23&apos; sort_order,&apos;&lt;b&gt;Version(s)&lt;/b&gt;&apos; metric, TO_CHAR(versions) FROM t4 UNION 
SELECT gsan_system_name, &apos;24&apos; sort_order,&apos;&lt;b&gt;Nodes Disk Capacity&lt;/b&gt;&apos; metric, TO_CHAR(nodes_total_capacity,&apos;999G999G999D99&apos;)||&apos; ${freeCombo1}&apos; FROM t4 UNION 
SELECT gsan_system_name, &apos;25&apos; sort_order,&apos;&lt;b&gt;Nodes Used Capacity&lt;/b&gt;&apos; metric, TO_CHAR(nodes_used_capacity,&apos;999G999G999D99&apos;)||&apos; ${freeCombo1}&apos; FROM t4 UNION 
SELECT gsan_system_name, &apos;26&apos; sort_order,&apos;&lt;b&gt;Nodes Available Capacity&lt;/b&gt;&apos; metric, TO_CHAR(nodes_free_capacity,&apos;999G999G999D99&apos;)||&apos; ${freeCombo1}&apos; FROM t4 
ORDER BY 1,2</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
