      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 11/04/2012
--NOTE: These require the purchase of the NBU Policy Audit Module license in order to work.
SELECT 
log_date,
server_id, server_name,
policy_id, policy_name,
policy_change change 
FROM
TABLE(nbu_rtd.listPolicyChanges(${startDate}, ${endDate}, ${spHosts},NULL,${serverGroups},1)) p</string>
          </entry>
