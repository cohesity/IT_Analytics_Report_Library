  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>longDescription</string>
      <string>This report shows you the total amount of data in gigabytes that was backed up but has not expired yet for each of the days in the report scope. This report shows results only for NetBackup and NetBackup Appliances. The report also shows a trendline with the average for the period.</string>
    </entry>
