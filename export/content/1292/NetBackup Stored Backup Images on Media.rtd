          </entry>
          <entry>
            <string>dataSource</string>
            <string>WITH &#xd;
var AS (&#xd;
SELECT&#xd;
ROUND((${endDate} - ${startDate}),2) nbrOfDays,&#xd;
DECODE(&apos;${freeCombo2}&apos;,&#xd;
&apos;KB&apos;,1,&apos;MB&apos;,1024,&apos;GB&apos;,(1024*1024),&apos;TB&apos;,(1024*1024*1024),&apos;PB&apos;,(1024*1024*1024*1024)) div_by &#xd;
FROM apt_v_dual&#xd;
),&#xd;
t1 AS (&#xd;
SELECT&#xd;
TRUNC(j.start_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YY&apos;)) the_date,&#xd;
COUNT(DISTINCT j. client_id) client_count,&#xd;
ROUND(SUM(CASE WHEN j.expiration_date &gt; sysdate THEN (j.kilobytes/div_by) ELSE 0 END),2) job_volume,&#xd;
ROUND(SUM(CASE WHEN dm.expiration_date &gt; sysdate THEN (dm.written_kilobytes/div_by) ELSE 0 END),2) dm_job_volume,&#xd;
ROUND(SUM(CASE WHEN tm.expiration_date &gt; sysdate THEN (tm.kilobytes/div_by) ELSE 0 END),2) tm_job_volume,&#xd;
ROUND(AVG(CASE WHEN j.expiration_date &gt; sysdate THEN (j.kilobytes/div_by) ELSE 0 END),2) avg_job_volume,&#xd;
ROUND(AVG(CASE WHEN dm.expiration_date &gt; sysdate THEN (dm.written_kilobytes/div_by) ELSE 0 END),2) dm_avg_volume,&#xd;
ROUND(AVG(CASE WHEN tm.expiration_date &gt; sysdate THEN (tm.kilobytes/div_by) ELSE 0 END),2) tm_avg_volume&#xd;
FROM apt_v_nbu_job_detail j, apt_v_nbu_job_disk_media dm, apt_v_nbu_job_tape_media tm, var&#xd;
WHERE j.client_id IN (${hosts})&#xd;
AND j.start_date BETWEEN ${startDate} AND ${endDate}&#xd;
AND j.job_id=dm.job_id (+)&#xd;
AND j.job_id=tm.job_id (+)&#xd;
AND REGEXP_LIKE(j.policy_name,&apos;${freeText1}&apos;)&#xd;
GROUP BY&#xd;
TRUNC(j.start_date,DECODE(&apos;${freeCombo1}&apos;,&apos;Day&apos;,&apos;DD&apos;,&apos;Week&apos;,&apos;WW&apos;,&apos;Month&apos;,&apos;MM&apos;,&apos;Quarter&apos;,&apos;Q&apos;,&apos;Year&apos;,&apos;YY&apos;))&#xd;
)&#xd;
SELECT&#xd;
TO_CHAR(the_date,&apos;MM/DD/YY&apos;) the_date,&#xd;
TO_CHAR(the_date,&apos;YYYYMMDD&apos;) sort_order,&#xd;
client_count,&#xd;
AVG(avg_job_volume + dm_avg_volume + tm_avg_volume) avg_job_volume,&#xd;
SUM(job_volume + dm_job_volume + tm_job_volume) job_volume&#xd;
FROM t1&#xd;
GROUP BY the_date, client_count&#xd;
ORDER BY 2</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
