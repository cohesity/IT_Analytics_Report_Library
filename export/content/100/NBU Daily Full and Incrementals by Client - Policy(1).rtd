  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>descriptiveName</string>
            <string>NBU Daily Full and Incrementals by Client - Policy</string>
          </entry>
          <entry>
            <string>drilldown</string>
            <boolean>false</boolean>
          </entry>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated, 10/30/2015
--NOTE: Requires Drilldown Report, NBU Daily Full and Incrementals.D
WITH 
t1 AS (
SELECT to_char(start_date,&#039;MM/DD/YY&#039;) the_date,
client_host_name||&#039; - &#039;||policy_name client_policy, 
SUM(DECODE(job_type,&#039;102&#039;,1)) incr_job_count,
SUM(DECODE(job_type,101,1)) full_job_count,
ROUND(SUM(DECODE(job_type,102,kilobytes/1024/1024)),2) incr_job_size,
ROUND(SUM(DECODE(job_type,101,kilobytes/1024/1024)),2) full_job_size
FROM apt_v_nbu_job_detail
WHERE start_date BETWEEN ${startDate} AND ${endDate}
AND client_id IN (${hosts})
AND job_type IN (101,102)
AND summary_status IN (0,1)
GROUP BY to_char(start_date,&#039;MM/DD/YY&#039;), client_host_name||&#039; - &#039;||policy_name
)
SELECT
the_date,
client_policy,
  NVL2(full_job_size,&#039;&lt;table width=100% border=0 cellspacing=0 cellpadding=0&gt;&lt;td style=background-color:#CCCCFF align=left&gt;&#039;||full_job_count||&#039; Full &#039;||full_job_size||&#039; GB &lt;/td&gt;&lt;/table&gt;&#039;,null)||NVL2(incr_job_size,&#039;&lt;table width=100% border=0 cellspacing=0 cellpadding=0&gt;&lt;td style=background-color:#CCFFFF align=left&gt;&#039;||incr_job_count||&#039; Incr &#039;||incr_job_size||&#039; GB&lt;/td&gt;&lt;/table&gt;&#039;,null) job_type_size
FROM t1
ORDER BY 1,2</string>
          </entry>
