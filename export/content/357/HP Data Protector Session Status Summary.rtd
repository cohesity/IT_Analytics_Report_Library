<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>descriptiveName</string>
            <string>HP Data Protector Session Status Summary</string>
          </entry>
          <entry>
            <string>drilldown</string>
            <boolean>false</boolean>
          </entry>
          <entry>
            <string>dataSource</string>
            <string>--Author:rich.rose@aptare.com
--Last Modified: 11/02/2015
WITH
VAR AS (
SELECT
ROUND((${endDate} - ${startDate}),2) nbrOfDays, 
${startDate} startDate, 
&#039;${freeCombo1}&#039; unit,
DECODE(&#039;${freeCombo1}&#039;, &#039;KB&#039;,1,&#039;MB&#039;,1024,&#039;GB&#039;,(1024*1024),&#039;TB&#039;,(1024*1024*1024),&#039;PB&#039;,(1024*1024*1024*1024)) div_by 
FROM dual 
),
t1 AS (
SELECT
hj.session_id,
hj.session_name,
MIN(hj.start_date) started,
MAX(finish_date) ended,
COUNT(DISTINCT hj.client_id) clients,
SUM(kilobytes/div_by) job_size,
COUNT(hj.job_id) total_jobs,
SUM(DECODE(hj.summary_status,0,1,0)) success,
SUM(DECODE(hj.summary_status,1,1,0)) partial,
SUM(DECODE(hj.summary_status,2,1,0)) failed,
SUM(DECODE(hj.summary_status,null,1,0)) incomplete,
SUM(DECODE(hj.vendor_status,5,1,0)) running,
SUM(DECODE(hj.vendor_status,6,1,0)) pending
FROM apt_v_hpd_job hj, var
WHERE
hj.client_id IN (${hosts})
AND hj.start_date BETWEEN ${startDate} AND ${endDate}
GROUP BY
hj.session_id,
hj.session_name
)
SELECT
session_id,
session_name,
started,
ended,
clients,
job_size,
total_jobs,
success,
partial,
failed,
failed/DECODE((total_jobs - incomplete),0,null,(total_jobs - incomplete)) pct_fail,
failed/DECODE((total_jobs - incomplete),0,null,(total_jobs - incomplete))*100 fail_pct,
incomplete,
running,
pending,
incomplete/DECODE(total_jobs,0,null,total_jobs) pct_incomplete,
incomplete/DECODE(total_jobs,0,null,total_jobs)*100 incomplete_pct
FROM t1
ORDER BY 
started DESC</string>
          </entry>
