  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>SELECT storage_array_id,array_name,raid_type,
sum(total_capacity_gb/1024) total_capacity_tb,
sum(DECODE(is_mapped,&#039;Y&#039;,total_capacity_gb,0)/1024) mapped_capacity_tb,
sum(DECODE(is_mapped,&#039;N&#039;,total_capacity_gb,0)/1024) umapped_capacity_tb,
sum(nbr_of_luns) nbr_of_luns,
sum(DECODE(is_mapped,&#039;Y&#039;,nbr_of_luns,0)) mapped_nbr_of_luns,
sum(DECODE(is_mapped,&#039;N&#039;,nbr_of_luns,0)) unmapped_nbr_of_luns
FROM aps_v_emc_sym_logical_unit
GROUP BY storage_array_id,array_name,raid_Type</string>
          </entry>
