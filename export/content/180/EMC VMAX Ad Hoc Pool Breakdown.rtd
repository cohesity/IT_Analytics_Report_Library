<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 08/23/2011
--EMC VMAX Pool subscription by Total,Used,Available,Subscribed,Over Subscribed
WITH q1 AS (
SELECT
pool_name,
sp.dev_config raid_type,
round(total_tracks_kb/1024/1024/1024,2) total_tracks,
round(total_used_tracks_kb/1024/1024/1024,2) used_tracks,
round((total_tracks_kb-total_used_tracks_kb)/1024/1024/1024,2) avail_tracks,
round((total_tracks_kb * (subscribed_pct/100))/1024/1024/1024,2) subscribed,  
CASE 
  WHEN subscribed_pct &lt;= 100 THEN 0
  ELSE ((total_tracks_kb * (subscribed_pct/100))/1024/1024/1024) - (total_tracks_kb/1024/1024/1024) 
END over_subscribed
FROM aps_v_emc_sym_storage_pool sp
WHERE  
array_name = &#039;${queryCombo1}&#039;
AND array_name is not null
)
SELECT
pool_name,
DECODE(&#039;${freeCombo1}&#039;,
&#039;Total Capacity&#039;,total_tracks,
&#039;Used Capacity&#039;,used_tracks,
&#039;Available Capacity&#039;,avail_tracks,
&#039;Amount Subscribed&#039;,subscribed,
&#039;Amount Over Subscribed&#039;,over_subscribed
) metric
FROM q1</string>
          </entry>
