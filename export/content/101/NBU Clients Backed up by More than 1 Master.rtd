  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Athor: rich.rose@aptare.com
--Last Modified: 06/05/2012
SELECT
client_id,client_host_name,
count(DISTINCT server_id) server_id_count,
sum(kilobytes/1024/1024) actual_gb,
sum(kilobytes/1024/1024)/2 wasted_gb,
aptStringConcat(DISTINCT master_host_name) master_servers
FROM apt_v_nbu_job 
WHERE 
client_id IN (${hosts})
AND start_date BETWEEN ${startDate} AND ${endDate}
AND client_host_name &lt;&gt; &#039;NONE&#039;
GROUP BY 
client_id,client_host_name
HAVING
count(DISTINCT server_id) &gt; 1</string>
          </entry>
