          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com&#xd;
--Last Modified: 02/14/2012&#xd;
WITH &#xd;
t1 AS (&#xd;
SELECT DISTINCT&#xd;
fsp.host_id,&#xd;
fsp.host_name,&#xd;
DECODE(fsp.is_san_disk,&apos;Y&apos;,&apos;SAN&apos;,&apos;N&apos;,&apos;DAS&apos;) disk_type,&#xd;
fsp.file_system_type,&#xd;
fsp.mount_point,&#xd;
fsp.filesystem_capacity_kb/1024/1024 filesystem_capacity_gb,&#xd;
fsp.filesystem_used_kb/1024/1024 filesystem_used_gb,&#xd;
trunc(DECODE(fsp.filesystem_used_kb,0,null,fsp.filesystem_used_kb)/fsp.filesystem_capacity_kb*100) used_pct&#xd;
FROM aps_v_file_system_path fsp&#xd;
WHERE &#xd;
fsp.mount_point IS NOT NULL&#xd;
AND fsp.host_id in (${hosts})&#xd;
UNION ALL&#xd;
SELECT DISTINCT&#xd;
fs.host_id,&#xd;
fs.host_name,&#xd;
&apos;NAS&apos; disk_type,&#xd;
fs.file_system_type,&#xd;
fs.mount_point,&#xd;
fs.capacity_kb/1024/1024 filesystem_capacity_gb,&#xd;
fs.used_kb/1024/1024 filesystem_used_gb,&#xd;
trunc(DECODE(fs.used_kb,0,null,fs.used_kb)/fs.capacity_kb*100) used_pct&#xd;
FROM aps_v_file_system fs&#xd;
WHERE &#xd;
fs.mount_point IS NOT NULL&#xd;
AND fs.host_id in (${hosts})&#xd;
AND fs.file_system_type LIKE &apos;nfs%&apos;&#xd;
)&#xd;
SELECT host_id,&#xd;
host_name,&#xd;
disk_type,&#xd;
file_system_type,&#xd;
mount_point,&#xd;
filesystem_capacity_gb,&#xd;
filesystem_used_gb,&#xd;
filesystem_capacity_gb-filesystem_used_gb filesystem_free_gb,&#xd;
used_pct/100 pct_used,&#xd;
used_pct&#xd;
FROM t1&#xd;
WHERE used_pct &gt;= ${freeCombo1}&#xd;
AND disk_type LIKE DECODE(&apos;${freeCombo2}&apos;,&apos;SAN&apos;,&apos;SAN&apos;,&apos;DAS&apos;,&apos;DAS&apos;,&apos;NAS&apos;,&apos;NAS&apos;,&apos;All&apos;,&apos;%&apos;)&#xd;
ORDER BY host_name, mount_point</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
