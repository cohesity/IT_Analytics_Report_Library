  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 05/02/2013
--NDMP Policies clients and pathnames
WITH 
VAR AS (
SELECT
ROUND((${endDate} - ${startDate})) nbrOfDays,
${startDate} startDate
FROM dual
),
t1 AS (
SELECT 
s.display_name master_server,
pc.client_id,
UPPER(pc.client_name) client_name,
CASE 
WHEN REGEXP_COUNT(pc.client_name,&#039;\\.&#039;) = 3 THEN pc.client_name
WHEN REGEXP_COUNT(pc.client_name,&#039;\\.&#039;) IN (1,2) THEN UPPER(SUBSTR(pc.client_name,1,INSTR(pc.client_name,&#039;.&#039;,1)-1)) 
WHEN REGEXP_COUNT(pc.client_name,&#039;\\.&#039;) = 0 THEN pc.client_name
END
short_client_name,
p.policy_id,
p.policy_name,
UPPER(pf.pathname) pathname
FROM 
apt_v_nbu_policy_file pf, apt_v_nbu_policy p, apt_v_nbu_policy_client pc, apt_v_server s
WHERE 
pc.client_id IN (${hosts})
AND p.server_id = s.server_id
AND pc.policy_id = p.policy_id
AND p.policy_type_name = &#039;NDMP&#039;
AND p.policy_id = pf.policy_id
AND p.is_active = &#039;Y&#039;
AND UPPER(SUBSTR(pf.pathname,1,4)) = &#039;/VOL&#039;
),
t2 AS (
SELECT
client_id,
policy_id,
MAX(j.start_date) last_backup
FROM apt_v_nbu_job j, var 
WHERE 
client_id IN (${hosts})
AND j.start_date &gt;= sysdate - var.nbrOfDays
GROUP BY 
client_id,
policy_id
)
SELECT 
t1.*,
NVL(TO_CHAR(t2.last_backup,&#039;MM/DD/YYYY HH:MI&#039;),&#039;&lt;font color=red&gt;No backup in &#039;||var.nbrOfDays||&#039; days&lt;/font&gt;&#039;) last_backup
FROM t1,t2,var
WHERE t1.client_id = t2.client_id (+)
AND t1.policy_id = t2.policy_id (+)</string>
          </entry>
