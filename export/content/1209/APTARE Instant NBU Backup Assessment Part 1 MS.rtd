          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last updated: 08/27/2015
--Provides Several Key Performance Indicators for a NBU Environment
--Part 1 of 2
--This was divided up into 2 parts so it would fit better on a dashboard
WITH 
VAR AS (
SELECT
ROUND((${endDate} - ${startDate}),2) nbrOfDays,
${startDate} startDate,
DECODE(&apos;${freeCombo1}&apos;,
&apos;KB&apos;,1,&apos;MB&apos;,1024,&apos;GB&apos;,(1024*1024),&apos;TB&apos;,(1024*1024*1024),&apos;PB&apos;,(1024*1024*1024*1024)) div_by 
FROM apt_v_dual
),
t0 AS (--Calculates Individual Job Statistics
SELECT
COUNT(DISTINCT j.server_id) server_count,
COUNT(DISTINCT j.media_server_id ) media_server_count,
COUNT(DISTINCT j.client_id) client_count,
COUNT(j.job_id) job_count,
SUM(DECODE(j.summary_status,0,1,0)) successful_job_count,
SUM(DECODE(j.summary_status,1,1,0)) partial_job_count,
SUM(DECODE(j.summary_status,2,1,0)) failed_job_count,
SUM((started_readwrite - start_date)*24*60*60) q_time,
SUM(CASE WHEN (started_readwrite - start_date)*24*60 &lt; 5 THEN 1 ELSE 0 END) qjobl5_count,
SUM(CASE WHEN (started_readwrite - start_date)*24*60 BETWEEN 5 AND 15 THEN 1 ELSE 0 END) qjob515_count,
SUM(CASE WHEN (started_readwrite - start_date)*24*60 &gt;= 15 THEN 1 ELSE 0 END) qjob15_count,
AVG(j.duration_secs) avg_duration1,
MAX(j.duration_secs) max_duration1,
SUM(CASE WHEN j.duration_secs/60/60 &gt;= 1 THEN 1 ELSE 0 END) job_g1_count,
SUM(CASE WHEN j.duration_secs/60/60 BETWEEN 1 AND 12 THEN 1 ELSE 0 END) job_112_count,
SUM(CASE WHEN j.duration_secs/60/60 BETWEEN 12 AND 24 THEN 1 ELSE 0 END) job_1224_count,
SUM(CASE WHEN j.duration_secs/60/60 &gt;= 24 THEN 1 ELSE 0 END) job_g24_count,
ROUND(SUM(j.kilobytes/var.div_by),2) job_volume,
ROUND(SUM(CASE WHEN j.job_type IN (101) THEN j.kilobytes/var.div_by ELSE 0 END),2) full_job_volume,
ROUND(SUM(CASE WHEN j.job_type IN (102) THEN j.kilobytes/var.div_by ELSE 0 END),2) incr_job_volume,
ROUND(SUM(CASE WHEN j.job_type IN (112) THEN j.kilobytes/var.div_by ELSE 0 END),2) appl_job_volume,
ROUND(SUM(CASE WHEN j.job_type IN (107) THEN j.kilobytes/var.div_by ELSE 0 END),2) dup_job_volume,
ROUND(SUM(CASE WHEN j.job_type NOT IN (101,102,112,107) THEN j.kilobytes/var.div_by ELSE 0 END),2) other_job_volume,
ROUND(SUM(CASE WHEN j.policy_type_name IN (&apos;VMware&apos;,&apos;NDMP&apos;,&apos;Oracle&apos;,&apos;MS-SQL Server&apos;,&apos;MS-Exchange Server&apos;,&apos;FlashBackup&apos;) THEN j.kilobytes/var.div_by ELSE 0 END),2) db_job_volume,
ROUND(SUM(DECODE(j.policy_type_name,&apos;VMware&apos;,j.kilobytes/var.div_by,0)),2) vmware_job_volume,
ROUND(SUM(DECODE(j.policy_type_name,&apos;NDMP&apos;,j.kilobytes/var.div_by,0)),2) ndmp_job_volume,
ROUND(SUM(DECODE(j.policy_type_name,&apos;Oracle&apos;,j.kilobytes/var.div_by,0)),2) oracle_job_volume,
ROUND(SUM(DECODE(j.policy_type_name,&apos;MS-SQL Server&apos;,j.kilobytes/var.div_by,0)),2) mssql_job_volume,
ROUND(SUM(DECODE(j.policy_type_name,&apos;MS-Exchange Server&apos;,j.kilobytes/var.div_by,0)),2) msexch_job_volume,
ROUND(SUM(DECODE(j.policy_type_name,&apos;FlashBackup&apos;,j.kilobytes/var.div_by,0)),2) flashbackup_job_volume,
COUNT(DISTINCT j.client_id||j.policy_id) cp_combos,
COUNT(DISTINCT j.client_id||j.policy_id||j.schedule_id) cps_combos,
AVG(j.duration_secs/60 )avg_duration,
SUM(j.nbr_of_files/1000000) tot_nbr_of_files
FROM apt_v_nbu_job_detail j, var
WHERE j.client_id IN (${hosts})
AND j.start_date BETWEEN ${startDate} AND ${endDate}
AND j.job_type &lt;&gt; 105
),
t3 AS (--Calculates Future Expiring data
SELECT
ROUND(SUM(CASE WHEN j.expiration_date &gt; j.start_date THEN j.kilobytes/var.div_by END),3) tot_data_expiring1,
ROUND(SUM(CASE WHEN j.expiration_date BETWEEN j.start_date AND j.start_date+30 THEN j.kilobytes/var.div_by END),3) data_expiring_l30d,
ROUND(SUM(CASE WHEN j.expiration_date BETWEEN j.start_date+30 AND j.start_date+365.25 THEN j.kilobytes/var.div_by END),3) data_expiring_30d_1y,
ROUND(SUM(CASE WHEN j.expiration_date BETWEEN j.start_date+356.25 AND j.start_date+1826 THEN j.kilobytes/var.div_by END),3) data_expiring_1y_5y,
ROUND(SUM(CASE WHEN j.expiration_date &gt; j.start_date+1826 THEN j.kilobytes/var.div_by END),2) data_expiring_o5y
FROM apt_v_nbu_job j, var
WHERE j.client_id IN (${hosts})
AND j.start_date BETWEEN ${startDate} AND ${endDate}
AND j.expiration_date &gt; j.start_date
AND j.job_type &lt;&gt; 105
),
t4 AS (--Calculates Failed Clients 
SELECT
COUNT(client_id) failed_clients1,
COUNT(DISTINCT client_id) distinct_failed_clients1
FROM (SELECT
j.client_id,
TO_CHAR(j.start_date,&apos;MM/DD/YYYY&apos;) the_date,
MIN(j.summary_status) failed_client0
FROM apt_v_nbu_job j
WHERE j.client_id IN (${hosts})
AND j.start_date BETWEEN ${startDate} AND ${endDate}
AND j.job_type &lt;&gt; 105
GROUP BY j.client_id, TO_CHAR(j.start_date,&apos;MM/DD/YYYY&apos;)
HAVING MIN(j.summary_status) = 2)
),--Calculate The Front End ${freeCombo1} (Sum of the largest full for each client done in a day)
fg1 AS (--First roll up all client, policy, schedule combinations per day
SELECT
j.server_id,j.client_id,j.policy_id,j.schedule_id,
TRUNC(j.start_date,&apos;DD&apos;) the_day,
SUM(j.kilobytes/var.div_by) fulls_for_day
FROM apt_v_nbu_job j,var
WHERE j.client_id IN (${hosts})
AND j.start_date BETWEEN ${startDate} AND ${endDate}
AND j.job_type IN (101,112)
GROUP BY j.server_id,j.client_id,j.policy_id,j.schedule_id,
TRUNC(j.start_date,&apos;DD&apos;)
),
fg2 AS (--Add up all the fulls for that day in case there were more than one
SELECT
server_id,client_id,
the_day,
SUM(fulls_for_day) the_fulls
FROM fg1
GROUP BY server_id,client_id,the_day
),
fg3 AS (--Pick the largest one for each client
SELECT 
server_id,client_id,
MAX(the_fulls) largest_full
FROM fg2
GROUP BY server_id,client_id
),
t5 AS (--Sum up all the clients largest fulls to get Front End Size
SELECT 
ROUND(SUM(largest_full),2) sum_of_fulls1
FROM fg3
)
SELECT
&apos;Number of Master Servers&apos; kpi_metric,
TO_CHAR(server_count) kpi_value1,
 &apos; &apos; kpi_value2
FROM t0
UNION ALL
SELECT
&apos;Number of Media Servers&apos; kpi_metric,
TO_CHAR(media_server_count) kpi_value1,
 &apos; &apos; kpi_value2
FROM t0
UNION ALL
SELECT
&apos;Number of Clients&apos; kpi_metric,
TO_CHAR(client_count) kpi_value1,
 &apos; &apos; kpi_value2
FROM t0
UNION ALL
SELECT
&apos;Number of Client Policy Combinations&apos; kpi_metric,
TO_CHAR(cp_combos) kpi_value1,
 &apos; &apos; kpi_value2
FROM t0
UNION ALL
SELECT
&apos;Number of Client Policy Schedule Combinations&apos; kpi_metric,
TO_CHAR(cps_combos) kpi_value1,
 &apos; &apos; kpi_value2
FROM t0
UNION ALL
SELECT
&apos;Average Number of Failed Clients per Day&apos; kpi_metric,
TO_CHAR(ROUND((failed_clients1/nbrOfDays),2)) kpi_value1,
TO_CHAR(ROUND((failed_clients1/nbrOfDays)/DECODE(client_count,0,null,client_count)*100,2))||&apos;%&apos; kpi_value2
FROM t0,t4,var
UNION ALL
SELECT
&apos;Front End ${freeCombo1}: Amount of Client Data to Protect&apos; kpi_metric,
TO_CHAR(sum_of_fulls1,&apos;999,999,999.00&apos;)||&apos; ${freeCombo1}&apos; kpi_value1,
 &apos; &apos; kpi_value2
FROM t5
UNION ALL
SELECT
&apos;&lt;b&gt;Total Amount of Streamed Data From All Backups&lt;/b&gt;&apos; kpi_metric,
TO_CHAR(job_volume,&apos;999,999,999.00&apos;)||&apos; ${freeCombo1}&apos; kpi_value1,
 &apos; &apos; kpi_value2
FROM t0
UNION ALL
SELECT
&apos;-- From Full Backups&apos; kpi_metric,
TO_CHAR(full_job_volume,&apos;999,999,999.00&apos;)||&apos; ${freeCombo1}&apos; kpi_value1,
TO_CHAR(ROUND((full_job_volume/DECODE(job_volume,0,null,job_volume)*100),2),&apos;999.00&apos;)||&apos;%&apos; kpi_value2
FROM t0
UNION ALL
SELECT
&apos;-- From Incremental Backups&apos; kpi_metric,
TO_CHAR(incr_job_volume,&apos;999,999,999.00&apos;)||&apos; ${freeCombo1}&apos; kpi_value1,
TO_CHAR(ROUND((incr_job_volume/DECODE(job_volume,0,null,job_volume)*100),2),&apos;999.00&apos;)||&apos;%&apos; kpi_value2
FROM t0
UNION ALL
SELECT
&apos;-- From Application Backups&apos; kpi_metric,
TO_CHAR(appl_job_volume,&apos;999,999,999.00&apos;)||&apos; ${freeCombo1}&apos; kpi_value1,
TO_CHAR(ROUND((appl_job_volume/DECODE(job_volume,0,null,job_volume)*100),2),&apos;999.00&apos;)||&apos;%&apos; kpi_value2
FROM t0
UNION ALL
SELECT
&apos;-- From Duplication Jobs&apos; kpi_metric,
TO_CHAR(dup_job_volume,&apos;999,999,999.00&apos;)||&apos; ${freeCombo1}&apos; kpi_value1,
TO_CHAR(ROUND((dup_job_volume/DECODE(job_volume,0,null,job_volume)*100),2),&apos;999.00&apos;)||&apos;%&apos; kpi_value2
FROM t0
UNION ALL
SELECT
&apos;-- From All Other Jobs&apos; kpi_metric,
TO_CHAR(other_job_volume,&apos;999,999,999.00&apos;)||&apos; ${freeCombo1}&apos; kpi_value1,
TO_CHAR(ROUND((other_job_volume/DECODE(job_volume,0,null,job_volume)*100),2),&apos;999.00&apos;)||&apos;%&apos; kpi_value2
FROM t0
UNION ALL
SELECT
&apos;&lt;b&gt;Amount of Streamed Data From Special Policy Types&lt;/b&gt;&apos; kpi_metric,
TO_CHAR(db_job_volume,&apos;999,999,999.00&apos;)||&apos; ${freeCombo1}&apos; kpi_value1,
 &apos; &apos; kpi_value2
FROM t0
UNION ALL
SELECT
&apos;-- From Policy Type: VMware&apos; kpi_metric,
TO_CHAR(vmware_job_volume,&apos;999,999,999.00&apos;)||&apos; ${freeCombo1}&apos; kpi_value1,
TO_CHAR(NVL(ROUND((vmware_job_volume/DECODE(db_job_volume,0,null,db_job_volume)*100),2),0),&apos;999.00&apos;)||&apos;%&apos; kpi_value2
FROM t0
UNION ALL
SELECT
&apos;-- From Policy Type: NDMP&apos; kpi_metric,
TO_CHAR(ndmp_job_volume,&apos;999,999,999.00&apos;)||&apos; ${freeCombo1}&apos; kpi_value1,
TO_CHAR(NVL(ROUND((ndmp_job_volume/DECODE(db_job_volume,0,null,db_job_volume)*100),2),0),&apos;999.00&apos;)||&apos;%&apos; kpi_value2
FROM t0
UNION ALL
SELECT
&apos;-- From Policy Type: Oracle&apos; kpi_metric,
TO_CHAR(oracle_job_volume,&apos;999,999,999.00&apos;)||&apos; ${freeCombo1}&apos; kpi_value1,
TO_CHAR(NVL(ROUND((oracle_job_volume/DECODE(db_job_volume,0,null,db_job_volume)*100),2),0),&apos;999.00&apos;)||&apos;%&apos; kpi_value2
FROM t0
UNION ALL
SELECT
&apos;-- From Policy Type: MS-SQL&apos; kpi_metric,
TO_CHAR(mssql_job_volume,&apos;999,999,999.00&apos;)||&apos; ${freeCombo1}&apos; kpi_value1,
TO_CHAR(NVL(ROUND((mssql_job_volume/DECODE(db_job_volume,0,null,db_job_volume)*100),2),0),&apos;999.00&apos;)||&apos;%&apos; kpi_value2
FROM t0
UNION ALL
SELECT
&apos;-- From Policy Type: MS-Exchange&apos; kpi_metric,
TO_CHAR(msexch_job_volume,&apos;999,999,999.00&apos;)||&apos; ${freeCombo1}&apos; kpi_value1,
TO_CHAR(NVL(ROUND((msexch_job_volume/DECODE(db_job_volume,0,null,db_job_volume)*100),2),0),&apos;999.00&apos;)||&apos;%&apos; kpi_value2
FROM t0
UNION ALL
SELECT
&apos;-- From Policy Type: FlashBackup&apos; kpi_metric,
TO_CHAR(flashbackup_job_volume,&apos;999,999,999.00&apos;)||&apos; ${freeCombo1}&apos; kpi_value1,
TO_CHAR(NVL(ROUND((flashbackup_job_volume/DECODE(db_job_volume,0,null,db_job_volume)*100),2),0),&apos;999.00&apos;)||&apos;%&apos; kpi_value2
FROM t0
UNION ALL
SELECT
&apos;&lt;b&gt;Total Amount of Retained Data Created: Expiring in the Future&lt;/b&gt;&apos; kpi_metric,
TO_CHAR(tot_data_expiring1,&apos;999,999,999.00&apos;)||&apos; ${freeCombo1}&apos; kpi_value1,
 &apos; &apos; kpi_value2
FROM t3
UNION ALL
SELECT
&apos;-- Expiring in Less Than 30 Days&apos; kpi_metric,
TO_CHAR(NVL(data_expiring_l30d,0),&apos;999,999,999.00&apos;)||&apos; ${freeCombo1}&apos; kpi_value1,
TO_CHAR(NVL(ROUND(data_expiring_l30d/DECODE(tot_data_expiring1,0,null,tot_data_expiring1)*100,2),0))||&apos;%&apos; kpi_value2
FROM t3
UNION ALL
SELECT
&apos;-- Expiring Between 30 Days and 1 Year&apos; kpi_metric,
TO_CHAR(NVL(data_expiring_30d_1y,0),&apos;999,999,999.00&apos;)||&apos; ${freeCombo1}&apos; kpi_value1,
TO_CHAR(NVL(ROUND(data_expiring_30d_1y/DECODE(tot_data_expiring1,0,null,tot_data_expiring1)*100,2),0))||&apos;%&apos; kpi_value2
FROM t3
UNION ALL
SELECT
&apos;-- Expiring Between 1 and 5 Years&apos; kpi_metric,
TO_CHAR(NVL(data_expiring_1y_5y,0),&apos;999,999,999.00&apos;)||&apos; ${freeCombo1}&apos; kpi_value1,
TO_CHAR(NVL(ROUND(data_expiring_1y_5y/DECODE(tot_data_expiring1,0,null,tot_data_expiring1)*100,2),0))||&apos;%&apos; kpi_value2
FROM t3
UNION ALL
SELECT
&apos;-- Expiring Over 5 Years&apos; kpi_metric,
TO_CHAR(NVL(data_expiring_o5y,0),&apos;999,999,999.00&apos;)||&apos; ${freeCombo1}&apos; kpi_value1,
TO_CHAR(NVL(ROUND(data_expiring_o5y/DECODE(tot_data_expiring1,0,null,tot_data_expiring1)*100,2),0))||&apos;%&apos; kpi_value2
FROM t3
UNION ALL
SELECT
&apos;&lt;b&gt;Total Number of Backup Jobs&lt;/b&gt;&apos; kpi_metric,
TO_CHAR(job_count) kpi_value1,
 &apos; &apos; kpi_value2
FROM t0
UNION ALL
SELECT
&apos;-- Successful Backup Jobs&apos; kpi_metric,
TO_CHAR(successful_job_count) kpi_value1,
TO_CHAR(ROUND(successful_job_count/DECODE(job_count,0,null,job_count)*100,2))||&apos;%&apos; kpi_value2
FROM t0
UNION ALL
SELECT
&apos;-- Jobs with Skipped Files (Partially Successful)&apos; kpi_metric,
TO_CHAR(partial_job_count) kpi_value1,
TO_CHAR(ROUND(partial_job_count/DECODE(job_count,0,null,job_count)*100,2))||&apos;%&apos; kpi_value2
FROM t0
UNION ALL
SELECT
&apos;-- Failed Backup Jobs&apos; kpi_metric,
TO_CHAR(failed_job_count) kpi_value1,
TO_CHAR(ROUND(failed_job_count/DECODE(job_count,0,null,job_count)*100,2))||&apos;%&apos; kpi_value2
FROM t0</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
