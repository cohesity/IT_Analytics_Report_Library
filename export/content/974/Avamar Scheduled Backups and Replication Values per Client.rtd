          <entry>
            <string>dataSource</string>
            <string>
--Author: rich.rose@aptare.com
--Last Updated: 08/20/2012
WITH 
t1 AS (--Get the scanned values
SELECT 
gsan_system_id,gsan_system_name,client_name,
COUNT(job_id) job_count,
COUNT(DECODE(job_type_name,&apos;Scheduled Backup&apos;,job_id,null)) sb_job_count,
MAX(DECODE(job_type_name,&apos;Scheduled Backup&apos;,scanned_kb,0)/1024/1024) sb_MAX_scanned_gb,
AVG(DECODE(job_type_name,&apos;Scheduled Backup&apos;,scanned_kb,0)/1024/1024) sb_AVG_scanned_gb,
COUNT(DECODE(job_type_name,&apos;Replication Source&apos;,job_id,null)) rs_job_count,
MAX(DECODE(job_type_name,&apos;Replication Source&apos;,scanned_kb,0)/1024/1024) rs_MAX_scanned_gb,
AVG(DECODE(job_type_name,&apos;Replication Source&apos;,scanned_kb,0)/1024/1024) rs_AVG_scanned_gb
FROM apt_v_avm_activities
WHERE 
gsan_system_name = &apos;${queryCombo1}&apos;
AND scanned_kb &gt; 0
AND recorded_date BETWEEN ${startDate} AND ${endDate}
GROUP BY gsan_system_id,gsan_system_name,client_name
),
t2 AS (--Get the totals
SELECT
gsan_system_id,
SUM(sb_job_count) tot_sb_job_count,
SUM(sb_MAX_scanned_gb) tot_sb_MAX_scanned_gb,
SUM(sb_AVG_scanned_gb) tot_sb_AVG_scanned_gb,
SUM(rs_job_count) tot_rs_job_count,
SUM(rs_MAX_scanned_gb) tot_rs_MAX_scanned_gb,
SUM(rs_AVG_scanned_gb) tot_rs_AVG_scanned_gb
FROM t1
GROUP BY gsan_system_id
),
T3 AS (
SELECT 
t1.gsan_system_id,t1.gsan_system_name,client_name,
sb_job_count,
sb_MAX_scanned_gb,
sb_AVG_scanned_gb,
ROUND(sb_job_count/tot_sb_job_count*100,4) sb_pct_total_jobs,
ROUND(sb_MAX_scanned_gb/tot_sb_MAX_scanned_gb*100,4) sb_pct_MAX_scanned_gb,
ROUND(sb_AVG_scanned_gb/tot_sb_AVG_scanned_gb*100,4) sb_pct_AVG_scanned_gb,
rs_job_count,
rs_MAX_scanned_gb,
rs_AVG_scanned_gb,
ROUND(rs_job_count/tot_rs_job_count*100,4) rs_pct_total_jobs,
ROUND(rs_MAX_scanned_gb/tot_rs_MAX_scanned_gb*100,4) rs_pct_MAX_scanned_gb,
ROUND(rs_AVG_scanned_gb/tot_rs_AVG_scanned_gb*100,4) rs_pct_AVG_scanned_gb
FROM t1,t2
WHERE t1.gsan_system_id = t2.gsan_system_id
)
SELECT 
t3.gsan_system_id,t3.gsan_system_name,
t3.client_name,
t3.sb_job_count,
t3.sb_MAX_scanned_gb,
t3.sb_AVG_scanned_gb,
t3.sb_pct_total_jobs,
t3.sb_pct_MAX_scanned_gb,
t3.sb_pct_AVG_scanned_gb,
t3.rs_job_count,
t3.rs_MAX_scanned_gb,
t3.rs_AVG_scanned_gb,
t3.rs_pct_total_jobs,
t3.rs_pct_MAX_scanned_gb,
t3.rs_pct_AVG_scanned_gb
FROM T3</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
