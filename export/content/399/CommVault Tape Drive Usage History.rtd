          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 06/14/2018
SELECT
TO_CHAR(TRUNC(tdl.poll_time,&#039;MI&#039;),&#039;MM/DD hh:mi&#039;) the_date,
tdl.drive_name,
DECODE(tdl.tape_media_id,null,&#039;white&#039;,&#039;blue&#039;) in_use_dot,
tdl.media_name
FROM apt_v_tape_drive_log tdl, apt_v_tape_drive td
WHERE 
tdl.drive_id = td.drive_id
AND tdl.poll_time BETWEEN ${startDate} AND ${endDate}
AND td.controlling_server_id IN (${hosts})
ORDER BY tdl.drive_name, tdl.poll_time</string>
          </entry>
        </data>
