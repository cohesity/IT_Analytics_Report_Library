  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>descriptiveName</string>
            <string>NBU Auto Image Replication (AIR) Jobs</string>
          </entry>
          <entry>
            <string>drilldown</string>
            <boolean>false</boolean>
          </entry>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 11/01/2017
WITH 
var AS (
SELECT
DECODE(&#039;${freeCombo1}&#039;,&#039;KB&#039;,1,&#039;MB&#039;,1024,&#039;GB&#039;,(1024*1024),&#039;TB&#039;,(1024*1024*1024),&#039;PB&#039;,(1024*1024*1024*1024)) div_by 
FROM dual
),
t1 AS (--Get the Replication Import Jobs and their pathnames which are the original backup image
SELECT 
jd.job_id,
jd.nbu_job_id,
jd.master_host_name,
jd.client_host_name,
jd.job_type_name,
jd.start_date,
jd.finish_date,
jd.vendor_status,
jf.pathname
FROM apt_v_nbu_job jd, apt_v_nbu_job_file jf
WHERE jd.server_id IN (${hosts})
AND jd.start_date BETWEEN ${startDate} AND ${endDate}
AND jd.job_id = jf.job_id
AND jd.job_type = 122
)
SELECT
--Source
jd.job_id o_job_id,
jd.nbu_job_id,
jd.master_host_name,
jd.client_host_name,
jd.policy_id,
jd.policy_name,
jd.lifecycle_policy_name,
jd.schedule_name,
jd.job_type_name,
jd.start_date,
jd.finish_date,
jd.expiration_date,
jd.vendor_status,
jd.kilobytes/div_by job_size,
--Target
t1.job_id t_job_id,
t1.nbu_job_id t_nbu_job_id,
t1.master_host_name t_master_host_name,
t1.client_host_name t_client_host_name,
t1.job_type_name t_job_type_name,
t1.start_date t_start_date,
t1.finish_date t_finish_date,
t1.vendor_status t_vendor_status,
t1.pathname t_pathname
FROM apt_v_nbu_job_detail jd, t1, var
WHERE jd.client_id IN (${hosts})
AND jd.start_date BETWEEN ${startDate} AND ${endDate}
AND jd.backup_id = t1.pathname</string>
          </entry>
