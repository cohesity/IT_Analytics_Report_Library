  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 06/12/2012
WITH 
t1 AS (
SELECT
nvl(rtd.getObjectAttributeValue(src.storage_array_id,&#039;${queryCombo1}&#039;,&#039;A&#039;),&#039;Unassigned&#039;) attribute,
sc.source_storage_system_id,
sc.source_system_name,
sc.source_volume_id,
sc.source_volume_name,
sc.source_qtree_id,
sc.source_qtree_name,
sc.destination_storage_system_id,
sc.destination_system_name,
sc.destination_volume_id,
sc.destination_volume_name,
ss.nap_snapmirror_status_id,
ss.mirror_timestamp,
summary_status,
rtd.secsToHoursMinSecs(ss.lag_time) lag_time
FROM aps_v_nap_snapmirror_status ss, aps_v_nap_snapmirror_schd sc,
aps_v_storage_array src, aps_v_storage_array dest
WHERE ss.nap_snapmirror_schd_id = sc.nap_snapmirror_schd_id
AND sc.source_storage_system_id = src.storage_array_id
AND sc.destination_storage_system_id = dest.storage_array_id
AND ss.mirror_timestamp BETWEEN ${startDate} AND ${endDate}
AND ss.summary_status IS NOT NULL
)
SELECT
attribute,
count(*) total_snapmirrors,
SUM(DECODE(summary_status,0,1,0)) success,
SUM(DECODE(summary_status,1,1,0)) partial,
SUM(DECODE(summary_status,2,1,0)) failed
FROM t1
GROUP BY attribute</string>
          </entry>
