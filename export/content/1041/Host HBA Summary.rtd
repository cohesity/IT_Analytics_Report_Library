            <string>dataSource</string>
            <string>
--Author: rich.rose@aptare.com
--Last Modified: 05/10/2012
SELECT 
host_id, host_name, 
manufacturer,
hba_model, 
driver,
driver_version, 
firmware_version, 
node_nickname,
device_name, 
node_wwn_id, node_wwn  
FROM aps_v_hba_node_detail
WHERE host_id IN (${hosts})</string>
