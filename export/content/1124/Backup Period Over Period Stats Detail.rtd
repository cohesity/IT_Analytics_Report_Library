                  <entry>
                    <string>freeComboValues2</string>
                    <string>All,New Client,Client Retired,Client backup size decreased,Client backup size stayed the same,Client backup size increased,Client backup size increased 1% to 20%,Client backup size increased 20% to 50%,Client backup size increased 50% to 100%,Client backup size increased over 100%</string>
                  </entry>
                  <entry>
                    <string>freeComboHeading2</string>
                    <string>Metric:</string>
