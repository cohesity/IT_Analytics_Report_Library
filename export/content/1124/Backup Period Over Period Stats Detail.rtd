          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 10/22/2013
-- Compares the Period over Period values 
WITH
var AS (
SELECT
ROUND((${endDate} - ${startDate}),2) nbrOfDays,
DECODE(&apos;${freeCombo1}&apos;,
&apos;KB&apos;,1,&apos;MB&apos;,1024,&apos;GB&apos;,(1024*1024),&apos;TB&apos;,(1024*1024*1024),&apos;PB&apos;,(1024*1024*1024*1024)) div_by 
FROM apt_v_dual
),
d0 AS ( --Decode the date ranges
SELECT 
(TRUNC(${endDate}) - TRUNC(${startDate}))+1 day_num
FROM apt_v_dual
),
d1 AS (
SELECT
day_num,
TRUNC(sysdate - (day_num * 2)) prior_start_date,
TRUNC((sysdate - day_num))  prior_end_date,
TRUNC((sysdate - day_num)) current_start_date,
TRUNC(sysdate) current_end_date
FROM d0
),
j1 AS ( --Prior period client stats
SELECT 
j.client_id, 
j.client_name, 
SUM(kilobytes/div_by) job_volume,
COUNT(job_id) job_count
FROM d1, apt_v_job j, var
WHERE j.client_id IN (${hosts})
AND j.start_date BETWEEN prior_start_date AND prior_end_date
AND j.summary_status IN (0,1)
GROUP BY j.client_id, j.client_name
),
j2 AS ( --Current period stats
SELECT 
j.client_id, 
j.client_name, 
SUM(kilobytes/div_by) job_volume,
COUNT(job_id) job_count
FROM d1, apt_v_job j, var
WHERE j.client_id IN (${hosts})
AND j.start_date BETWEEN current_start_date AND current_end_date
AND j.summary_status IN (0,1)
GROUP BY j.client_id, j.client_name
),
c0 AS ( --Clients who stayed exactly the same
SELECT
1 sort_order,
&apos;Client Stayed the Same&apos; metric,
j1.client_id,
j1.client_name, 
j1.job_volume vol_prior,
j2.job_volume vol_curr,
j2.job_volume-j1.job_volume vol_change,
(j2.job_volume-j1.job_volume)/DECODE(j2.job_volume,0,null,j2.job_volume)*100 pct_change
FROM j1,j2
WHERE j1.client_id = j2.client_id
AND (j2.job_volume-j1.job_volume) = 0
),
c1 AS ( --Clients who increased
SELECT
2 sort_order,
&apos;Client Increased&apos; metric,
j1.client_id,
j1.client_name, 
j1.job_volume vol_prior,
j2.job_volume vol_curr,
j2.job_volume-j1.job_volume vol_change,
(j2.job_volume-j1.job_volume)/DECODE(j2.job_volume,0,null,j2.job_volume)*100 pct_change
FROM j1,j2
WHERE j1.client_id = j2.client_id
AND (j2.job_volume-j1.job_volume) &gt; 0
),
c2 AS ( --Clients who decreased
SELECT
3 sort_order,
&apos;Client Decreased&apos; metric,
j1.client_id,
j1.client_name, 
j1.job_volume vol_prior,
j2.job_volume vol_curr,
j2.job_volume-j1.job_volume vol_change,
(j2.job_volume-j1.job_volume)/DECODE(j2.job_volume,0,null,j2.job_volume)*100 pct_change
FROM j1,j2
WHERE j1.client_id = j2.client_id
AND (j2.job_volume-j1.job_volume) &lt; 0
),
t1 AS (
SELECT 
4 sort_order,
&apos;Client Retired&apos; metric,
j1.client_id,
j1.client_name, 
j1.job_volume vol_prior,
0 vol_curr,
j1.job_volume vol_change,
100 pct_change
FROM j1
WHERE j1.client_id NOT IN (SELECT j2.client_id FROM j2)
UNION
SELECT 
5 sort_order,
&apos;New Client&apos; metric,
j2.client_id,
j2.client_name, 
0 vol_prior,
j2.job_volume vol_curr,
j2.job_volume vol_change,
100 pct_change
FROM j2
WHERE j2.client_id NOT IN (SELECT j1.client_id FROM j1)
UNION
SELECT 
6 sort_order,
&apos;Client backup size decreased&apos; metric,
c2.client_id,
c2.client_name, 
vol_prior,
vol_curr,
c2.vol_change vol_change,
pct_change
FROM c2
UNION
SELECT 
7 sort_order,
&apos;Client backup size stayed the same&apos; metric,
c0.client_id,
c0.client_name, 
vol_prior,
vol_curr,
c0.vol_change vol_change,
pct_change
FROM c0
UNION
SELECT 
8 sort_order,
&apos;Client backup size increased 1% to 20% &apos; metric,
c1.client_id,
c1.client_name, 
vol_prior,
vol_curr,
c1.vol_change vol_change,
pct_change
FROM c1
WHERE c1.pct_change &lt; 20 
UNION
SELECT 
9 sort_order,
&apos;Client backup size increased 20% to 50% &apos; metric,
c1.client_id,
c1.client_name, 
vol_prior,
vol_curr,
c1.vol_change vol_change,
pct_change
FROM c1
WHERE c1.pct_change BETWEEN 20 AND 50
UNION
SELECT 
10 sort_order,
&apos;Client backup size increased 50% to 100% &apos; metric,
c1.client_id,
c1.client_name, 
vol_prior,
vol_curr,
c1.vol_change vol_change,
pct_change
FROM c1
WHERE c1.pct_change BETWEEN 50 AND 100
UNION
SELECT 
11 sort_order,
&apos;Client backup size increased over 100% &apos; metric,
c1.client_id,
c1.client_name, 
vol_prior,
vol_curr,
c1.vol_change vol_change,
pct_change
FROM c1
WHERE c1.pct_change &gt; 100
)
SELECT *
FROM t1 
WHERE metric LIKE DECODE(&apos;${freeCombo2}&apos;,&apos;All&apos;,&apos;%&apos;,&apos;${freeCombo2}%&apos;)</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
