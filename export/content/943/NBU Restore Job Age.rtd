          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 07/12/2012
SELECT
rbj.backup_job_id,
bj.client_host_name backup_client,
bj.start_date backup_start_date,
rbj.restore_job_id,
rj.client_host_name restore_client,
rj.start_date restore_start_date,
rj.target_client_id,
tc.hostname target_client,
rj.kilobytes/1024/1024 restore_size_gb,
round(rj.start_date-bj.start_date) restore_age,
(SELECT REPLACE(aptStringConcat(jf.pathname),&apos;,&apos;,&apos;&lt;br&gt;&apos;) FROM apt_v_nbu_job_file jf WHERE jf.job_id=rj.job_id) files_restored
FROM apt_v_nbu_job bj, apt_v_nbu_job rj, apt_v_nbu_restore_backup_job rbj, apt_v_server tc
WHERE bj.job_id = rbj.backup_job_id
AND rj.job_id = rbj.restore_job_id
AND rj.client_id IN (${hosts})
AND rj.start_date BETWEEN ${startDate} AND ${endDate}
AND rj.target_client_id = tc.server_id</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
