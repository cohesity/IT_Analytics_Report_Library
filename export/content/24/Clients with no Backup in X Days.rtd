            <string>designerScript</string>
            <null/>
          </entry>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 01/11/2018
WITH 
c1 AS (
SELECT 
DISTINCT server_id client_id, hostname
FROM apt_v_server
WHERE server_id IN (${hosts})
),
j1 AS (
SELECT
client_id,
MAX(lcj.finish_date) last_backup
FROM apt_v_last_client_job lcj
WHERE server_id IN (${hosts})
GROUP BY client_id
),
j2 AS (
SELECT
c1.hostname client,
NVL(to_char(last_backup,&#039;MM/DD/YYYY&#039;),&#039;Never&#039;) last_backup, 
NVL((sysdate - last_backup),99999) days_since_last
FROM j1, c1
WHERE
c1.client_id = j1.client_id (+)
)
SELECT 
client,
last_backup,
days_since_last
FROM j2
WHERE days_since_last &gt;=
DECODE(&#039;${freeCombo1}&#039;,
&#039;in at least 3 Days&#039;,3,
&#039;in at least 7 Days&#039;,7,
&#039;in at least 14 Days&#039;,14,
&#039;in at least 30 Days&#039;,30,
&#039;in at least 60 Days&#039;,60,
&#039;Ever&#039;,99999
)
ORDER BY
days_since_last</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
