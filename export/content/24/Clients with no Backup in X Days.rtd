                    <string>in at least 3 Days,in at least 7 Days,in at least 14 Days,in at least 30 Days,in at least 60 Days,Ever</string>
                  </entry>
                  <entry>
                    <string>freeComboDefaultValue1</string>
                    <string>in at least 7 Days</string>
                  </entry>
                </configuration>
