  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 12/06/2012
SELECT
to_char(trunc(start_date,DECODE(&#039;${freeCombo1}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;)),&#039;MM/DD/YY&#039;) the_date,
ROUND(SUM(DECODE(policy_type_name,&#039;Standard&#039;,1,0)),2) Standard,
ROUND(SUM(DECODE(policy_type_name,&#039;MS-Windows&#039;,1,0)),2) MS_Windows,
ROUND(SUM(DECODE(policy_type_name,&#039;Oracle&#039;,1,0)),2) Oracle,
ROUND(SUM(DECODE(policy_type_name,&#039;NDMP&#039;,1,0)),2) NDMP,
ROUND(SUM(DECODE(policy_type_name,&#039;MS-Sharepoint&#039;,1,0)),2) MS_Sharepoint,
ROUND(SUM(DECODE(policy_type_name,&#039;MS-SQL&#039;,1,0)),2) MS_SQL,
ROUND(SUM(DECODE(policy_type_name,&#039;MS-Exchange Server&#039;,1,0)),2) MS_Exchange_Server,
ROUND(SUM(DECODE(policy_type_name,&#039;FlashBackup&#039;,1,0)),2) FlashBackup,
ROUND(SUM(DECODE(policy_type_name,&#039;Vault&#039;,1,0)),2) Vault
FROM apt_v_nbu_job_detail
WHERE client_id IN (${hosts})
AND start_date BETWEEN ${startDate} AND ${endDate}
GROUP BY to_char(trunc(start_date,DECODE(&#039;${freeCombo1}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;)),&#039;MM/DD/YY&#039;)</string>
          </entry>
