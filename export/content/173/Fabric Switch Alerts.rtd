  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>SELECT
&#039;Alert&#039; source,
DECODE(ai.alerting_managed_element_type
,&#039;PHYSICAL_SWITCH_FC_PORT&#039;,&#039;PORT&#039;
,ai.alerting_managed_element_type
) element_type,
DECODE(ai.alerting_managed_element_type
,&#039;PHYSICAL_SWITCH_FC_PORT&#039;,sw1.element_name||&#039; Port &#039;||fcp.port_nbr 
,&#039;SWITCH&#039;,sw.element_name
,&#039;OTHER&#039;
) element_name,
ai.perceived_severity severity,
DECODE(
ai.perceived_severity,
0,&#039;blue&#039; ,
5,&#039;yellow&#039;,
2,&#039;red&#039;,
3,&#039;red&#039;,
&#039;white&#039;
) status,
ai.indication_date, 
ai.description 
FROM aps_v_swi_alert_ind ai, aps_v_swi_switch sw, aps_v_swi_switch_fc_port fcp, aps_v_swi_switch sw1
WHERE ai.switch_id = sw.switch_id(+)
AND ai.switch_fc_port_id = fcp.switch_fc_port_id(+)
AND fcp.physical_switch_id = sw1.physical_switch_id(+)</string>
          </entry>
