<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>descriptiveName</string>
            <string>Legato Daily Client Consecutive Failure Alert</string>
          </entry>
          <entry>
            <string>drilldown</string>
            <boolean>false</boolean>
          </entry>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 11/09/2015
WITH d0 AS (--Build a table of 14 date pairs
SELECT 14 the_day, 2 the_week, 1 the_month, TRUNC(sysdate-14) start_date, TRUNC(sysdate-13) cutoff_date FROM dual UNION
SELECT 13 the_day, 2 the_week, 1 the_month, TRUNC(sysdate-13) start_date, TRUNC(sysdate-12) cutoff_date FROM dual UNION
SELECT 12 the_day, 2 the_week, 1 the_month, TRUNC(sysdate-12) start_date, TRUNC(sysdate-11) cutoff_date FROM dual UNION
SELECT 11 the_day, 2 the_week, 1 the_month, TRUNC(sysdate-11) start_date, TRUNC(sysdate-10) cutoff_date FROM dual UNION
SELECT 10 the_day, 2 the_week, 1 the_month, TRUNC(sysdate-10) start_date, TRUNC(sysdate-09) cutoff_date FROM dual UNION
SELECT 09 the_day, 2 the_week, 1 the_month, TRUNC(sysdate-09) start_date, TRUNC(sysdate-08) cutoff_date FROM dual UNION
SELECT 08 the_day, 2 the_week, 1 the_month, TRUNC(sysdate-08) start_date, TRUNC(sysdate-07) cutoff_date FROM dual UNION
SELECT 07 the_day, 1 the_week, 1 the_month, TRUNC(sysdate-07) start_date, TRUNC(sysdate-06) cutoff_date FROM dual UNION
SELECT 06 the_day, 1 the_week, 1 the_month, TRUNC(sysdate-06) start_date, TRUNC(sysdate-05) cutoff_date FROM dual UNION
SELECT 05 the_day, 1 the_week, 1 the_month, TRUNC(sysdate-05) start_date, TRUNC(sysdate-04) cutoff_date FROM dual UNION
SELECT 04 the_day, 1 the_week, 1 the_month, TRUNC(sysdate-04) start_date, TRUNC(sysdate-03) cutoff_date FROM dual UNION
SELECT 03 the_day, 1 the_week, 1 the_month, TRUNC(sysdate-03) start_date, TRUNC(sysdate-02) cutoff_date FROM dual UNION
SELECT 02 the_day, 1 the_week, 1 the_month, TRUNC(sysdate-02) start_date, TRUNC(sysdate-01) cutoff_date FROM dual UNION
SELECT 01 the_day, 1 the_week, 1 the_month, TRUNC(sysdate-01) start_date, TRUNC(sysdate-00) cutoff_date FROM dual
),
d1 AS (--Apply the cutoff time to the date pairs
SELECT 
the_day,the_week,the_month,
TRUNC(start_date)+(1/24) * DECODE(&#039;${freeCombo1}&#039;,&#039;5:00am&#039;,5,&#039;6:00am&#039;,6,&#039;7:00am&#039;,7,&#039;8:00am&#039;,8,&#039;9:00am&#039;,9,&#039;10:00am&#039;,10,&#039;11:00am&#039;,11) start_date,
TRUNC(cutoff_date)+(1/24) * DECODE(&#039;${freeCombo1}&#039;,&#039;5:00am&#039;,5,&#039;6:00am&#039;,6,&#039;7:00am&#039;,7,&#039;8:00am&#039;,8,&#039;9:00am&#039;,9,&#039;10:00am&#039;,10,&#039;11:00am&#039;,11) cutoff_date  
FROM d0
),
t1 AS (--Client Daily Statistics
SELECT 
d1.the_day, d1.the_week, d1.the_month, d1.start_date, d1.cutoff_date,
j.server_id, j.server_name,
j.client_id, j.client_name,
lj.saveset_group_id,
lj.saveset_group_name,
COUNT(j.job_id) job_count,
MIN(j.summary_status) min_status,
MAX(j.summary_status) max_status
FROM apt_v_job j, apt_v_leg_job lj, apt_v_leg_client_resource cr, d1
WHERE j.start_date BETWEEN d1.start_date AND d1.cutoff_date
AND j.client_id IN (${hosts})
AND j.client_id = cr.client_id
AND j.job_id = lj.job_id
AND cr.scheduled_backup = &#039;Y&#039;
AND lj.is_save_group_active = &#039;Y&#039;
GROUP BY 
d1.the_day, d1.the_week, d1.the_month, d1.start_date, d1.cutoff_date,
j.server_id, j.server_name,
j.client_id, j.client_name,
lj.saveset_group_id,
lj.saveset_group_name
ORDER BY 
d1.the_day,d1.the_week,d1.the_month, d1.start_date, d1.cutoff_date,
j.server_id, j.server_name,
j.client_id, j.client_name,
lj.saveset_group_id,
lj.saveset_group_name
),
t2 AS (--Crosstab the results
SELECT
server_id, server_name,
client_id, client_name,
saveset_group_id,
saveset_group_name,
MIN(DECODE(the_day,01,min_status)) day01_status,
MIN(DECODE(the_day,02,min_status)) day02_status,
MIN(DECODE(the_day,03,min_status)) day03_status,
MIN(DECODE(the_day,04,min_status)) day04_status,
MIN(DECODE(the_day,05,min_status)) day05_status,
MIN(DECODE(the_day,06,min_status)) day06_status,
MIN(DECODE(the_day,07,min_status)) day07_status,
MIN(DECODE(the_day,08,min_status)) day08_status,
MIN(DECODE(the_day,09,min_status)) day09_status,
MIN(DECODE(the_day,10,min_status)) day10_status,
MIN(DECODE(the_day,11,min_status)) day11_status,
MIN(DECODE(the_day,12,min_status)) day12_status,
MIN(DECODE(the_day,13,min_status)) day13_status,
MIN(DECODE(the_day,14,min_status)) day14_status
FROM t1
GROUP BY 
server_id, server_name,
client_id, client_name,
saveset_group_id,
saveset_group_name
),
t3 AS (--Evaluate the risk
SELECT
server_id, server_name,
client_id, client_name,
saveset_group_id, saveset_group_name,
CASE 
WHEN NVL(day01_status,0)+ NVL(day02_status,0)+ NVL(day03_status,0) = 6
THEN &#039;Failed Backup 3 Consecutive Days&#039;
WHEN NVL(day01_status,0)+ NVL(day02_status,0) = 4
THEN &#039;Failed Backup 2 Consecutive Days&#039;
WHEN day01_status IS NULL AND day02_status = 2 AND day03_status = 2
THEN &#039;No Backup After 2 Days of Failure&#039;
WHEN day01_status IS NULL AND day02_status IS NULL AND day03_status = 2
THEN &#039;No Backup in 2 Days After Failure&#039;
WHEN day01_status IS NULL AND day02_status IS NULL AND day03_status IS NULL
THEN &#039;No Backup Last 3 Days&#039;
END risk_analysis,
day01_status, day02_status, day03_status, day04_status, day05_status, day06_status, day07_status,
day08_status, day09_status, day10_status, day11_status, day12_status, day13_status, day14_status,
DECODE(day01_status,null,&#039;white&#039;,0,&#039;green&#039;,1,&#039;yellow&#039;,2,&#039;red&#039;) day01_dot,
DECODE(day02_status,null,&#039;white&#039;,0,&#039;green&#039;,1,&#039;yellow&#039;,2,&#039;red&#039;) day02_dot, 
DECODE(day03_status,null,&#039;white&#039;,0,&#039;green&#039;,1,&#039;yellow&#039;,2,&#039;red&#039;) day03_dot, 
DECODE(day04_status,null,&#039;white&#039;,0,&#039;green&#039;,1,&#039;yellow&#039;,2,&#039;red&#039;) day04_dot, 
DECODE(day05_status,null,&#039;white&#039;,0,&#039;green&#039;,1,&#039;yellow&#039;,2,&#039;red&#039;) day05_dot, 
DECODE(day06_status,null,&#039;white&#039;,0,&#039;green&#039;,1,&#039;yellow&#039;,2,&#039;red&#039;) day06_dot, 
DECODE(day07_status,null,&#039;white&#039;,0,&#039;green&#039;,1,&#039;yellow&#039;,2,&#039;red&#039;) day07_dot,
DECODE(day08_status,null,&#039;white&#039;,0,&#039;green&#039;,1,&#039;yellow&#039;,2,&#039;red&#039;) day08_dot,
DECODE(day09_status,null,&#039;white&#039;,0,&#039;green&#039;,1,&#039;yellow&#039;,2,&#039;red&#039;) day09_dot, 
DECODE(day10_status,null,&#039;white&#039;,0,&#039;green&#039;,1,&#039;yellow&#039;,2,&#039;red&#039;) day10_dot, 
DECODE(day11_status,null,&#039;white&#039;,0,&#039;green&#039;,1,&#039;yellow&#039;,2,&#039;red&#039;) day11_dot, 
DECODE(day12_status,null,&#039;white&#039;,0,&#039;green&#039;,1,&#039;yellow&#039;,2,&#039;red&#039;) day12_dot, 
DECODE(day13_status,null,&#039;white&#039;,0,&#039;green&#039;,1,&#039;yellow&#039;,2,&#039;red&#039;) day13_dot, 
DECODE(day14_status,null,&#039;white&#039;,0,&#039;green&#039;,1,&#039;yellow&#039;,2,&#039;red&#039;) day14_dot
FROM t2
WHERE 
--Only get ones that had a failure in the last 14 days
GREATEST(NVL(day01_status,0), NVL(day02_status,0), NVL(day03_status,0), NVL(day04_status,0), NVL(day05_status,0), NVL(day06_status,0), NVL(day07_status,0),
NVL(day08_status,0), NVL(day09_status,0), NVL(day10_status,0), NVL(day11_status,0), NVL(day12_status,0), NVL(day13_status,0), NVL(day14_status,0)) = 2
)
SELECT
server_id, server_name,
client_id, client_name,
saveset_group_id, saveset_group_name,
risk_analysis,
day01_dot, day02_dot, day03_dot, day04_dot, day05_dot, day06_dot, day07_dot,
day08_dot, day09_dot, day10_dot, day11_dot, day12_dot, day13_dot, day14_dot
FROM t3
WHERE
--All,Failed Backup,No Backup
risk_analysis LIKE 
CASE 
WHEN &#039;${freeCombo2}&#039; = &#039;All&#039; THEN &#039;%&#039;
WHEN &#039;${freeCombo2}&#039; = &#039;Failed Backup&#039; THEN &#039;Failed Backup%&#039;
WHEN &#039;${freeCombo2}&#039; = &#039;No Backup&#039; THEN &#039;No Backup%&#039;
END
ORDER BY 
UPPER(server_name),
UPPER(client_name)</string>
          </entry>
