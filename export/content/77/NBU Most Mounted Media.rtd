  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>WITH t1 AS (
SELECT s.hostname master_server,
tape_media_id,media_name barcode, nbr_of_mounts
FROM apt_v_nbu_tape_media tm,apt_v_server s 
WHERE tm.server_id IN (${hosts})
AND tm.server_id = s.server_id
ORDER BY tm.nbr_of_mounts DESC
)
SELECT master_server,tape_media_id, barcode, nbr_of_mounts
FROM t1 WHERE ROWNUM &lt;= ${freeCombo1}</string>
          </entry>
          <entry>
            <string>designerScript</string>
            <null/>
          </entry>
          <entry>
            <string>advancedComponents</string>
            <list/>
          </entry>
