          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@veritas.com
--Last Modified: 07/30/2020
WITH 
ss AS (--Count up the various summary status
SELECT					
TRUNC(start_date) the_start_date,
product_type_name,
server_id,					
server_name,
client_id,
client_name,
COUNT(*) job_count,
SUM(DECODE(summary_status,0,1,0)) s_count,					
SUM(DECODE(summary_status,1,1,0)) w_count,					
SUM(DECODE(summary_status,2,1,0)) f_count,					
SUM(DECODE(summary_status,NULL,1,0)) i_count,
SUM(CASE WHEN duration_secs/60/60 &gt; 24 THEN 1 ELSE 0 END) over_24_count,
--Normally a NULL summary_status would indicate a job is still running past cuttoff
--but for historical reporting I will assume a job running for &gt; 24 hrs to be incomplete relative
--to it&apos;s start date
MIN(start_date) min_start_date,
MAX(start_date) max_start_date,
MIN(finish_date) min_finish_date,
MAX(finish_date) max_finish_date,
aptStringConcat(DISTINCT job_type_name) job_types,
aptStringConcat(DISTINCT vendor_status) status_states,
SUM(kilobytes/1024/1024)  job_size_gb					
FROM apt_v_job				
WHERE 
TRUNC(start_date) BETWEEN TRUNC(${startDate}) AND TRUNC(${endDate})
AND client_id IN (${hosts})
AND REGEXP_LIKE(client_name,&apos;${freeText1}&apos;)					
GROUP BY
TRUNC(start_date),
product_type_name,
server_id,					
server_name,
client_id,					
client_name
),
sc AS (--Assign the Secret Code
SELECT
the_start_date,
min_start_date,
max_start_date,
min_finish_date,
max_finish_date,
product_type_name,
server_id,					
server_name,
client_id,					
client_name,
job_count,
--If the have any status 0,1,2 or NULL assign an exponential number to represent it
CASE WHEN s_count &gt; 0 THEN 1 ELSE 0 END s_code,					
CASE WHEN w_count &gt; 0 THEN 2 ELSE 0 END w_code,					
CASE WHEN f_count &gt; 0 THEN 4 ELSE 0 END f_code,					
CASE WHEN (NVL(i_count,0) + over_24_count) &gt; 0 THEN 8 ELSE 0 END i_code,
--The secret code is the sum of the indiviapt_v_dual exponential numbers (every combination will be unique)
CASE WHEN s_count &gt; 0 THEN 1 ELSE 0 END +					
CASE WHEN w_count &gt; 0 THEN 2 ELSE 0 END +					
CASE WHEN f_count &gt; 0 THEN 4 ELSE 0 END +					
CASE WHEN (NVL(i_count,0) + over_24_count) &gt; 0 THEN 8 ELSE 0 END secret_code,				
--The counts will represent how many actual successes vs failures 
s_count,
w_count,
f_count,
(NVL(i_count,0) + over_24_count) i_count,
job_types,
status_states,
job_size_gb
FROM ss
),
t1 AS (
--Decode the secret_code and display the overall client status 
SELECT 
the_start_date,
TO_CHAR(the_start_date,&apos;MM/DD&apos;) start_month_day_char,
TO_CHAR(the_start_date,&apos;MM/DD/YYYY&apos;) start_date_char,
min_start_date,
max_start_date,
min_finish_date,
max_finish_date,
product_type_name,
server_id,
server_name,
client_id,
client_name,
server_name||&apos; - &apos;||client_name server_client,
secret_code,
job_count,
DECODE(secret_code,				
 1 , &apos;Successful&apos;,--No 				
 2 , &apos;Warnings&apos;,--Low 				
 3 , &apos;Successful &amp; Warnings&apos;,--Low 				
 4 , &apos;Failed&apos;,--High 				
 5 , &apos;Successful &amp; Failed&apos;,--Med 				
 6 , &apos;Warnings &amp; Failed&apos;,--Med 				
 7 , &apos;Successful &amp; Warnings &amp; Failed&apos;,--Med 				
 8 , &apos;Incomplete&apos;,--High 				
 9 , &apos;Successful &amp; Incomplete&apos;,--Med 				
10 , &apos;Warnings &amp; Incomplete&apos;,--Med 				
11 , &apos;Successful &amp; Warnings &amp; Incomplete&apos;,--Med 				
12 , &apos;Failed &amp; Incomplete&apos;,--High 				
13 , &apos;Successful &amp; Failed &amp; Incomplete&apos;,--Med 				
14 , &apos;Warnings &amp; Failed &amp; Incomplete&apos;,--Med 				
15 , &apos;Successful &amp; Warnings &amp; Failed &amp; Incomplete&apos;,--Med 				
&apos;Other&apos;) overall_client_status,
DECODE(secret_code,				
 1 , &apos;status1&apos;, 				
 2 , &apos;status2&apos;, 				
 3 , &apos;status3&apos;, 				
 4 , &apos;status4&apos;, 				
 5 , &apos;status5&apos;, 				
 6 , &apos;status6&apos;, 				
 7 , &apos;status7&apos;, 				
 8 , &apos;status8&apos;, 				
 9 , &apos;status9&apos;, 				
10 , &apos;status10&apos;, 				
11 , &apos;status11&apos;, 				
12 , &apos;status12&apos;, 				
13 , &apos;status13&apos;, 				
14 , &apos;status14&apos;, 				
15 , &apos;status15&apos;,  				
&apos;white&apos;) ostatus_dot,
DECODE(secret_code,				
 1 , &apos;No&apos;, 				
 2 , &apos;Low&apos;, 				
 3 , &apos;Low&apos;, 				
 4 , &apos;High&apos;, 				
 5 , &apos;Med&apos;, 				
 6 , &apos;Med&apos;, 				
 7 , &apos;Med&apos;, 				
 8 , &apos;High&apos;, 				
 9 , &apos;Med&apos;, 				
10 , &apos;Med&apos;, 				
11 , &apos;Med&apos;, 				
12 , &apos;High&apos;, 				
13 , &apos;Med&apos;, 				
14 , &apos;Med&apos;, 				
15 , &apos;Med&apos;, 				
&apos;Other&apos;) client_risk_level,
DECODE(secret_code,				
 1 , 1, 				
 2 , 2, 				
 3 , 2, 				
 4 , 4, 				
 5 , 3, 				
 6 , 3, 				
 7 , 3, 				
 8 , 4, 				
 9 , 3, 				
10 , 3, 				
11 , 3, 				
12 , 4, 				
13 , 3, 				
14 , 3, 				
15 , 3, 				
1) AS slice_order,
CASE WHEN s_count &gt; 0 THEN &apos;green&apos; ELSE null END s_dot,					
CASE WHEN w_count &gt; 0 THEN &apos;yellow&apos; ELSE null END w_dot,					
CASE WHEN f_count &gt; 0 THEN &apos;red&apos; ELSE null END f_dot,					
CASE WHEN i_count &gt; 0 THEN &apos;white&apos; ELSE null END i_dot,
s_count,
w_count,
f_count,
i_count,
job_types,
status_states,
job_size_gb
FROM sc
)
SELECT
slice_order,
client_risk_level,
COUNT(client_id) client_count
FROM t1
GROUP BY
slice_order,
client_risk_level
ORDER BY 1</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
