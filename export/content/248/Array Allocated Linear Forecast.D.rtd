  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 03/30/2012
--Computes the future capacity of an array based on 
--Linear Regression (Linear) Sum of squares linear algorithm y=mX+b
WITH 
d0 AS (
SELECT
DECODE(&#039;${TheGroupBy}&#039;,&#039;Day&#039;,1,&#039;Week&#039;,7,&#039;Month&#039;,31,&#039;Quarter&#039;,93,&#039;Year&#039;,365.24) nbr_of_days,
--Limit the forecasting periods to 48
CASE 
WHEN to_number(&#039;${TheForecastPeriods}&#039;) &gt; 48 THEN 48 
ELSE to_number(&#039;${TheForecastPeriods}&#039;) END forecast_periods
FROM dual
),
a0 as (
SELECT 
array_name,
trunc(log_date,DECODE(&#039;${TheGroupBy}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;,&#039;YY&#039;)) log_date,
max(allocated_gb) allocated_gb,
max(capacity_gb) capacity_gb,
max(capacity_gb) - max(allocated_gb) available_gb
FROM aps_v_storage_array_log
WHERE log_date BETWEEN ${startDate} AND ${endDate}
AND array_name = &#039;${TheArrayName}&#039; 
AND array_name is not null
GROUP BY array_name,trunc(log_date,DECODE(&#039;${TheGroupBy}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;,&#039;YY&#039;))
),
a1 AS (
SELECT 
rownum period,
log_date,
allocated_gb,
capacity_gb,
REGR_SLOPE(allocated_gb,rownum) over (partition by array_name) slope,
REGR_INTERCEPT(allocated_gb, rownum) over (partition by array_name) y_intercept
FROM a0
ORDER BY 1
),
MP AS (--Find the last period so you can forecast past it
SELECT 
max(period) last_period,
max(log_date) last_date
FROM a1
)
SELECT
log_date,
round(allocated_gb,2) allocated_gb,
0 future_allocated,
round(capacity_gb-allocated_gb,2) available_gb,
0 future_available,
period*slope+y_intercept trend_line--Future values can be determined for any period unsing this formula
FROM a1, mp
UNION ALL --Future
SELECT 
trunc(the_date,DECODE(&#039;${TheGroupBy}&#039;,&#039;Day&#039;,&#039;DD&#039;,&#039;Week&#039;,&#039;WW&#039;,&#039;Month&#039;,&#039;MM&#039;,&#039;Quarter&#039;,&#039;Q&#039;,&#039;Year&#039;,&#039;YY&#039;)) log_date,
0 allocated_gb,
round((period+rownum)*slope+y_intercept,2) future_allocated,
0 available_gb,
round(capacity_gb - ((period+rownum)*slope+y_intercept),2) future_available,
(period+rownum)*slope+y_intercept trend_line
FROM a1,mp,d0, TABLE(rtd.APTlistOfDates(mp.last_date+d0.nbr_of_days,mp.last_date+(d0.forecast_periods*d0.nbr_of_days),DECODE(&#039;${TheGroupBy}&#039;,&#039;Day&#039;,11,&#039;Week&#039;,12,&#039;Month&#039;,13,&#039;Quarter&#039;,14,&#039;Year&#039;,15))) the_dates
WHERE period = mp.last_period</string>
          </entry>
