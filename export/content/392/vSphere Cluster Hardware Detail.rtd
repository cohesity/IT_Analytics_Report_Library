          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 05/08/2018
SELECT
vc.vmw_cluster_id,
vc.cluster_name,
vh.virtual_system_id,
vh.virtual_system_name,
vh.system_vendor||&#039; &#039;||vh.system_model||&#039; &#039;||vh.cpu_description hardware,
DECODE(vh.cpu_vendor,&#039;amd&#039;,&#039;AMD&#039;,&#039;intel&#039;,&#039;Intel&#039;,vh.cpu_vendor) cpu_vendor,
vh.cpu_speed_mhz/1000 cpu_ghz,
vh.cpu_package_num,
vc.nbr_of_cpu_cores/vc.nbr_of_hosts nbr_cpu_cores,
(vc.total_memory_kb/1024/1024)/vc.nbr_of_hosts total_memory
FROM apt_v_vmw_cluster vc,apt_v_virtual_system vs, apt_v_vmw_hardware vh
WHERE vs.host_id IN (${hosts})
AND vs.vmw_cluster_id = vc.vmw_cluster_id
AND vs.virtual_system_id = vh.virtual_system_id</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
