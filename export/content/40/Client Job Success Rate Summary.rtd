<com.aptare.sc.dal.versioning.ObjectMap>
  <version>2</version>
  <className>com.aptare.sc.domain.reportTemplateDesigner.RtdTemplate</className>
  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Updated: 05/01/2012
--Overall client success Rate
WITH 
t1 AS ( 
SELECT
to_char(start_date,&#039;MM/DD&#039;) the_date,
j.client_name,
min(summary_status) min_summary_status,
max(summary_status) max_summary_status,
SUM(DECODE(summary_status,0,1,0)) status_0_count,
SUM(DECODE(summary_status,1,1,0)) status_1_count,
SUM(DECODE(summary_status,2,1,0)) status_2_count
FROM apt_v_job j
WHERE j.client_id IN (${hosts})
AND j.start_date BETWEEN ${startDate} AND ${endDate}
GROUP BY
to_char(start_date,&#039;MM/DD&#039;),
j.client_name
),
t2 AS (
SELECT
the_date,
SUM(DECODE(min_summary_status,2,1,0)) failed_clients,
SUM(DECODE(min_summary_status,1,1,0)) partial_clients,
SUM(DECODE(max_summary_status,0,1,0)) successful_clients,
SUM(CASE WHEN min_summary_status &lt; 2 AND max_summary_status = 2 THEN 1 ELSE 0 END) success_and_failed_clients
FROM t1
GROUP BY the_date
)
SELECT
the_date,
ROUND(failed_clients/(failed_clients + partial_clients + successful_clients + success_and_failed_clients)*100,2) failure_rate,
ROUND(partial_clients/(failed_clients + partial_clients + successful_clients + success_and_failed_clients)*100,2) partial_rate,
ROUND(successful_clients/(failed_clients + partial_clients + successful_clients + success_and_failed_clients)*100,2) success_rate,
ROUND(success_and_failed_clients/(failed_clients + partial_clients + successful_clients + success_and_failed_clients)*100,2) mixed_rate
FROM t2

</string>
          </entry>
