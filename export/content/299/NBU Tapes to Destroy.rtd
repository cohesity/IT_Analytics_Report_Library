  <data>
    <entry>
      <string>reportDefinition</string>
      <com.aptare.sc.dal.versioning.ObjectMap>
        <version>1</version>
        <className>com.aptare.sc.domain.report.ReportDefinition</className>
        <data>
          <entry>
            <string>dataSource</string>
            <string>--Author: rich.rose@aptare.com
--Last Modified: 05/15/2013
SELECT 
jtm.tape_media_id,
tm.bar_code,
COUNT(DISTINCT jtm.job_id) images,
COUNT(DISTINCT jtm.client_id) clients,
MIN(jtm.expiration_date) newest_image,
MAX(jtm.expiration_date) oldest_image,
SUM(jtm.kilobytes/1024/1024) size_gb
FROM apt_v_nbu_job_tape_media jtm, apt_v_nbu_tape_media tm
WHERE 
jtm.client_id IN (${hosts})
AND jtm.controlling_server_id IN (${hosts})
AND jtm.expiration_date BETWEEN ${startDate} AND ${endDate}
AND jtm.tape_media_id = tm.tape_media_id
GROUP BY
jtm.tape_media_id,tm.bar_code</string>
          </entry>
