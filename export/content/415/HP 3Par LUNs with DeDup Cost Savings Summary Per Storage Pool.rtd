                  <entry>
                    <string>queryComboValues1</string>
                    <string>SELECT &#039; All&#039; the_key, &#039; All&#039; the_value FROM dual UNION SELECT DISTINCT ROUND(NVL(dedup_ratio,0),0)||&#039;:1&#039; the_key , ROUND(NVL(dedup_ratio,0),0)||&#039;:1&#039;  the_value FROM aps_v_h3p_logical_unit ORDER BY 1</string>
                  </entry>
                  <entry>
