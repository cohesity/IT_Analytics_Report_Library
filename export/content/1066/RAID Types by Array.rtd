          <entry>
            <string>dataSource</string>
            <string>SELECT sa.array_name||sa.serial_nbr array, 
decode(lu.raid_type,null,&apos;None&apos;,lu.raid_type) raid_type, 
sum(total_capacity_kb)/1024/1024 total_capacity_Gb
FROM aps_v_logical_unit lu, aps_v_storage_array sa
WHERE  sa.storage_array_id=lu.storage_array_id
AND sa.vendor_name LIKE DECODE(&apos;${freeCombo1}&apos;,&apos;All&apos;,&apos;%&apos;,&apos;%${freeCombo1}%&apos;)
GROUP BY sa.array_name||sa.serial_nbr, lu.raid_type</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
