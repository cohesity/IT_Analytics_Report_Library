          <entry>
            <string>dataSource</string>
            <string>--Author: Muhammad.Tahir@veritas.com
--Last Modified 03/31/2020
WITH 
VAR AS (
SELECT
  DECODE(&apos;${freeCombo1}&apos;,
  &apos;KB&apos;,1,&apos;MB&apos;,1024,&apos;GB&apos;,(1024*1024),&apos;TB&apos;,(1024*1024*1024),&apos;PB&apos;,(1024*1024*1024*1024)) div_by 
FROM dual
),
t1 AS ( 
SELECT
  mtree_id,
  SUBSTR(mtree_name,12) mtree_name,
  ROUND(SUM(local_comp_kb/div_by),2) total_size,
  ROUND(SUM(CASE WHEN file_modified_date &gt; sysdate-1 THEN local_comp_kb/div_by END),2) one_day,
  ROUND(SUM(CASE WHEN file_modified_date BETWEEN sysdate-7 AND sysdate-2 THEN local_comp_kb/div_by END),2) bt_2_and_7,
  ROUND(SUM(CASE WHEN file_modified_date BETWEEN sysdate-14 AND sysdate-7 THEN local_comp_kb/div_by END),2) bt_7_and_14,
  ROUND(SUM(CASE WHEN file_modified_date BETWEEN sysdate-30 AND sysdate-14 THEN local_comp_kb/div_by END),2) bt_14_and_30,
  ROUND(SUM(CASE WHEN file_modified_date BETWEEN sysdate-60 AND sysdate-30 THEN local_comp_kb/div_by END),2) bt_30_and_60,
  ROUND(SUM(CASE WHEN file_modified_date BETWEEN sysdate-90 AND sysdate-60 THEN local_comp_kb/div_by END),2) bt_60_and_90,
  ROUND(SUM(CASE WHEN file_modified_date BETWEEN sysdate-180 AND sysdate-90 THEN local_comp_kb/div_by END),2) bt_90_and_180,
  ROUND(SUM(CASE WHEN file_modified_date BETWEEN sysdate-365 AND sysdate-180 THEN local_comp_kb/div_by END),2) bt_180_and_365,
  ROUND(SUM(CASE WHEN file_modified_date &lt; sysdate-366 THEN local_comp_kb/div_by END),2) over_1yr
FROM 
  apt_v_ddm_file_level_comp, var
WHERE
  ddm_host_id IN (${hosts})
GROUP BY
  mtree_id,
  mtree_name
ORDER BY
  total_size DESC
)
SELECT * 
FROM t1 
WHERE rownum &lt;= ${freeCombo2}</string>
          </entry>
        </data>
      </com.aptare.sc.dal.versioning.ObjectMap>
    </entry>
